# driver.cyr — SVD evaluation driver for ganita_mat_svd / _linalg_svd_impl.
#
# Reads corpus.bin on fd 0 and writes results.bin on fd 1 (formats: README.md).
# Build it FROM A TREE ROOT that holds lib/ and src/ (includes are cwd-relative):
#   cd <tree> && cyrius build <harness>/driver.cyr <out>
# so the binary exercises THAT tree's src/matrix.cyr + src/linalg.cyr.
#
# Per matrix it writes:
#   i64 status of ganita_mat_svd(A, U, S, Vt), n sigma bits, m*n U bits, n*n Vt bits,
#   i64 status of _linalg_svd_impl(A, 0, S2, 0, 0), n sigma bits.
# Every out-param is filled with the NaN poison 0x7FF4000000000BAD before the call,
# so anything the call did not write is visible.
#
# Memory: the corpus and the output live in their own anonymous mappings, outside the
# bump heap, and alloc_reset() rewinds the heap after every matrix, so the heap never
# holds more than one matrix's working set. A candidate that caches a heap pointer in a
# global ACROSS calls would be broken by that; build with `-D SVDH_NO_RESET` to keep
# every allocation instead (the whole corpus needs well under 100 MB that way).
#
# A diagnostic line goes to fd 2: matrices processed, and how many calls modified A.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"

include "src/matrix.cyr"
include "src/linalg.cyr"
include "src/math_advanced.cyr"

var POISON = 0x7FF4000000000BAD;
var IN_CAP = 0x40000000;    # 1 GiB virtual (NORESERVE, lazily committed)
var OUT_CAP = 0x40000000;
var _ob = 0;
var _op = 0;

fn err(s) { sys_write(2, s, strlen(s)); return 0; }

fn errnum(v) {
    var buf[24];
    var i = 23;
    var x = v;
    var neg = 0;
    if (x < 0) { neg = 1; x = 0 - x; }
    if (x == 0) { store8(&buf + i, 48); i = i - 1; }
    while (x > 0) {
        store8(&buf + i, 48 + (x % 10));
        x = x / 10;
        i = i - 1;
    }
    if (neg == 1) { store8(&buf + i, 45); i = i - 1; }
    sys_write(2, &buf + i + 1, 23 - i);
    return 0;
}

fn die(s) { err("driver: "); err(s); err("\n"); sys_exit_group(2); return 0; }

fn map_region(sz) {
    var p = syscall(SYS_MMAP, 0, sz, 3, 0x4022, 0 - 1, 0);
    if (p < 0) { die("mmap failed"); }
    if (p == 0) { die("mmap failed"); }
    return p;
}

fn emit(v) {
    store64(_ob + _op, v);
    _op = _op + 8;
    if (_op > OUT_CAP - 64) { die("output region full"); }
    return 0;
}

fn flush_all() {
    var off = 0;
    while (off < _op) {
        var w = sys_write(1, _ob + off, _op - off);
        if (w <= 0) { die("write failed"); }
        off = off + w;
    }
    _op = 0;
    return 0;
}

fn poison(p, nwords) {
    var i = 0;
    while (i < nwords) { store64(p + i * 8, POISON); i = i + 1; }
    return 0;
}

fn load_matrix(src, rows, cols) {
    var a = ganita_mat_new(rows, cols);
    if (a == 0) { die("ganita_mat_new failed for A"); }
    var i = 0;
    while (i < rows * cols) { store64(a + 16 + i * 8, load64(src + i * 8)); i = i + 1; }
    return a;
}

fn same_as(a, src, n) {
    var i = 0;
    while (i < n) {
        if (load64(a + 16 + i * 8) != load64(src + i * 8)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() {
    alloc_init();
    var inb = map_region(IN_CAP);
    _ob = map_region(OUT_CAP);
    var len = 0;
    while (1 == 1) {
        if (len >= IN_CAP - 4096) { die("input too large"); }
        var r = sys_read(0, inb + len, IN_CAP - len);
        if (r < 0) { die("read failed"); }
        if (r == 0) { break; }
        len = len + r;
    }
    if (len < 8) { die("short input"); }
    var count = load64(inb);
    var p = inb + 8;
    var end = inb + len;
    var k = 0;
    var modified = 0;
    while (k < count) {
        if (p + 16 > end) { die("truncated corpus header"); }
        var rows = load64(p);
        var cols = load64(p + 8);
        p = p + 16;
        if (rows <= 0 || cols <= 0) { die("bad shape"); }
        if (p + rows * cols * 8 > end) { die("truncated corpus data"); }

        # full SVD
        var a = load_matrix(p, rows, cols);
        var u = ganita_mat_new(rows, cols);
        var vt = ganita_mat_new(cols, cols);
        var s = alloc(cols * 8);
        if (u == 0 || vt == 0 || s == 0) { die("alloc failed"); }
        poison(u + 16, rows * cols);
        poison(vt + 16, cols * cols);
        poison(s, cols);
        var st = ganita_mat_svd(a, u, s, vt);
        if (same_as(a, p, rows * cols) == 0) { modified = modified + 1; }
        emit(st);
        var i = 0;
        while (i < cols) { emit(load64(s + i * 8)); i = i + 1; }
        i = 0;
        while (i < rows * cols) { emit(load64(u + 16 + i * 8)); i = i + 1; }
        i = 0;
        while (i < cols * cols) { emit(load64(vt + 16 + i * 8)); i = i + 1; }

        # values only, on a fresh copy of A
        var a2 = load_matrix(p, rows, cols);
        var s2 = alloc(cols * 8);
        if (s2 == 0) { die("alloc failed"); }
        poison(s2, cols);
        var st2 = _linalg_svd_impl(a2, 0, s2, 0, 0);
        if (same_as(a2, p, rows * cols) == 0) { modified = modified + 1; }
        emit(st2);
        i = 0;
        while (i < cols) { emit(load64(s2 + i * 8)); i = i + 1; }

        p = p + rows * cols * 8;
        if (_op > 0x1000000) { flush_all(); }
        #ifndef SVDH_NO_RESET
        alloc_reset();
        #endif
        k = k + 1;
    }
    flush_all();
    err("driver: ");
    errnum(count);
    err(" matrices; calls that modified A: ");
    errnum(modified);
    err("\n");
    return 0;
}

var rc = main();
sys_exit_group(rc);
