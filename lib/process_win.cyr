# process_win.cyr — Windows (PE) process management via CreateProcessW.
# Usage: included by lib/process.cyr under #ifdef CYRIUS_TARGET_WIN.
# Requires: lib/syscalls.cyr, lib/string.cyr, lib/alloc.cyr, lib/tagged.cyr,
#           lib/str.cyr, lib/vec.cyr (for the exec_* family).
#
# Win32 has no fork/exec — every consumer verb maps to CreateProcessW plus
# the kernel32 reroutes wired into src/backend/x86/emit.cyr (the PE-internal
# syscall numbers 0xF001-0xF005), reusing the existing EREAD_PE (raw-handle
# ReadFile, v6.0.45) and ECLOSE_PE (CloseHandle, syscall 3). See issue
# 2026-06-03-windows-pe-syscall-surface-blocks-detection.md and the v6.0.51
# CHANGELOG entry. Runtime-verified on cass (Windows x86_64) at v6.0.51 — the
# spawn-runtime smoke landed here; v6.0.52 carries only the ai-hwaccel wheel.
#
# Win32 call numbers (PE-internal; mirror the parse_expr.cyr dispatch):
#   0xF001 (61441) WaitForSingleObject(handle, timeout)
#   0xF002 (61442) GetExitCodeProcess(handle, &code)
#   0xF003 (61443) SetHandleInformation(handle, mask, flags)
#   0xF004 (61444) CreatePipe(&rd, &wr, &sa, size)
#   0xF005 (61445) CreateProcessW(&args10)
#   0xF01D (61469) TerminateProcess(handle, exitCode)  — v6.4.26, the SIGKILL analogue
#
# A spawned "pid" (from spawn()) is the process HANDLE, not a Unix PID —
# treat it opaquely and pass it to wait_pid(). getpid()/getppid() are stubs
# (Windows self-pid via GetCurrentProcessId is out of this arc's scope).

# ================================================================
# UTF-16LE command-line / environment construction
# ================================================================

# Append NUL-terminated cstr `src` to UTF-16LE buffer `wbuf` at byte offset
# `woff` (ASCII zero-extend — each byte becomes a 2-byte little-endian wide
# char; adequate for tool paths and flags). Returns the new byte offset.
fn _w_append_cstr(wbuf, woff, src): i64 {
    var i = 0;
    while (load8(src + i) != 0) {
        store8(wbuf + woff, load8(src + i));
        store8(wbuf + woff + 1, 0);
        woff = woff + 2;
        i = i + 1;
    }
    return woff;
}

# Append a single space (U+0020) at woff. Returns the new offset.
fn _w_append_space(wbuf, woff): i64 {
    store8(wbuf + woff, 32);
    store8(wbuf + woff + 1, 0);
    return woff + 2;
}

# Write the two-byte wide NUL terminator at woff. Returns the new offset.
fn _w_terminate(wbuf, woff): i64 {
    store8(wbuf + woff, 0);
    store8(wbuf + woff + 1, 0);
    return woff + 2;
}

# v6.6.6 — the heap buffer for a `cmd /s /c` command line, SIZED FROM ITS INPUTS.
# Returns 0 after a NAMED refusal; the caller adds its own context and fails closed.
#
# `_w_append_cstr` above does NOT bound-check — it stores until the source cstr's NUL —
# so a FIXED buffer here is a heap overwrite waiting for a long enough path, and a
# SILENT one. `_win_cmdline` (cbt/build.cyr) was changed from exactly this shape at
# 6.6.5 for that reason, and `_win_wcmdline3` / `_win_wcmdline_vec` above have always
# sized from their arguments; the two `cmd /s /c` builders in this file and the two in
# cbt/build.cyr were the last fixed ones. `nchars` is the caller's own content; the
# margin covers the literal `cmd /s /c ""`/`" < "`/`" > "` scaffolding.
#
# The ceiling is Windows' own: a command line maxes at 32,767 characters, past which
# CreateProcessW fails anyway — so refuse there rather than build something unspawnable.
# CHANGELOG [6.6.6].
fn _w_cmdbuf(nchars): i64 {
    var need = (nchars + 32) * 2 + 8;
    if (need > 65536) {
        var m = "error: command line exceeds the Windows 32767-character limit\n";
        sys_write(2, m, strlen(m));
        return 0;
    }
    return alloc(need);
}

# Build a writable UTF-16LE command line "cmd [arg1 [arg2]]" on the heap.
# (CreateProcessW may modify lpCommandLine in place, so it must be writable
# heap, never a read-only literal.) Returns the buffer pointer.
fn _win_wcmdline3(cmd, arg1, arg2): i64 {
    var total = strlen(cmd) + 1;
    if (arg1 != 0) { total = total + strlen(arg1) + 1; }
    if (arg2 != 0) { total = total + strlen(arg2) + 1; }
    var wbuf = alloc((total + 1) * 2);
    var o = _w_append_cstr(wbuf, 0, cmd);
    if (arg1 != 0) { o = _w_append_space(wbuf, o); o = _w_append_cstr(wbuf, o, arg1); }
    if (arg2 != 0) { o = _w_append_space(wbuf, o); o = _w_append_cstr(wbuf, o, arg2); }
    _w_terminate(wbuf, o);
    return wbuf;
}

# Build a UTF-16LE command line from a vec of argv elements. `is_str` = 1 →
# elements are Str fat-pointers (extract str_data); 0 → raw cstr. Elements
# are space-joined. Returns the heap buffer pointer.
fn _win_wcmdline_vec(args, is_str): i64 {
    var argc = vec_len(args);
    var total = 0;
    var i = 0;
    while (i < argc) {
        var e = vec_get(args, i);
        if (is_str == 1) { e = str_data(e); }
        total = total + strlen(e) + 1;
        i = i + 1;
    }
    var wbuf = alloc((total + 1) * 2);
    var o = 0;
    var j = 0;
    while (j < argc) {
        var e = vec_get(args, j);
        if (is_str == 1) { e = str_data(e); }
        if (j > 0) { o = _w_append_space(wbuf, o); }
        o = _w_append_cstr(wbuf, o, e);
        j = j + 1;
    }
    _w_terminate(wbuf, o);
    return wbuf;
}

# Build a UTF-16LE environment block from a vec of "KEY=VALUE" elements.
# Format: each entry NUL-terminated, the whole block double-NUL-terminated.
# Pass with CREATE_UNICODE_ENVIRONMENT (0x400). Returns the block pointer.
fn _win_wenvblock_vec(env, is_str): i64 {
    var envc = vec_len(env);
    var total = 1;
    var i = 0;
    while (i < envc) {
        var e = vec_get(env, i);
        if (is_str == 1) { e = str_data(e); }
        total = total + strlen(e) + 1;
        i = i + 1;
    }
    var wbuf = alloc((total + 1) * 2);
    var o = 0;
    var j = 0;
    while (j < envc) {
        var e = vec_get(env, j);
        if (is_str == 1) { e = str_data(e); }
        o = _w_append_cstr(wbuf, o, e);
        o = _w_terminate(wbuf, o);
        j = j + 1;
    }
    _w_terminate(wbuf, o);
    return wbuf;
}

# ================================================================
# CreateProcessW core
# ================================================================

# Create a process. `wcmdline` = writable UTF-16LE command line.
# `hStdOut` = write-handle for child stdout+stderr (0 = inherit parent's).
# `wenv` = UTF-16LE env block (0 = inherit parent's). `pi` = caller's
# 24-byte PROCESS_INFORMATION (zeroed + filled here). Returns the
# CreateProcessW BOOL (non-zero = success).
fn _win_create_process(wcmdline, hStdOut, wenv, pi): i64 {
    # STARTUPINFOW (104 bytes), zeroed. Offsets: cb=0x00, dwFlags=0x3C,
    # hStdInput=0x50, hStdOutput=0x58, hStdError=0x60.
    var si[104];
    var z = 0;
    while (z < 104) { store8(&si + z, 0); z = z + 1; }
    store64(&si, 104);                          # cb = sizeof(STARTUPINFOW)
    if (hStdOut != 0) {
        store64(&si + 60, 256);                 # dwFlags = STARTF_USESTDHANDLES
        store64(&si + 88, hStdOut);             # hStdOutput
        store64(&si + 96, hStdOut);             # hStdError
    }
    # PROCESS_INFORMATION (24 bytes), zeroed.
    var pz = 0;
    while (pz < 24) { store8(pi + pz, 0); pz = pz + 1; }
    # CreateProcessW argument struct (10 qwords) — see ECREATEPROC_PE.
    var a[80];
    var flags = 0;
    if (wenv != 0) { flags = 1024; }            # CREATE_UNICODE_ENVIRONMENT
    store64(&a + 0, 0);                          # lpApplicationName
    store64(&a + 8, wcmdline);                   # lpCommandLine (writable)
    store64(&a + 16, 0);                         # lpProcessAttributes
    store64(&a + 24, 0);                         # lpThreadAttributes
    store64(&a + 32, 1);                         # bInheritHandles = TRUE
    store64(&a + 40, flags);                     # dwCreationFlags
    store64(&a + 48, wenv);                      # lpEnvironment
    store64(&a + 56, 0);                         # lpCurrentDirectory
    store64(&a + 64, &si);                       # lpStartupInfo
    store64(&a + 72, pi);                        # lpProcessInformation
    return syscall(61445, &a);                   # CreateProcessW
}

# ⛔ 6.6.8 — A DEADLINE ON WINDOWS TOO, AND NO "exit 0" FOR A WAIT THAT NEVER HAPPENED.
# Two defects in the waits below:
#   * `_win_wait_close` ignored what WaitForSingleObject and GetExitCodeProcess returned. It
#     zeroed the code buffer first, so a failed GetExitCodeProcess reported "exit 0" — the
#     fail-open direction — and a WAIT_FAILED read STILL_ACTIVE (259) as an exit code. Both are
#     now -1 (not observed), like the POSIX verbs' unreaped child.
#   * nothing here could be bounded: every wait was INFINITE and `proc_set_timeout_ms` was a
#     POSIX-only symbol, so `cyrius audit` on Windows waited for a hung cyrlint for ever. The
#     deadline now exists here with the POSIX meaning: 0 (the default) waits for ever; a
#     positive bound TerminateProcess-es the child when it expires and the verb reports -2
#     (`run` / `wait_pid`: Err(110), ETIMEDOUT). A CAPTURING verb drains its pipe BEFORE it can
#     wait, and ReadFile on that pipe blocks until the child exits, so those verbs arm a
#     watchdog THREAD (CreateThread, 0xF007) that waits on the process with the bound and
#     terminates it — the child's exit closes the pipe and the drain returns. Win32 has no
#     process tree to end: a grandchild holding the pipe is outside this bound.
# CHANGELOG [6.6.8]
var _PROC_DEADLINE_MS = 0;
var _proc_deadline_kills = 0;

# Bound every child these verbs wait for to `ms` milliseconds (0 = for ever, the default).
# Returns the previous value. Same contract as lib/process.cyr's POSIX peer.
fn proc_set_timeout_ms(ms): i64 {
    var prev = _PROC_DEADLINE_MS;
    _PROC_DEADLINE_MS = ms;
    return prev;
}

# The deadline in force, in ms (0 = none).
fn proc_timeout_ms(): i64 { return _PROC_DEADLINE_MS; }

# How many children this process has ended at a deadline, ever.
fn proc_deadline_kills(): i64 { return _proc_deadline_kills; }

# Wait for process handle `h` (bounded by the deadline in force) and return its exit code;
# -2 when the deadline ended it, -1 when the wait or GetExitCodeProcess failed (the code is
# then UNKNOWN — never a guessed 0). Does not close `h`.
fn _win_wait_handle(h): i64 {
    var ms = 4294967295;                          # INFINITE
    if (_PROC_DEADLINE_MS > 0) { ms = _PROC_DEADLINE_MS; }
    var wr = syscall(61441, h, ms) & 4294967295;  # WaitForSingleObject
    var killed = 0;
    if (wr == 258) {                              # WAIT_TIMEOUT
        _win_terminate(h, 1);
        wr = syscall(61441, h, 4294967295) & 4294967295;
        killed = 1;
        _proc_deadline_kills = _proc_deadline_kills + 1;
    }
    if (killed == 1) { return 0 - 2; }
    if (wr != 0) { return 0 - 1; }                # WAIT_FAILED (or anything but signalled)
    var code[8];
    store64(&code, 0);
    if (syscall(61442, h, &code) == 0) { return 0 - 1; }   # GetExitCodeProcess failed
    return load32(&code);
}

# Wait for the process in `pi` to exit (bounded by the deadline in force), return its exit
# code (-2 deadline, -1 unknown — see `_win_wait_handle`), and close both the process and
# thread handles.
fn _win_wait_close(pi): i64 {
    var hProcess = load64(pi + 0);
    var hThread = load64(pi + 8);
    var ec = _win_wait_handle(hProcess);
    syscall(3, hThread);                          # CloseHandle(hThread)
    syscall(3, hProcess);                         # CloseHandle(hProcess)
    return ec;
}

# The watchdog thread body (a cyrius fn compiled for PE is a valid ThreadProc: the one
# argument arrives in RCX). `a` = {hProcess, ms, fired}. Allocates nothing — the bump
# allocator is not thread-safe.
fn _win_watchdog(a): i64 {
    var wr = syscall(61441, load64(a), load64(a + 8)) & 4294967295;
    if (wr == 258) {
        _win_terminate(load64(a), 1);
        store64(a + 16, 1);
    }
    return 0;
}

# Arm a watchdog on `pi`'s process when a deadline is in force. `wd` = the caller's 24-byte
# block (it must outlive `_win_watch_end`). Returns the thread handle, 0 when none is armed.
fn _win_watch_start(pi, wd): i64 {
    store64(wd, load64(pi));
    store64(wd + 8, _PROC_DEADLINE_MS);
    store64(wd + 16, 0);
    if (_PROC_DEADLINE_MS <= 0) { return 0; }
    var ta[48];
    store64(&ta,      0);                         # lpThreadAttributes
    store64(&ta + 8,  0);                         # dwStackSize (default)
    store64(&ta + 16, &_win_watchdog);            # lpStartAddress
    store64(&ta + 24, wd);                        # lpParameter
    store64(&ta + 32, 0);                         # dwCreationFlags
    store64(&ta + 40, 0);                         # lpThreadId
    return syscall(61447, &ta);                   # CreateThread
}

# Join the watchdog; returns 1 if it had to terminate the child (counted once, here).
fn _win_watch_end(t, wd): i64 {
    if (t != 0) {
        syscall(61441, t, 4294967295);
        syscall(3, t);
    }
    if (load64(wd + 16) == 1) {
        _proc_deadline_kills = _proc_deadline_kills + 1;
        return 1;
    }
    return 0;
}

# v6.4.26 — force-terminate a spawned process. `hProcess` is the process HANDLE
# (pi+0 from _win_create_process / the opaque "pid" from spawn()); `exitCode` is
# the exit code the killed child reports. Returns the TerminateProcess BOOL
# (nonzero=success). The Windows analogue of kill(pid, SIGKILL) — Win32 has no
# signals, so a runaway child can only be stopped this way.
# See 2026-07-08-windows-pe-surface-no-terminateprocess.md.
fn _win_terminate(hProcess, exitCode): i64 {
    return syscall(61469, hProcess, exitCode);    # TerminateProcess(hProcess, exitCode)
}

# v6.4.26 — wait for the process in `pi` up to `ms` milliseconds; if it does not
# exit in time, TerminateProcess it and reap. Returns the child exit code (the
# forced code 137 = 128+SIGKILL when we had to kill, mirroring the POSIX
# SIGKILL-exit convention so a downstream can treat both lanes uniformly), and
# sets *killed_out = 1 iff the deadline was enforced (0 iff it exited on its own).
# Closes both handles either way. This is the timeout-kill primitive thoth's
# exec_shell_capture needs on Windows (the analogue of the POSIX deadline+SIGKILL).
fn _win_wait_timeout(pi, ms, killed_out): i64 {
    var hProcess = load64(pi + 0);
    var hThread = load64(pi + 8);
    store64(killed_out, 0);
    var wr = syscall(61441, hProcess, ms) & 4294967295;   # WaitForSingleObject(hProcess, ms)
    if (wr == 258) {                              # WAIT_TIMEOUT (0x102) → enforce deadline
        _win_terminate(hProcess, 137);            # TerminateProcess(hProcess, 137)
        wr = syscall(61441, hProcess, 4294967295) & 4294967295;   # INFINITE — reap
        store64(killed_out, 1);
    }
    # 6.6.8: -1 when the wait or GetExitCodeProcess FAILED — the zeroed buffer used to read
    # as "exit 0" (see `_win_wait_handle`).
    var ec = 0 - 1;
    var code[8];
    store64(&code, 0);
    if (wr == 0) {
        if (syscall(61442, hProcess, &code) != 0) { ec = load32(&code); }   # GetExitCodeProcess
    }
    syscall(3, hThread);                           # CloseHandle(hThread)
    syscall(3, hProcess);                          # CloseHandle(hProcess)
    return ec;
}

# v6.0.85 — spawn `cc < source > output` for `cyrius build` on Windows. cycc
# reads its source from stdin and writes the PE to stdout; Win32 has no
# fork/dup2/execve, so we hand the redirect to cmd.exe via CreateProcessW.
# `cmd /s /c "<inner>"` strips ONLY the outermost quote pair (the /s rule), so
# the inner per-path quotes + the `<` / `>` operators reach cmd intact:
#   cmd /s /c ""C:\...\cycc.exe" < "src.cyr" > "out.exe""
# Writes directly to `output` (SYS_RENAME is not a PE reroute, so the POSIX
# atomic tmp+rename can't be used here). Returns the child exit code; 1 if the
# spawn itself fails.
fn _win_compile_spawn(cc, source, output): i64 {
    var wbuf = _w_cmdbuf(strlen(cc) + strlen(source) + strlen(output));
    if (wbuf == 0) { return 1; }
    var o = 0;
    o = _w_append_cstr(wbuf, o, "cmd /s /c \"\"");
    o = _w_append_cstr(wbuf, o, cc);
    o = _w_append_cstr(wbuf, o, "\" < \"");
    o = _w_append_cstr(wbuf, o, source);
    o = _w_append_cstr(wbuf, o, "\" > \"");
    o = _w_append_cstr(wbuf, o, output);
    o = _w_append_cstr(wbuf, o, "\"\"");
    _w_terminate(wbuf, o);
    var pi[24];
    if (_win_create_process(wbuf, 0, 0, &pi) == 0) { return 1; }
    return _win_wait_close(&pi);
}

# Create an anonymous inheritable pipe, mark the read end non-inheritable,
# and return the read handle (write handle returned via *wr_out). Returns
# the read handle, or 0 on failure.
fn _win_make_pipe(wr_out): i64 {
    var pipeh[16];
    store64(&pipeh, 0);
    store64(&pipeh + 8, 0);
    # SECURITY_ATTRIBUTES { nLength=24, lpSecurityDescriptor=0, bInheritHandle=1 }
    var sa[24];
    store64(&sa, 24);
    store64(&sa + 8, 0);
    store64(&sa + 16, 1);
    var pr = syscall(61444, &pipeh, &pipeh + 8, &sa, 0);   # CreatePipe
    if (pr == 0) { return 0; }
    var hRead = load64(&pipeh);
    var hWrite = load64(&pipeh + 8);
    syscall(61443, hRead, 1, 0);                  # SetHandleInformation(hRead, INHERIT, 0)
    store64(wr_out, hWrite);
    return hRead;
}

# Drain a pipe read handle into buf (up to buflen). Returns bytes read.
fn _win_drain(hRead, buf, buflen): i64 {
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(hRead, buf + total, buflen - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= buflen) { rgo = 0; }
        }
    }
    return total;
}

# ================================================================
# Public API (mirrors lib/process.cyr's POSIX surface)
# ================================================================

# Run a command and wait for it. Returns Result(exit_code).
fn run(cmd, arg1, arg2): Result {
    var wcmd = _win_wcmdline3(cmd, arg1, arg2);
    var pi[24];
    var ok = _win_create_process(wcmd, 0, 0, &pi);
    if (ok == 0) { return Err(1); }
    var ec = _win_wait_close(&pi);
    if (ec == 0 - 2) { return Err(110); }         # ETIMEDOUT — the POSIX peer's PROC_ETIMEDOUT
    if (ec == 0 - 1) { return Err(10); }          # the exit code is unknown (PROC_ECHILD)
    return Ok(ec);
}

# Run a command and capture stdout (+stderr) into buf. Returns Result(bytes).
fn run_capture(cmd, arg1, arg2, buf, buflen): Result {
    var hWrite = 0;
    var hRead = _win_make_pipe(&hWrite);
    if (hRead == 0) { return Err(1); }
    var wcmd = _win_wcmdline3(cmd, arg1, arg2);
    var pi[24];
    var ok = _win_create_process(wcmd, hWrite, 0, &pi);
    if (ok == 0) { syscall(3, hRead); syscall(3, hWrite); return Err(1); }
    syscall(3, hWrite);                           # parent drops write end → EOF on child exit
    var wd[24];
    var wt = _win_watch_start(&pi, &wd);
    var total = _win_drain(hRead, buf, buflen);
    syscall(3, hRead);
    _win_watch_end(wt, &wd);
    _win_wait_close(&pi);
    return Ok(total);
}

# Spawn a command in the background. Returns Result(process_handle).
# The handle is the "pid" token — pass it to wait_pid().
fn spawn(cmd, arg1, arg2): Result {
    var wcmd = _win_wcmdline3(cmd, arg1, arg2);
    var pi[24];
    var ok = _win_create_process(wcmd, 0, 0, &pi);
    if (ok == 0) { return Err(1); }
    syscall(3, load64(&pi + 8));                  # close hThread (unused)
    return Ok(load64(&pi + 0));                   # hProcess as the pid token
}

# Wait for a previously-spawned process handle. Returns Result(exit_code).
fn wait_pid(pid): Result {
    var ec = _win_wait_handle(pid);               # bounded by the deadline in force (6.6.8)
    syscall(3, pid);                              # CloseHandle
    if (ec == 0 - 2) { return Err(110); }
    if (ec == 0 - 1) { return Err(10); }
    return Ok(ec);
}

# v6.3.44: real Windows self-PID via kernel32!GetCurrentProcessId (syscall 0xF01C
# PE reroute). Was a 0-returning stub — the v6.0.51 process arc routed process
# *creation* and left self-PID out of scope (issue 2026-07-03-getpid-cross-platform).
fn getpid(): i64 { return syscall(0xF01C); }
# Parent-pid has no cheap Win32 equivalent (would need a CreateToolhelp32Snapshot
# walk), so getppid stays a documented 0 stub on Windows.
fn getppid(): i64 { return 0; }

# ================================================================
# vec-based family (cstr argv) — mirrors exec_vec / exec_capture / exec_env
# ================================================================

# Run command with a vec of cstr argv elements. Returns exit code or -1.
fn exec_vec(args): i64 {
    if (vec_len(args) < 1) { return 0 - 1; }
    var wcmd = _win_wcmdline_vec(args, 0);
    var pi[24];
    var ok = _win_create_process(wcmd, 0, 0, &pi);
    if (ok == 0) { return 0 - 1; }
    return _win_wait_close(&pi);
}

# Run command with cstr args vec, capture stdout (+stderr — one pipe on Windows), and
# report how it ended in `status_out`'s two i64 slots, as the POSIX verb does: [0] = the
# GetExitCodeProcess code (an NTSTATUS such as 0xC0000005 for a crash — never 0), -1 when
# nothing could be spawned or the code could not be read (6.6.8: it used to read as 0), -2
# when the deadline (`proc_set_timeout_ms`) ended it; [1] = 0 (Win32 has no signals).
# Returns bytes read, -1 when nothing ran. CHANGELOG [6.6.7] [6.6.8]
fn exec_capture_status(args, buf, buflen, status_out): i64 {
    store64(status_out, 0 - 1);
    store64(status_out + 8, 0);
    if (vec_len(args) < 1) { return 0 - 1; }
    var hWrite = 0;
    var hRead = _win_make_pipe(&hWrite);
    if (hRead == 0) { return 0 - 1; }
    var wcmd = _win_wcmdline_vec(args, 0);
    var pi[24];
    var ok = _win_create_process(wcmd, hWrite, 0, &pi);
    if (ok == 0) { syscall(3, hRead); syscall(3, hWrite); return 0 - 1; }
    syscall(3, hWrite);
    var wd[24];
    var wt = _win_watch_start(&pi, &wd);
    var total = _win_drain(hRead, buf, buflen);
    syscall(3, hRead);
    var fired = _win_watch_end(wt, &wd);
    var ec = _win_wait_close(&pi);
    if (fired == 1) { ec = 0 - 2; }
    store64(status_out, ec);
    return total;
}

# Run command with cstr args vec and capture stdout. Returns bytes read; the exit code is
# discarded (use exec_capture_status to observe it).
fn exec_capture(args, buf, buflen): i64 {
    var _st[16];
    return exec_capture_status(args, buf, buflen, &_st);
}

# Run command with cstr args vec + cstr "KEY=VALUE" env vec.
fn exec_env(args, env): i64 {
    if (vec_len(args) < 1) { return 0 - 1; }
    var wcmd = _win_wcmdline_vec(args, 0);
    var wenv = _win_wenvblock_vec(env, 0);
    var pi[24];
    var ok = _win_create_process(wcmd, 0, wenv, &pi);
    if (ok == 0) { return 0 - 1; }
    return _win_wait_close(&pi);
}

# ================================================================
# Str-shape family — argv elements are Str fat-pointers (str_data extracted)
# ================================================================

# Run command with a vec of Str argv elements. Returns exit code or -1.
fn exec_vec_str(args): i64 {
    if (vec_len(args) < 1) { return 0 - 1; }
    var wcmd = _win_wcmdline_vec(args, 1);
    var pi[24];
    var ok = _win_create_process(wcmd, 0, 0, &pi);
    if (ok == 0) { return 0 - 1; }
    return _win_wait_close(&pi);
}

# Run command with Str args vec and capture stdout. Returns bytes read.
fn exec_capture_str(args, buf, buflen): i64 {
    if (vec_len(args) < 1) { return 0 - 1; }
    var hWrite = 0;
    var hRead = _win_make_pipe(&hWrite);
    if (hRead == 0) { return 0 - 1; }
    var wcmd = _win_wcmdline_vec(args, 1);
    var pi[24];
    var ok = _win_create_process(wcmd, hWrite, 0, &pi);
    if (ok == 0) { syscall(3, hRead); syscall(3, hWrite); return 0 - 1; }
    syscall(3, hWrite);
    var wd[24];
    var wt = _win_watch_start(&pi, &wd);
    var total = _win_drain(hRead, buf, buflen);
    syscall(3, hRead);
    _win_watch_end(wt, &wd);
    _win_wait_close(&pi);
    return total;
}

# Run command with Str args vec + Str "KEY=VALUE" env vec.
fn exec_env_str(args, env): i64 {
    if (vec_len(args) < 1) { return 0 - 1; }
    var wcmd = _win_wcmdline_vec(args, 1);
    var wenv = _win_wenvblock_vec(env, 1);
    var pi[24];
    var ok = _win_create_process(wcmd, 0, wenv, &pi);
    if (ok == 0) { return 0 - 1; }
    return _win_wait_close(&pi);
}

# Run a shell command line through `cmd /s /c "<cmdline>"` so pipes,
# redirects, and `&&` work, and inherit the parent's environment (wenv=0)
# so PATH/USERPROFILE reach the child. `/s` strips ONLY the outermost quote
# pair, so the inner cmdline reaches cmd intact (same rule used by
# _win_compile_spawn). Pre-v6.2.34 this space-split the cmdline and ran the
# bare first token via CreateProcessW directly — shell metacharacters became
# literal argv and nothing piped. See CHANGELOG; mirrors the POSIX
# /bin/sh -c fix in lib/process.cyr.
fn exec_cmd(cmdline): i64 {
    var wbuf = _w_cmdbuf(strlen(cmdline));
    if (wbuf == 0) { return 0 - 1; }
    var o = 0;
    o = _w_append_cstr(wbuf, o, "cmd /s /c \"");
    o = _w_append_cstr(wbuf, o, cmdline);
    o = _w_append_cstr(wbuf, o, "\"");
    _w_terminate(wbuf, o);
    var pi[24];
    if (_win_create_process(wbuf, 0, 0, &pi) == 0) { return 0 - 1; }
    return _win_wait_close(&pi);
}
