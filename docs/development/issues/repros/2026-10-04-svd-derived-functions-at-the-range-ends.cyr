# ganita_mat_pseudo_inv and ganita_mat_condition give wrong answers for finite matrices at the
# two ends of the double range, though the SVD under them is right:
#   - a singular value that is kept (above 1e-12·sigma_1) but below 2^-1024 has a reciprocal
#     that overflows to +inf, and pseudo_inv multiplies that +inf by V^T's zeros: NaN entries
#     (diag(2^-1060, 2^-1060), diag(2^-1000, 2^-1030));
#   - a sigma_1 above DBL_MAX comes back +inf, the correctly rounded overflow, and the RELATIVE
#     tolerances built from it, 1e-12·sigma_1, are +inf too: condition calls DBL_MAX·[[1, 1],
#     [1, -1]] singular (-1.0) though its condition number is exactly 1, and pseudo_inv returns
#     a matrix of zeros for it. DBL_MAX·[[1, 1], [1, 1/2]], whose sigma_2 does not overflow, is
#     "singular" too.
#
# Self-proving: the exit code is the number of checks below that come back wrong -- 0 when
# every check is right:
#   pseudo_inv   null (refused), or a matrix with no NaN entry and not all zeros where the
#                exact pseudo-inverse has a non-zero entry
#   condition    within 4 ulps of the exact condition number (computed with python3 Fraction
#                and mpmath, rounded once); -1.0 is the wrong answer "singular"
# A control (diag(2, 3)) must still give its exact answers.
#
# Filed with docs/development/issues/archived/2026-10-04-svd-derived-functions-at-the-range-ends.md.
# Found by the 1.2.12 verification of the SVD rewrite; every check gives the same result on
# 1.2.11, so neither defect is new.
#
# Build and run from the ganita repo root:
#   cyrius build docs/development/issues/repros/2026-10-04-svd-derived-functions-at-the-range-ends.cyr /tmp/svdends
#   /tmp/svdends; echo "exit=$?"      # -> 5 on 1.2.11 and 1.2.12; 0 from 1.2.13
#
# Every value is written as a bit pattern, so the program means the same thing on every
# toolchain. Includes src/ directly rather than lib/ganita.cyr so it exercises the working
# source; to run it against a stdlib fold, drop the include lines and build from a directory
# whose cyrius.cyml pins the toolchain and declares stdlib "ganita".

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"

include "src/matrix.cyr"
include "src/linalg.cyr"

var _DMAX = 0x7FEFFFFFFFFFFFFF;
var _bad = 0;
var _hexd = "0123456789abcdef";

fn out(s) { syscall(1, 1, s, strlen(s)); return 0; }

# 0x + 16 hex digits; local so the repro builds on every fold from cyrius 6.6.1.
fn hex(v) {
    var buf[18];
    store8(&buf, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 16) {
        store8(&buf + 2 + i, load8(_hexd + ((v >> ((15 - i) * 4)) & 15)));
        i = i + 1;
    }
    syscall(1, 1, &buf, 18);
    return 0;
}

fn is_nan(v) {
    if (((v >> 52) & 0x7FF) != 0x7FF) { return 0; }
    if ((v & 0x000FFFFFFFFFFFFF) == 0) { return 0; }
    return 1;
}

fn m22(a, b, c, d) {
    var m = ganita_mat_new(2, 2);
    ganita_mat_set(m, 0, 0, a);
    ganita_mat_set(m, 0, 1, b);
    ganita_mat_set(m, 1, 0, c);
    ganita_mat_set(m, 1, 1, d);
    return m;
}

fn verdict(ok, label) {
    if (ok == 1) { out("  ok    "); } else {
        out("  WRONG ");
        _bad = _bad + 1;
    }
    out(label);
    return 0;
}

# pseudo_inv(a): right when null, or when no entry is NaN and some entry is non-zero (every
# matrix here has a non-zero exact pseudo-inverse).
fn pinv_row(label, a) {
    var p = ganita_mat_pseudo_inv(a);
    var ok = 1;
    var nan = 0;
    var nz = 0;
    if (p != 0) {
        var i = 0;
        while (i < ganita_mat_rows(p) * ganita_mat_cols(p)) {
            var v = load64(p + 16 + i * 8);
            if (is_nan(v) == 1) { nan = nan + 1; }
            if ((v & 0x7FFFFFFFFFFFFFFF) != 0) { nz = nz + 1; }
            i = i + 1;
        }
        if (nan > 0 || nz == 0) { ok = 0; }
    }
    verdict(ok, label);
    if (p == 0) { out("  null\n"); return 0; }
    out("  [0][0] ");
    hex(load64(p + 16));
    out("  NaN entries ");
    fmt_int(nan);
    out(", non-zero ");
    fmt_int(nz);
    out("\n");
    return 0;
}

# condition(a): right when within 4 ulps of `want`, the exact condition number rounded once.
fn cond_row(label, a, want) {
    var c = ganita_mat_condition(a);
    var d = c - want;
    if (d < 0) { d = 0 - d; }
    var ok = 0;
    if ((c >> 63) == (want >> 63) && d <= 4) { ok = 1; }
    verdict(ok, label);
    out("  ");
    hex(c);
    out("  want ");
    hex(want);
    out("\n");
    return 0;
}

fn main() {
    var z = 0;
    # 2^-1060: kept by the relative tolerance (it IS sigma_1), and 1/2^-1060 overflows.
    pinv_row("pseudo_inv(diag(2^-1060, 2^-1060))       ", m22(0x0000000000004000, z, z, 0x0000000000004000));
    # sigma_2 = 2^-1030 is 2^-30 of sigma_1, far above 1e-12 of it, and 1/sigma_2 overflows.
    pinv_row("pseudo_inv(diag(2^-1000, 2^-1030))       ", m22(0x0170000000000000, z, z, 0x0000400000000000));
    # sigma_1 = sigma_2 = sqrt(2)·DBL_MAX: both +inf, so 1e-12·sigma_1 is +inf and every sigma is
    # "negligible". The exact pseudo-inverse is [[1, 1], [1, -1]]/(2·DBL_MAX), subnormal entries.
    var h = m22(_DMAX, _DMAX, _DMAX, _DMAX ^ 0x8000000000000000);
    pinv_row("pseudo_inv(DBL_MAX * [[1, 1], [1, -1]])  ", h);
    cond_row("condition(DBL_MAX * [[1, 1], [1, -1]])   ", h, 0x3FF0000000000000);
    # DBL_MAX·[[1, 1], [1, 1/2]]: sigma_1 = 1.78·DBL_MAX overflows, sigma_2 = 0.28·DBL_MAX does not,
    # and the condition number is that of [[1, 1], [1, 1/2]], 6.3423292192132454.
    cond_row("condition(DBL_MAX * [[1, 1], [1, 1/2]])  ", m22(_DMAX, _DMAX, _DMAX, 0x7FDFFFFFFFFFFFFF),
        0x40195E8B8D03F1C5);
    # Control: diag(2, 3). pseudo_inv = diag(1/2, 1/3), condition = 1.5.
    var c = m22(0x4000000000000000, z, z, 0x4008000000000000);
    pinv_row("pseudo_inv(diag(2, 3)), control          ", c);
    cond_row("condition(diag(2, 3)), control           ", c, 0x3FF8000000000000);
    out("checks wrong: ");
    fmt_int(_bad);
    out("\n");
    return _bad;
}

var r = main();
syscall(60, r);
