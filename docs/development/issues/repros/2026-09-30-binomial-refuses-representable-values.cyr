# ganita_binomial returns -1 ("does not fit in i64") for C(n, k) that DO fit:
# every one above i64_MAX / min(k, n - k).
#
# Self-proving: the exit code is the number of rows below that come back wrong --
# 0 when every row is right. Each row prints what it got and the exact value
# (-1 where the true value is above i64_MAX). The last row checks every C(n, k)
# with n <= 70 against Pascal's triangle built by addition alone, an algorithm
# independent of the one under test, and prints how many of the 2556 cells
# differ; that row counts once.
#
# Filed with docs/development/issues/2026-09-30-binomial-refuses-representable-values.md.
# Found by abaco 2.4.8: its evaluator began reporting ganita's -1 as a math error,
# so `binomial(62, 31)` became one although the value fits (through 2.4.7 the -1
# passed through as the answer). abaco 2.4.9 stopped calling ganita's binomial.
#
# Build and run from the ganita repo root:
#   cyrius build docs/development/issues/repros/2026-09-30-binomial-refuses-representable-values.cyr /tmp/binomr
#   /tmp/binomr; echo "exit=$?"      # -> 9 on ganita 1.2.10 (8 named rows + the sweep, 113 cells)
#
# Every input and expected value is an exact integer (no floating point), so the
# program means the same thing on every toolchain. The expected values were
# computed with Python's math.comb.
#
# Includes src/ directly rather than lib/ganita.cyr so it exercises the working
# source. math_advanced has no matrix/linalg dependency.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"

include "src/math_advanced.cyr"

var _MAX = 0x7FFFFFFFFFFFFFFF;
var _bad = 0;

# want = -1: the true value is above i64_MAX and the function must refuse.
fn row(label, n, k, want) {
    var got = ganita_binomial(n, k);
    if (got != want) { _bad = _bad + 1; print("  WRONG ", 8); } else { print("  ok    ", 8); }
    print(label, strlen(label));
    print("  got ", 6); fmt_int(got);
    print("  want ", 7); fmt_int(want);
    println("");
    return 0;
}

# Every C(n, k) for 0 <= k <= n <= 70 against Pascal's rule
# C(n, k) = C(n-1, k-1) + C(n-1, k), computed by addition with -1 marking a cell
# whose true value is above i64_MAX (a sum of two non-negative terms either fits
# or is detected by a > MAX - b). Returns the number of cells that differ.
fn sweep() {
    var prev = alloc(72 * 8);
    var cur = alloc(72 * 8);
    var cells = 0;
    var wrong = 0;
    var refused_fit = 0;
    var n = 0;
    while (n <= 70) {
        var k = 0;
        while (k <= n) {
            var c = 1;
            if (k > 0 && k < n) {
                var a = load64(prev + (k - 1) * 8);
                var b = load64(prev + k * 8);
                if (a < 0 || b < 0) { c = 0 - 1; }
                else { if (a > _MAX - b) { c = 0 - 1; } else { c = a + b; } }
            }
            store64(cur + k * 8, c);
            var got = ganita_binomial(n, k);
            cells = cells + 1;
            if (got != c) {
                wrong = wrong + 1;
                if (got == 0 - 1) { refused_fit = refused_fit + 1; }
            }
            k = k + 1;
        }
        var t = prev;
        prev = cur;
        cur = t;
        n = n + 1;
    }
    var ok = 1;
    if (wrong != 0) { ok = 0; _bad = _bad + 1; print("  WRONG ", 8); } else { print("  ok    ", 8); }
    print("every C(n,k), n <= 70: ", 23);
    fmt_int(wrong); print(" of ", 4); fmt_int(cells); print(" cells wrong (", 14);
    fmt_int(refused_fit); print(" refused although they fit, ", 28);
    fmt_int(wrong - refused_fit); println(" other)");
    return ok;
}

fn main() {
    alloc_init();
    println("C(n,k) that fit in i64, refused today");
    row("C(62,28)          = 349615716557887465  ", 62, 28, 349615716557887465);
    row("C(62,31)          = 465428353255261088  ", 62, 31, 465428353255261088);
    row("C(66,33)          = 7219428434016265740 ", 66, 33, 7219428434016265740);
    row("C(67,29)          = 7886597962249166160 ", 67, 29, 7886597962249166160);
    row("C(3037000501,2)   = 4611686020018625250 ", 3037000501, 2, 4611686020018625250);
    row("C(2^32,2)         = 2^63 - 2^31         ", 4294967296, 2, 9223372034707292160);
    row("C(3810779,3)      = 9223371416043870029 ", 3810779, 3, 9223371416043870029);
    row("C(121977,4)       = 9223148185681446450 ", 121977, 4, 9223148185681446450);
    println("controls: right today");
    row("C(52,5)           = 2598960             ", 52, 5, 2598960);
    row("C(61,30)          = 232714176627630544  ", 61, 30, 232714176627630544);
    row("C(3037000500,2)   = 4611686016981624750 ", 3037000500, 2, 4611686016981624750);
    row("C(i64_MAX,1)      = i64_MAX             ", _MAX, 1, _MAX);
    row("C(67,33)          > i64_MAX -> -1       ", 67, 33, 0 - 1);
    row("C(2^32+1,2)       > i64_MAX -> -1       ", 4294967297, 2, 0 - 1);
    row("C(3810780,3)      > i64_MAX -> -1       ", 3810780, 3, 0 - 1);
    row("C(i64_MAX,2)      > i64_MAX -> -1       ", _MAX, 2, 0 - 1);
    row("C(2^62,2^61)      > i64_MAX -> -1       ", 4611686018427387904, 2305843009213693952, 0 - 1);
    row("C(-3,2)           negative n -> -1      ", 0 - 3, 2, 0 - 1);
    println("exhaustive, against Pascal's triangle");
    sweep();
    print("rows wrong: ", 12); fmt_int(_bad); println("");
    return _bad;
}

var r = main();
sys_exit_group(r);
