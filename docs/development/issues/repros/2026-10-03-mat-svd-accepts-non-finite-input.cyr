# ganita_mat_svd -- and ganita_mat_rank, ganita_mat_condition, ganita_mat_pseudo_inv,
# which share _linalg_svd_impl -- accept a NaN or infinite entry and report success.
# An all-NaN 2x2 comes back as status 0 with singular values (0, 0), rank 0, condition
# -1.0 ("singular") and a pseudo-inverse of zeros. [[NaN, 0], [0, 2]] comes back with
# status 0 and the FINITE singular values (2, 0): the NaN disappears. So does the NaN in
# [[3, 0], [0, NaN]], the LAST entry: S = (3, 0), rank 1, and pseudo_inv [0][0] = 1/3.
#
# Self-proving: the exit code is the number of checks below that come back wrong -- 0
# when every check is right. For each non-finite input the four functions must report
# failure in their own shape (linalg.cyr's FAILURE VOCABULARY, ADR 0001):
#   ganita_mat_svd        a negative status        (today: 0)
#   ganita_mat_rank       a negative status        (today: a rank, 0 or 1)
#   ganita_mat_condition  NaN                      (today: -1.0 for three of them)
#   ganita_mat_pseudo_inv 0 (null)                 (today: a matrix)
# The repro asks only for "negative", not for a particular code; -2 (contract
# violation) is the obvious one. A finite control must still succeed.
#
# Filed with docs/development/issues/2026-10-03-mat-svd-accepts-non-finite-input.md.
# Found by hisab 3.3.3, whose svd_compute / svd_truncated now refuse a non-finite A
# themselves before calling ganita; re-measured on ganita 1.2.11 as folded into
# cyrius 6.6.14.
#
# Build and run from the ganita repo root:
#   cyrius build docs/development/issues/repros/2026-10-03-mat-svd-accepts-non-finite-input.cyr /tmp/svdnf
#   /tmp/svdnf; echo "exit=$?"      # -> 18 on 1.2.4 .. 1.2.11
#
# NaN and infinity are written as bit patterns, so the program means the same thing on
# every toolchain. Includes src/ directly rather than lib/ganita.cyr so it exercises the
# working source; to run it against a stdlib fold, drop the include lines and build from
# a directory whose cyrius.cyml pins the toolchain and declares stdlib "ganita".

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"

include "src/matrix.cyr"
include "src/linalg.cyr"

var _NAN = 0x7FF8000000000000;
var _PINF = 0x7FF0000000000000;
var _TWO = 0x4000000000000000;
var _THREE = 0x4008000000000000;
var _TOL = 0x3D719799812DEA11;   # 1e-12, rank's tolerance
var _bad = 0;
var _hexd = "0123456789abcdef";

fn out(s) { syscall(1, 1, s, strlen(s)); return 0; }

# 0x + 16 hex digits; local so the repro builds on every fold from cyrius 6.6.1.
fn hex(v) {
    var buf[18];
    store8(&buf, 48);
    store8(&buf + 1, 120);
    var i = 0;
    while (i < 16) {
        store8(&buf + 2 + i, load8(_hexd + ((v >> ((15 - i) * 4)) & 15)));
        i = i + 1;
    }
    syscall(1, 1, &buf, 18);
    return 0;
}

fn is_nan(v) {
    if (((v >> 52) & 0x7FF) != 0x7FF) { return 0; }
    if ((v & 0x000FFFFFFFFFFFFF) == 0) { return 0; }
    return 1;
}

fn m22(a, b, c, d) {
    var m = ganita_mat_new(2, 2);
    ganita_mat_set(m, 0, 0, a);
    ganita_mat_set(m, 0, 1, b);
    ganita_mat_set(m, 1, 0, c);
    ganita_mat_set(m, 1, 1, d);
    return m;
}

fn verdict(ok) {
    if (ok == 0) {
        _bad = _bad + 1;
        out("  WRONG ");
    } else {
        out("  ok    ");
    }
    return 0;
}

# want_fail = 1: every function must report failure. 0 (the control): every one
# must succeed.
fn rows(label, a, want_fail) {
    out(label);
    out("\n");
    var s = alloc(16);
    var rc = ganita_mat_svd(a, ganita_mat_new(2, 2), s, ganita_mat_new(2, 2));
    if (want_fail == 1) { verdict(rc < 0); } else { verdict(rc == 0); }
    out("svd status ");
    fmt_int(rc);
    if (rc == 0) {
        out("  S ");
        hex(load64(s));
        out(" ");
        hex(load64(s + 8));
    }
    out("\n");
    var rk = ganita_mat_rank(a, _TOL);
    if (want_fail == 1) { verdict(rk < 0); } else { verdict(rk == 2); }
    out("rank ");
    fmt_int(rk);
    out("\n");
    var cn = ganita_mat_condition(a);
    if (want_fail == 1) { verdict(is_nan(cn)); } else { verdict(is_nan(cn) == 0); }
    out("condition ");
    hex(cn);
    out("\n");
    var p = ganita_mat_pseudo_inv(a);
    if (want_fail == 1) { verdict(p == 0); } else { verdict(p != 0); }
    out("pseudo_inv ");
    if (p == 0) {
        out("null");
    } else {
        out("[0][0] = ");
        hex(ganita_mat_get(p, 0, 0));
    }
    out("\n");
    return 0;
}

fn main() {
    alloc_init();
    rows("all-NaN 2x2", m22(_NAN, _NAN, _NAN, _NAN), 1);
    rows("[[NaN, 0], [0, 2]]", m22(_NAN, 0, 0, _TWO), 1);
    rows("[[+Inf, 0], [0, 2]]", m22(_PINF, 0, 0, _TWO), 1);
    rows("[[3, NaN], [0, 2]]", m22(_THREE, _NAN, 0, _TWO), 1);
    # The last entry: a scan of rows, cols or rows * cols - 1 entries misses it.
    rows("[[3, 0], [0, NaN]]", m22(_THREE, 0, 0, _NAN), 1);
    rows("control diag(3, 2)", m22(_THREE, 0, 0, _TWO), 0);
    out("checks wrong: ");
    fmt_int(_bad);
    out("\n");
    return _bad;
}

var r = main();
sys_exit_group(r);
