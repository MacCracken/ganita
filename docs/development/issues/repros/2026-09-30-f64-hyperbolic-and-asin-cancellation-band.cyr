# ganita_f64_sinh / tanh / atanh / asinh have a relative error of about 2^-53/|x|
# just above their small-|x| cutoff (tens of millions of ulp near 2^-26),
# ganita_f64_acosh loses the same way in x - 1 near x = 1, and ganita_f64_asin
# loses up to ~1,000 ulp near |x| = 1. Each evaluates a form that subtracts two
# nearly equal numbers, or rounds 1 + small before ln sees it.
#
# Self-proving: the exit code is the number of rows below that come back MORE
# THAN 2 ULP from the correctly rounded value -- 0 when every row is right. The
# distance is the difference of the two bit patterns (same sign), which is the
# ulp count between them. Each row prints the bits it got, the bits it wants and
# the distance. The wanted bits are the correctly rounded value, computed with
# mpmath at 300 bits and rounded once to 53.
#
# Filed with docs/development/issues/2026-09-30-f64-hyperbolic-and-asin-cancellation-band.md.
# Found by abaco 2.4.9's project audit: abaco's `sinh` / `tanh` / `asinh` /
# `acosh` / `atanh` / `asin` builtins pass ganita's values straight through.
#
# Build and run from the ganita repo root:
#   cyrius build docs/development/issues/repros/2026-09-30-f64-hyperbolic-and-asin-cancellation-band.cyr /tmp/hypcanc
#   /tmp/hypcanc; echo "exit=$?"      # -> 16 on ganita 1.2.10 (all 16 band rows; the 3 controls pass)
# Built with --aarch64 and run under qemu-aarch64: the same 16, with the same
# bits (only the acosh(2.5) control differs, by 1 ulp: x87 ln vs the polyfill).
#
# Inputs and wanted values are written as bit patterns so the program means the
# same thing on every toolchain.
#
# Includes src/ directly rather than lib/ganita.cyr so it exercises the working
# source. math_advanced has no matrix/linalg dependency.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"

include "src/math_advanced.cyr"

var _bad = 0;

fn call(fid, x) {
    if (fid == 1) { return ganita_f64_sinh(x); }
    if (fid == 2) { return ganita_f64_tanh(x); }
    if (fid == 3) { return ganita_f64_atanh(x); }
    if (fid == 4) { return ganita_f64_asinh(x); }
    if (fid == 5) { return ganita_f64_acosh(x); }
    return ganita_f64_asin(x);
}

# Wrong when the result is a NaN, has the wrong sign, or is more than 2 ulp
# from `want`.
fn row(label, fid, x, want) {
    var got = call(fid, x);
    var d = 0 - 1;
    if ((((got >> 52) & 0x7FF) != 0x7FF) && ((got >> 63) == (want >> 63))) {
        d = (got & 0x7FFFFFFFFFFFFFFF) - (want & 0x7FFFFFFFFFFFFFFF);
        if (d < 0) { d = 0 - d; }
    }
    if (d < 0 || d > 2) { _bad = _bad + 1; print("  WRONG ", 8); } else { print("  ok    ", 8); }
    print(label, strlen(label));
    print("  got ", 6); fmt_hex0x(got);
    print("  want ", 7); fmt_hex0x(want);
    print("  off ", 6);
    if (d < 0) { print("(NaN or sign)", 13); } else { fmt_int(d); print(" ulp", 4); }
    println("");
    return 0;
}

fn main() {
    println("sinh / tanh / atanh / asinh just above the 2^-26 cutoff, and on toward |x| = 1");
    row("sinh(1.9706785678861335e-8)  ", 1, 0x3E5528F5C28F5993, 0x3E5528F5C28F5993);
    row("sinh(1e-6)                   ", 1, 0x3EB0C6F7A0B5ED8D, 0x3EB0C6F7A0B5F0A0);
    row("sinh(-0.01)                  ", 1, 0xBF847AE147AE147B, 0xBF847AF7A654E9EF);
    row("tanh(1.9706785678861335e-8)  ", 2, 0x3E5528F5C28F5993, 0x3E5528F5C28F5992);
    row("tanh(1e-7)                   ", 2, 0x3E7AD7F29ABCAF48, 0x3E7AD7F29ABCAF2F);
    row("tanh(-2^-12)                 ", 2, 0xBF30000000000000, 0xBF2FFFFFF555555A);
    row("atanh(2.339482307433937e-8)  ", 3, 0x3E591EB851EB8368, 0x3E591EB851EB8369);
    row("atanh(-2^-20)                ", 3, 0xBEB0000000000000, 0xBEB0000000000555);
    row("atanh(0.001)                 ", 3, 0x3F50624DD2F1A9FC, 0x3F50624E2E91ED17);
    row("asinh(1.4783193667728686e-8) ", 4, 0x3E4FBF258BF2565D, 0x3E4FBF258BF2565D);
    row("asinh(1e-7)                  ", 4, 0x3E7AD7F29ABCAF48, 0x3E7AD7F29ABCAF3B);
    row("asinh(-0.05)                 ", 4, 0xBFA999999999999A, 0xBFA996DF55A826BB);
    println("acosh near x = 1");
    row("acosh(1 + 2^-52)             ", 5, 0x3FF0000000000001, 0x3E56A09E667F3BCC);
    row("acosh(1 + 2^-40)             ", 5, 0x3FF0000000001000, 0x3EB6A09E667F39EA);
    println("asin near |x| = 1");
    row("asin(1 - 2^-27)              ", 6, 0x3FEFFFFFFC000000, 0x3FF9217B54442BC3);
    row("asin(-(1 - 2^-27))           ", 6, 0xBFEFFFFFFC000000, 0xBFF9217B54442BC3);
    println("controls -- right today, must stay right");
    row("sinh(2^-27)    (below cutoff)", 1, 0x3E40000000000000, 0x3E40000000000000);
    row("asin(0.5)                    ", 6, 0x3FE0000000000000, 0x3FE0C152382D7366);
    row("acosh(2.5)                   ", 5, 0x4004000000000000, 0x3FF9119C13A31BB0);
    print("rows wrong: ", 12); fmt_int(_bad); println("");
    return _bad;
}

var r = main();
sys_exit_group(r);
