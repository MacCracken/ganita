# 02 — solving Ax = b three independent ways, and cross-checking them
#
#   cyrius build docs/examples/02-solving-systems.cyr /tmp/ex02 && /tmp/ex02
#
# ganita gives you three routes to a square solve, and they have different
# preconditions and different failure modes. The point of this example is that
# you can run all three on the same system and check they agree — which is also
# how ganita's own test suite pins them, because two independent paths agreeing
# is much harder to fake than one path matching a transcribed number.
#
#   ganita_mat_lu + lu_solve   general square, partial pivoting. Returns the
#                              permutation sign, or 0 if singular.
#   ganita_mat_cholesky        symmetric POSITIVE-DEFINITE only. Returns 1, or
#                              0 if the input is not positive-definite — which
#                              is a real answer about the matrix, not an error.
#   ganita_mat_gaussian_elim   in place on an augmented [A|b]. Returns 1, or 0
#                              if singular.
#
# The failure returns matter. Since 1.2.2 the decompositions also report an
# allocation failure distinctly: -1 from the status functions, and NaN from
# ganita_mat_det, because det already uses 0.0 to mean "singular" and must not
# overload it to mean "the run failed".

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"

include "src/matrix.cyr"
include "src/linalg.cyr"

# Print a length-n flat f64 array on one line.
fn show_vec(label, v, n): i64 {
    syscall(1, 1, label, 13);
    var i = 0;
    while (i < n) {
        syscall(1, 1, " ", 1);
        fmt_float(load64(v + i * 8), 6);
        i = i + 1;
    }
    println("");
    return 0;
}

# |a - b| < 1e-9, the tolerance the test suite uses for inexact results.
fn close(a, b): i64 {
    var tol = f64_div(f64_from(1), f64_from(1000000000));
    if (f64_lt(f64_abs(f64_sub(a, b)), tol) == 1) { return 1; }
    return 0;
}

# Build the symmetric positive-definite system used throughout:
#     [ 4  1 ] [x]   [ 1 ]                     [ 1/11 ]   [ 0.090909... ]
#     [ 1  3 ] [y] = [ 2 ]   whose solution is [ 7/11 ] = [ 0.636364... ]
# det = 4*3 - 1*1 = 11; x = (3*1 - 1*2)/11, y = (4*2 - 1*1)/11.
fn spd_system(): i64 {
    var a = ganita_mat_new(2, 2);
    if (a == 0) { return 0; }
    ganita_mat_set(a, 0, 0, f64_from(4)); ganita_mat_set(a, 0, 1, f64_from(1));
    ganita_mat_set(a, 1, 0, f64_from(1)); ganita_mat_set(a, 1, 1, f64_from(3));
    return a;
}

fn main(): i64 {
    alloc_init();

    var a = spd_system();
    if (a == 0) { println("mat_new refused"); return 1; }
    var b = alloc(16);
    if (b == 0) { println("alloc refused"); return 1; }
    store64(b, f64_from(1));
    store64(b + 8, f64_from(2));

    println("System:  [4 1; 1 3] x = [1; 2]      exact solution [1/11; 7/11]");
    println("");

    # --- route 1: LU with partial pivoting -------------------------------
    # The caller allocates both out-params. out_lu is n x n and receives the
    # packed L\\U; out_piv is a flat i64 array of length n.
    var lu = ganita_mat_new(2, 2);
    var piv = alloc(16);
    if (lu == 0 || piv == 0) { println("alloc refused"); return 1; }
    var sign = ganita_mat_lu(a, lu, piv);
    if (sign == 0) { println("LU: singular"); return 1; }
    var x1 = alloc(16);
    if (x1 == 0) { println("alloc refused"); return 1; }
    if (ganita_mat_lu_solve(lu, piv, b, x1) != 0) { println("lu_solve: allocation failed"); return 1; }
    show_vec("LU        x =", x1, 2);

    # --- route 2: Cholesky ------------------------------------------------
    # A is symmetric and positive-definite, so A = L L^T exists. cholesky
    # returns 0 for a matrix that is NOT positive-definite; that is the
    # cheapest positive-definiteness test in the library.
    var l = ganita_mat_new(2, 2);
    if (l == 0) { println("mat_new refused"); return 1; }
    if (ganita_mat_cholesky(a, l) != 1) { println("Cholesky: not positive-definite"); return 1; }
    var x2 = alloc(16);
    if (x2 == 0) { println("alloc refused"); return 1; }
    if (ganita_mat_cholesky_solve(l, b, x2) != 0) { println("cholesky_solve: allocation failed"); return 1; }
    show_vec("Cholesky  x =", x2, 2);

    # --- route 3: Gaussian elimination on [A|b] ---------------------------
    # This one works IN PLACE on an n x (n+1) augmented matrix and leaves the
    # solution in the last column, so build a fresh copy rather than handing it
    # the matrix you still want.
    var aug = ganita_mat_new(2, 3);
    if (aug == 0) { println("mat_new refused"); return 1; }
    ganita_mat_set(aug, 0, 0, f64_from(4)); ganita_mat_set(aug, 0, 1, f64_from(1));
    ganita_mat_set(aug, 0, 2, f64_from(1));
    ganita_mat_set(aug, 1, 0, f64_from(1)); ganita_mat_set(aug, 1, 1, f64_from(3));
    ganita_mat_set(aug, 1, 2, f64_from(2));
    if (ganita_mat_gaussian_elim(aug) != 1) { println("gaussian_elim: singular"); return 1; }
    syscall(1, 1, "Gauss     x =", 13);
    syscall(1, 1, " ", 1); fmt_float(ganita_mat_get(aug, 0, 2), 6);
    syscall(1, 1, " ", 1); fmt_float(ganita_mat_get(aug, 1, 2), 6);
    println("");

    # --- the cross-check ---------------------------------------------------
    println("");
    syscall(1, 1, "all three agree to 1e-9: ", 25);
    var agree = 0;
    if (close(load64(x1), load64(x2)) == 1) {
        if (close(load64(x1), ganita_mat_get(aug, 0, 2)) == 1) {
            if (close(load64(x1 + 8), load64(x2 + 8)) == 1) {
                if (close(load64(x1 + 8), ganita_mat_get(aug, 1, 2)) == 1) { agree = 1; }
            }
        }
    }
    fmt_int(agree);
    println("   (1 = yes)");

    # --- determinant and inverse -------------------------------------------
    # det(A) = 4*3 - 1*1 = 11, exactly.
    println("");
    syscall(1, 1, "det(A)     = ", 13); fmt_float(ganita_mat_det(a), 6); println("   (4*3 - 1*1 = 11)");

    var inv = ganita_mat_inv(a);
    if (inv == 0) { println("inv: singular or allocation failed"); return 1; }
    var prod = ganita_mat_mul(a, inv);
    if (prod == 0) { println("mul refused"); return 1; }
    var i2 = ganita_mat_identity(2);
    if (i2 == 0) { println("identity refused"); return 1; }
    var tol = f64_div(f64_from(1), f64_from(1000000000));
    syscall(1, 1, "A * A^-1 == I: ", 15);
    fmt_int(ganita_mat_eq(prod, i2, tol));
    println("   (the property, not a transcribed number)");

    # --- what singular looks like -------------------------------------------
    # Row 2 is exactly twice row 1, so the system has no unique solution. Every
    # route reports it, each in its own vocabulary. Note det returns 0.0 here:
    # a REAL answer about the matrix. An allocation failure would return NaN,
    # which is why the two are not allowed to share a value.
    println("");
    println("Singular system [1 2; 2 4]:");
    var s = ganita_mat_new(2, 2);
    if (s == 0) { println("mat_new refused"); return 1; }
    ganita_mat_set(s, 0, 0, f64_from(1)); ganita_mat_set(s, 0, 1, f64_from(2));
    ganita_mat_set(s, 1, 0, f64_from(2)); ganita_mat_set(s, 1, 1, f64_from(4));
    var slu = ganita_mat_new(2, 2);
    var spiv = alloc(16);
    if (slu == 0 || spiv == 0) { println("alloc refused"); return 1; }
    syscall(1, 1, "  mat_lu       -> ", 18); fmt_int(ganita_mat_lu(s, slu, spiv));
    println("   (0 = singular)");
    syscall(1, 1, "  mat_inv      -> ", 18); fmt_int(ganita_mat_inv(s));
    println("   (0 = null)");
    syscall(1, 1, "  mat_det      -> ", 18); fmt_float(ganita_mat_det(s), 6);
    println("   (0.0 — an answer about the matrix; NaN would mean the run failed)");
    # [1 2; 2 4] is positive SEMI-definite: symmetric, det 0, eigenvalues 0 and 5.
    # Semi-definite is not definite, so the contract says 0. Before 1.2.3 this
    # returned 1, put a zero on L's diagonal, and cholesky_solve then divided by
    # it and wrote NaN while also reporting success.
    var sl = ganita_mat_new(2, 2);
    if (sl == 0) { println("mat_new refused"); return 1; }
    syscall(1, 1, "  mat_cholesky -> ", 18); fmt_int(ganita_mat_cholesky(s, sl));
    println("   (0 = not positive-definite — semi-definite counts as not)");

    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
