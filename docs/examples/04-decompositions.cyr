# 04 — QR, eigen, SVD, and the quantities you read off them
#
#   cyrius build docs/examples/04-decompositions.cyr /tmp/ex04 && /tmp/ex04
#
# Every check here is a PROPERTY, not a transcribed number: Q^T Q = I,
# A = QR, sum of eigenvalues = trace, product = determinant, A A+ A = A. A
# property survives a reimplementation and cannot be satisfied by a
# plausible-looking wrong answer, which is why ganita's own suite is written
# this way and why an example should be too.
#
# ⚠ ALLOCATION. Every out-param below is allocated by the CALLER, at the size
# the doc comment states, and every constructor is checked. ganita_mat_qr wants
# an m x m Q — that is its contract, and it bounds m at about 5792 for anyone
# who needs Q explicitly. If you only want to SOLVE, use
# ganita_mat_least_squares, which forms no Q at all (see example 03).

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"

include "src/matrix.cyr"
include "src/linalg.cyr"

# 1e-9 — the tolerance ganita's suite uses for anything that went through a
# decomposition. Exact equality is the wrong test for these.
fn tol(): i64 { return f64_div(f64_from(1), f64_from(1000000000)); }

# Print "  [1] <label>" — the flag first so a column of them scans at a glance.
fn check(label, ok): i64 {
    syscall(1, 1, "  [", 3);
    fmt_int(ok);
    syscall(1, 1, "] ", 2);
    println(label);
    return 0;
}

fn main(): i64 {
    alloc_init();

    # A well-conditioned 3x3 to decompose. Not symmetric, so QR and SVD have
    # something to do; the symmetric eigensolver gets its own matrix below.
    var a = ganita_mat_new(3, 3);
    if (a == 0) { println("mat_new refused"); return 1; }
    ganita_mat_set(a, 0, 0, f64_from(12)); ganita_mat_set(a, 0, 1, f64_from(0 - 51)); ganita_mat_set(a, 0, 2, f64_from(4));
    ganita_mat_set(a, 1, 0, f64_from(6));  ganita_mat_set(a, 1, 1, f64_from(167));    ganita_mat_set(a, 1, 2, f64_from(0 - 68));
    ganita_mat_set(a, 2, 0, f64_from(0 - 4)); ganita_mat_set(a, 2, 1, f64_from(24));  ganita_mat_set(a, 2, 2, f64_from(0 - 41));

    # --- QR (Householder) -------------------------------------------------
    println("QR of A = [12 -51 4; 6 167 -68; -4 24 -41]  (the classic Householder example)");
    var q = ganita_mat_new(3, 3);
    var r = ganita_mat_new(3, 3);
    if (q == 0 || r == 0) { println("mat_new refused"); return 1; }
    if (ganita_mat_qr(a, q, r) != 0) { println("qr: allocation failed"); return 1; }

    var qt = ganita_mat_transpose(q);
    if (qt == 0) { println("transpose refused"); return 1; }
    var qtq = ganita_mat_mul(qt, q);
    var qr = ganita_mat_mul(q, r);
    var i3 = ganita_mat_identity(3);
    if (qtq == 0 || qr == 0 || i3 == 0) { println("allocation refused"); return 1; }
    check("Q^T Q = I  (Q is orthogonal)", ganita_mat_eq(qtq, i3, tol()));
    check("Q R   = A  (the factorisation reconstructs)", ganita_mat_eq(qr, a, tol()));
    syscall(1, 1, "  R is upper triangular: R[1][0] = ", 35); fmt_float(ganita_mat_get(r, 1, 0), 12);
    syscall(1, 1, ", R[2][0] = ", 12); fmt_float(ganita_mat_get(r, 2, 0), 12); println("");

    # --- symmetric eigendecomposition (Jacobi) -----------------------------
    # [[2,1],[1,2]] has eigenvalues 3 and 1. eigen_sym returns the ITERATION
    # COUNT on success — any NEGATIVE return is a failure: -1 means it hit the
    # 100*n^2 iteration ceiling, -2 (since 1.2.2) means a working allocation
    # failed. Check `>= 0`, not `== 0`.
    println("");
    println("Symmetric eigendecomposition of [2 1; 1 2]  (eigenvalues 3 and 1)");
    var sym = ganita_mat_new(2, 2);
    if (sym == 0) { println("mat_new refused"); return 1; }
    ganita_mat_set(sym, 0, 0, f64_from(2)); ganita_mat_set(sym, 0, 1, f64_from(1));
    ganita_mat_set(sym, 1, 0, f64_from(1)); ganita_mat_set(sym, 1, 1, f64_from(2));
    var vals = alloc(16);
    var vecs = ganita_mat_new(2, 2);
    if (vals == 0 || vecs == 0) { println("allocation refused"); return 1; }
    var iters = ganita_mat_eigen_sym(sym, vals, vecs);
    if (iters < 0) { println("eigen_sym failed"); return 1; }
    syscall(1, 1, "  converged in ", 15); fmt_int(iters); println(" Jacobi rotations");
    syscall(1, 1, "  lambda = ", 11); fmt_float(load64(vals), 9);
    syscall(1, 1, ", ", 2); fmt_float(load64(vals + 8), 9); println("");

    # Two invariants that hold whatever order the eigenvalues came out in.
    var lsum = f64_add(load64(vals), load64(vals + 8));
    var lprod = f64_mul(load64(vals), load64(vals + 8));
    check("sum of eigenvalues = trace  (3 + 1 = 4)", f64_lt(f64_abs(f64_sub(lsum, ganita_mat_trace(sym))), tol()));
    check("product of eigenvalues = det  (3 * 1 = 3)", f64_lt(f64_abs(f64_sub(lprod, ganita_mat_det(sym))), tol()));

    var vt2 = ganita_mat_transpose(vecs);
    if (vt2 == 0) { println("transpose refused"); return 1; }
    var vtv = ganita_mat_mul(vt2, vecs);
    var i2 = ganita_mat_identity(2);
    if (vtv == 0 || i2 == 0) { println("allocation refused"); return 1; }
    check("eigenvectors are orthonormal  (V^T V = I)", ganita_mat_eq(vtv, i2, tol()));

    # --- SVD ----------------------------------------------------------------
    # For an m x n input with m >= n: A = U diag(sigma) V^T. out_u is m x n,
    # out_sigma is a flat array of n singular values (sorted descending), and
    # out_vt is n x n.
    println("");
    println("SVD of A");
    var u = ganita_mat_new(3, 3);
    var sigma = alloc(24);
    var vt = ganita_mat_new(3, 3);
    if (u == 0 || sigma == 0 || vt == 0) { println("allocation refused"); return 1; }
    if (ganita_mat_svd(a, u, sigma, vt) != 0) { println("svd: allocation failed"); return 1; }
    syscall(1, 1, "  sigma = ", 10);
    fmt_float(load64(sigma), 6); syscall(1, 1, ", ", 2);
    fmt_float(load64(sigma + 8), 6); syscall(1, 1, ", ", 2);
    fmt_float(load64(sigma + 16), 6); println("   (descending)");

    # |det A| = product of the singular values.
    var sprod = f64_mul(f64_mul(load64(sigma), load64(sigma + 8)), load64(sigma + 16));
    var dabs = f64_abs(ganita_mat_det(a));
    # These are ~1e6, so compare RELATIVELY: an absolute 1e-9 is far below the
    # last representable bit at this magnitude and would fail on a correct answer.
    var rel = f64_div(f64_abs(f64_sub(sprod, dabs)), dabs);
    check("product of singular values = |det A|  (relative, 1e-6)", f64_lt(rel, f64_div(f64_from(1), f64_from(1000000))));

    # --- rank, condition, pseudo-inverse -------------------------------------
    # rank returns a COUNT, or -1 if a working allocation failed — a rank is
    # never negative, so the two can never be confused. condition returns an
    # f64: -1.0 for a singular matrix, NaN if an allocation failed.
    println("");
    syscall(1, 1, "rank(A, 1e-9) = ", 16); fmt_int(ganita_mat_rank(a, tol())); println("   (full rank 3)");
    syscall(1, 1, "cond(A)       = ", 16); fmt_float(ganita_mat_condition(a), 6);
    println("   (sigma_max / sigma_min)");

    var pinv = ganita_mat_pseudo_inv(a);
    if (pinv == 0) { println("pseudo_inv: allocation failed"); return 1; }
    var apa = ganita_mat_mul(ganita_mat_mul(a, pinv), a);
    if (apa == 0) { println("mul refused"); return 1; }
    # A A+ A = A is the first Moore-Penrose condition. Relative again: A's
    # entries reach 167, so squared terms land near 1e6.
    var i = 0;
    var worst = f64_from(0);
    while (i < 3) {
        var j = 0;
        while (j < 3) {
            var d = f64_abs(f64_sub(ganita_mat_get(apa, i, j), ganita_mat_get(a, i, j)));
            if (f64_gt(d, worst) == 1) { worst = d; }
            j = j + 1;
        }
        i = i + 1;
    }
    syscall(1, 1, "  worst |A A+ A - A| entry = ", 29); fmt_float(worst, 9);
    println("   (Moore-Penrose condition 1)");

    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
