# linalg.cyr — dense linear algebra on f64 matrices
# Usage: include "lib/ganita.cyr" (the fold; this file is its linalg layer)
# Requires: alloc.cyr, math.cyr, and ganita's own src/matrix.cyr (earlier in the fold)
#
# Builds on matrix.cyr's storage layer (row-major, f64 as i64 bit patterns).
# All decompositions use out-params (Cyrius has no tuples):
#   ganita_mat_lu(m, out_lu, out_piv)  not  (lu, piv) = ganita_mat_lu(m)
#
# Pivoting: the user-facing eliminations (lu, and through it det and inv, and
# gaussian_elim) use partial (row) pivoting only. Complete pivoting is deliberately
# excluded there (O(n^3) column search per step, no benefit for hisab's use cases).
# The one exception is internal: the SVD's Householder QRs (1.2.12) pivot columns
# (the largest remaining norm, LAPACK dgeqp3's rule) AND rows (the pivot column's
# largest entry, Powell and Reid), because the preconditioned Jacobi needs |R_kk|
# >= |R_kj| and row-wise backward stability — see ganita_mat_svd. ganita_mat_qr and
# ganita_mat_least_squares do not pivot.
#
# ganita_mat_det and ganita_mat_inv are convenience wrappers around ganita_mat_lu — they are
# not independent implementations.

# FAILURE VOCABULARY (settled at 1.2.3 — see docs/adr/0001-failure-vocabulary.md).
# Every function reports failure in the shape of its own return value:
#
#   returns a matrix or array  ->  0 (null)
#   returns a status           ->  NEGATIVE, and never a positive code:
#                                    -1  allocation failure
#                                    -2  contract violation (shape, dimension,
#                                        index, or a documented precondition)
#                                    -3  algorithmic non-convergence
#
# THREE EXCEPTIONS, whose failure is 0, not a negative:
#   ganita_mat_lu — its successful returns are the permutation sign +1 and -1,
#     so it cannot spend a negative on an error. It folds a contract violation
#     into its existing 0 ("cannot decompose"), which is what a caller already
#     tests for.
#   ganita_mat_cholesky and ganita_mat_gaussian_elim — boolean statuses, 1 on
#     success and 0 on any failure. They predate the vocabulary and were not
#     listed here until 1.2.12; they stay 1/0 so no caller's `== 0` test breaks.
#   returns an f64             ->  NaN, because 0.0 and -1.0 are real answers
#                                  about the matrix in det and condition
#
# A caller that only wants "did it work" can test `< 0` on every status fn except
# those three, and `== 0` on them.
#
# NON-FINITE INPUT (1.2.12, docs/adr/0004-non-finite-input.md). Every function that
# JUDGES a matrix — the decompositions, the solvers, det, rank, condition, eq,
# is_symmetric — refuses a NaN or infinite entry (and a non-finite b or tolerance)
# in its own failure shape, before it writes anything (_linalg_all_finite).
# Arithmetic that only carries values — add, sub, scale, mul, neg, transpose,
# frobenius, max_norm, trace — propagates them, as IEEE does, and needs no check;
# max_norm no longer drops a row whose sum is NaN.

# ⚠ RELATIVE TOLERANCE FACTOR (1.2.4) — 1e-12, as its exact f64 bit pattern.
#
# Through 1.2.3 this was compared DIRECTLY against pivots, norms and singular
# values, which made every singularity verdict depend on the caller's units
# rather than on the matrix. Scale a perfectly conditioned matrix down by 1e-6
# and `det`, `inv`, `lu`, `gaussian_elim` and `condition` all called it singular
# while `rank` called it full rank — the library contradicting itself about the
# same matrix. Scale up, and a genuinely singular matrix sailed through.
#
# It is now a FACTOR, multiplied by a magnitude taken from the data at each use
# site: the matrix scale for the pivot tests, the largest singular value for the
# rank tests, the initial off-diagonal magnitude for Jacobi convergence. The
# threshold moves with the problem, which is the only way a fixed number can
# mean anything about conditioning.
#
# EAGER, not lazy. It used to be 0 until `_linalg_init_eps()` ran, and only the
# decompositions called that — so `ganita_mat_eq`, whose doc told callers to pass
# LINALG_EPS as the default tolerance, answered differently depending on what the
# program had done beforehand. A literal bit pattern has no initialisation order.
var LINALG_EPS = 0x3D719799812DEA11;

# 2^-52, the f64 machine epsilon — the spacing of representable values near 1.
# Used ONLY as an internal iteration-convergence bound (currently by the
# one-sided Jacobi SVD), never as a judgement about a caller's matrix. Anything
# that decides "is this singular?" uses LINALG_EPS above.
var _LINALG_MACH_EPS = 0x3CB0000000000000;

# The magnitude a tolerance should be measured against: the largest absolute
# entry. Returns 0.0 for the zero matrix, and that is right — in a matrix of
# zeros nothing is negligible *relative to* anything, so every threshold
# collapses to an exact-zero test.
#
# ⚠ It must only ever see FINITE input. The ordered max skips a NaN (every
# comparison against one is false) and turns one infinity into an infinite scale,
# so every threshold derived from it is +inf. Through 1.2.11 that was how qr,
# least_squares and eigen_sym reported success on NaN or infinite input; every
# caller now refuses such input first (_linalg_all_finite, 1.2.12).
fn _linalg_mat_scale(m): i64 {
    var n = ganita_mat_rows(m) * ganita_mat_cols(m);
    var mx = f64_from(0);
    var i = 0;
    while (i < n) {
        var v = f64_abs(load64(m + 16 + i * 8));
        if (f64_gt(v, mx) == 1) { mx = v; }
        i = i + 1;
    }
    return mx;
}

# Two-norm of v[0..len), with the largest magnitude scaled out first.
#
# The direct sum of squares overflows to +inf for entries above ~1.3e154 and
# underflows to 0 below ~1.5e-162 — in both cases for vectors whose norm is
# perfectly representable. That is not theoretical here: `ganita_mat_qr` and
# `ganita_mat_least_squares` took the direct form, so a large-magnitude matrix
# produced a NaN norm and both still returned success.
fn _linalg_norm2(v, len): i64 {
    var mx = f64_from(0);
    var i = 0;
    while (i < len) {
        var av = f64_abs(load64(v + i * 8));
        if (f64_gt(av, mx) == 1) { mx = av; }
        i = i + 1;
    }
    if (mx & 0x7FFFFFFFFFFFFFFF == 0) { return f64_from(0); }
    var sum = f64_from(0);
    i = 0;
    while (i < len) {
        var t = f64_div(load64(v + i * 8), mx);
        sum = f64_add(sum, f64_mul(t, t));
        i = i + 1;
    }
    return f64_mul(mx, f64_sqrt(sum));
}

# True when an f64 bit pattern is a NaN — max exponent, non-zero mantissa.
# Needed because every f64 comparison is FALSE against a NaN, so a loop shaped
# `if (bad) return 0;` falls through and reports success. That is not a
# hypothetical: it is exactly how ganita_mat_eq reported an all-NaN matrix as
# equal to the identity through 1.2.2.
fn _linalg_is_nan(b): i64 {
    if (((b >> 52) & 0x7FF) != 0x7FF) { return 0; }
    if ((b & 0x000FFFFFFFFFFFFF) == 0) { return 0; }
    return 1;
}

# 1 when all n f64 words at p are finite: no NaN, no infinity (1.2.12). Tested on the
# exponent bits, so it does not lean on how a target compares a NaN. Every function
# that JUDGES a matrix calls this before its first write — see NON-FINITE INPUT in the
# header. Through 1.2.11 none outside the SVD family did, and two mechanisms turned a
# NaN or an infinity into a success: an infinity became _linalg_mat_scale, so every
# relative threshold was +inf and every "anything left to do?" test failed at once
# (qr returned Q = I and R = A; eigen_sym returned the raw diagonal), and an ordered
# comparison dropped a NaN (eigen_sym never pivoted on it; least_squares skipped the
# reflector of a column holding one and fitted b from a single row).
fn _linalg_all_finite(p, n): i64 {
    var i = 0;
    while (i < n) {
        if ((load64(p + i * 8) & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when tol can be used as a comparison tolerance: finite and not negative (-0.0 is
# 0). A NaN tolerance fails every `diff > tol` test, so through 1.2.11 eq and
# is_symmetric accepted ANY two matrices under one — and the idiom their docs
# recommend, tol = LINALG_EPS * a norm, yields NaN or +inf from a norm of bad input.
# +inf is refused for that reason: it is far likelier an overflowed scale than a
# deliberate "everything is equal".
fn _linalg_tol_ok(tol): i64 {
    if ((tol & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
    if (f64_lt(tol, f64_from(0)) == 1) { return 0; }
    return 1;
}

# ================================================================
# Tier 3 — Matrix utilities (additions to matrix.cyr's feature set)
# ================================================================

# Deep copy of a matrix. Returns 0 if the copy cannot be allocated (propagates
# ganita_mat_new's null).
fn ganita_mat_copy(m): i64 {
    if (m == 0) { return 0; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    var c = ganita_mat_new(rows, cols);
    if (c == 0) { return 0; }
    var i = 0;
    var n = rows * cols;
    while (i < n) {
        store64(c + 16 + i * 8, load64(m + 16 + i * 8));
        i = i + 1;
    }
    return c;
}

# Negate all elements. Returns 0 if the result cannot be allocated (propagates
# ganita_mat_new's null).
fn ganita_mat_neg(m): i64 {
    if (m == 0) { return 0; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    var c = ganita_mat_new(rows, cols);
    if (c == 0) { return 0; }
    var i = 0;
    var n = rows * cols;
    while (i < n) {
        store64(c + 16 + i * 8, f64_neg(load64(m + 16 + i * 8)));
        i = i + 1;
    }
    return c;
}

# Extract row r as a flat f64 array (heap-allocated, cols entries).
# Returns 0 for a null matrix, for r outside [0, rows), or on allocation failure.
fn ganita_mat_row(m, r): i64 {
    if (m == 0) { return 0; }
    if (r < 0 || r >= ganita_mat_rows(m)) { return 0; }
    var cols = ganita_mat_cols(m);
    var out = alloc(cols * 8);
    if (out == 0) { return 0; }
    var j = 0;
    while (j < cols) {
        store64(out + j * 8, ganita_mat_get(m, r, j));
        j = j + 1;
    }
    return out;
}

# Extract column c as a flat f64 array (heap-allocated, rows entries).
# Returns 0 for a null matrix, for c outside [0, cols), or on allocation failure.
fn ganita_mat_col(m, c): i64 {
    if (m == 0) { return 0; }
    if (c < 0 || c >= ganita_mat_cols(m)) { return 0; }
    var rows = ganita_mat_rows(m);
    var out = alloc(rows * 8);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < rows) {
        store64(out + i * 8, ganita_mat_get(m, i, c));
        i = i + 1;
    }
    return out;
}

# Overwrite row r from a flat f64 array of `cols` entries.
# Returns 0 on success, -2 for a null matrix or r outside [0, rows).
#
# The index gate is new at 1.2.3. This function WRITES, so an out-of-range r was
# an out-of-bounds write (CWE-787), not merely a read: r == rows lands on
# whatever the bump allocator handed out next — typically the {rows, cols}
# header of the next matrix, which then reports fabricated dimensions — and a
# negative r walks backwards into the target matrix's own header.
fn ganita_mat_set_row(m, r, data): i64 {
    if (m == 0) { return 0 - 2; }
    if (r < 0 || r >= ganita_mat_rows(m)) { return 0 - 2; }
    var cols = ganita_mat_cols(m);
    var j = 0;
    while (j < cols) {
        ganita_mat_set(m, r, j, load64(data + j * 8));
        j = j + 1;
    }
    return 0;
}

# Overwrite column c from a flat f64 array of `rows` entries.
# Returns 0 on success, -2 for a null matrix or c outside [0, cols).
# Same out-of-bounds write as ganita_mat_set_row through 1.2.2.
fn ganita_mat_set_col(m, c, data): i64 {
    if (m == 0) { return 0 - 2; }
    if (c < 0 || c >= ganita_mat_cols(m)) { return 0 - 2; }
    var rows = ganita_mat_rows(m);
    var i = 0;
    while (i < rows) {
        ganita_mat_set(m, i, c, load64(data + i * 8));
        i = i + 1;
    }
    return 0;
}

# Extract submatrix [r0..r1, c0..c1) as a new matrix — half-open on both axes.
# Returns 0 for a null matrix, for an empty or inverted range, for a window that
# is not wholly inside the source, or on allocation failure.
#
# The window gate is new at 1.2.3. Through 1.2.2 only the SIGN of the extent was
# checked — implicitly, by ganita_mat_new rejecting a non-positive dimension —
# and never the range against the source. A window past the end copied whatever
# the allocator had placed after the matrix into a perfectly well-formed result;
# a negative origin read backwards and faulted at scale.
fn ganita_mat_submatrix(m, r0, c0, r1, c1): i64 {
    if (m == 0) { return 0; }
    if (r0 < 0 || c0 < 0) { return 0; }
    if (r1 > ganita_mat_rows(m) || c1 > ganita_mat_cols(m)) { return 0; }
    var nr = r1 - r0;
    var nc = c1 - c0;
    var s = ganita_mat_new(nr, nc);
    if (s == 0) { return 0; }
    var i = 0;
    while (i < nr) {
        var j = 0;
        while (j < nc) {
            ganita_mat_set(s, i, j, ganita_mat_get(m, r0 + i, c0 + j));
            j = j + 1;
        }
        i = i + 1;
    }
    return s;
}

# Frobenius norm: sqrt(sum of squares of all elements). A NaN entry gives NaN and an
# infinite one +inf, as IEEE arithmetic carries them.
#
# ⚠ THE PLAIN SUM IS ONLY TRUSTED WHERE IT IS EXACT ENOUGH (1.2.12). Squaring
# overflowed for entries above ~1.3e154, so the finite [[1e200, 1e200]] had norm
# +inf, and the tolerance idiom ganita_mat_eq recommends, LINALG_EPS * norm, became
# +inf with it. Squares below 2^-1022 lose precision the same way. When the sum is
# +inf or below 2^-969 and every entry is finite, the norm is recomputed with the
# largest magnitude scaled out (_linalg_norm2). Every other input takes exactly the
# arithmetic it always did: above 2^-969, the subnormal squares can move the sum by
# at most n * 2^-106 of itself.
fn ganita_mat_frobenius(m): i64 {
    var n = ganita_mat_rows(m) * ganita_mat_cols(m);
    var sum = f64_from(0);
    var i = 0;
    while (i < n) {
        var v = load64(m + 16 + i * 8);
        sum = f64_add(sum, f64_mul(v, v));
        i = i + 1;
    }
    if (sum == 0x7FF0000000000000 || f64_lt(sum, 0x0360000000000000) == 1) {
        if (_linalg_all_finite(m + 16, n) == 1) { return _linalg_norm2(m + 16, n); }
    }
    return f64_sqrt(sum);
}

# Infinity norm: max absolute row sum. NaN if any entry is NaN (1.2.12); an infinite
# entry gives +inf, which is the norm.
#
# Through 1.2.11 a row holding a NaN had a NaN sum that f64_gt never let win, so the
# row was dropped: [[NaN, 1], [2, 3]] had norm 5 and an all-NaN matrix 0.0, the
# norm of the zero matrix.
fn ganita_mat_max_norm(m): i64 {
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    var mx = f64_from(0);
    var i = 0;
    while (i < rows) {
        var rsum = f64_from(0);
        var j = 0;
        while (j < cols) {
            rsum = f64_add(rsum, f64_abs(ganita_mat_get(m, i, j)));
            j = j + 1;
        }
        if (_linalg_is_nan(rsum) == 1) { return rsum; }
        if (f64_gt(rsum, mx) == 1) { mx = rsum; }
        i = i + 1;
    }
    return mx;
}

# Check symmetry within tolerance. Returns 1 if symmetric, 0 otherwise —
# including for a null or non-square matrix, for one containing ANY NaN or
# infinity, and for a tol that is NaN, infinite or negative. See ganita_mat_eq
# below for why the NaN case needs saying.
#
# ⚠ THE DIAGONAL AND THE TOLERANCE ARE CHECKED (1.2.12). The pair loop starts
# above the diagonal, so through 1.2.11 a NaN ON it was never seen, despite this
# doc. Under a NaN tolerance every pair passed. The two combined: with
# tol = LINALG_EPS * frobenius(m), the asymmetric [[NaN, 1], [4, 2]] was called
# symmetric. That matters here more than anywhere, because this is the check the
# cholesky and eigen_sym docs tell a caller to run first. Mirrored infinities
# passed by accident (|inf - inf| is NaN, which fails `diff > tol`); every
# non-finite entry now fails closed.
fn ganita_mat_is_symmetric(m, tol): i64 {
    if (m == 0) { return 0; }
    var n = ganita_mat_rows(m);
    if (n != ganita_mat_cols(m)) { return 0; }
    if (_linalg_tol_ok(tol) == 0) { return 0; }
    if (_linalg_all_finite(m + 16, n * n) == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var j = i + 1;
        while (j < n) {
            var above = ganita_mat_get(m, i, j);
            var below = ganita_mat_get(m, j, i);
            if (_linalg_is_nan(above) == 1 || _linalg_is_nan(below) == 1) { return 0; }
            var diff = f64_abs(f64_sub(above, below));
            if (f64_gt(diff, tol) == 1) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Element-wise equality within tolerance. Returns 1 if equal, 0 otherwise —
# including for a null operand, a shape mismatch, ANY NaN or infinity on either
# side, or a tol that is NaN, infinite or negative (1.2.12).
#
# ⚠ PASS AN ABSOLUTE TOLERANCE, in the units of your data. LINALG_EPS is a
# RELATIVE factor as of 1.2.4 — 1e-12 of something — so passing it raw compares
# your entries against 1e-12 absolute, which is what the old doc wrongly
# recommended. If you want a relative comparison here, pass
# `f64_mul(LINALG_EPS, scale)` for a scale you choose.
#
# ⚠ NaN NOW FAILS CLOSED. Every f64 comparison is false against a NaN, so the
# `if (diff > tol) return 0;` shape below simply never fired and the loop fell
# through to `return 1`: through 1.2.2 an all-NaN matrix compared EQUAL to the
# identity. That is worse than an ordinary wrong answer, because this function
# is the comparison tool the test suite uses to check the decompositions — a
# solver that returned NaN would have been certified correct by its own suite.
#
# ⚠ AND SO DO A BAD TOLERANCE AND AN INFINITY (1.2.12). The same shape let a NaN
# tol accept ANY two matrices, and the idiom above makes one: a norm of a matrix
# holding a NaN is NaN, and a norm of one holding an infinity is +inf, which
# accepted everything just as well. Two identical infinities compared equal only
# because |inf - inf| is NaN; an infinity now fails closed like a NaN.
fn ganita_mat_eq(a, b, tol): i64 {
    if (a == 0 || b == 0) { return 0; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    if (rows != ganita_mat_rows(b)) { return 0; }
    if (cols != ganita_mat_cols(b)) { return 0; }
    if (_linalg_tol_ok(tol) == 0) { return 0; }
    var n = rows * cols;
    var i = 0;
    while (i < n) {
        var va = load64(a + 16 + i * 8);
        var vb = load64(b + 16 + i * 8);
        if ((va & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
        if ((vb & 0x7FF0000000000000) == 0x7FF0000000000000) { return 0; }
        var diff = f64_abs(f64_sub(va, vb));
        if (f64_gt(diff, tol) == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Trace: sum of diagonal elements. SQUARE INPUT ONLY — returns NaN otherwise.
#
# The precondition is new at 1.2.3, and it was not academic: n came from the ROW
# count alone, so a tall matrix walked ganita_mat_get(m, i, i) for i up to
# rows-1 while the store only holds rows*cols elements. A 100000x1 read ~800 MB
# past its own allocation.
fn ganita_mat_trace(m): i64 {
    if (m == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var n = ganita_mat_rows(m);
    if (n != ganita_mat_cols(m)) { return f64_div(f64_from(0), f64_from(0)); }
    var sum = f64_from(0);
    var i = 0;
    while (i < n) {
        sum = f64_add(sum, ganita_mat_get(m, i, i));
        i = i + 1;
    }
    return sum;
}

# ================================================================
# Tier 1 — Linear solvers
# ================================================================

# LU decomposition with partial pivoting.
# out_lu: n×n matrix (caller allocates via ganita_mat_new). Receives packed L\U.
# out_piv: flat i64 array of length n (caller allocates via alloc(n*8)).
# Returns pivot sign (+1 or -1) for determinant, or 0 on a singular matrix.
# SQUARE INPUT ONLY — a non-square (or null) input also returns 0, because the
# success values +1/-1 leave no room for a distinct error code and 0 already
# means "cannot decompose". So does a NaN or infinite entry (1.2.12), with nothing
# written to out_lu or out_piv.
#
# ⚠ THAT REFUSAL USED TO BE AN ACCIDENT. An infinity made lu_tol +inf and a NaN
# never won the pivot search, so both ended at the "singular pivot" test — which
# holds only while LINALG_EPS > 0. With LINALG_EPS = 0 (a public var), lu
# returned 1 for [[+inf, 1], [1, 1]] and ganita_mat_inv a finite matrix.
#
# The square gate is new at 1.2.3. n came from the ROW count alone, so a tall
# input drove an n*n copy loop over a store holding only rows*cols elements —
# an out-of-bounds read of the caller's matrix that then propagated into
# ganita_mat_det and ganita_mat_inv, which are wrappers around this.
#
# L is unit lower triangular (1s on diagonal, stored below diagonal).
# U is upper triangular (stored on and above diagonal).
fn ganita_mat_lu(m, out_lu, out_piv): i64 {
    if (m == 0 || out_lu == 0 || out_piv == 0) { return 0; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0; }
    var n = ganita_mat_rows(m);
    if (_linalg_all_finite(m + 16, n * n) == 0) { return 0; }
    # Copy m into out_lu
    var i = 0;
    var total = n * n;
    while (i < total) {
        store64(out_lu + 16 + i * 8, load64(m + 16 + i * 8));
        i = i + 1;
    }
    # Initialize pivot vector to identity permutation
    i = 0;
    while (i < n) { store64(out_piv + i * 8, i); i = i + 1; }

    # The singularity threshold, RELATIVE to the matrix's own magnitude (1.2.4).
    # Computed once from the input, not per step, so a pivot is judged against
    # the problem it came from rather than against an absolute 1e-12 that means
    # nothing without units.
    var lu_tol = f64_mul(LINALG_EPS, _linalg_mat_scale(out_lu));

    var sign = 1;
    var k = 0;
    while (k < n) {
        # Find pivot: row with largest |a[i][k]| for i >= k
        var max_val = f64_from(0);
        var max_row = k;
        i = k;
        while (i < n) {
            var av = f64_abs(ganita_mat_get(out_lu, i, k));
            if (f64_gt(av, max_val) == 1) {
                max_val = av;
                max_row = i;
            }
            i = i + 1;
        }

        # `<=` so that an exactly-zero pivot in an all-zero matrix (where the
        # tolerance is itself 0) is still singular.
        if (f64_le(max_val, lu_tol) == 1) {
            return 0;  # Singular
        }

        # Swap rows k and max_row
        if (max_row != k) {
            var j = 0;
            while (j < n) {
                var tmp = ganita_mat_get(out_lu, k, j);
                ganita_mat_set(out_lu, k, j, ganita_mat_get(out_lu, max_row, j));
                ganita_mat_set(out_lu, max_row, j, tmp);
                j = j + 1;
            }
            var ptmp = load64(out_piv + k * 8);
            store64(out_piv + k * 8, load64(out_piv + max_row * 8));
            store64(out_piv + max_row * 8, ptmp);
            sign = 0 - sign;
        }

        # Eliminate below pivot
        var akk = ganita_mat_get(out_lu, k, k);
        i = k + 1;
        while (i < n) {
            var factor = f64_div(ganita_mat_get(out_lu, i, k), akk);
            ganita_mat_set(out_lu, i, k, factor);  # Store L factor
            var j = k + 1;
            while (j < n) {
                var val = f64_sub(ganita_mat_get(out_lu, i, j),
                  f64_mul(factor, ganita_mat_get(out_lu, k, j)));
                ganita_mat_set(out_lu, i, j, val);
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    return sign;
}

# Solve Ax=b from LU factors (from ganita_mat_lu).
# lu: packed L\U matrix. piv: pivot vector. b: flat f64 array of length n.
# out_x: flat f64 array of length n (caller allocates). Receives solution.
# Returns 0 on success, -1 if the forward-substitution scratch cannot be allocated,
# and -2 for a null argument, a non-square lu, a pivot outside [0, n), a zero on
# U's diagonal, or a NaN or infinite entry in lu or b. On -2 nothing is written.
#
# ⚠ THE FACTORS COME FROM THE CALLER (1.2.12), so this checks what it divides by
# and indexes with. Through 1.2.11 it checked nothing but nulls: an infinity on
# U's diagonal divided a finite sum to 0 and decoupled x_i, so the factors of
# [[4, 3], [6, 3]] with U[1][1] = +inf returned 0 and an all-finite wrong x; a zero
# there gave a NaN x with status 0; and piv[i] indexed b unchecked. The checks are
# O(n^2), the order of the solve itself, and run before the scratch allocation.
fn ganita_mat_lu_solve(lu, piv, b, out_x): i64 {
    if (lu == 0 || piv == 0 || b == 0 || out_x == 0) { return 0 - 2; }
    var n = ganita_mat_rows(lu);
    if (ganita_mat_cols(lu) != n) { return 0 - 2; }
    var c = 0;
    while (c < n) {
        var pc = load64(piv + c * 8);
        if (pc < 0 || pc >= n) { return 0 - 2; }
        if ((ganita_mat_get(lu, c, c) & 0x7FFFFFFFFFFFFFFF) == 0) { return 0 - 2; }
        c = c + 1;
    }
    if (_linalg_all_finite(lu + 16, n * n) == 0) { return 0 - 2; }
    if (_linalg_all_finite(b, n) == 0) { return 0 - 2; }

    # Forward substitution: Ly = Pb
    var y = alloc(n * 8);
    if (y == 0) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        var pi = load64(piv + i * 8);
        var sum = load64(b + pi * 8);
        var j = 0;
        while (j < i) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(lu, i, j), load64(y + j * 8)));
            j = j + 1;
        }
        store64(y + i * 8, sum);
        i = i + 1;
    }

    # Back substitution: Ux = y
    i = n - 1;
    while (i >= 0) {
        var sum = load64(y + i * 8);
        var j = i + 1;
        while (j < n) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(lu, i, j), load64(out_x + j * 8)));
            j = j + 1;
        }
        store64(out_x + i * 8, f64_div(sum, ganita_mat_get(lu, i, i)));
        i = i - 1;
    }
    return 0;
}

# Determinant via LU. Convenience wrapper around ganita_mat_lu.
# SQUARE INPUT ONLY. Returns 0.0 for a singular matrix, and NaN for a null or
# non-square input, a NaN or infinite entry, or if the n×n working factor cannot be
# allocated — NOT 0.0, which would report a perfectly invertible matrix as singular.
#
# ⚠ Through 1.2.11 a NaN or infinite entry DID come back as 0.0: lu refuses it with
# its one failure value, and this function read that 0 as "singular". It now scans
# for it first, so 0.0 means singular and nothing else (1.2.12).
fn ganita_mat_det(m): i64 {
    if (m == 0) { return f64_div(f64_from(0), f64_from(0)); }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return f64_div(f64_from(0), f64_from(0)); }
    var n = ganita_mat_rows(m);
    if (_linalg_all_finite(m + 16, n * n) == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var lu = ganita_mat_new(n, n);
    if (lu == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var piv = alloc(n * 8);
    if (piv == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var sign = ganita_mat_lu(m, lu, piv);
    if (sign == 0) { return f64_from(0); }
    var det = f64_from(sign);
    var i = 0;
    while (i < n) {
        det = f64_mul(det, ganita_mat_get(lu, i, i));
        i = i + 1;
    }
    return det;
}

# Inverse via LU. Convenience wrapper — solves LU against identity columns.
# SQUARE INPUT ONLY. Returns a new n×n matrix, or 0 if the input is null or
# non-square, if it is singular, if it holds a NaN or infinite entry (refused by
# ganita_mat_lu, 1.2.12), or if any working allocation fails.
fn ganita_mat_inv(m): i64 {
    if (m == 0) { return 0; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0; }
    var n = ganita_mat_rows(m);
    var lu = ganita_mat_new(n, n);
    if (lu == 0) { return 0; }
    var piv = alloc(n * 8);
    if (piv == 0) { return 0; }
    var sign = ganita_mat_lu(m, lu, piv);
    if (sign == 0) { return 0; }

    # Every element is written below — column k in full on pass k.
    var inv = _ganita_mat_new_raw(n, n);
    if (inv == 0) { return 0; }

    # ⚡ ONE SCRATCH COLUMN, AND NO IDENTITY COLUMN AT ALL (1.2.6).
    #
    # Through 1.2.5 this built e_k and called ganita_mat_lu_solve on it n times.
    # lu_solve allocates its own n-element forward-substitution scratch on every
    # call, and the allocator is a bump allocator with no free, so an inverse
    # leaked 8n² bytes of scratch it never reused — as much again as the result.
    # It also forward-substituted DENSELY against a unit vector, although the
    # answer's leading entries are known to be zero.
    #
    # L·y = P·e_k has its single 1 in row s, where piv[s] == k. Every y_i above s
    # is therefore exactly zero and y_s is exactly one, so forward substitution
    # starts at s and its inner sums start at column s. Back substitution U·x = y
    # then runs in place in the same buffer: x_i reads only y_i and the x_j with
    # j > i, and those slots already hold x by the time row i is reached.
    #
    # Bit-identical to the 1.2.5 result for finite input: the skipped terms were
    # all products with an exact zero, and subtracting a signed zero from +0.0 or
    # from 1.0 leaves it unchanged.
    var w = alloc(n * 8);
    if (w == 0) { return 0; }
    # row_of[k] = the row s with piv[s] == k: where P·e_k keeps its 1.
    var row_of = alloc(n * 8);
    if (row_of == 0) { return 0; }
    var i = 0;
    while (i < n) {
        store64(row_of + load64(piv + i * 8) * 8, i);
        i = i + 1;
    }

    var k = 0;
    while (k < n) {
        var s = load64(row_of + k * 8);
        # Forward: L·y = P·e_k, from row s.
        i = 0;
        while (i < s) {
            store64(w + i * 8, f64_from(0));
            i = i + 1;
        }
        store64(w + s * 8, f64_from(1));
        i = s + 1;
        while (i < n) {
            var fsum = f64_from(0);
            var j = s;
            while (j < i) {
                fsum = f64_sub(fsum, f64_mul(ganita_mat_get(lu, i, j), load64(w + j * 8)));
                j = j + 1;
            }
            store64(w + i * 8, fsum);
            i = i + 1;
        }
        # Back: U·x = y, in place, straight into column k.
        i = n - 1;
        while (i >= 0) {
            var bsum = load64(w + i * 8);
            var j2 = i + 1;
            while (j2 < n) {
                bsum = f64_sub(bsum, f64_mul(ganita_mat_get(lu, i, j2), load64(w + j2 * 8)));
                j2 = j2 + 1;
            }
            var xi = f64_div(bsum, ganita_mat_get(lu, i, i));
            store64(w + i * 8, xi);
            ganita_mat_set(inv, i, k, xi);
            i = i - 1;
        }
        k = k + 1;
    }
    return inv;
}

# Cholesky factorization for symmetric positive-definite matrices.
# out_l: n×n matrix (caller allocates). Receives lower triangular L where A = LL^T.
# Returns 1 on success, 0 if the input is null, non-square, holds a NaN or
# infinite entry anywhere (1.2.12), or is NOT POSITIVE-DEFINITE. This return is the
# cheapest positive-definiteness test in the library, so it has to be exact about
# what "definite" means. (1/0, not the negative codes: one of the documented
# exceptions in the header.)
#
# ⚠ AN INFINITE PIVOT WAS "POSITIVE" through 1.2.11. [[+inf, 2], [2, 3]] returned 1
# with L = [[+inf, 0], [0, 1.73]]: every later entry in the column divided by +inf
# and became 0, so the coupling vanished, and cholesky_solve turned that into a
# finite wrong answer. A NaN in the never-read upper triangle was accepted too.
#
# ⚠ SEMI-DEFINITE IS NOT DEFINITE, and through 1.2.2 this said otherwise. The
# pivot guard was `diag < 0`, strictly less than, so a pivot of exactly zero
# passed, f64_sqrt(0) went onto L's diagonal, and every later off-diagonal
# divided by it. [1 2; 2 4] — symmetric, det 0, eigenvalues 0 and 5 — returned
# 1, produced L = [1 0; 2 0], and ganita_mat_cholesky_solve then returned 0
# (success) having written NaN into every slot of the solution. A caller doing
# exactly the documented thing got success, success, NaN.
#
# Only the entries BELOW and ON the diagonal are used, so a finite non-symmetric
# input is accepted and factorised as if it were its own lower triangle mirrored.
# Call ganita_mat_is_symmetric first if the input is not known to be symmetric.
fn ganita_mat_cholesky(m, out_l): i64 {
    if (m == 0 || out_l == 0) { return 0; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0; }
    var n = ganita_mat_rows(m);
    if (_linalg_all_finite(m + 16, n * n) == 0) { return 0; }
    # Zero out_l
    var i = 0;
    var total = n * n;
    while (i < total) { store64(out_l + 16 + i * 8, f64_from(0)); i = i + 1; }

    i = 0;
    while (i < n) {
        var j = 0;
        while (j <= i) {
            var sum = f64_from(0);
            var k = 0;
            while (k < j) {
                sum = f64_add(sum, f64_mul(ganita_mat_get(out_l, i, k), ganita_mat_get(out_l, j, k)));
                k = k + 1;
            }
            if (i == j) {
                var diag = f64_sub(ganita_mat_get(m, i, i), sum);
                # `<= 0`, not `< 0`: a zero pivot means semi-definite, which is
                # not definite, and letting it through puts a 0 on L's diagonal
                # for every later division to produce NaN through. NaN itself
                # fails every comparison, so it is rejected explicitly.
                if (_linalg_is_nan(diag) == 1) { return 0; }
                if (f64_le(diag, f64_from(0)) == 1) { return 0; }
                ganita_mat_set(out_l, i, j, f64_sqrt(diag));
            } else {
                var lij = f64_div(f64_sub(ganita_mat_get(m, i, j), sum), ganita_mat_get(out_l, j, j));
                ganita_mat_set(out_l, i, j, lij);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Solve Ax=b from Cholesky factor L (where A = LL^T).
# l: lower triangular. b: flat f64 array. out_x: flat f64 array.
# Returns 0 on success, -1 if the forward-substitution scratch cannot be allocated,
# and -2 for a null argument, a non-square l, a zero on L's diagonal, or a NaN or
# infinite entry in l or b. On -2 nothing is written and no scratch is taken.
fn ganita_mat_cholesky_solve(l, b, out_x): i64 {
    if (l == 0 || b == 0 || out_x == 0) { return 0 - 2; }
    var n = ganita_mat_rows(l);
    if (ganita_mat_cols(l) != n) { return 0 - 2; }
    # Defence in depth: every step below divides by L[i][i]. A factor that came
    # from a successful ganita_mat_cholesky cannot have a zero there as of 1.2.3,
    # but this function takes L from the CALLER and cannot know where it came
    # from — and a zero would quietly produce a solution of NaN while returning
    # success, which is exactly the failure the cholesky fix closed upstream.
    # An INFINITE diagonal is worse (1.2.12): a finite sum divided by it is 0, so
    # through 1.2.11 L = [[2, 0], [1, +inf]] returned 0 and an all-finite wrong x.
    var d = 0;
    while (d < n) {
        if ((ganita_mat_get(l, d, d) & 0x7FFFFFFFFFFFFFFF) == 0) { return 0 - 2; }
        d = d + 1;
    }
    if (_linalg_all_finite(l + 16, n * n) == 0) { return 0 - 2; }
    if (_linalg_all_finite(b, n) == 0) { return 0 - 2; }

    # Forward: Ly = b
    var y = alloc(n * 8);
    if (y == 0) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        var sum = load64(b + i * 8);
        var j = 0;
        while (j < i) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(l, i, j), load64(y + j * 8)));
            j = j + 1;
        }
        store64(y + i * 8, f64_div(sum, ganita_mat_get(l, i, i)));
        i = i + 1;
    }

    # Backward: L^T x = y
    i = n - 1;
    while (i >= 0) {
        var sum = load64(y + i * 8);
        var j = i + 1;
        while (j < n) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(l, j, i), load64(out_x + j * 8)));
            j = j + 1;
        }
        store64(out_x + i * 8, f64_div(sum, ganita_mat_get(l, i, i)));
        i = i - 1;
    }
    return 0;
}

# QR decomposition via Householder reflections.
# out_q: m×m matrix (caller allocates). Receives orthogonal Q.
# out_r: m×n matrix (caller allocates). Receives upper triangular R.
# Returns 0 on success, -1 if a working allocation fails, -2 if any argument is
# null, an out-param is not the documented shape, or A holds a NaN or infinite
# entry (1.2.12). On -2 nothing is written.
#
# ⚠ NON-FINITE INPUT WAS "ALREADY REDUCED" through 1.2.11. An infinity made qr_tol
# +inf, so no reflector passed its gate and qr returned 0 with Q = I and R = A —
# not triangular, with the infinity below the diagonal where a caller reading R
# never looks. A NaN made its column's norm NaN, which skipped that reflector the
# same way.
#
# ⚠ The m×m out_q is this function's CONTRACT, and it bounds m at
# sqrt(GANITA_MAT_MAX_ELEMS) ≈ 5792 for any caller that wants an explicit Q.
# If you only need to SOLVE, ganita_mat_least_squares no longer comes through
# here — it applies the reflectors to b directly and is O(m·n).
fn ganita_mat_qr(m, out_q, out_r): i64 {
    if (m == 0 || out_q == 0 || out_r == 0) { return 0 - 2; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    if (ganita_mat_rows(out_q) != rows || ganita_mat_cols(out_q) != rows) { return 0 - 2; }
    if (ganita_mat_rows(out_r) != rows || ganita_mat_cols(out_r) != cols) { return 0 - 2; }
    if (_linalg_all_finite(m + 16, rows * cols) == 0) { return 0 - 2; }
    # Relative reflector threshold — 1e-12 of the input's largest absolute entry.
    var qr_tol = f64_mul(LINALG_EPS, _linalg_mat_scale(m));

    # Copy m into R
    var i = 0;
    while (i < rows * cols) {
        store64(out_r + 16 + i * 8, load64(m + 16 + i * 8));
        i = i + 1;
    }

    # Initialize Q to identity
    i = 0;
    var q_total = rows * rows;
    while (i < q_total) { store64(out_q + 16 + i * 8, f64_from(0)); i = i + 1; }
    i = 0;
    while (i < rows) { ganita_mat_set(out_q, i, i, f64_from(1)); i = i + 1; }

    var min = rows;
    if (cols < min) { min = cols; }

    # ⚡ One reflector buffer for the whole factorisation (1.2.4), sized for the
    # longest column. It used to be allocated INSIDE the k-loop, and the
    # allocator is a bump allocator with no free — so a factorisation leaked
    # O(m*n) bytes of scratch it never reused.
    var v = alloc(rows * 8);
    if (v == 0) { return 0 - 1; }

    var k = 0;
    while (k < min) {
        # Extract column k below diagonal into the hoisted scratch.
        i = 0;
        while (i < rows - k) {
            store64(v + i * 8, ganita_mat_get(out_r, k + i, k));
            i = i + 1;
        }

        # Scaled two-norm (1.2.4). The direct sum of squares overflowed to +inf
        # for entries above ~1.3e154 and underflowed to 0 below ~1.5e-162, in
        # both cases for vectors whose norm is perfectly representable — and the
        # skip test below then acted on that value while still returning success.
        var norm = _linalg_norm2(v, rows - k);

        # RELATIVE skip test (1.2.4). Against an absolute 1e-12, a matrix whose
        # entries were merely SMALL had every reflector skipped, leaving R
        # non-triangular and producing a plausible-looking wrong answer with a
        # success return. qr_tol is 1e-12 of the input's own magnitude.
        if (f64_gt(norm, qr_tol) == 1) {
            # Choose sign to avoid cancellation
            var v0 = load64(v);
            if (f64_gt(v0, f64_from(0)) == 1) {
                store64(v, f64_add(v0, norm));
            } else {
                store64(v, f64_sub(v0, norm));
            }

            # Normalize v, again through the scaled norm.
            var vnorm = _linalg_norm2(v, rows - k);
            if (f64_gt(vnorm, qr_tol) == 1) {
                i = 0;
                while (i < rows - k) {
                    store64(v + i * 8, f64_div(load64(v + i * 8), vnorm));
                    i = i + 1;
                }
            }

            # Apply H = I - 2vv^T to R (columns k..cols)
            var j = k;
            while (j < cols) {
                var dot = f64_from(0);
                i = 0;
                while (i < rows - k) {
                    dot = f64_add(dot, f64_mul(load64(v + i * 8), ganita_mat_get(out_r, k + i, j)));
                    i = i + 1;
                }
                dot = f64_mul(f64_from(2), dot);
                i = 0;
                while (i < rows - k) {
                    var rij = ganita_mat_get(out_r, k + i, j);
                    ganita_mat_set(out_r, k + i, j, f64_sub(rij, f64_mul(dot, load64(v + i * 8))));
                    i = i + 1;
                }
                j = j + 1;
            }

            # Apply H to Q (columns)
            j = 0;
            while (j < rows) {
                var dot = f64_from(0);
                i = 0;
                while (i < rows - k) {
                    dot = f64_add(dot, f64_mul(load64(v + i * 8), ganita_mat_get(out_q, k + i, j)));
                    i = i + 1;
                }
                dot = f64_mul(f64_from(2), dot);
                i = 0;
                while (i < rows - k) {
                    var qij = ganita_mat_get(out_q, k + i, j);
                    ganita_mat_set(out_q, k + i, j, f64_sub(qij, f64_mul(dot, load64(v + i * 8))));
                    i = i + 1;
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }

    # Q accumulated H_k...H_1 — transpose to get Q where A = QR.
    #
    # ⚡ IN PLACE (1.2.6). Q is square, so its transpose is a swap across the
    # diagonal. Through 1.2.5 this materialised a whole m×m transposed copy,
    # copied it back element by element and discarded it: a second m×m
    # allocation that the bump allocator never reclaims, and an allocation-
    # failure return for what is only a permutation of values already in hand.
    i = 0;
    while (i < rows) {
        var jt = i + 1;
        while (jt < rows) {
            var tq = ganita_mat_get(out_q, i, jt);
            ganita_mat_set(out_q, i, jt, ganita_mat_get(out_q, jt, i));
            ganita_mat_set(out_q, jt, i, tq);
            jt = jt + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Gaussian elimination on augmented matrix [A|b]. Solves in-place.
# aug: n×(n+1) augmented matrix. Solution written to last column.
# Returns 1 on success, 0 if the input is null, not n×(n+1), singular, or holds a
# NaN or infinite entry anywhere, the right-hand side included (1.2.12; 1/0, one of
# the documented exceptions in the header). On a non-finite refusal aug is left
# untouched. Through 1.2.11 an infinity refused only as a side effect of the
# tolerance, a NaN in A refused after half-eliminating aug, and a NaN in b
# returned 1 with a NaN solution.
#
# The shape gate is new at 1.2.3. The routine indexes column n on an n-row
# matrix, so an n×n argument — the shape a caller most plausibly reaches for by
# mistake, since every other solver here takes one — wrote one element PAST the
# backing store on each of n rows and still returned 1.
fn ganita_mat_gaussian_elim(aug): i64 {
    if (aug == 0) { return 0; }
    var n = ganita_mat_rows(aug);
    if (ganita_mat_cols(aug) != n + 1) { return 0; }
    if (_linalg_all_finite(aug + 16, n * (n + 1)) == 0) { return 0; }

    # Relative singularity threshold — see ganita_mat_lu. Taken over the whole
    # augmented matrix, which includes b; that is deliberate, since a b far
    # larger than A is exactly the case where an absolute threshold misleads.
    var ge_tol = f64_mul(LINALG_EPS, _linalg_mat_scale(aug));

    var k = 0;
    while (k < n) {
        # Partial pivot
        var max_val = f64_from(0);
        var max_row = k;
        var i = k;
        while (i < n) {
            var av = f64_abs(ganita_mat_get(aug, i, k));
            if (f64_gt(av, max_val) == 1) {
                max_val = av;
                max_row = i;
            }
            i = i + 1;
        }
        if (f64_le(max_val, ge_tol) == 1) { return 0; }

        # Swap rows
        if (max_row != k) {
            var j = k;
            while (j <= n) {
                var tmp = ganita_mat_get(aug, k, j);
                ganita_mat_set(aug, k, j, ganita_mat_get(aug, max_row, j));
                ganita_mat_set(aug, max_row, j, tmp);
                j = j + 1;
            }
        }

        # Eliminate
        var akk = ganita_mat_get(aug, k, k);
        i = k + 1;
        while (i < n) {
            var factor = f64_div(ganita_mat_get(aug, i, k), akk);
            var j = k;
            while (j <= n) {
                ganita_mat_set(aug, i, j, f64_sub(ganita_mat_get(aug, i, j),
                    f64_mul(factor, ganita_mat_get(aug, k, j))));
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }

    # Back substitution — write solution into last column
    var i = n - 1;
    while (i >= 0) {
        var sum = ganita_mat_get(aug, i, n);
        var j = i + 1;
        while (j < n) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(aug, i, j), ganita_mat_get(aug, j, n)));
            j = j + 1;
        }
        ganita_mat_set(aug, i, n, f64_div(sum, ganita_mat_get(aug, i, i)));
        i = i - 1;
    }
    return 1;
}

# Least-squares solve via Householder QR: minimize ||Ax - b||^2.
# a: m×n matrix (m >= n). b: flat f64 array of length m.
# out_x: flat f64 array of length n (caller allocates).
# Returns 0 on success, -1 if a working allocation fails, -2 if an argument is
# null, the system is UNDER-determined (m < n), or A or b holds a NaN or infinite
# entry (1.2.12). On -2 nothing is written and no scratch is taken.
#
# ⚠ Through 1.2.11 such input came back as SUCCESS with a finite x. An infinity in
# A made ls_tol +inf, so no reflector was applied and the top n×n triangle of the
# unreduced A was solved against b[0..n-1], ignoring every other row of A and b:
# [[1, 1], [1, 2], [1, +inf]] fitted x = (0, 1) whatever b[2] held. A NaN below the
# diagonal skipped its column's reflector the same way; for one column, x was
# b[0] / a[0][0], from a single row.
#
# ⚠ m >= n IS CHECKED AS OF 1.2.3. Back-substitution runs from row cols-1, so a
# wide design indexed qtb and R past their ends: the routine read far out of
# bounds and then returned 0 — success — with out_x full of NaN, or faulted
# outright at scale. An under-determined system has no unique least-squares
# solution and needs the minimum-norm one, which is ganita_mat_pseudo_inv.
#
# ⚠ NO Q IS EVER FORMED. Through 1.2.1 this called ganita_mat_qr, whose
# contract is an explicit m×m orthogonal Q — so a caller's perfectly ordinary
# m×n design matrix made this function ask for an m² one. A degree-2 fit over
# 5793 samples is a 5793×3 design (17,379 elements, 0.05% of
# GANITA_MAT_MAX_ELEMS) and ganita_mat_new accepts it without complaint, but the
# internal Q was 5793² = 33,558,849 elements, just over the cap. mat_new
# returned 0, nothing checked it, and ganita_mat_qr's Q-initialisation loop
# stored through the null: SIGSEGV from a public API on in-contract arguments,
# with an undocumented ceiling of m ≈ 5792 that came from a matrix the algorithm
# does not need. Filed by naad 2.1.3; see
# docs/development/issues/archived/2026-08-23-least-squares-unchecked-q-alloc.md.
#
# The reflectors are now applied to `b` in the same sweep that reduces A to R,
# which IS Q^T·b (R = H_{n-1}···H_0·A, so Q^T = H_{n-1}···H_0 and each H is its
# own inverse). Peak memory is O(m·n) instead of O(m²): an m×n working copy plus
# two length-m vectors. The 5793×3 case needs 231 KB where it used to need
# 268 MB, and a degree-2 fit over 100,000 samples — outright impossible before,
# at any cap — costs 4 MB.
#
# The upstream report proposed thin modified Gram-Schmidt (as ported by hisab
# 1.4.0). Householder-applied-to-b reaches the same O(m·n) bound, and is kept
# here instead because it is unconditionally stable where MGS is not, and
# because it is the SAME arithmetic 1.1.4 through 1.2.1 already shipped — only
# the accumulation of Q, and its transpose, are gone. Results are unchanged to
# well inside the suite's 1e-9 tolerance, and are strictly more accurate: the
# reflectors now reach b directly rather than through a materialised Q.
fn ganita_mat_least_squares(a, b, out_x): i64 {
    if (a == 0 || b == 0 || out_x == 0) { return 0 - 2; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    if (rows < cols) { return 0 - 2; }
    if (_linalg_all_finite(a + 16, rows * cols) == 0) { return 0 - 2; }
    if (_linalg_all_finite(b, rows) == 0) { return 0 - 2; }
    # Relative reflector threshold — see ganita_mat_qr.
    var ls_tol = f64_mul(LINALG_EPS, _linalg_mat_scale(a));

    # Working copy of A, reduced to R in place.
    var r = ganita_mat_copy(a);
    if (r == 0) { return 0 - 1; }
    # Q^T·b, accumulated reflector by reflector. Starts as a copy of b.
    var qtb = alloc(rows * 8);
    if (qtb == 0) { return 0 - 1; }
    # Reflector scratch, sized once for the longest column (k = 0).
    var v = alloc(rows * 8);
    if (v == 0) { return 0 - 1; }

    var i = 0;
    while (i < rows) {
        store64(qtb + i * 8, load64(b + i * 8));
        i = i + 1;
    }

    var k = 0;
    while (k < cols) {
        var len = rows - k;

        # Extract column k below the diagonal
        i = 0;
        while (i < len) {
            store64(v + i * 8, ganita_mat_get(r, k + i, k));
            i = i + 1;
        }

        # Scaled two-norm (1.2.4). The direct sum of squares overflowed to +inf
        # for entries above ~1.3e154 and underflowed to 0 below ~1.5e-162, in
        # both cases for vectors whose norm is perfectly representable — and the
        # skip test below then acted on that value while still returning success.
        var norm = _linalg_norm2(v, len);

        # RELATIVE skip test (1.2.4). Against an absolute 1e-12, a matrix whose
        # entries were merely SMALL had every reflector skipped, leaving R
        # non-triangular and producing a plausible-looking wrong answer with a
        # success return. ls_tol is 1e-12 of the input's own magnitude.
        if (f64_gt(norm, ls_tol) == 1) {
            # Choose sign to avoid cancellation
            var v0 = load64(v);
            if (f64_gt(v0, f64_from(0)) == 1) {
                store64(v, f64_add(v0, norm));
            } else {
                store64(v, f64_sub(v0, norm));
            }

            # Normalize v, again through the scaled norm.
            var vnorm = _linalg_norm2(v, len);
            if (f64_gt(vnorm, ls_tol) == 1) {
                i = 0;
                while (i < len) {
                    store64(v + i * 8, f64_div(load64(v + i * 8), vnorm));
                    i = i + 1;
                }
            }

            # Apply H = I - 2vv^T to R (columns k..cols)
            var j = k;
            while (j < cols) {
                var dot = f64_from(0);
                i = 0;
                while (i < len) {
                    dot = f64_add(dot, f64_mul(load64(v + i * 8), ganita_mat_get(r, k + i, j)));
                    i = i + 1;
                }
                dot = f64_mul(f64_from(2), dot);
                i = 0;
                while (i < len) {
                    var rij = ganita_mat_get(r, k + i, j);
                    ganita_mat_set(r, k + i, j, f64_sub(rij, f64_mul(dot, load64(v + i * 8))));
                    i = i + 1;
                }
                j = j + 1;
            }

            # Apply the SAME H to b. Sweeping every reflector across b in the
            # order they hit A leaves Q^T·b behind, with no Q in between.
            var dotb = f64_from(0);
            i = 0;
            while (i < len) {
                dotb = f64_add(dotb, f64_mul(load64(v + i * 8), load64(qtb + (k + i) * 8)));
                i = i + 1;
            }
            dotb = f64_mul(f64_from(2), dotb);
            i = 0;
            while (i < len) {
                var bi = load64(qtb + (k + i) * 8);
                store64(qtb + (k + i) * 8, f64_sub(bi, f64_mul(dotb, load64(v + i * 8))));
                i = i + 1;
            }
        }
        k = k + 1;
    }

    # Back-substitution on upper n×n of R
    i = cols - 1;
    while (i >= 0) {
        var sum = load64(qtb + i * 8);
        var j = i + 1;
        while (j < cols) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(r, i, j), load64(out_x + j * 8)));
            j = j + 1;
        }
        store64(out_x + i * 8, f64_div(sum, ganita_mat_get(r, i, i)));
        i = i - 1;
    }
    return 0;
}

# ================================================================
# Tier 2 — Advanced decomposition
# ================================================================

# Column index of the largest |a[r][j]| over j > r — one row of the strict upper
# triangle. Returns r+1 for the last row, which has no off-diagonal entries and
# which ganita_mat_eigen_sym never reads. Ties go to the lowest j (strict >),
# matching the scan order the exhaustive search used, so the pivot SEQUENCE is
# unchanged and so are the results, bit for bit.
fn _linalg_row_max_col(a, n, r): i64 {
    var best = r + 1;
    if (best >= n) { return best; }
    var bv = f64_abs(ganita_mat_get(a, r, best));
    var j = r + 2;
    while (j < n) {
        var v = f64_abs(ganita_mat_get(a, r, j));
        if (f64_gt(v, bv) == 1) {
            bv = v;
            best = j;
        }
        j = j + 1;
    }
    return best;
}

# Eigendecomposition for real symmetric matrices via Jacobi rotation.
# out_vals: flat f64 array of length n (caller allocates via alloc(n*8)).
# out_vecs: n×n matrix (caller allocates via ganita_mat_new). Columns are eigenvectors.
# SYMMETRIC SQUARE INPUT ONLY. Returns the number of rotations applied, or a
# negative failure code: -1 allocation, -2 contract violation (null argument,
# non-square input, out_vecs not n×n, or a NaN or infinite entry anywhere — 1.2.12),
# -3 max iterations exceeded. On -2 nothing is written.
#
# ⚠ Through 1.2.11 NaN and infinite input came back as SUCCESS with finite values.
# An infinity made eig_tol +inf, so the iteration stopped at once and returned the
# raw diagonal with vectors I. A NaN off-diagonal was never chosen as a pivot (the
# searches use f64_gt), and at (r, r+1) it became row r's recorded maximum, hiding
# every finite coupling after it: [[1, NaN, 5], [NaN, 2, 0], [5, 0, 3]] returned 0
# rotations and (1, 2, 3).
#
# ⚠ THE -1/-3 SPLIT CHANGED AT 1.2.3. Non-convergence used to be -1 and
# allocation failure -2 (added at 1.2.2); they now follow the module-wide
# vocabulary at the top of this file. Any negative is still a failure, which is
# what the existing `>= 0` idiom tests.
#
# Symmetry is NOT checked, and BOTH triangles are read: the pivot search scans
# above the diagonal, but each rotation reads columns p and q in full before
# writing both mirrors. A non-symmetric input therefore yields the eigenvalues of
# no particular matrix (this said "of its symmetrised self" through 1.2.11, which
# was never true). Call ganita_mat_is_symmetric first if the input is not known to
# be symmetric.
# Max 100*n^2 rotations. Converges when the largest off-diagonal < LINALG_EPS.
fn ganita_mat_eigen_sym(m, out_vals, out_vecs): i64 {
    if (m == 0 || out_vals == 0 || out_vecs == 0) { return 0 - 2; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0 - 2; }
    var n = ganita_mat_rows(m);
    if (ganita_mat_rows(out_vecs) != n || ganita_mat_cols(out_vecs) != n) { return 0 - 2; }
    if (_linalg_all_finite(m + 16, n * n) == 0) { return 0 - 2; }

    # Copy m into working matrix A (will be diagonalized in place). A failed copy is
    # an allocation failure, -1; through 1.2.11 it returned -2, against this doc.
    var a = ganita_mat_copy(m);
    if (a == 0) { return 0 - 1; }
    # Convergence threshold, RELATIVE to the input (1.2.4). Taken from the
    # original, not from `a`, whose magnitude shrinks as it diagonalises.
    # Against an absolute 1e-12 this converged instantly for any matrix whose
    # entries were below ~1e-6 — which is how svd, rank, condition and
    # pseudo_inv came to report rank 2 and condition 2.0 for a singular matrix.
    var eig_tol = f64_mul(LINALG_EPS, _linalg_mat_scale(m));

    # Initialize out_vecs to identity (accumulates rotations)
    var i = 0;
    var total = n * n;
    while (i < total) { store64(out_vecs + 16 + i * 8, f64_from(0)); i = i + 1; }
    i = 0;
    while (i < n) { ganita_mat_set(out_vecs, i, i, f64_from(1)); i = i + 1; }

    # ⚡ THE PIVOT SEARCH IS INDEXED, NOT EXHAUSTIVE (1.2.3).
    #
    # Classical Jacobi picks the largest off-diagonal entry each time. Through
    # 1.2.2 that meant rescanning the whole upper triangle — O(n^2) — before
    # EVERY rotation, and convergence takes O(n^2) rotations, so the routine was
    # O(n^4). ganita_mat_condition on a 200x200 took about 13 seconds, and
    # ganita_mat_rank, ganita_mat_condition and ganita_mat_pseudo_inv all route
    # through here, so the cost was not confined to callers who asked for
    # eigenvalues.
    #
    # rmax[i] holds the column of the largest |a[i][j]| over j > i. The global
    # maximum is then one O(n) pass over rmax. A rotation at (p, q) changes only
    # rows p and q and columns p and q, so afterwards rows p and q are recomputed
    # in full and every other row is repaired from its two changed entries —
    # rescanned only when its recorded maximum WAS at column p or q and may
    # therefore have shrunk. That is O(n) per rotation in the common case,
    # O(n^2) in the worst, against O(n^2) unconditionally before.
    #
    # Ties break identically (strict >, lowest index first), so this selects the
    # same pivot at every step as the exhaustive scan did: the eigenvalues are
    # bit-for-bit what 1.2.2 produced, not merely close.
    var rmax = alloc(n * 8);
    if (rmax == 0) { return 0 - 1; }
    i = 0;
    while (i < n - 1) {
        store64(rmax + i * 8, _linalg_row_max_col(a, n, i));
        i = i + 1;
    }

    var max_iter = 100 * n * n;
    var iter = 0;
    while (iter < max_iter) {
        # Largest off-diagonal element, read off the per-row maxima.
        var max_off = f64_from(0);
        var p = 0;
        var q = 1;
        i = 0;
        while (i < n - 1) {
            var rc = load64(rmax + i * 8);
            var rv = f64_abs(ganita_mat_get(a, i, rc));
            if (f64_gt(rv, max_off) == 1) {
                max_off = rv;
                p = i;
                q = rc;
            }
            i = i + 1;
        }

        # Converged?
        if (f64_le(max_off, eig_tol) == 1) {
            # Extract eigenvalues from diagonal
            i = 0;
            while (i < n) {
                store64(out_vals + i * 8, ganita_mat_get(a, i, i));
                i = i + 1;
            }
            return iter;
        }

        # Compute rotation angle
        var app = ganita_mat_get(a, p, p);
        var aqq = ganita_mat_get(a, q, q);
        var apq = ganita_mat_get(a, p, q);

        var theta = f64_div(f64_sub(aqq, app),
          f64_mul(f64_from(2), apq));
        # t = sign(theta) / (|theta| + sqrt(theta^2 + 1))
        var t = f64_from(0);
        var abs_theta = f64_abs(theta);
        var denom = f64_add(abs_theta,
          f64_sqrt(f64_add(f64_mul(theta, theta), f64_from(1))));
        if (f64_gt(theta, f64_from(0)) == 1) {
            t = f64_div(f64_from(1), denom);
        } else {
            t = f64_neg(f64_div(f64_from(1), denom));
        }

        var c = f64_div(f64_from(1),
          f64_sqrt(f64_add(f64_mul(t, t), f64_from(1))));
        var s = f64_mul(t, c);
        var tau = f64_div(s, f64_add(f64_from(1), c));

        # Apply rotation to A
        # Update rows/cols p and q
        i = 0;
        while (i < n) {
            if (i != p && i != q) {
                var aip = ganita_mat_get(a, i, p);
                var aiq = ganita_mat_get(a, i, q);
                ganita_mat_set(a, i, p, f64_sub(aip, f64_mul(s,
                      f64_add(aiq, f64_mul(tau, aip)))));
                ganita_mat_set(a, i, q, f64_add(aiq, f64_mul(s,
                      f64_sub(aip, f64_mul(tau, aiq)))));
                ganita_mat_set(a, p, i, ganita_mat_get(a, i, p));
                ganita_mat_set(a, q, i, ganita_mat_get(a, i, q));
            }
            i = i + 1;
        }

        # Update diagonal
        ganita_mat_set(a, p, p, f64_sub(app, f64_mul(t, apq)));
        ganita_mat_set(a, q, q, f64_add(aqq, f64_mul(t, apq)));
        ganita_mat_set(a, p, q, f64_from(0));
        ganita_mat_set(a, q, p, f64_from(0));

        # Accumulate rotation into eigenvector matrix
        i = 0;
        while (i < n) {
            var vip = ganita_mat_get(out_vecs, i, p);
            var viq = ganita_mat_get(out_vecs, i, q);
            ganita_mat_set(out_vecs, i, p, f64_sub(vip, f64_mul(s,
                  f64_add(viq, f64_mul(tau, vip)))));
            ganita_mat_set(out_vecs, i, q, f64_add(viq, f64_mul(s,
                  f64_sub(vip, f64_mul(tau, viq)))));
            i = i + 1;
        }

        # Repair the per-row maxima. Rows p and q changed in many positions and
        # are recomputed in full; every other row saw at most its p and q entries
        # change, so it only needs a rescan when its recorded maximum was AT one
        # of those columns and may have shrunk.
        store64(rmax + p * 8, _linalg_row_max_col(a, n, p));
        if (q < n - 1) { store64(rmax + q * 8, _linalg_row_max_col(a, n, q)); }
        i = 0;
        while (i < n - 1) {
            if (i != p && i != q) {
                var rc2 = load64(rmax + i * 8);
                if (rc2 == p || rc2 == q) {
                    store64(rmax + i * 8, _linalg_row_max_col(a, n, i));
                } else {
                    var cv = f64_abs(ganita_mat_get(a, i, rc2));
                    if (p > i) {
                        var vp = f64_abs(ganita_mat_get(a, i, p));
                        if (f64_gt(vp, cv) == 1) {
                            cv = vp;
                            rc2 = p;
                        }
                    }
                    if (q > i) {
                        var vq = f64_abs(ganita_mat_get(a, i, q));
                        if (f64_gt(vq, cv) == 1) {
                            cv = vq;
                            rc2 = q;
                        }
                    }
                    store64(rmax + i * 8, rc2);
                }
            }
            i = i + 1;
        }

        iter = iter + 1;
    }

    # Didn't converge — still extract what we have, but SAY so. -3 per the
    # module vocabulary; this was -1 through 1.2.2.
    i = 0;
    while (i < n) {
        store64(out_vals + i * 8, ganita_mat_get(a, i, i));
        i = i + 1;
    }
    return 0 - 3;
}
# SVD by QR-PRECONDITIONED ONE-SIDED JACOBI (1.2.12).
# For m×n matrix A (m >= n):  A = U * diag(sigma) * V^T
# out_u: m×n matrix (caller allocates).
# out_sigma: flat f64 array of length n (singular values, descending, never negative).
# out_vt: n×n matrix (caller allocates, V transposed).
# Returns 0 on success, -1 if the working allocation fails, -2 for a null argument, for m < n,
# for a mis-shaped out-param, or for a NaN or infinite entry in A (1.2.12), and -3 if the Jacobi
# sweeps do not converge (1.2.12). NOTHING IS WRITTEN TO THE OUT-PARAMS ON ANY NON-ZERO STATUS:
# -2 is decided before any work, -1 by the one allocation, and -3 before the output pass. A
# sigma that is exactly 0 (also one too small to represent once unscaled) gets an all-zero
# column in U; every other column of U is a unit vector orthogonal to the rest, a subnormal
# sigma's included (1.2.12: at most 5.9 u from orthonormal over the corpus, the adversarial set
# and the _linalg_svd_reorth hunt listed below).
#
# ⚠ A sigma_1 within a few ulps of DBL_MAX can come back +inf. sigma is unscaled in one rounding
# from a value carrying the usual error of a few ulps, and past DBL_MAX that rounding is to
# +inf. Every floating-point SVD has this edge. Of 563 matrices built with sigma_1 near DBL_MAX,
# 7 came back +inf, and 1.2.11 had kept 4 of those finite (exact 0x7FEFFFFFFFFFFFFE: 1.2.11
# ...FD, 1.2.12 +inf).
#
# ⚠ NON-CONVERGENCE IS -3 AS OF 1.2.12. Through 1.2.11 it was folded into -1, the code ADR 0001
# reserves for allocation failure, and it was not rare: square matrices with a zero or repeated
# row, column pairs that needed a very small rotation and a rounding-level two-cycle all came
# back -1 (docs/development/issues/archived/2026-10-03-mat-svd-no-convergence-on-tiny-columns.md).
# NO FINITE INPUT IS KNOWN TO REACH -3 NOW — a measurement, not a proof (2026-10-04).
# scripts/svdh rebuilds the corpus, the adversarial sets, the hunt and the d1hunt families below;
# the row-graded study and the 2^20×5 run were one-off scripts, and the sweep counts came from
# an instrumented build:
#   - the 20,622-matrix exact-oracle corpus built for that filing: all 20,604 finite ones
#     decompose and pass, in at most 7 sweeps (mean 2.3), and the 18 non-finite ones are -2;
#   - 3,809 adversarial matrices (scripts/svdh/adv): all pass, in at most 10 sweeps;
#   - 819,998 matrices hunted in families aimed at each failure branch (rounding cycles,
#     integer ties, tall near-orthogonal columns, grading across the whole range, subnormal
#     rows; scripts/svdh/adv/hunt_all.sh): all status 0;
#   - row-graded D·B, 30×30 to 200×200 and 2× and 4× tall, over 100 to 1,000 binades: 181 of
#     them, at most 6 sweeps (unpreconditioned Jacobi takes 15 to 100 and more on these);
#   - 2,275 matrices aimed at _linalg_svd_reorth (largest entry near DBL_MAX, sigma near or
#     below DBL_MIN, up to 4096×5; scripts/svdh/tools/d1hunt.py), and three 2^20×5 built the
#     same way: all status 0.
# The cap stays at 60 sweeps, so that a case nobody has found still stops.
#
# ⚠ NO A^T A IS FORMED (1.2.4). Through 1.2.3 this eigendecomposed A^T·A, which
# is the easy construction and carries the textbook cost: cond(A^T A) = cond(A)².
# Half the available precision was spent before the eigensolver started, so
# `rank` and `condition` began lying above cond ≈ 4e8 — while `det` and `inv`,
# which go through LU and never form the product, got the SAME matrix right. The
# library disagreed with itself. `condition` also returned NaN — its documented
# allocation-failure sentinel — for a perfectly conditioned matrix whose entries
# merely overflowed when squared.
#
# THE ALGORITHM (1.2.12) is Drmač and Veselić's preconditioned Jacobi SVD (LAPACK dgejsv, whose
# Jacobi is dgesvj):
#   1. Scale A by a power of two, 2^s, so its largest entry sits near the top of the range.
#   2. Householder QR with column and row pivoting:  A·P1 = Q1·R1.
#   3. For n >= 4, the same factorisation of the n×n R1^T:  R1^T·P2 = Q2·R2, and X = R2^T.
#      For n <= 3, X = R1^T.
#   4. One-sided Jacobi on the columns of X until every pair is orthogonal:
#      X·Z = W·diag(sigma), Z the product of the rotations, W's columns X's normalised.
# For n >= 4, A = (Q1·[P2·W; 0])·diag(sigma)·(P1·Q2·Z)^T: U is built from normalised columns, so
# a zero sigma keeps its zero U column, and V is a product of reflectors and rotations, so it is
# orthogonal whatever the data. A column of X whose entries are all subnormal in the working copy
# is the exception: its U column is made orthonormal to the others explicitly (_linalg_svd_reorth).
# For n <= 3, A = (Q1·[Z; 0])·diag(sigma)·(P1·W)^T: U is the product, with a zero sigma's column
# zeroed, and V the normalised columns, a zero or all-subnormal one completed to an orthonormal
# basis (_linalg_svd_complete). With want_uv = 0 only X and its rotations are computed, by the
# same arithmetic, so status and sigma are the same bits.
#
# WHY QR FIRST. Through 1.2.11 this was one-sided Jacobi on A itself. Rank deficiency then had
# to be found by the rotations, which wore one column down to a rounding residue confined to the
# span of the others, so it stayed nearly parallel to its partner and rotated forever (the zero-
# row 3×3 kept a cosine above 0.9999 for ten sweeps). Pivoted QR puts the deficiency in the
# trailing rows of R instead, and pivoting guarantees |R_ii| >= |R_ij|, so the last row's
# cosine with any other row is at most 1/sqrt(2): what the Jacobi sees is a small column, not a
# near-parallel remainder. And for n >= 4, X^T·X = R2·R2^T is far closer to diagonal than A^T·A —
# two steps of the QR iteration — so the sweeps that remain are few, on an n×n matrix, not m×n.
#
# ONE QR FOR n <= 3. The second QR is there to bring X^T·X closer to diagonal, so fewer sweeps
# remain. With one to three pairs there is little to save, and its fixed cost was most of what
# 1.2.12 added to the 3×3 values-only call (1.24× to 1.29× 1.2.11's time with it in two runs,
# 1.15× without, pinned and interleaved). R1^T keeps the property that matters for a null column (its last column
# meets any other at a cosine of at most 1/sqrt(2)), and the corpus's n <= 3 matrices take 1.45
# sweeps on average. What it costs is that V, not U, comes from normalised columns: a zero
# column is completed, and so is one whose entries are all subnormal (see _linalg_svd_impl).
#
# THE FILING'S FOUR BRANCHES, AND WHAT CLOSES EACH NOW:
#   1. zeta² overflowed, t became 0, and an identity "rotation" counted as progress, forever.
#      zeta is formed from the scaled sums and never squared above 2^27, where t = 1/(2 zeta)
#      and c = 1 are what they are to working precision; past an exponent gap of 500 it is not
#      formed at all (regime B, _linalg_svd_rot); and a rotation that changes no bit of X is not
#      progress. The 4,296-matrix scan of the filing's A(t) family converges in at most 2 sweeps.
#   2. alpha·beta underflowed, and the orthogonality threshold with it. Each column of a pair is
#      multiplied by a power of two near its own largest entry, exactly, so the test is a cosine
#      at every magnitude, and near the subnormal range it gains an absolute floor
#      (_linalg_svd_sweep).
#   3. A null column stayed nearly parallel to its partner inside the span of the others. The
#      pivoted QR (above) turns it into a small trailing column. All 5,000 zero- and
#      repeated-row squares of the corpus, 2×2 to 10×10, converge, in at most 6 sweeps.
#   4. A two-cycle at rounding level: the full-rank 5×4's gamma flipped sign at a fixed
#      magnitude just above the 2^-52 threshold. tol is now sqrt(n)·2^-52, and DGESVJ's second
#      stopping test ends a sweep whose cosines were all at rounding level and whose rotations
#      were too small to disturb anything (_linalg_svd_impl). The 5×4 converges in 4 sweeps at
#      all four of the filing's scales; the second test ends the iteration of 198 corpus
#      matrices.
# And one the filing did not list: two columns that are both subnormal cannot be made orthogonal
# to a relative tolerance at all, since their rounding is absolute. That is the floor in 2.
#
# WHERE THIS IS NOT DGEJSV / DGESVJ LINE FOR LINE, deliberately:
#   - One exact power-of-two scaling of all of A to the top of the range, not dgejsv's column
#     norms through dlassq and its rescaling only near overflow; sigma is unscaled once.
#   - Row pivoting at every step of each QR (the pivot column's largest entry to the diagonal,
#     Powell and Reid), not dgejsv's optional single sort of the rows by norm (JOBP = 'P').
#   - No truncation of R1's negligible trailing rows, no condition estimate and none of its
#     A^T·A or LQ variants: the full n×n R goes to the Jacobi, which finds small columns itself.
#   - The second QR only for n >= 4, always column-pivoted; n <= 3 runs the Jacobi on R1^T.
#   - Pivot norms downdated as dlaqp2 does and recomputed below 2^-26 (tol3z). Every sum over an
#     m-row column (norms, reflector tails, reflector dots) and every final norm is pairwise
#     (_linalg_svd_ssq); the Jacobi's own n-term sums are plain.
#   - The Jacobi: plain row-cyclic order, without dgesvj's de Rijk pivoting or its cache tiles;
#     plain rotations, not its scaled fast ones; each column scaled by the power of two of its
#     own largest entry, where dgesvj tracks norms (SVA) and refreshes them through dlassq; the
#     cosine tested squared against tol = sqrt(n)·2^-52, with 2^-52 for eps where dlamch gives
#     2^-53; t = 1/(2 zeta) from |zeta| > 2^27, where dgsvj0 switches at 1/sqrt(eps); c and s
#     with one division; pairs between 2^-52 and tol rotated but not counted as progress;
#     regime B at an exponent gap of 500, where dgsvj0 makes its Gram-Schmidt step at a norm
#     ratio of SFMIN/eps; and two guards dgesvj does not have, the absolute subnormal floor and
#     "a rotation that changed no bit is no progress".
#   - The second stopping test is dgesvj's, from sweep 2, except that a pair the test left alone
#     enters max|cos| as its bound 2^-52, not its measured cosine.
#   - U is normalised after Q1 is applied, and each sigma comes from a fresh pairwise norm of
#     its final column.
#
# HOW OFTEN EACH SPECIAL BRANCH FIRES on the 20,622-matrix corpus (2026-10-04), so a reader can
# tell the load-bearing ones from the guards. t = 1/(2 zeta): 67,217 of 308,980 rotations, in
# 8,516 matrices. Rotations between 2^-52 and tol: 3,553 in 1,938. The second stopping test:
# 198 matrices. V completion (n <= 3): 1,765 columns in 1,759 matrices. sigma through ldexp's
# single rounding: 4,811; the second scaling factor (A's largest entry below 2^-(3+kk)): 2,325
# matrices. Regime B: 63 projections in 61 matrices, all with n <= 3 (318 more in the
# adversarial set; none with n >= 4 in either). The subnormal floor: formed 6 times, changing no
# decision — no corpus input needs it; in the adversarial set it changes 94 decisions, and one
# 5×4 there (first column near 2^1000, the other three between 2^-1047 and 2^-1040) returns -3
# without it. "No bit changed": never, in either set — a guard. _linalg_svd_reorth: no corpus
# matrix, 12 adversarial ones (1.7e6 u from orthonormal before it, 1.3 u after).
# Inputs that reach the rare ones end to end: [[1, 1], [0, 2^-1060]] takes regime B (sigma_2 is
# exactly 2^-1060.5 rounded, 0x2D41; without regime B it came back 0), and that 5×4 the floor.
#
# WHY THE TOP OF THE RANGE. Through 1.2.11 A was divided by its largest entry, which rounded
# every entry and left anything 2^-1022 below the largest one subnormal, with a few bits. A U
# column computed from such a column had a few bits too. Nothing here squares an entry, so
# the only headroom needed above the largest entry is the growth of a norm, sqrt(m·n), and
# placing it there keeps over 2000 binades of full precision beneath it: a sigma down to about
# 2^-2000 of the largest entry gets a U column computed to full precision, and the dot products
# of graded columns no longer underflow (1.2.11 returned 0 for one graded 5×4 with two U columns
# at cosine 0.99999999). Below that, X's column is subnormal; see _linalg_svd_reorth.
fn ganita_mat_svd(m, out_u, out_sigma, out_vt): i64 {
    if (out_u == 0 || out_vt == 0) { return 0 - 2; }
    if (m != 0) {
        if (ganita_mat_rows(out_u) != ganita_mat_rows(m)) { return 0 - 2; }
        if (ganita_mat_cols(out_u) != ganita_mat_cols(m)) { return 0 - 2; }
        if (ganita_mat_rows(out_vt) != ganita_mat_cols(m)) { return 0 - 2; }
        if (ganita_mat_cols(out_vt) != ganita_mat_cols(m)) { return 0 - 2; }
    }
    return _linalg_svd_impl(m, out_u, out_sigma, out_vt, 1, 0);
}

# 2^j for -1074 <= j <= 1023, as its exact bit pattern (a subnormal below -1022).
fn _linalg_svd_pow2(j): i64 {
    if (j >= 0 - 1022) { return (j + 1023) << 52; }
    return 1 << (j + 1074);
}

# The exponent a value is scaled by: floor(log2 |x|), held to >= -1022 so 2^-e is representable.
# For a subnormal x that only leaves x·2^-e below 1 rather than in [1, 2) — still exact.
fn _linalg_svd_expo(x): i64 {
    var bx = (x >> 52) & 0x7FF;
    if (bx == 0) { return 0 - 1022; }
    return bx - 1023;
}

# x·2^e rounded ONCE, for a normal (or zero) x and any e. A power-of-two factor is exact unless
# the result leaves the normal range, and leaving it in two steps would round twice.
fn _linalg_svd_ldexp(x, e): i64 {
    if ((x & 0x7FFFFFFFFFFFFFFF) == 0) { return x; }
    var k = e + ((x >> 52) & 0x7FF) - 1023;
    if (k > 1023) { return (x & 0x8000000000000000) | 0x7FF0000000000000; }
    if (k >= 0 - 1022) { return (x & 0x800FFFFFFFFFFFFF) | ((k + 1023) << 52); }
    if (k < 0 - 1076) { return x & 0x8000000000000000; }
    # x's mantissa / 4, times 2^(k+2): the product is exact before its one rounding.
    return f64_mul((x & 0x800FFFFFFFFFFFFF) | 0x3FD0000000000000, _linalg_svd_pow2(k + 2));
}

# |x| for x[0..len), for the pivoting. Like _linalg_norm2 it never forms a raw sum of squares,
# which over- and underflows for representable norms, but it scales by 2^-e (e the largest
# entry's exponent), a multiplication that is exact, instead of dividing every entry by the
# largest one. The largest entry is found by comparing magnitude bits as integers, which orders
# finite doubles exactly as their values (every working value here is finite).
fn _linalg_svd_nrm(x, len): i64 {
    var mx = 0;
    var i = 0;
    while (i < len) {
        var ax = load64(x + i * 8) & 0x7FFFFFFFFFFFFFFF;
        if (ax > mx) { mx = ax; }
        i = i + 1;
    }
    if (mx == 0) { return mx; }
    # e and the factors 2^-e, 2^e as bit patterns; every working value is below 2^1022, so
    # e <= 1021 and both factors are normal.
    var e = ((mx >> 52) & 0x7FF) - 1023;
    if (e < 0 - 1022) { e = 0 - 1022; }
    var f = (1023 - e) << 52;
    return f64_mul(f64_sqrt(_linalg_svd_ssq(x, len, f, 0)), (e + 1023) << 52);
}

# The sum of (x_i·f)² over x[0..len), PAIRWISE (1.2.12); with put = 1 each x_i·f is also stored
# back into x_i. Every sum of len terms in the SVD — a column norm, a reflector's tail, a sigma —
# goes through this or _linalg_svd_dot, because a sum taken one term after another carries a
# rounding error up to len·2^-53 of its size, and on tall input that is the whole answer. With
# such sums the first 1.2.12 draft returned, for a 4096×2 with every row (1, 2) — rank 1, sigma_2
# exactly 0, which 1.2.11 got exactly — sigma_2 at 104 u·sigma_1 and U's columns 565 u from
# orthogonal, and for 65536 rows of (0.1, 0.7) sigma_1 2889 u off (1.2.11 returned -1 for that
# one). Halving the range until 16 terms are left bounds the error by
# (15 + log2(len/16))·2^-53 with the same flops and no scratch. PAIRWISE rather than blocked
# (fixed blocks of B, then a sum of the block sums): that is (B + len/B)·2^-53, which still grows
# with len. Up to 16 terms it is the plain loop, so a short sum keeps its bits.
fn _linalg_svd_ssq(x, len, f, put): i64 {
    if (len > 16) {
        var h = len / 2;
        return f64_add(_linalg_svd_ssq(x, h, f, put), _linalg_svd_ssq(x + h * 8, len - h, f, put));
    }
    var s = f64_from(0);
    var i = 0;
    while (i < len) {
        var t = f64_mul(load64(x + i * 8), f);
        if (put == 1) { store64(x + i * 8, t); }
        s = f64_add(s, f64_mul(t, t));
        i = i + 1;
    }
    return s;
}

# The dot product of a[0..len) and b[0..len), pairwise for the reason given at _linalg_svd_ssq.
fn _linalg_svd_dot(a, b, len): i64 {
    if (len > 16) {
        var h = len / 2;
        return f64_add(_linalg_svd_dot(a, b, h), _linalg_svd_dot(a + h * 8, b + h * 8, len - h));
    }
    var s = f64_from(0);
    var i = 0;
    while (i < len) {
        s = f64_add(s, f64_mul(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return s;
}

# Householder reflector in place: x[0..len) becomes the unit v of H = I - 2·v·v^T, and the return
# is r with H·x = r·e_1 — |r| = |x|, opposite in sign to x[0], as in ganita_mat_qr. mx is the
# largest |x_i|, which the caller's row pivoting has just found. A zero x stays zero, which makes
# H the identity. x is first multiplied by 2^-e for mx's exponent e, which is exact and puts every
# sum of squares below in [1, 4·len): no over- or underflow, and a tiny or subnormal x still
# yields a v of unit length, so H stays orthogonal at every magnitude. |v|² = v_0² + (the tail's
# sum of squares) reuses the tail sum, so it takes two passes.
fn _linalg_svd_house(x, len, mx): i64 {
    if (mx == 0) { return mx; }
    var i = 0;
    if (len == 1) {
        # One entry needs no reflection: H = I (a zero v) and r = x_0. R's diagonal signs are free.
        var r1 = load64(x);
        store64(x, f64_from(0));
        return r1;
    }
    # sh = -e for mx's exponent e (held to >= -1022, see _linalg_svd_expo), and f = 2^sh.
    var sh = 1023 - ((mx >> 52) & 0x7FF);
    if (sh > 1022) { sh = 1022; }
    var f = (sh + 1023) << 52;
    var x0 = f64_mul(load64(x), f);
    var tl = _linalg_svd_ssq(x + 8, len - 1, f, 1);
    var xn = f64_sqrt(f64_add(f64_mul(x0, x0), tl));
    var r = xn;
    var v0 = f64_sub(x0, xn);
    if (f64_gt(x0, f64_from(0)) == 1) {
        v0 = f64_add(x0, xn);
        r = f64_neg(xn);
    }
    var vn = f64_sqrt(f64_add(f64_mul(v0, v0), tl));
    store64(x, f64_div(v0, vn));
    i = 1;
    while (i < len) {
        store64(x + i * 8, f64_div(load64(x + i * 8), vn));
        i = i + 1;
    }
    # sh < 1000 means mx was normal, so |r| >= 1 and r·2^-sh is normal and exact; otherwise R_kk
    # may be subnormal and ldexp rounds it once.
    if (sh < 1000) { return f64_mul(r, (1023 - sh) << 52); }
    return _linalg_svd_ldexp(r, 0 - sh);
}

# y := (I - 2·v·v^T)·y for the len-vector y. A zero v (an identity reflector) is skipped.
fn _linalg_svd_reflect(v, y, len): i64 {
    if ((load64(v) & 0x7FFFFFFFFFFFFFFF) == 0) { return 0; }
    var dot = _linalg_svd_dot(v, y, len);
    dot = f64_add(dot, dot);
    var i = 0;
    while (i < len) {
        store64(y + i * 8, f64_sub(load64(y + i * 8), f64_mul(dot, load64(v + i * 8))));
        i = i + 1;
    }
    return 0;
}

# Householder QR with column AND row pivoting, in place on the column-major mr×nc array a
# (mr >= nc): A·P = Q·R. R's diagonal goes to rd, its strict upper triangle stays in a; the
# unit reflector of step k fills column k from the diagonal down; piv[k] is the original index
# of the column now at k, and rp[k] the row that step k swapped with row k before its reflector,
# so Q = Pi_0·H_0·Pi_1·H_1···Pi_{nc-1}·H_{nc-1}.
#
# Each step takes the remaining column of largest norm, which is what makes |R_kk| >= |R_kj| and
# pushes any rank deficiency into the trailing rows. Then it brings that column's largest entry to
# the diagonal (Powell and Reid's row pivoting). Without that a reflector mixes a tiny row into a
# huge one and leaves the tiny row an error the size of the huge one: [[0, 5e-292], [3e-260,
# -6e-279]] lost three digits of its sigma_2. With it the factorisation is backward stable row by
# row (Cox and Higham), as the rotations of the Jacobi that follows already are.
#
# The remaining norms are downdated rather than recomputed (LAPACK dlaqp2): after step k a column
# norm loses R_kj², and when that cancels below sqrt(eps) of the last exact value (vn2) it is
# taken again from the entries — the downdate's error would otherwise steer the pivoting.
fn _linalg_svd_qrcp(a, mr, nc, rd, piv, rp, vn1, vn2): i64 {
    var i = 0;
    var j = 0;
    while (j < nc) {
        store64(piv + j * 8, j);
        var cn = _linalg_svd_nrm(a + j * mr * 8, mr);
        store64(vn1 + j * 8, cn);
        store64(vn2 + j * 8, cn);
        j = j + 1;
    }
    var k = 0;
    while (k < nc) {
        var pv = k;
        j = k + 1;
        while (j < nc) {
            if (f64_gt(load64(vn1 + j * 8), load64(vn1 + pv * 8)) == 1) { pv = j; }
            j = j + 1;
        }
        if (pv != k) {
            i = 0;
            while (i < mr) {
                var t = load64(a + (k * mr + i) * 8);
                store64(a + (k * mr + i) * 8, load64(a + (pv * mr + i) * 8));
                store64(a + (pv * mr + i) * 8, t);
                i = i + 1;
            }
            var tp = load64(piv + k * 8);
            store64(piv + k * 8, load64(piv + pv * 8));
            store64(piv + pv * 8, tp);
            store64(vn1 + pv * 8, load64(vn1 + k * 8));
            store64(vn2 + pv * 8, load64(vn2 + k * 8));
        }
        var rk = k;
        var rmx = load64(a + (k * mr + k) * 8) & 0x7FFFFFFFFFFFFFFF;
        i = k + 1;
        while (i < mr) {
            var ar = load64(a + (k * mr + i) * 8) & 0x7FFFFFFFFFFFFFFF;
            if (ar > rmx) {
                rk = i;
                rmx = ar;
            }
            i = i + 1;
        }
        store64(rp + k * 8, rk);
        if (rk != k) {
            j = k;
            while (j < nc) {
                var t2 = load64(a + (j * mr + k) * 8);
                store64(a + (j * mr + k) * 8, load64(a + (j * mr + rk) * 8));
                store64(a + (j * mr + rk) * 8, t2);
                j = j + 1;
            }
        }
        var len = mr - k;
        var v = a + (k * mr + k) * 8;
        store64(rd + k * 8, _linalg_svd_house(v, len, rmx));
        j = k + 1;
        while (j < nc) {
            var y = a + (j * mr + k) * 8;
            _linalg_svd_reflect(v, y, len);
            # Only the pivoting reads these norms, and the last step has a single candidate.
            var cn1 = load64(vn1 + j * 8);
            if (cn1 != 0 && k < nc - 2) {
                var rr = f64_div(f64_abs(load64(y)), cn1);
                var tt = f64_sub(f64_from(1), f64_mul(rr, rr));
                if (f64_lt(tt, f64_from(0)) == 1) { tt = f64_from(0); }
                var qq = f64_div(cn1, load64(vn2 + j * 8));
                # 2^-26, about sqrt(eps): LAPACK's tol3z.
                if (f64_le(f64_mul(tt, f64_mul(qq, qq)), 0x3E50000000000000) == 1) {
                    var cn2 = f64_from(0);
                    if (len > 1) { cn2 = _linalg_svd_nrm(y + 8, len - 1); }
                    store64(vn1 + j * 8, cn2);
                    store64(vn2 + j * 8, cn2);
                } else {
                    store64(vn1 + j * 8, f64_mul(cn1, f64_sqrt(tt)));
                }
            }
            j = j + 1;
        }
        k = k + 1;
    }
    return 0;
}

# y := Q·y for the column-major mr×ny array y, with Q from _linalg_svd_qrcp's a and rp.
fn _linalg_svd_apply_q(a, mr, nc, rp, y, ny): i64 {
    var k = nc - 1;
    while (k >= 0) {
        var rk = load64(rp + k * 8);
        var j = 0;
        while (j < ny) {
            var yc = y + j * mr * 8;
            _linalg_svd_reflect(a + (k * mr + k) * 8, yc + k * 8, mr - k);
            if (rk != k) {
                var t = load64(yc + k * 8);
                store64(yc + k * 8, load64(yc + rk * 8));
                store64(yc + rk * 8, t);
            }
            j = j + 1;
        }
        k = k - 1;
    }
    return 0;
}

# The transpose of the n×n upper triangle that _linalg_svd_qrcp left in a (leading dimension
# mr) and rd, into the column-major n×n array t: column j of t is row j of R. When ce != 0, each
# column's scaling for the Jacobi is recorded there as well (_linalg_svd_cf).
fn _linalg_svd_rt(a, mr, rd, n, t, ce): i64 {
    var j = 0;
    while (j < n) {
        var mx = 0;
        var i = 0;
        while (i < n) {
            var e = f64_from(0);
            if (i == j) { e = load64(rd + j * 8); }
            if (i > j) { e = load64(a + (i * mr + j) * 8); }
            store64(t + (j * n + i) * 8, e);
            if ((e & 0x7FFFFFFFFFFFFFFF) > mx) { mx = e & 0x7FFFFFFFFFFFFFFF; }
            i = i + 1;
        }
        if (ce != 0) { store64(ce + j * 8, _linalg_svd_cf(mx)); }
        j = j + 1;
    }
    return 0;
}

# The Jacobi's scaling of a column whose largest |entry| has the bits mx: 2^-e for mx's exponent
# e (held to >= -1022, as in _linalg_svd_expo), or 0 for an all-zero column. e itself is 1023 minus
# the factor's exponent field.
fn _linalg_svd_cf(mx): i64 {
    if (mx == 0) { return 0; }
    var bx = (mx >> 52) & 0x7FF;
    if (bx == 0) { bx = 1; }
    return (2046 - bx) << 52;
}

# One cyclic sweep of the one-sided Jacobi over every pair of columns of the column-major n×n
# array x, in row-cyclic order. Returns the number of rotations that were PROGRESS: the pair's
# cosine was above `tol` and the rotation changed x. 0 means every pair is orthogonal to tol, or
# that no rotation the arithmetic can express is left. ce holds each column's scaling (see
# _linalg_svd_cf); a zero column is orthogonal to all. st (two words) receives what the stopping
# rule in _linalg_svd_impl reads: st[0] the largest squared cosine of the sweep, st[1] the
# largest |sin| of a rotation it made.
#
# Each column is multiplied by 2^-e, e the exponent of its own largest entry, before alpha, beta
# and gamma are formed. That is exact, puts both sums of squares in [1, 4n) (below 1 only for a
# column whose largest entry is subnormal), and so the test is a cosine whatever the two
# magnitudes — through 1.2.11 alpha·beta underflowed to 0 for a column below about 2^-537 and the
# threshold went with it. The cosine is tested squared, gamma'² > tol²·alpha'·beta', with no root.
#
# ⚡ A PAIR IS ROTATED ABOVE 2^-52, BUT IT IS PROGRESS ONLY ABOVE tol (1.2.12). With
# tol = sqrt(n)·2^-52 the sweeps stop with cosines up to tol, and U's orthogonality is then
# about tol itself, 6.3 u at 40×40. So a pair between 2^-52 and tol is rotated too — a rotation
# by at most about tol, which costs one pass over two columns — but does not count: whether the
# iteration has converged is still decided at tol, so this cannot keep a rounding-level cycle
# alive. With it and U normalised after Q1 (see _linalg_svd_impl), 40×40 random gives U to 2.4 u
# on average and about 4 u at worst (3.9 u over 15 matrices, 4.06 u over 30 more), against 6.9 u
# with neither. It fires 3,553 times in 1,938 of the 20,622 test-corpus matrices.
#
# The stopping rule's largest cosine is measured for every pair that is rotated. A pair the test
# leaves alone has |cos| <= 2^-52, and that bound stands in for its measured value (one division
# a pair saved, and the rule only gets stricter); a pair the floor below leaves alone is measured.
#
# ⚠ NEAR THE SUBNORMAL RANGE THE TEST GAINS AN ABSOLUTE FLOOR (1.2.12). There an entry's rounding
# error is up to 2^-1075, not a fraction of the entry, so two columns that are both subnormal
# cannot be made more orthogonal than that absolute error allows. A pure cosine test then asked
# for more than the arithmetic delivers and rotated forever: a 7×6 with entries from 5e-324 to
# 5e292 ended with two all-subnormal columns of X at cosine 2^-46.8, and every rotation rounded
# back to the same bits. In scaled terms column p's entries carry an error of fp·2^-1075 each, so
# by Cauchy-Schwarz gamma' moves by up to fp·2^-1075·sqrt(n)·sqrt(beta'), and the same with p and
# q exchanged. The floor is n·2^-1074·(fp·sqrt(beta') + fq·sqrt(alpha')), that bound with a factor
# 2·sqrt(n) to spare, added to both thresholds. It is n·2^-1074 on its own, NOT derived from tol:
# the first 1.2.12 draft wrote it tol·2^-1022, which was n·2^-1074 only while tol was n·2^-52.
# Relative to the cosine term it is sqrt(n)·2^-1022·(fp/sqrt(alpha') + fq/sqrt(beta')) — under
# 2^-54 of it for any n the element cap allows, unless a column's largest entry is below 2^-960
# (factor above 2^960) — so only then is it formed, with its two square roots, and only for a
# pair the plain test would rotate, since the floor can only raise the threshold. n·2^-1074 is
# multiplied by each factor first: fp·sqrt(beta') alone overflows (fp reaches 2^1022, beta' 4n).
# Without the floor, one 5×4 of the adversarial set (first column near 2^1000, the others between
# 2^-1047 and 2^-1040) returns -3; with it the floor is formed 331 times and changes 94 decisions
# in that set of 3,809, and is formed 6 times, changing none, in the 20,622-matrix corpus.
#
# What the floor leaves is orthogonal only to that absolute error, which for a column whose
# entries are all subnormal can be a cosine near 1. For n <= 3 such a column of X becomes V's,
# and is completed (_linalg_svd_complete); for n >= 4 it becomes U's, and _linalg_svd_reorth
# makes it orthonormal to the others.
fn _linalg_svd_sweep(x, n, z, ce, tol, st): i64 {
    var tol2 = f64_mul(tol, tol);
    var mxc2 = 0;
    var left = 0;
    store64(st + 8, 0);
    var moved = 0;
    var p = 0;
    while (p < n - 1) {
        var xp = x + p * n * 8;
        var fp = load64(ce + p * 8);
        var q = p + 1;
        while (q < n) {
            var fq = load64(ce + q * 8);
            if (fp != 0 && fq != 0) {
                var xq = x + q * n * 8;
                var al = f64_from(0);
                var be = f64_from(0);
                var ga = f64_from(0);
                var i = 0;
                while (i < n) {
                    var sp = f64_mul(load64(xp + i * 8), fp);
                    var sq = f64_mul(load64(xq + i * 8), fq);
                    al = f64_add(al, f64_mul(sp, sp));
                    be = f64_add(be, f64_mul(sq, sq));
                    ga = f64_add(ga, f64_mul(sp, sq));
                    i = i + 1;
                }
                var ga2 = f64_mul(ga, ga);
                var ab = f64_mul(al, be);
                # |cos| > 2^-52 (0x3970000000000000 is 2^-104, its square): the pair is rotated.
                if (f64_gt(ga2, f64_mul(0x3970000000000000, ab)) == 1) {
                    # big: |cos| > tol as well, so that rotation is progress.
                    var big = f64_gt(ga2, f64_mul(tol2, ab));
                    var pol = 1;
                    if (fp > 0x7BF0000000000000 || fq > 0x7BF0000000000000) {
                        # n·2^-1074 is the subnormal whose bits are n, exactly (n < 2^52).
                        var fl = f64_add(f64_mul(f64_mul(n, fp), f64_sqrt(be)), f64_mul(f64_mul(n, fq), f64_sqrt(al)));
                        var sab = f64_sqrt(ab);
                        pol = f64_gt(f64_abs(ga), f64_add(f64_mul(_LINALG_MACH_EPS, sab), fl));
                        big = f64_gt(f64_abs(ga), f64_add(f64_mul(tol, sab), fl));
                    }
                    # The stopping rule's largest cosine, squared. Squares are never negative, so
                    # they compare as integers.
                    var c2 = f64_div(ga2, ab);
                    if (c2 > mxc2) { mxc2 = c2; }
                    if (pol == 1) {
                        if (_linalg_svd_rot(x, n, z, ce, p, q, al, be, ga, st) == 1) { moved = moved + big; }
                        fp = load64(ce + p * 8);
                    }
                } else {
                    left = 1;
                }
            }
            q = q + 1;
        }
        p = p + 1;
    }
    # A pair the plain test left alone has |cos| <= 2^-52, and that bound stands in for it.
    if (left == 1 && mxc2 < 0x3970000000000000) { mxc2 = 0x3970000000000000; }
    store64(st, mxc2);
    return moved;
}

# The Jacobi rotation of columns p and q of x (and of z when z != 0) that makes them orthogonal,
# from their scaled sums alpha', beta', gamma' (see _linalg_svd_sweep); ce is kept current.
# Returns 1 if it changed a bit of x, else 0, and raises st[1] to its |sin| when it did.
#
# ⚠ A ROTATION THAT CHANGES NO BIT OF X IS NOT PROGRESS (1.2.12). When c·x_p - s·x_q rounds back
# to x_p and s·x_p + c·x_q to x_q in every row, the pair is exactly as it was and the next sweep
# will measure the same cosine and try the same rotation, forever: the filing's first branch was
# that loop (t underflowed to 0, the "rotation" was the identity, and it counted). So the sweep
# counts only rotations that moved x, and one that did not is not applied to z either — it was
# not performed. That is a guard, not the mechanism: it fires on no input of the corpus or the
# adversarial set; the subnormal floor and the stopping rule are what end such loops.
#
# zeta is formed from the scaled sums:
#   zeta = (beta - alpha) / (2 gamma) = (beta'·2^(eq-ep) - alpha'·2^(ep-eq)) / (2 gamma').
# When the exponents differ by more than 500 it is not formed: past 1023 the factors 2^(±de) are
# not doubles, and well before that beta'·2^de can overflow. It is not needed either: the
# rotation is then, to far below working precision, "remove from the small column its component
# along the large one" — the large column would move by under 2^-998 of itself and Z by under
# 2^-499 — so that projection is done directly (regime B; dgsvj0 switches to a Gram-Schmidt step
# for a column below 2^-970 of its partner for the same reason). Its |sin| for the stopping rule
# is taken as 2^-1022, as dgsvj0 does for that step. Only the n <= 3 path, whose X is R1^T, meets
# it: 63 projections in 61 corpus matrices, 318 in the adversarial set. After two pivoted QRs a
# pair 500 binades apart is orthogonal far beyond tol, and no tested input with n >= 4 reaches it.
fn _linalg_svd_rot(x, n, z, ce, p, q, al, be, ga, st): i64 {
    var fp = load64(ce + p * 8);
    var fq = load64(ce + q * 8);
    var ep = 1023 - ((fp >> 52) & 0x7FF);
    var eq = 1023 - ((fq >> 52) & 0x7FF);
    var xp = x + p * n * 8;
    var xq = x + q * n * 8;
    var i = 0;
    var de = eq - ep;
    if (de > 500 || de < 0 - 500) {
        # x_s -= (gamma / |x_b|²)·x_b for the small column s and the large one b, in scaled form.
        var xs = xp;
        var xb = xq;
        var es = ep;
        var fb = fq;
        var cs = p;
        var coef = f64_div(ga, be);
        if (de < 0) {
            xs = xq;
            xb = xp;
            es = eq;
            fb = fp;
            cs = q;
            coef = f64_div(ga, al);
        }
        var g = (es + 1023) << 52;
        var ms = 0;
        var mv = 0;
        i = 0;
        while (i < n) {
            var ov = load64(xs + i * 8);
            var nv = f64_sub(ov, f64_mul(f64_mul(coef, f64_mul(load64(xb + i * 8), fb)), g));
            store64(xs + i * 8, nv);
            if (nv != ov) { mv = 1; }
            if ((nv & 0x7FFFFFFFFFFFFFFF) > ms) { ms = nv & 0x7FFFFFFFFFFFFFFF; }
            i = i + 1;
        }
        store64(ce + cs * 8, _linalg_svd_cf(ms));
        if (mv == 1 && load64(st + 8) < 0x0010000000000000) { store64(st + 8, 0x0010000000000000); }
        return mv;
    }

    # 2^de and 2^-de as bit patterns: |de| <= 500 keeps both normal.
    var zeta = f64_div(f64_sub(f64_mul(be, (de + 1023) << 52), f64_mul(al, (1023 - de) << 52)), f64_add(ga, ga));
    var c = f64_from(1);
    var s = f64_from(0);
    if (f64_gt(f64_abs(zeta), 0x41A0000000000000) == 1) {
        # |zeta| > 2^27: sqrt(1 + zeta²) is |zeta| and c is 1 to working precision, so t = 1/(2 zeta).
        s = f64_div(0x3FE0000000000000, zeta);
    } else {
        # t = sign(zeta)/w with w = |zeta| + sqrt(1 + zeta²) >= 1, and 1 + t² = (w² + 1)/w², so
        # c = w/sqrt(w² + 1) and s = sign(zeta)/sqrt(w² + 1): one division instead of two.
        var w = f64_add(f64_abs(zeta), f64_sqrt(f64_add(f64_from(1), f64_mul(zeta, zeta))));
        var g2 = f64_div(f64_from(1), f64_sqrt(f64_add(f64_mul(w, w), f64_from(1))));
        c = f64_mul(w, g2);
        s = g2;
        if (f64_lt(zeta, f64_from(0)) == 1) { s = f64_neg(g2); }
    }
    # The new column maxima, as magnitude bits compared as integers (see _linalg_svd_nrm).
    var mp = 0;
    var mq = 0;
    var ch = 0;
    i = 0;
    while (i < n) {
        var wp = load64(xp + i * 8);
        var wq = load64(xq + i * 8);
        var np = f64_sub(f64_mul(c, wp), f64_mul(s, wq));
        var nq = f64_add(f64_mul(s, wp), f64_mul(c, wq));
        store64(xp + i * 8, np);
        store64(xq + i * 8, nq);
        ch = ch | (np ^ wp) | (nq ^ wq);
        if ((np & 0x7FFFFFFFFFFFFFFF) > mp) { mp = np & 0x7FFFFFFFFFFFFFFF; }
        if ((nq & 0x7FFFFFFFFFFFFFFF) > mq) { mq = nq & 0x7FFFFFFFFFFFFFFF; }
        i = i + 1;
    }
    if (ch == 0) { return 0; }
    store64(ce + p * 8, _linalg_svd_cf(mp));
    store64(ce + q * 8, _linalg_svd_cf(mq));
    var sa = s & 0x7FFFFFFFFFFFFFFF;
    if (sa > load64(st + 8)) { store64(st + 8, sa); }
    if (z != 0) {
        var zp = z + p * n * 8;
        var zq = z + q * n * 8;
        i = 0;
        while (i < n) {
            var vp = load64(zp + i * 8);
            var vq = load64(zq + i * 8);
            store64(zp + i * 8, f64_sub(f64_mul(c, vp), f64_mul(s, vq)));
            store64(zq + i * 8, f64_add(f64_mul(s, vp), f64_mul(c, vq)));
            i = i + 1;
        }
    }
    return 1;
}

# For n <= 3, where V is built from X's normalised columns (see ganita_mat_svd): each zero column
# of the column-major n×n x becomes a unit vector orthogonal to the others, which are unit and
# mutually orthogonal to the Jacobi's tolerance. ce marks the zero columns (0). A zero column is
# a sigma that is exactly 0, or one whose column the caller zeroed because it held only
# subnormal entries. n = 1 never has one: X is then the single entry R1_00, non-zero for a
# non-zero A. For n = 2 it is the other column turned by 90 degrees, for n = 3 with one zero
# column the cross product of the other two, and with two the axis the remaining column is least
# aligned with, minus its component along that column, then the cross product of the two.
fn _linalg_svd_complete(x, n, ce): i64 {
    var nz = 0;
    var a = 0 - 1;
    var b = 0 - 1;
    var z1 = 0 - 1;
    var z2 = 0 - 1;
    var j = 0;
    while (j < n) {
        if (load64(ce + j * 8) == 0) {
            if (z1 < 0) { z1 = j; } else { z2 = j; }
            nz = nz + 1;
        } else {
            if (a < 0) { a = j; } else { b = j; }
        }
        j = j + 1;
    }
    if (nz == 0) { return 0; }
    var xa = x + a * n * 8;
    if (n == 2) {
        store64(x + z1 * n * 8, f64_neg(load64(xa + 8)));
        store64(x + z1 * n * 8 + 8, load64(xa));
        return 0;
    }
    if (nz == 1) {
        _linalg_svd_cross(xa, x + b * n * 8, x + z1 * n * 8);
        return 0;
    }
    var e = 0;
    var m0 = load64(xa) & 0x7FFFFFFFFFFFFFFF;
    j = 1;
    while (j < 3) {
        if ((load64(xa + j * 8) & 0x7FFFFFFFFFFFFFFF) < m0) {
            e = j;
            m0 = load64(xa + j * 8) & 0x7FFFFFFFFFFFFFFF;
        }
        j = j + 1;
    }
    # |x_a[e]| <= 1/sqrt(3), so e_e - x_a[e]·x_a has length at least sqrt(2/3): no cancellation.
    var w1 = x + z1 * n * 8;
    var ae = load64(xa + e * 8);
    j = 0;
    while (j < 3) {
        var u = f64_neg(f64_mul(ae, load64(xa + j * 8)));
        if (j == e) { u = f64_add(f64_from(1), u); }
        store64(w1 + j * 8, u);
        j = j + 1;
    }
    _linalg_svd_unit(w1, 3);
    _linalg_svd_cross(xa, w1, x + z2 * n * 8);
    return 0;
}

# c := a × b, normalised, for 3-vectors that are unit and orthogonal to working precision.
fn _linalg_svd_cross(a, b, c): i64 {
    store64(c, f64_sub(f64_mul(load64(a + 8), load64(b + 16)), f64_mul(load64(a + 16), load64(b + 8))));
    store64(c + 8, f64_sub(f64_mul(load64(a + 16), load64(b)), f64_mul(load64(a), load64(b + 16))));
    store64(c + 16, f64_sub(f64_mul(load64(a), load64(b + 8)), f64_mul(load64(a + 8), load64(b))));
    _linalg_svd_unit(c, 3);
    return 0;
}

# v := v/|v| for a non-zero vector of moderate size (its sum of squares neither over- nor
# underflows).
fn _linalg_svd_unit(v, len): i64 {
    var s = f64_sqrt(_linalg_svd_ssq(v, len, 0x3FF0000000000000, 0));
    var i = 0;
    while (i < len) {
        store64(v + i * 8, f64_div(load64(v + i * 8), s));
        i = i + 1;
    }
    return 0;
}

# Column r of the column-major rows×cols y, made orthonormal to every column c with st[c] = 1
# (unit and mutually orthogonal): two passes of modified Gram-Schmidt, then normalised. Twice is
# enough unless the column was numerically in their span; when it keeps less than half its length
# it starts again from the coordinate axis e_i those columns cover least. Their squares sum to at
# most cols - 1 < rows over all of y, so some row has a sum of at most (cols - 1)/rows, and e_i
# keeps at least sqrt(1/rows) of its length.
#
# ⚠ FOR n >= 4 A U COLUMN FROM AN ALL-SUBNORMAL COLUMN OF X COMES HERE (1.2.12). When A's largest
# entry is near DBL_MAX the working copy is scaled DOWN, by up to 2^(3+kk), and a sigma within
# about 3+kk binades above 2^-1022 then has a column of X whose entries are all subnormal: few
# bits, and orthogonal to the others only to the subnormal floor's absolute error
# (_linalg_svd_sweep). U, built from X's columns, inherited that. The first 1.2.12 draft gave U
# 530 u from orthonormal on a 4096×4 that 1.2.11 passed, and 5e4 u on a 2^20×5; with this, 1.4 u.
# Such a sigma is below sqrt(n)·2^(kk-2042) of sigma_1, so any unit vector orthogonal to the rest
# is as good normwise, and this one keeps as much of x_j's direction as orthogonality allows. A
# column whose largest entry is normal is not touched: its rounding stays below about 2^-53 of
# its norm, which the cosine test already allows for. It fires on no corpus matrix, on 12 of the
# adversarial set (subnormal sigma, 1.7e6 u from orthonormal before, 1.3 u after) and, counted
# with an instrumented build, 5,770 times in the 2,275 matrices of scripts/svdh/tools/d1hunt.py;
# the axis restart fired on none (a guard, tested directly).
fn _linalg_svd_reorth(y, rows, cols, r, st): i64 {
    var yr = y + r * rows * 8;
    var i = 0;
    var c = 0;
    var nv = f64_from(0);
    var tries = 0;
    while (tries < 2) {
        var ps = 0;
        while (ps < 2) {
            c = 0;
            while (c < cols) {
                if (load64(st + c * 8) == 1) {
                    var yc = y + c * rows * 8;
                    var d = _linalg_svd_dot(yc, yr, rows);
                    i = 0;
                    while (i < rows) {
                        store64(yr + i * 8, f64_sub(load64(yr + i * 8), f64_mul(d, load64(yc + i * 8))));
                        i = i + 1;
                    }
                }
                c = c + 1;
            }
            ps = ps + 1;
        }
        nv = f64_sqrt(_linalg_svd_ssq(yr, rows, 0x3FF0000000000000, 0));
        if (tries == 1 || f64_gt(nv, 0x3FE0000000000000) == 1) {
            tries = 2;
        } else {
            var bi = 0;
            var bw = 0x7FF0000000000000;
            i = 0;
            while (i < rows) {
                var w = f64_from(0);
                c = 0;
                while (c < cols) {
                    if (load64(st + c * 8) == 1) {
                        var e = load64(y + (c * rows + i) * 8);
                        w = f64_add(w, f64_mul(e, e));
                    }
                    c = c + 1;
                }
                if (f64_lt(w, bw) == 1) {
                    bi = i;
                    bw = w;
                }
                i = i + 1;
            }
            i = 0;
            while (i < rows) { store64(yr + i * 8, f64_from(0)); i = i + 1; }
            store64(yr + bi * 8, 0x3FF0000000000000);
            tries = 1;
        }
    }
    i = 0;
    while (i < rows) {
        store64(yr + i * 8, f64_div(load64(yr + i * 8), nv));
        i = i + 1;
    }
    return 0;
}

# The implementation. `want_uv` = 0 computes ONLY the singular values: no reflector is applied
# to anything but R, Z is not accumulated and U is not built — exactly what ganita_mat_rank and
# ganita_mat_condition need. The arithmetic that produces sigma is the same either way, so the
# two paths return the same status and the same sigma bits. out_u and out_vt are ignored (and
# may be 0) when want_uv is 0. Nothing is written to out_sigma, out_u or out_vt before the
# status is known to be 0.
#
# `out_sh` (1.2.13): 0 for sigma in A's own magnitude. Non-zero, it receives the working shift
# sh and out_sigma holds sigma_j·2^sh — the WORKING SCALE, where sigma_1 is near 2^1020 and
# neither end of the double range is reached. pseudo_inv and condition take that form: a sigma
# unscaled to A's magnitude can underflow to a reciprocal of +inf, or overflow to a +inf that
# makes every relative tolerance +inf. Where no unscaled sigma under- or overflows the two forms
# differ by exactly 2^sh, so everything derived from them is bit-identical to 1.2.12's.
fn _linalg_svd_impl(m, out_u, out_sigma, out_vt, want_uv, out_sh): i64 {
    if (m == 0 || out_sigma == 0) { return 0 - 2; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    if (rows < cols) { return 0 - 2; }

    # A NaN or infinite entry is a contract violation (1.2.12). A has no SVD then,
    # and through 1.2.11 three steps dropped a NaN without a word: the scale and
    # _linalg_norm2 are ordered maxima that a NaN never wins, and a NaN gamma fails
    # the orthogonality test, so the pair counted as converged. An all-NaN 2x2
    # came back as status 0 with sigma (0, 0). _linalg_all_finite tests the
    # exponent bits, so it does not lean on how a target compares a NaN.
    if (_linalg_all_finite(m + 16, rows * cols) == 0) { return 0 - 2; }

    var scale = _linalg_mat_scale(m);
    var i = 0;
    var j = 0;

    # A matrix of zeros has every singular value zero, U zero and V the identity.
    # Taking the general path would divide by the zero scale.
    if (scale & 0x7FFFFFFFFFFFFFFF == 0) {
        i = 0;
        while (i < cols) { store64(out_sigma + i * 8, f64_from(0)); i = i + 1; }
        if (out_sh != 0) { store64(out_sh, 0); }
        if (want_uv == 1) {
            i = 0;
            while (i < rows * cols) { store64(out_u + 16 + i * 8, f64_from(0)); i = i + 1; }
            i = 0;
            while (i < cols * cols) { store64(out_vt + 16 + i * 8, f64_from(0)); i = i + 1; }
            i = 0;
            while (i < cols) { ganita_mat_set(out_vt, i, i, f64_from(1)); i = i + 1; }
        }
        return 0;
    }

    # The working copy is A·2^sh, column-major, with its largest entry in [2^(1020-kk), 2^(1021-kk))
    # where 4^kk >= m·n (up to 52 binades lower when that entry of A is subnormal, since
    # _linalg_svd_expo holds its exponent at -1022). Every norm, R entry and rotated column is
    # then below sqrt(m·n)·2^(1021-kk) <= 2^1021, so nothing overflows however large A is, and a
    # tiny A is scaled up into the normal range. A power of two is exact going up; going down (at
    # most a factor 2^(kk+3), for an A near DBL_MAX) it rounds only entries that become subnormal.
    var kk = 0;
    while ((1 << (2 * kk)) < rows * cols) { kk = kk + 1; }
    var sh = 1020 - kk - _linalg_svd_expo(scale);
    var f1 = _linalg_svd_pow2(sh);
    if (sh > 1023) { f1 = _linalg_svd_pow2(1023); }

    # Scratch, O(m·n + n²): a (m×n) for the first QR, b (n×n) for the second (n >= 4 only) and x
    # (n×n) for the Jacobi, eight length-n vectors, and with want_uv also z (Z, n×n) and y (U,
    # m×n), in one allocation, the only one: -1 can come from nowhere else. Once the QRs are done
    # the first pivoting norms' slots hold the Jacobi's column scalings (ce), and the two R
    # diagonals' slots the singular values (sig) and their order (idx).
    var nw = rows * cols + 2 * cols * cols + 8 * cols;
    if (want_uv == 1) { nw = nw + rows * cols + cols * cols; }
    var a = alloc(nw * 8);
    if (a == 0) { return 0 - 1; }
    var b = a + rows * cols * 8;
    var x = b + cols * cols * 8;
    var aux = x + cols * cols * 8;
    var rd1 = aux;
    var rd2 = aux + cols * 8;
    var piv1 = aux + cols * 16;
    var piv2 = aux + cols * 24;
    var rp1 = aux + cols * 32;
    var rp2 = aux + cols * 40;
    var vn1 = aux + cols * 48;
    var vn2 = aux + cols * 56;
    var ce = vn1;
    var sig = rd1;
    var idx = rd2;
    var z = 0;
    var y = 0;
    if (want_uv == 1) {
        z = aux + cols * 64;
        y = z + cols * cols * 8;
    }

    # Transposed into column-major on the way: row i of A becomes entry i of every column.
    var src = m + 16;
    i = 0;
    while (i < rows) {
        var dst = a + i * 8;
        j = 0;
        while (j < cols) {
            store64(dst, f64_mul(load64(src), f1));
            src = src + 8;
            dst = dst + rows * 8;
            j = j + 1;
        }
        i = i + 1;
    }
    # A tiny A needs more than 2^1023: the rest, as a second exact factor.
    if (sh > 1023) {
        var f2 = _linalg_svd_pow2(sh - 1023);
        i = 0;
        while (i < rows * cols) {
            store64(a + i * 8, f64_mul(load64(a + i * 8), f2));
            i = i + 1;
        }
    }

    # A·P1 = Q1·R1; for n >= 4 then R1^T·P2 = Q2·R2 and X = R2^T, for n <= 3 X = R1^T (see
    # ganita_mat_svd, ONE QR FOR n <= 3). The row swaps are part of Q1 and Q2. With one QR, P2 is
    # the identity, so piv2 is filled with it and the U assembly below serves both.
    var q2 = 0;
    if (cols > 3) { q2 = 1; }
    _linalg_svd_qrcp(a, rows, cols, rd1, piv1, rp1, vn1, vn2);
    if (q2 == 1) {
        _linalg_svd_rt(a, rows, rd1, cols, b, 0);
        _linalg_svd_qrcp(b, cols, cols, rd2, piv2, rp2, vn1, vn2);
        _linalg_svd_rt(b, cols, rd2, cols, x, ce);
    } else {
        _linalg_svd_rt(a, rows, rd1, cols, x, ce);
        i = 0;
        while (i < cols) { store64(piv2 + i * 8, i); i = i + 1; }
    }
    if (want_uv == 1) {
        i = 0;
        while (i < cols * cols) { store64(z + i * 8, f64_from(0)); i = i + 1; }
        i = 0;
        while (i < cols) { store64(z + (i * cols + i) * 8, f64_from(1)); i = i + 1; }
    }

    # Sweep until a pass makes no progress, or until DGESVJ's second test says the rotations left
    # are at rounding level. Convergence is quadratic, and after the QR steps X typically needs
    # 2-4 sweeps; 60 is the cap that makes a pathological case terminate, and reaching it is -3.
    #
    # tol = sqrt(n)·2^-52 (1.2.12), DGESVJ's default for the n-row columns of X. The first 1.2.12
    # draft used n·2^-52, twice the worst-case rounding of an n-term dot product, as its guard
    # against the filing's rounding-level two-cycle; but U's columns come out orthogonal only to
    # the tolerance, so that cost a factor n: 39 u at 40×40 random and 256 u at 256×256. The
    # two-cycle is closed by the second test instead: from sweep 2 on, stop when
    # max|cos| < sqrt(n)·tol = n·2^-52 and n·max|cos|·max|sin| < tol — every cosine this sweep
    # met was already at rounding level, and its rotations were too small to move any other pair
    # by tol. Both read only X, so the values-only path stops on the same sweep.
    var tol = f64_mul(f64_sqrt(f64_from(cols)), _LINALG_MACH_EPS);
    var tolc = f64_mul(f64_from(cols), _LINALG_MACH_EPS);
    var st[16];
    var sweep = 0;
    var done = 0;
    while (sweep < 60 && done == 0) {
        var moved = _linalg_svd_sweep(x, cols, z, ce, tol, &st);
        sweep = sweep + 1;
        if (moved == 0) { done = 1; }
        if (done == 0 && sweep >= 2) {
            var mxc = f64_sqrt(load64(&st));
            var cs2 = f64_mul(f64_mul(f64_from(cols), mxc), load64(&st + 8));
            if (f64_lt(mxc, tolc) == 1 && f64_lt(cs2, tol) == 1) { done = 1; }
        }
    }
    if (done == 0) { return 0 - 3; }

    # sigma_j = |x_j|·2^-sh, from the column scaled by its own exponent and unscaled in one
    # rounding. With want_uv, x_j is scaled in place by that exponent (exact but for entries that
    # underflow, far below its largest one), and for n <= 3, where it becomes V's column,
    # normalised as well.
    j = 0;
    while (j < cols) {
        var sj = f64_from(0);
        var fj = load64(ce + j * 8);
        store64(vn2 + j * 8, 0);
        if (fj != 0) {
            var ej = 1023 - ((fj >> 52) & 0x7FF);
            var xj = x + j * cols * 8;
            var nrm = f64_sqrt(_linalg_svd_ssq(xj, cols, fj, 0));
            # nrm is in [2^-52, 2^30), so when |ej - sh| <= 960 a plain multiply is exact; only a
            # sigma near the ends of the range needs ldexp's single rounding (or overflow to inf).
            var ex = ej - sh;
            if (out_sh != 0) { ex = ej; }
            if (ex >= 0 - 960 && ex <= 960) {
                sj = f64_mul(nrm, (ex + 1023) << 52);
            } else {
                sj = _linalg_svd_ldexp(nrm, ex);
            }
            if (want_uv == 1) {
                # nsub: the column's largest entry is normal (its scaled form is at least 1).
                var nsub = 0;
                i = 0;
                while (i < cols) {
                    var wv = f64_mul(load64(xj + i * 8), fj);
                    if ((wv & 0x7FFFFFFFFFFFFFFF) >= 0x3FF0000000000000) { nsub = 1; }
                    if (q2 == 0) { wv = f64_div(wv, nrm); }
                    store64(xj + i * 8, wv);
                    i = i + 1;
                }
                # ⚠ For n <= 3 a column whose entries are all subnormal is not a V column (1.2.12).
                # The subnormal floor (_linalg_svd_sweep) leaves it orthogonal to the others only
                # to its own absolute rounding, which for such a column is a cosine as large as
                # 2^-14: V's rows came out 2.5e6 u from orthogonal on a 4×3 whose last two rows sit
                # 2060 binades below the first. It is completed instead, like a zero column. Its
                # sigma is below 2^-1021·sqrt(n) of a working copy whose largest entry is near
                # 2^1020, so swapping its V column moves A by far less than u·|A|. For n >= 4 V
                # comes from rotations and needs no such care.
                if (q2 == 0 && nsub == 0) {
                    i = 0;
                    while (i < cols) { store64(xj + i * 8, f64_from(0)); i = i + 1; }
                    store64(ce + j * 8, 0);
                }
                # For n >= 4 it is U's column that comes from x_j, by the same argument, and vn2
                # (free since the QRs) marks it for _linalg_svd_reorth.
                if (q2 == 1 && nsub == 0) { store64(vn2 + j * 8, 1); }
            }
        }
        store64(sig + j * 8, sj);
        store64(idx + j * 8, j);
        j = j + 1;
    }

    # Descending order, as a permutation idx: out position r takes column idx[r].
    i = 0;
    while (i < cols) {
        var mxi = i;
        j = i + 1;
        while (j < cols) {
            if (f64_gt(load64(sig + load64(idx + j * 8) * 8), load64(sig + load64(idx + mxi * 8) * 8)) == 1) {
                mxi = j;
            }
            j = j + 1;
        }
        var ti = load64(idx + i * 8);
        store64(idx + i * 8, load64(idx + mxi * 8));
        store64(idx + mxi * 8, ti);
        store64(out_sigma + i * 8, load64(sig + load64(idx + i * 8) * 8));
        i = i + 1;
    }
    if (out_sh != 0) { store64(out_sh, sh); }
    if (want_uv == 0) { return 0; }

    # uw holds the n×n columns that U is made of, vw those V is made of: for n >= 4 the scaled
    # columns of X and Z, for n <= 3 Z and X's normalised and completed columns.
    var uw = x;
    var vw = z;
    if (q2 == 0) {
        uw = z;
        vw = x;
        _linalg_svd_complete(x, cols, ce);
    }

    # U = Q1·[P2·uw; 0], each column then divided by its own (pairwise) norm: row piv2[k] of
    # P2·uw is row k of uw. A sigma that is exactly 0 — a zero column, or one whose norm
    # underflowed when unscaled — keeps an all-zero U column.
    #
    # ⚡ NORMALISED AFTER Q1, NOT BEFORE (1.2.12). Applying n reflectors to a unit vector leaves
    # its length a few u from 1, and that was most of U's departure from orthogonality once the
    # Jacobi itself was tight: up to 6.1 u at 40×40 random, against about 4 u (2.4 u on average)
    # normalising last. A column of X that was all subnormal is then made orthonormal to the
    # others (_linalg_svd_reorth), the only U column whose bits that changes.
    i = 0;
    while (i < rows * cols) { store64(y + i * 8, f64_from(0)); i = i + 1; }
    var r = 0;
    while (r < cols) {
        if (load64(out_sigma + r * 8) != 0) {
            var xc = uw + load64(idx + r * 8) * cols * 8;
            var k = 0;
            while (k < cols) {
                store64(y + (r * rows + load64(piv2 + k * 8)) * 8, load64(xc + k * 8));
                k = k + 1;
            }
        }
        r = r + 1;
    }
    _linalg_svd_apply_q(a, rows, cols, rp1, y, cols);
    # Each non-zero column is divided by its norm in place. sig, free once out_sigma is written,
    # then holds each column's state for _linalg_svd_reorth: 0 zero, 1 final, 2 still to be made
    # orthonormal to the final ones (n >= 4, x_j marked above).
    var nre = 0;
    r = 0;
    while (r < cols) {
        var ust = 0;
        if (load64(out_sigma + r * 8) != 0) {
            var yr = y + r * rows * 8;
            var un = f64_sqrt(_linalg_svd_ssq(yr, rows, 0x3FF0000000000000, 0));
            if (un != 0) {
                i = 0;
                while (i < rows) {
                    store64(yr + i * 8, f64_div(load64(yr + i * 8), un));
                    i = i + 1;
                }
                ust = 1;
                if (load64(vn2 + load64(idx + r * 8) * 8) == 1) {
                    ust = 2;
                    nre = nre + 1;
                }
            }
        }
        store64(sig + r * 8, ust);
        r = r + 1;
    }
    r = 0;
    while (nre > 0 && r < cols) {
        if (load64(sig + r * 8) == 2) {
            _linalg_svd_reorth(y, rows, cols, r, sig);
            store64(sig + r * 8, 1);
            nre = nre - 1;
        }
        r = r + 1;
    }
    i = 0;
    while (i < rows) {
        r = 0;
        while (r < cols) {
            ganita_mat_set(out_u, i, r, load64(y + (r * rows + i) * 8));
            r = r + 1;
        }
        i = i + 1;
    }

    # V = P1·Q2·vw (Q2 = I for n <= 3): row piv1[k] of V is row k of Q2·vw; out_vt's row r is V's
    # column idx[r].
    if (q2 == 1) { _linalg_svd_apply_q(b, cols, cols, rp2, z, cols); }
    r = 0;
    while (r < cols) {
        var zc = vw + load64(idx + r * 8) * cols * 8;
        var k2 = 0;
        while (k2 < cols) {
            ganita_mat_set(out_vt, r, load64(piv1 + k2 * 8), load64(zc + k2 * 8));
            k2 = k2 + 1;
        }
        r = r + 1;
    }
    return 0;
}

# Moore-Penrose pseudoinverse via SVD.
# TALL-OR-SQUARE INPUT ONLY (m >= n) — see ganita_mat_svd. Returns a new n×m
# matrix, or 0 (null) for a null or wide input, a NaN or infinite entry, if any
# working allocation fails, or if the SVD does not converge — its -3 (1.2.12), which
# no finite input is known to reach (see ganita_mat_svd for what was measured).
# Through 1.2.11 the SVD's -1 for non-convergence made this null for textbook
# singular input such as [[1, 2, 3], [1, 2, 3], [4, 5, 6]], the input a
# pseudoinverse exists for. The n×n factors mean a wide input can exceed the cap
# even when the input does not.
# At the ends of the double range (1.2.13) an entry of the exact pseudo-inverse
# above DBL_MAX comes back ±inf, as IEEE arithmetic rounds it, and one below
# 2^-1074 comes back ±0; no entry is NaN. Through 1.2.12 a kept sigma below 2^-1024
# had a reciprocal of +inf that met V^T's zeros as NaN (diag(2^-1060, 2^-1060) was
# all NaN), and a sigma_1 that overflowed made every sigma "negligible": the
# pseudo-inverse of DBL_MAX·[[1, 1], [1, -1]] came back all zeros.
fn ganita_mat_pseudo_inv(m): i64 {
    if (m == 0) { return 0; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    if (rows < cols) { return 0; }

    var u = ganita_mat_new(rows, cols);
    if (u == 0) { return 0; }
    var sigma = alloc(cols * 8);
    if (sigma == 0) { return 0; }
    var vt = ganita_mat_new(cols, cols);
    if (vt == 0) { return 0; }
    # sigma in the SVD's working scale, sigma_j·2^sh (1.2.13; see _linalg_svd_impl).
    var sh = 0;
    if (_linalg_svd_impl(m, u, sigma, vt, 1, &sh) != 0) { return 0; }

    # Pseudo-inverse = V * Sigma_inv * U^T.
    #
    # ⚡ Sigma_inv is a DIAGONAL, so applying it is a scaling — O(n^2). Through
    # 1.2.3 this built it as a dense n x n matrix and called ganita_mat_mul,
    # paying a full O(n^3) matrix multiply to multiply by a diagonal.
    #
    # ⚡ AND NOTHING IS TRANSPOSED (1.2.6). Through 1.2.5 this materialised V as
    # transpose(V^T) and U^T as transpose(U) — an n×n and an n×m matrix, each
    # consumed once by the multiply and discarded, which a bump allocator never
    # reclaims. Both are unnecessary: scaling ROW j of V^T is scaling column j of
    # V, and V·Sigma_inv·U^T = (U · Sigma_inv·V^T)^T, which the multiply kernel
    # stores directly as a transpose. Same products, same summation order — the
    # result is bit-identical to 1.2.5's.
    #
    # A singular value is treated as zero RELATIVE to the largest one, which is
    # the standard rank tolerance — see ganita_mat_svd.
    var pinv_tol = f64_mul(LINALG_EPS, load64(sigma));

    # ⚠ THE WORKING SCALE (1.2.13). sigma here is sigma_j·2^sh, with sigma_1 near
    # 2^1020, so the tolerance is finite and every kept reciprocal is normal. Each
    # is formed as 2^t/sigma_j, t = floor(log2 sigma_1), which puts the factors in
    # (1/2, 2^41] and the product below in the middle of the range; the one exact
    # factor left, 2^(sh-t), is applied to each entry at the end with a single
    # rounding. Where nothing under- or overflows that is the 1.2.12 arithmetic
    # times exact powers of two, so the result is bit-identical.
    var t = _linalg_svd_expo(load64(sigma));
    var p2t = _linalg_svd_pow2(t);

    # Scale row j of V^T by 2^t/sigma_j, or zero it where sigma_j is negligible.
    var i = 0;
    while (i < cols) {
        var sv = load64(sigma + i * 8);
        var f = f64_from(0);
        if (f64_gt(sv, pinv_tol) == 1) { f = f64_div(p2t, sv); }
        var c2 = 0;
        while (c2 < cols) {
            ganita_mat_set(vt, i, c2, f64_mul(ganita_mat_get(vt, i, c2), f));
            c2 = c2 + 1;
        }
        i = i + 1;
    }

    # (U · Sigma_inv·V^T)^T, n×m. u is m×n and vt is n×n, so the shapes the
    # kernel requires hold by construction.
    var pinv = _ganita_mat_new_raw(cols, rows);
    if (pinv == 0) { return 0; }
    _ganita_mat_mul_into(u, vt, pinv, 1);

    # Back to A's scale: times 2^(sh-t), each entry rounded once.
    var e = sh - t;
    i = 0;
    while (i < rows * cols) {
        var pv = load64(pinv + 16 + i * 8);
        # _linalg_svd_ldexp wants a normal x: a subnormal one is lifted by 2^54 first (exact).
        if (((pv >> 52) & 0x7FF) == 0) {
            store64(pinv + 16 + i * 8, _linalg_svd_ldexp(f64_mul(pv, 0x4350000000000000), e - 54));
        } else {
            store64(pinv + 16 + i * 8, _linalg_svd_ldexp(pv, e));
        }
        i = i + 1;
    }
    return pinv;
}

# Numerical rank: count of singular values above tolerance.
# TALL-OR-SQUARE INPUT ONLY (m >= n) — see ganita_mat_svd.
# Returns -1 if any working allocation fails, -2 for a null or wide input, a
# NaN or infinite entry, or a negative or NaN tolerance, and -3 if the SVD does
# not converge (1.2.12): the SVD's status is passed through unchanged, and no
# finite input is known to reach -3 (see ganita_mat_svd). A rank is never
# negative, so no failure code can be mistaken for the rank-0 answer.
fn ganita_mat_rank(m, tol): i64 {
    if (m == 0) { return 0 - 2; }
    if (ganita_mat_rows(m) < ganita_mat_cols(m)) { return 0 - 2; }
    if (_linalg_is_nan(tol) == 1) { return 0 - 2; }
    if (f64_lt(tol, f64_from(0)) == 1) { return 0 - 2; }
    var cols = ganita_mat_cols(m);
    var sigma = alloc(cols * 8);
    if (sigma == 0) { return 0 - 1; }
    # ⚡ Values only (1.2.4). This reads sigma and nothing else, so there is no
    # reason to accumulate V through every rotation and normalise U afterwards —
    # which is what running the full ganita_mat_svd did through 1.2.3.
    # The SVD's status passes through (1.2.12): a non-finite entry is -2 and
    # non-convergence -3, not an allocation failure. Through 1.2.11 any SVD failure
    # came back -1, which is how a singular matrix — the input this function exists
    # to judge — read as "out of memory".
    var src = _linalg_svd_impl(m, 0, sigma, 0, 0, 0);
    if (src != 0) { return src; }

    var rank = 0;
    var i = 0;
    while (i < cols) {
        if (f64_gt(load64(sigma + i * 8), tol) == 1) {
            rank = rank + 1;
        }
        i = i + 1;
    }
    return rank;
}

# Condition number: sigma_max / sigma_min.
# TALL-OR-SQUARE INPUT ONLY (m >= n) — see ganita_mat_svd.
# Returns f64: -1.0 if the matrix is singular (sigma_min ≈ 0), and NaN for a null
# or wide input, a NaN or infinite entry, if any working allocation fails, or if the
# SVD does not converge (its -3, 1.2.12, which no finite input is known to reach;
# see ganita_mat_svd) — distinct from -1.0, which is a real answer about the matrix
# rather than about the run. Through 1.2.11 a singular matrix with a zero or repeated
# row came back NaN here, because the SVD reported -1; it is now -1.0.
# Any finite A (1.2.13): through 1.2.12 a sigma_1 above DBL_MAX came back +inf and
# made the singular test always true, so DBL_MAX·[[1, 1], [1, -1]], condition number
# exactly 1, was -1.0. The ratio is now taken in the SVD's working scale, where the
# power of two cancels.
fn ganita_mat_condition(m): i64 {
    if (m == 0) { return f64_div(f64_from(0), f64_from(0)); }
    if (ganita_mat_rows(m) < ganita_mat_cols(m)) { return f64_div(f64_from(0), f64_from(0)); }
    var cols = ganita_mat_cols(m);

    var sigma = alloc(cols * 8);
    if (sigma == 0) { return f64_div(f64_from(0), f64_from(0)); }
    # ⚡ Values only — see ganita_mat_rank. Every SVD failure (-1, -2, -3) is NaN here.
    # sigma in the working scale (1.2.13): sigma_1 is finite, and sh cancels in the ratio.
    var sh = 0;
    if (_linalg_svd_impl(m, 0, sigma, 0, 0, &sh) != 0) { return f64_div(f64_from(0), f64_from(0)); }

    var smax = load64(sigma);
    var smin = load64(sigma + (cols - 1) * 8);

    # Singular means sigma_min is negligible RELATIVE to sigma_max (1.2.4) —
    # which is exactly what a condition number measures. The absolute test made
    # this function disagree with ganita_mat_rank about the same matrix.
    if (f64_le(smin, f64_mul(LINALG_EPS, smax)) == 1) { return f64_neg(f64_from(1)); }
    return f64_div(smax, smin);
}
