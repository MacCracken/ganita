# ganita benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.
#
# Carries its own includes so the f32 tier is in scope (auto-prepend is skipped
# once a file has includes), mirroring tests/ganita.tcyr's list. Order follows
# [lib].modules: the compiler is single-pass, linalg calls into matrix, and the
# f32 pow/atan2/hypot/cbrt forward to math_advanced's ganita_f64_* fns.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/math.cyr"
include "lib/bench.cyr"

include "src/matrix.cyr"
include "src/linalg.cyr"
include "src/math_advanced.cyr"
include "src/math_f32.cyr"

# Empty call: measures the harness floor, not any ganita work.
fn bench_noop(): i64 { return 0; }

# The 1.1.x shape of the arithmetic that TIER 0 replaced, kept here ONLY as the
# benchmark baseline: widen both operands to f64, do the op, narrow back. For a
# single op it is correctly rounded, so this measures cost, not accuracy.
fn bench_f32_mul_widened(a, b): i64 {
    return f32_from(f64_mul(f32_to(a), f32_to(b)));
}

# The pre-1.2.0 lerp: one f64 rounding for the whole expression. Baseline only.
fn bench_f32_lerp_widened(a, b, t): i64 {
    var af = f32_to(a);
    var bf = f32_to(b);
    var tf = f32_to(t);
    return f32_from(f64_add(af, f64_mul(f64_sub(bf, af), tf)));
}

# Build the m x 3 Vandermonde for x = i/m and fill `out_b` with a quadratic that
# lies in its column space. Same design the 1.2.2 least-squares assertions use.
fn bench_quad_design(m, out_b): i64 {
    var a = ganita_mat_new(m, 3);
    if (a == 0) { return 0; }
    var i = 0;
    while (i < m) {
        var x = f64_div(f64_from(i), f64_from(m));
        ganita_mat_set(a, i, 0, f64_from(1));
        ganita_mat_set(a, i, 1, x);
        ganita_mat_set(a, i, 2, f64_mul(x, x));
        store64(out_b + i * 8, f64_add(f64_from(2),
            f64_sub(f64_mul(f64_from(3), x), f64_mul(f64_from(4), f64_mul(x, x)))));
        i = i + 1;
    }
    return a;
}

# Time `reps` least-squares solves of an m x 3 design. Reports nothing itself —
# the caller owns the bench handle so the label carries m.
fn bench_least_squares(m, reps, handle): i64 {
    var b = alloc(m * 8);
    if (b == 0) { return 0 - 1; }
    var a = bench_quad_design(m, b);
    if (a == 0) { return 0 - 1; }
    var out = alloc(24);
    if (out == 0) { return 0 - 1; }
    bench_batch_start(handle);
    var i = 0;
    while (i < reps) { ganita_mat_least_squares(a, b, out); i = i + 1; }
    bench_batch_stop(handle, reps);
    bench_report(handle);
    return 0;
}

var BSEED = 12345;

# Build an n x n symmetric matrix from a deterministic LCG. Same content every
# run, so the eigen benchmark below measures the code and not the data.
fn bench_sym_matrix(n): i64 {
    BSEED = 12345;
    var m = ganita_mat_new(n, n);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var j = i;
        while (j < n) {
            BSEED = (BSEED * 1103515245 + 12345) & 0x7FFFFFFF;
            var v = f64_div(f64_from(BSEED % 2000 - 1000), f64_from(97));
            ganita_mat_set(m, i, j, v);
            ganita_mat_set(m, j, i, v);
            j = j + 1;
        }
        i = i + 1;
    }
    return m;
}

# Time `reps` symmetric eigendecompositions of an n x n matrix.
fn bench_eigen(n, reps, handle): i64 {
    var m = bench_sym_matrix(n);
    if (m == 0) { return 0 - 1; }
    var vals = alloc(n * 8);
    var vecs = ganita_mat_new(n, n);
    if (vals == 0 || vecs == 0) { return 0 - 1; }
    bench_batch_start(handle);
    var i = 0;
    while (i < reps) {
        ganita_mat_eigen_sym(m, vals, vecs);
        i = i + 1;
    }
    bench_batch_stop(handle, reps);
    bench_report(handle);
    return 0;
}

# Time `reps` multiplications of two n x n matrices.
fn bench_matmul(n, reps, handle): i64 {
    var a = bench_sym_matrix(n);
    var b = bench_sym_matrix(n);
    if (a == 0 || b == 0) { return 0 - 1; }
    bench_batch_start(handle);
    var i = 0;
    while (i < reps) {
        ganita_mat_mul(a, b);
        i = i + 1;
    }
    bench_batch_stop(handle, reps);
    bench_report(handle);
    return 0;
}

# Time `reps` numerical-rank computations of an n x n matrix.
fn bench_rank(n, reps, handle): i64 {
    var a = bench_sym_matrix(n);
    if (a == 0) { return 0 - 1; }
    var tol = f64_div(f64_from(1), f64_from(1000000000));
    bench_batch_start(handle);
    var i = 0;
    while (i < reps) {
        ganita_mat_rank(a, tol);
        i = i + 1;
    }
    bench_batch_stop(handle, reps);
    bench_report(handle);
    return 0;
}

# Time `reps` full SVDs (U, sigma and V^T) of an n x n matrix; with `zero_row` = 1
# its row 3 is zeroed first, the rank-deficient square that 1.2.11 returned -1 for.
fn bench_svd(n, zero_row, reps, handle): i64 {
    var a = bench_sym_matrix(n);
    if (a == 0) { return 0 - 1; }
    if (zero_row == 1) {
        var k = 0;
        while (k < n) {
            ganita_mat_set(a, 3, k, f64_from(0));
            k = k + 1;
        }
    }
    var u = ganita_mat_new(n, n);
    var vt = ganita_mat_new(n, n);
    var s = alloc(n * 8);
    if (u == 0 || vt == 0 || s == 0) { return 0 - 1; }
    bench_batch_start(handle);
    var i = 0;
    while (i < reps) {
        ganita_mat_svd(a, u, s, vt);
        i = i + 1;
    }
    bench_batch_stop(handle, reps);
    bench_report(handle);
    return 0;
}

# Time `reps` inversions of an n x n matrix.
fn bench_inv(n, reps, handle): i64 {
    var a = bench_sym_matrix(n);
    if (a == 0) { return 0 - 1; }
    bench_batch_start(handle);
    var i = 0;
    while (i < reps) {
        ganita_mat_inv(a);
        i = i + 1;
    }
    bench_batch_stop(handle, reps);
    bench_report(handle);
    return 0;
}

# The cube root a consumer had to write through 1.2.5: sign split around
# pow(|x|, 1/3). Baseline only — it is neither exact on cubes nor correctly rounded.
fn bench_cbrt_via_pow(x): i64 {
    var third = f64_div(f64_from(1), f64_from(3));
    if (((x >> 63) & 1) == 1) { return ganita_f64_pow(x & 0x7FFFFFFFFFFFFFFF, third) | 0x8000000000000000; }
    return ganita_f64_pow(x, third);
}

# Time 256 x 4096 cube roots of integers spread over [1, 2^20]. `use_pow` = 1 times
# the pow baseline instead of ganita_f64_cbrt.
fn bench_cbrt(use_pow, handle): i64 {
    var xs = alloc(4096 * 8);
    if (xs == 0) { return 0 - 1; }
    var s = 12345;
    var i = 0;
    while (i < 4096) {
        s = (s * 1103515245 + 12345) & 0x7FFFFFFF;
        store64(xs + i * 8, f64_from(1 + (s % 1048576)));
        i = i + 1;
    }
    bench_batch_start(handle);
    var round = 0;
    while (round < 256) {
        i = 0;
        while (i < 4096) {
            if (use_pow == 1) { bench_cbrt_via_pow(load64(xs + i * 8)); } else { ganita_f64_cbrt(load64(xs + i * 8)); }
            i = i + 1;
        }
        round = round + 1;
    }
    bench_batch_stop(handle, 256 * 4096);
    bench_report(handle);
    return 0;
}

# The 1.2.10 ganita_f64_atan2, kept here ONLY as the benchmark baseline for the
# sign-bit guards 1.2.11 put in front of the quotient. It is wrong on signed zeros,
# on a NaN y at x = ±0 and on two infinities; on the finite non-zero pairs timed
# below it is bit-identical to ganita_f64_atan2, so the rows compare cost alone.
fn bench_atan2_1210(y, x): i64 {
    if (f64_eq(x, _F64_ZERO) == 1) {
        if (f64_eq(y, _F64_ZERO) == 1) { return _F64_ZERO; }
        if (f64_gt(y, _F64_ZERO) == 1) { return F64_PI_2; }
        return f64_neg(F64_PI_2);
    }
    var q = f64_atan(f64_div(y, x));
    if (f64_gt(x, _F64_ZERO) == 1) { return q; }
    if (f64_lt(y, _F64_ZERO) == 1) { return f64_sub(q, F64_PI); }
    return f64_add(q, F64_PI);
}

# Time 256 x 4096 atan2 calls on finite non-zero pairs (odd multiples of 1/7 in
# [-142.7, 142.7]) spread over all four quadrants. `use_old` = 1 times the 1.2.10
# baseline instead of ganita_f64_atan2.
fn bench_atan2(use_old, handle): i64 {
    var ys = alloc(4096 * 8);
    var xs = alloc(4096 * 8);
    if ((ys == 0) || (xs == 0)) { return 0 - 1; }
    var seven = f64_from(7);
    var s = 12345;
    var i = 0;
    while (i < 4096) {
        s = (s * 1103515245 + 12345) & 0x7FFFFFFF;
        store64(ys + i * 8, f64_div(f64_from(2 * (s % 1000) - 999), seven));
        s = (s * 1103515245 + 12345) & 0x7FFFFFFF;
        store64(xs + i * 8, f64_div(f64_from(2 * (s % 1000) - 999), seven));
        i = i + 1;
    }
    bench_batch_start(handle);
    var round = 0;
    while (round < 256) {
        i = 0;
        while (i < 4096) {
            if (use_old == 1) {
                bench_atan2_1210(load64(ys + i * 8), load64(xs + i * 8));
            } else {
                ganita_f64_atan2(load64(ys + i * 8), load64(xs + i * 8));
            }
            i = i + 1;
        }
        round = round + 1;
    }
    bench_batch_stop(handle, 256 * 4096);
    bench_report(handle);
    return 0;
}

# Time 1,000,000 calls of one hyperbolic-family function at x. fid: 1 sinh, 2 tanh,
# 3 atanh, 4 asinh, 5 acosh, 6 asin.
fn bench_hyp(fid, x, handle): i64 {
    bench_batch_start(handle);
    var i = 0;
    while (i < 1000000) {
        if (fid == 1) { ganita_f64_sinh(x); }
        if (fid == 2) { ganita_f64_tanh(x); }
        if (fid == 3) { ganita_f64_atanh(x); }
        if (fid == 4) { ganita_f64_asinh(x); }
        if (fid == 5) { ganita_f64_acosh(x); }
        if (fid == 6) { ganita_f64_asin(x); }
        i = i + 1;
    }
    bench_batch_stop(handle, 1000000);
    bench_report(handle);
    return 0;
}

# The tangent a consumer had to write through 1.2.10: f64_sin(x) / f64_cos(x).
# Baseline only — two reductions, two kernels and a division, up to 2 ulp off.
fn bench_tan_via_sincos(x): i64 { return f64_div(f64_sin(x), f64_cos(x)); }

# Time 256 x 4096 tangents of arguments spread over [-8, 8): every quadrant, and
# all but about a tenth of them through the argument reduction. `mode` 0 times
# ganita_f64_tan, 1 the sin/cos baseline, 2 ganita_f32_tan on the same arguments
# narrowed to f32.
fn bench_tan(mode, handle): i64 {
    var xs = alloc(4096 * 8);
    if (xs == 0) { return 0 - 1; }
    var s = 12345;
    var i = 0;
    while (i < 4096) {
        s = (s * 1103515245 + 12345) & 0x7FFFFFFF;
        var x = f64_sub(f64_div(f64_from(s % 1048576), f64_from(65536)), f64_from(8));
        if (mode == 2) { x = f32_from(x); }
        store64(xs + i * 8, x);
        i = i + 1;
    }
    bench_batch_start(handle);
    var round = 0;
    while (round < 256) {
        i = 0;
        while (i < 4096) {
            var xa = load64(xs + i * 8);
            if (mode == 0) {
                ganita_f64_tan(xa);
            } else {
                if (mode == 1) { bench_tan_via_sincos(xa); } else { ganita_f32_tan(xa); }
            }
            i = i + 1;
        }
        round = round + 1;
    }
    bench_batch_stop(handle, 256 * 4096);
    bench_report(handle);
    return 0;
}

# Bench entry point — harness floor, f32 native vs widened for mul and lerp,
# least-squares scaling, the Jacobi eigensolver, matmul and rank, the 1.2.6
# inverse and cube root, then the 1.2.11 binomial, atan2, hyperbolic family and
# tangent.
fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);

    # --- f32 TIER 0 (1.2.0): native single precision vs the widened baseline ---
    var x = f32_from(f64_div(f64_from(1), f64_from(3)));
    var y = f32_from(f64_div(f64_from(7), f64_from(9)));
    var t = f32_from(f64_div(f64_from(1), f64_from(7)));

    var b2 = bench_new("f32_mul (native)");
    bench_batch_start(b2);
    i = 0;
    while (i < 1000000) { ganita_f32_mul(x, y); i = i + 1; }
    bench_batch_stop(b2, 1000000);
    bench_report(b2);

    var b3 = bench_new("f32_mul (widened baseline)");
    bench_batch_start(b3);
    i = 0;
    while (i < 1000000) { bench_f32_mul_widened(x, y); i = i + 1; }
    bench_batch_stop(b3, 1000000);
    bench_report(b3);

    var b4 = bench_new("f32_lerp (native)");
    bench_batch_start(b4);
    i = 0;
    while (i < 1000000) { ganita_f32_lerp(x, y, t); i = i + 1; }
    bench_batch_stop(b4, 1000000);
    bench_report(b4);

    var b5 = bench_new("f32_lerp (widened baseline)");
    bench_batch_start(b5);
    i = 0;
    while (i < 1000000) { bench_f32_lerp_widened(x, y, t); i = i + 1; }
    bench_batch_stop(b5, 1000000);
    bench_report(b5);

    # --- least squares (1.2.2): the m x m Q is gone, so cost is O(m*n^2) ---
    # These three sizes are the point of the fix rather than a micro-optimisation:
    # m = 5793 is the exact size that SIGSEGV'd through 1.2.1 (its internal Q was
    # one element over the cap), and m = 20000 could not run at ANY cap — a
    # 20000^2 Q is 3.2 GB. Per-solve time should track m roughly linearly; a
    # superlinear jump means something is allocating per row again.
    bench_least_squares(1000, 20, bench_new("least_squares m=1000 n=3"));
    bench_least_squares(5793, 20, bench_new("least_squares m=5793 n=3 (was SIGSEGV)"));
    bench_least_squares(20000, 20, bench_new("least_squares m=20000 n=3 (was N/A)"));

    # --- symmetric eigendecomposition (1.2.3): O(n^3), was O(n^4) ---------
    # The pivot search is indexed rather than exhaustive as of 1.2.3, and these
    # three sizes are here to keep it that way: the ratio between them should
    # track n^3, and a return to n^4 shows up as the largest size pulling away.
    # Measured on the 1.2.2 -> 1.2.3 change, same host, same matrices, with the
    # eigenvalues verified bit-identical: n=40 25.4ms -> 13.7ms, n=120 1.55s ->
    # 0.36s, n=200 11.53s -> 1.76s. Below about n=20 the index bookkeeping costs
    # slightly more than the scan it replaces, which is the honest trade.
    bench_eigen(20, 20, bench_new("eigen_sym n=20"));
    bench_eigen(40, 10, bench_new("eigen_sym n=40"));
    bench_eigen(80, 3, bench_new("eigen_sym n=80"));

    # --- 1.2.4 optimizations ---------------------------------------------
    # mat_mul's accumulation loop uses raw row/column pointers instead of
    # ganita_mat_get, which re-reads the header and recomputes the offset on
    # every call — twice per multiply-accumulate. Measured 3.34x at 120x120
    # against 1.2.3 on this host.
    bench_matmul(60, 10, bench_new("mat_mul 60x60"));
    bench_matmul(120, 3, bench_new("mat_mul 120x120"));
    # rank reads only the singular values, so it now takes a values-only path
    # that skips the V accumulation and the U construction entirely. Measured
    # 1.61x at 40x40 — which also folds in the move off the A^T A eigensolver.
    bench_rank(40, 5, bench_new("rank 40x40 (values-only SVD)"));

    # --- 1.2.6 ------------------------------------------------------------
    # mat_inv forward-substitutes from the row that holds P·e_k's 1 and reuses one
    # scratch column, where it used to call lu_solve per column. Measured 1.17x to
    # 1.20x at 60x60 and 120x120 against 1.2.5 in one process, with results
    # bit-identical and 8n^2 fewer bytes taken from the allocator per call. (qr's
    # in-place transpose and pseudo_inv's fused multiply are memory fixes: their
    # time is unchanged to within 1%, which is why they have no row here.)
    bench_inv(60, 5, bench_new("mat_inv 60x60"));
    # ganita_f64_cbrt is correctly rounded by exact integer comparison, and costs
    # 1.1x to 1.15x the pow(x, 1/3) form it replaces, which is wrong on most cubes.
    bench_cbrt(0, bench_new("f64_cbrt (correctly rounded)"));
    bench_cbrt(1, bench_new("f64 pow(x, 1/3) with sign split (1.2.5 baseline)"));

    # --- 1.2.11: binomial is exact up to i64_MAX, not i64_MAX / min(k, n - k) ---
    # C(61, 30) never needs the gcd step: every product C(n, i)·(n - i) on the way
    # fits, so this row is the multiply-first path alone, the same arithmetic 1.2.10
    # did, and it should not move. C(66, 33) is the largest central coefficient in
    # i64; its last 10 of 33 steps would wrap if they multiplied first, so they divide
    # through gcd(C(n, i), i + 1) instead. 1.2.10 gave up at the first of those and
    # returned -1, so this row costs more than it did; that is the price of answering.
    # Measured on x86_64, three runs each, against the 1.2.10 body in the same tree:
    # C(61, 30) 127-131 ns (1.2.10: 128 ns); C(66, 33) 226-233 ns (1.2.10: 99 ns, -1).
    var b6 = bench_new("binomial(61, 30) (multiply-first path)");
    bench_batch_start(b6);
    i = 0;
    while (i < 1000000) { ganita_binomial(61, 30); i = i + 1; }
    bench_batch_stop(b6, 1000000);
    bench_report(b6);

    var b7 = bench_new("binomial(66, 33) (gcd path, last 10 steps)");
    bench_batch_start(b7);
    i = 0;
    while (i < 1000000) { ganita_binomial(66, 33); i = i + 1; }
    bench_batch_stop(b7, 1000000);
    bench_report(b7);

    # --- 1.2.11: f64_atan2 answers the whole C99 F.10.1.4 table ---
    # NaN, the signed zeros and the both-infinite rows are now decided on the magnitude
    # and sign bits before the atan(y/x) quotient, so every finite call pays for those
    # tests first. These two rows time that toll on finite non-zero pairs, where the two
    # bodies return identical bits (checked over 1,000,000 random pairs on x86_64 and
    # aarch64). Measured 57 ns against 53 ns on this host: a toll of 4 ns, about 7%.
    # Written as _f64_is_nan_pat / _f64_is_inf calls the same tests cost 12 ns, three
    # times as much (a scratch harness timing the three bodies side by side), which is
    # why ganita_f64_atan2 does them inline on the magnitude bits.
    bench_atan2(0, bench_new("f64_atan2 (C99 table)"));
    bench_atan2(1, bench_new("f64_atan2 (1.2.10 body, baseline)"));

    # --- 1.2.11: the hyperbolic family inside its old cancellation band ---
    # The rows price the accuracy fix where the 1.2.10 forms cancelled: sinh/tanh/
    # atanh/asinh at 1e-3 and acosh at 1 + 1e-3, which 1.2.10 had 285, 29, 104, 237
    # and 133 ulp off (up to 1.3e8 nearer the cutoffs), and asin at 0.99 on its new
    # (1 - |x|)(1 + |x|) branch. sinh and tanh now go through _gn_expm1, atanh/asinh/
    # acosh through _gn_log1p — plain f64 arithmetic, where the forms they replace
    # made one or two x87-native f64_exp / f64_ln calls. Measured against 1.2.10 on
    # this host (1e6 calls, three runs each, alternating): sinh 56 -> 80 ns, tanh
    # 55 -> 75, atanh 50 -> 74, asinh 46 -> 73, acosh 61 -> 77, asin 52 -> 53. The
    # two |x| = 5 rows price the reroute above 1, where nothing cancelled: about
    # 55 -> 108 ns each, which buys tanh's last points over 2 ulp (worst found on
    # [1, 20]: about 2.5 -> 0.9 ulp) and takes sinh's worst on [1, 22) from about
    # 1.5-1.6 to 1.3 ulp. The sinh(710) row prices _gn_exp_half past exp's overflow,
    # exp(|x| - c)·2^2042 where 1.2.10 had exp(|x| - ln 2), up to ~500 ulp off:
    # the same one exp plus a compare and two exact multiplies, 44 -> 52 ns.
    bench_hyp(1, 0x3F50624DD2F1A9FC, bench_new("f64_sinh(1e-3) (expm1 form)"));
    bench_hyp(2, 0x3F50624DD2F1A9FC, bench_new("f64_tanh(1e-3) (expm1 form)"));
    bench_hyp(3, 0x3F50624DD2F1A9FC, bench_new("f64_atanh(1e-3) (log1p form)"));
    bench_hyp(4, 0x3F50624DD2F1A9FC, bench_new("f64_asinh(1e-3) (log1p form)"));
    bench_hyp(5, 0x3FF004189374BC6A, bench_new("f64_acosh(1 + 1e-3) (log1p form)"));
    bench_hyp(6, 0x3FEFAE147AE147AE, bench_new("f64_asin(0.99) ((1-|x|)(1+|x|))"));
    bench_hyp(1, 0x4014000000000000, bench_new("f64_sinh(5) (expm1 form above 1)"));
    bench_hyp(2, 0x4014000000000000, bench_new("f64_tanh(5) (expm1 form above 1)"));
    bench_hyp(1, 0x4086300000000000, bench_new("f64_sinh(710) (past exp's overflow)"));

    # --- 1.2.11: tan vs the sin/cos quotient it replaces ---
    # ganita_f64_tan reduces once and runs one kernel; f64_sin(x) / f64_cos(x), the
    # only tangent before it, reduces twice, runs two kernels and divides, and is up
    # to 2 ulp off against tan's 1. Same 4096 arguments in [-8, 8) for both rows.
    # The accurate one is also faster — 5% to 24% across runs on a loaded host, not 2x:
    # tan's kernel alone costs about 2.4x sin's, and that gives back most of what
    # skipping the second reduction and kernel saves.
    # ganita_f32_tan is the f64 call plus a widen and a narrow, a few percent more.
    bench_tan(0, bench_new("f64_tan (fdlibm k_tan)"));
    bench_tan(1, bench_new("f64_sin / f64_cos (1.2.10 baseline)"));
    bench_tan(2, bench_new("f32_tan (widened onto f64_tan)"));

    # --- 1.2.12: the SVD is one-sided Jacobi on a pivoted QR ---
    # The Jacobi now starts from R^T (for n >= 4 from a second QR's), which is far
    # closer to orthogonal columns than A, so few sweeps remain. Against 1.2.11 on
    # these rows, medians of three interleaved runs pinned to one core: 3x3 1.00x,
    # 20x20 0.40x, 40x40 0.36x, and rank 40x40 above 0.41x. The zero-row 10x10 is the
    # filing's branch 3: 1.2.11 spent 726us returning -1 for it, 1.2.12 70us on the
    # answer. (3x3 values-only, not a row here, measured 1.15x in the svdh harness.)
    bench_svd(3, 0, 20000, bench_new("mat_svd 3x3 (full)"));
    bench_svd(20, 0, 20, bench_new("mat_svd 20x20 (full)"));
    bench_svd(40, 0, 5, bench_new("mat_svd 40x40 (full)"));
    bench_svd(10, 1, 200, bench_new("mat_svd 10x10, row 3 zero (1.2.11: -1)"));
    return 0;
}

var r = main();
syscall(60, r);
