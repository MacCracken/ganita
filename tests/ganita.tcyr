# ganita test suite — canonical ganita_* API + back-compat alias parity.
# Carries its own includes (auto-prepend skipped when includes present),
# mirroring how a consumer pulls lib/ganita.cyr + stdlib (+ stdlib math for
# the f64 builtin polyfills the transcendental fns need).

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/assert.cyr"
include "lib/math.cyr"

include "src/matrix.cyr"
include "src/linalg.cyr"
include "src/math_advanced.cyr"
include "src/math_f32.cyr"
include "src/_compat.cyr"

# --- linalg test helpers ------------------------------------------------
# Decomposition results are not bit-exact, so these compare within 1e-9.
# `ganita_mat_eq` is itself under test below; it is exercised directly first
# (both polarities) and only then used as a comparison tool.
fn t_d(n): i64 { return f64_from(n); }
# Comparison tolerance for the inexact decomposition results: 1e-9.
fn t_tol(): i64 { return f64_div(f64_from(1), f64_from(1000000000)); }
# True when two f64 values agree to within `t_tol()`.
fn t_dclose(got, want): i64 {
    if (f64_lt(f64_abs(f64_sub(got, want)), t_tol()) == 1) { return 1; }
    return 0;
}
# Build a 2x2 matrix from its four entries, row-major.
fn t_m2(a, b, c, d): i64 {
    var m = ganita_mat_new(2, 2);
    ganita_mat_set(m, 0, 0, a); ganita_mat_set(m, 0, 1, b);
    ganita_mat_set(m, 1, 0, c); ganita_mat_set(m, 1, 1, d);
    return m;
}
# Build a 3x3 matrix from its nine entries, row-major.
fn t_m3(a, b, c, d, e, f, g, h, i): i64 {
    var m = ganita_mat_new(3, 3);
    ganita_mat_set(m, 0, 0, a); ganita_mat_set(m, 0, 1, b); ganita_mat_set(m, 0, 2, c);
    ganita_mat_set(m, 1, 0, d); ganita_mat_set(m, 1, 1, e); ganita_mat_set(m, 1, 2, f);
    ganita_mat_set(m, 2, 0, g); ganita_mat_set(m, 2, 1, h); ganita_mat_set(m, 2, 2, i);
    return m;
}
# Heap-allocate a 2-element f64 array holding `a`, `b`.
fn t_arr2(a, b): i64 { var q = alloc(16); store64(q, a); store64(q + 8, b); return q; }
# Heap-allocate a 3-element f64 array holding `a`, `b`, `c`.
fn t_arr3(a, b, c): i64 {
    var q = alloc(24); store64(q, a); store64(q + 8, b); store64(q + 16, c); return q;
}
# Build the m x 3 Vandermonde for x = i/m and fill `out_b` with 2 + 3x - 4x^2.
# That quadratic lies EXACTLY in the column space, so the least-squares answer
# is the exact one and can be asserted tightly at any m. Returns the design
# matrix, or 0 if it could not be allocated.
fn t_quad_design(m, out_b): i64 {
    var a = ganita_mat_new(m, 3);
    if (a == 0) { return 0; }
    var i = 0;
    while (i < m) {
        var x = f64_div(f64_from(i), f64_from(m));
        ganita_mat_set(a, i, 0, f64_from(1));
        ganita_mat_set(a, i, 1, x);
        ganita_mat_set(a, i, 2, f64_mul(x, x));
        store64(out_b + i * 8, f64_add(f64_from(2),
            f64_sub(f64_mul(f64_from(3), x), f64_mul(f64_from(4), f64_mul(x, x)))));
        i = i + 1;
    }
    return a;
}

# --- f32 test helpers ---------------------------------------------------
# An f32 here is its IEEE-754 single bit pattern in the low 32 bits, the form
# f32_from / f32_to use. Constants are BUILT rather than hardcoded, except
# where the exact pattern is itself the assertion (sqrt 2).
fn t_f32(n): i64 { return f32_from(f64_from(n)); }
# The f32 pattern for the exact quotient a/b, built via f64 then narrowed.
fn t_f32div(a, b): i64 { return f32_from(f64_div(f64_from(a), f64_from(b))); }
# True when an f64 bit pattern is a NaN (max exponent, non-zero mantissa).
fn t_f64_is_nan(b): i64 {
    if (((b >> 52) & 0x7FF) != 0x7FF) { return 0; }
    if ((b & 0x000FFFFFFFFFFFFF) == 0) { return 0; }
    return 1;
}
# True when an f64 bit pattern is exactly +inf.
fn t_f64_is_pos_inf(b): i64 {
    if (b == 0x7FF0000000000000) { return 1; }
    return 0;
}
# True when an f32 bit pattern (low 32 bits) is a NaN.
fn t_is_nan(b): i64 {
    var lo = b & 0xFFFFFFFF;
    if ((lo & 0x7F800000) != 0x7F800000) { return 0; }
    if ((lo & 0x007FFFFF) == 0) { return 0; }
    return 1;
}

alloc_init();

test_group("matrix (canonical)");
var a = ganita_mat_new(3, 2);
assert_eq(ganita_mat_rows(a), 3, "rows");
assert_eq(ganita_mat_cols(a), 2, "cols");
var id = ganita_mat_identity(2);
assert_eq(ganita_mat_rows(id), 2, "identity rows");
assert_eq(ganita_mat_cols(id), 2, "identity cols");
assert_eq(ganita_mat_get(id, 0, 1), 0, "identity off-diagonal == 0.0 bits");

test_group("matrix: dimension guard (CWE-190 overflow)");
# Non-positive dims -> null (was: built a degenerate / wild matrix).
assert_eq(ganita_mat_new(0 - 1, 5), 0, "mat_new negative rows -> null");
assert_eq(ganita_mat_new(5, 0), 0, "mat_new zero cols -> null");
assert_eq(ganita_mat_new(0, 5), 0, "mat_new zero rows -> null");
# rows*cols so large that the old `16 + rows*cols*8` wrapped i64 into a tiny
# alloc, then the full-length zero-fill wrote past it (the heap overflow).
# Now rejected before the multiply.
assert_eq(ganita_mat_new(4611686018427387904, 8), 0, "mat_new wrap-inducing dims -> null");
# One element past the allocatable cap -> rejected without attempting a 256 MB+ alloc.
assert_eq(ganita_mat_new(33554431, 1), 0, "mat_new over element cap -> null");
# ADR 0002: the cap is a POLICY limit. The value is pinned so that changing it is a
# decision rather than an edit, and it must stay at or below what one allocation
# can hold, so the policy — not the allocator — is the limit a caller meets.
assert_eq(GANITA_MAT_MAX_ELEMS, 33554430, "GANITA_MAT_MAX_ELEMS is the ADR 0002 policy value");
assert_eq(GANITA_MAT_MAX_ELEMS <= (ALLOC_MAX - 16) / 8, 1,
  "the policy cap is at or below the allocator's per-allocation ceiling (ADR 0002)");
# A normal matrix is unaffected by the guard (fast path unchanged).
var mg = ganita_mat_new(8, 8);
assert_eq(ganita_mat_rows(mg), 8, "guarded mat_new still builds a valid 8x8");
assert_eq(ganita_mat_cols(mg), 8, "guarded 8x8 has correct cols");
# Derived dimension-taking constructors propagate the null.
assert_eq(ganita_mat_identity(0 - 1), 0, "mat_identity negative n -> null");
assert_eq(ganita_mat_from(0 - 1, 2, mg), 0, "mat_from negative rows -> null");

test_group("advanced math (canonical)");
assert_eq(ganita_binomial(5, 2), 10, "C(5,2)=10");
assert_eq(ganita_binomial(6, 3), 20, "C(6,3)=20");
assert_eq(ganita_fibonacci(10), ganita_fibonacci(9) + ganita_fibonacci(8), "fib recurrence");

test_group("f64_tanh saturation (regression: was inf/inf=NaN for large |x|)");
assert_eq(ganita_f64_tanh(f64_from(0)), f64_from(0), "tanh(0) = 0");
assert_eq(ganita_f64_tanh(f64_from(1000)), f64_from(1), "tanh(1000) saturates to 1 (was NaN)");
assert_eq(ganita_f64_tanh(f64_from(0 - 1000)), f64_from(0 - 1), "tanh(-1000) saturates to -1");
assert_eq(ganita_f64_tanh(f64_from(25)), f64_from(1), "tanh(25) (saturated) = 1");
assert_eq(ganita_f64_tanh(f64_from(20)), ganita_f64_tanh(f64_from(21)),
  "tanh bit-exact across the saturation boundary (formula 20 == saturated 21)");

# ========================================================================
# f32 scalar tier (1.1.0 API; tests added 1.1.2)
# ========================================================================
# Named constants, so an assertion reads as the float it is about.
var F_0    = t_f32(0);
var F_NZ   = 0x80000000;              # -0.0f
var F_1    = t_f32(1);
var F_2    = t_f32(2);
var F_3    = t_f32(3);
var F_4    = t_f32(4);
var F_5    = t_f32(5);
var F_8    = t_f32(8);
var F_M1   = t_f32(0 - 1);
var F_M2   = t_f32(0 - 2);
var F_M3   = t_f32(0 - 3);
var F_HALF = t_f32div(1, 2);          # 0.5f
var F_2H   = t_f32div(5, 2);          # 2.5f
var F_M2H  = t_f32div(0 - 5, 2);      # -2.5f
var F_INF  = 0x7F800000;
var F_NINF = 0xFF800000;

test_group("f32: arithmetic is NATIVE single precision, not widen-compute-narrow (1.2.0)");
assert_eq(ganita_f32_add(F_1, F_2), F_3, "1 + 2 = 3");
assert_eq(ganita_f32_sub(F_3, F_1), F_2, "3 - 1 = 2");
assert_eq(ganita_f32_mul(F_2, F_4), F_8, "2 * 4 = 8");
assert_eq(ganita_f32_div(F_8, F_4), F_2, "8 / 4 = 2");
assert_eq(ganita_f32_sub(F_1, F_1), F_0, "x - x = +0");
assert_eq(ganita_f32_add(F_M2, F_2), F_0, "-2 + 2 = +0 (not -0)");
assert_eq(ganita_f32_mul(F_M2, F_3), t_f32(0 - 6), "-2 * 3 = -6");
assert_eq(ganita_f32_div(F_1, F_3), 0x3EAAAAAB, "1/3 = 0x3EAAAAAB, the correctly-rounded single");

# ⭐ THE TEST THAT PINS THESE AS NATIVE. 2^24 is the last integer f32 represents
# exactly; 2^24+1 is not, and single-precision ties-to-even rounds it back DOWN to
# 2^24. A widen-compute-narrow implementation computes 16777217 exactly in f64 —
# and 16777217 is not representable in f32 either, so it too rounds to 2^24 on the
# way back. So this pair alone does not separate them; the CHAIN below does.
var F_2P24 = t_f32(16777216);
assert_eq(ganita_f32_add(F_2P24, F_1), F_2P24, "2^24 + 1 = 2^24 in single precision");

# Chained: (2^24 + 1) + 1. Native f32 rounds after EACH add, so the first one is
# already back at 2^24 and the second lands on 2^24 + 2 -> rounds to 2^24 again...
# an f64 accumulator would be sitting on 16777218, which IS representable in f32,
# and would come back as 2^24 + 2. This is the divergence the widened tier had.
assert_eq(ganita_f32_add(ganita_f32_add(F_2P24, F_1), F_1), F_2P24,
  "(2^24 + 1) + 1 = 2^24 natively; an f64 accumulator would give 2^24 + 2");

# Results are clean 32-bit patterns, like the rest of the tier.
assert_eq(ganita_f32_add(F_1, F_2) >> 32, 0, "add result has a clear high half");
assert_eq(ganita_f32_mul(F_M2, F_3) >> 32, 0, "mul result has a clear high half");

# Division edges: IEEE says finite/0 is a signed infinity, 0/0 is NaN.
assert_eq(ganita_f32_div(F_1, F_0), 0x7F800000, "1/0 = +inf");
assert_eq(ganita_f32_div(F_M1, F_0), 0xFF800000, "-1/0 = -inf");
assert_eq(t_is_nan(ganita_f32_div(F_0, F_0)), 1, "0/0 is NaN");

test_group("f32: min/max are sign-magnitude correct (the _f32_key story)");
# The trap, stated as an assertion: raw patterns order -1.0f BELOW -2.0f, and
# order every negative ABOVE every positive. A bare unsigned compare therefore
# gets both of the next two groups backwards while passing the easy one below.
assert_eq((F_M1 & 0xFFFFFFFF) < (F_M2 & 0xFFFFFFFF), 1,
  "raw f32 patterns: -1.0f sorts BELOW -2.0f (sign-magnitude reversal)");
assert_eq((F_M1 & 0xFFFFFFFF) > (F_1 & 0xFFFFFFFF), 1,
  "raw f32 patterns: -1.0f sorts ABOVE +1.0f (sign bit dominates)");

# Both negative — a naive unsigned min returns -1.0f here. The answer is -2.0f.
assert_eq(ganita_f32_min(F_M1, F_M2), F_M2, "min(-1,-2) = -2 (naive unsigned gives -1)");
assert_eq(ganita_f32_max(F_M1, F_M2), F_M1, "max(-1,-2) = -1 (naive unsigned gives -2)");
# Mixed sign — a naive unsigned min returns +1.0f here. The answer is -1.0f.
assert_eq(ganita_f32_min(F_M1, F_1), F_M1, "min(-1,1) = -1 (naive unsigned gives 1)");
assert_eq(ganita_f32_max(F_M1, F_1), F_1, "max(-1,1) = 1 (naive unsigned gives -1)");
# Non-negative — the case a naive implementation also passes. Kept so a
# regression that breaks the easy path is caught too, not as the real evidence.
assert_eq(ganita_f32_min(F_1, F_2), F_1, "min(1,2) = 1");
assert_eq(ganita_f32_max(F_1, F_2), F_2, "max(1,2) = 2");
# Operand order must not matter.
assert_eq(ganita_f32_min(F_M2, F_M1), ganita_f32_min(F_M1, F_M2), "min is commutative (both negative)");
assert_eq(ganita_f32_max(F_1, F_M1), ganita_f32_max(F_M1, F_1), "max is commutative (mixed sign)");
assert_eq(ganita_f32_min(F_M2, F_M2), F_M2, "min(x,x) = x");
# Signed zeros: -0.0f orders below +0.0f under the key.
assert_eq(ganita_f32_min(F_0, F_NZ), F_NZ, "min(+0,-0) = -0");
assert_eq(ganita_f32_max(F_0, F_NZ), F_0, "max(+0,-0) = +0");
# Infinities are ordinary under the key.
assert_eq(ganita_f32_min(F_NINF, F_1), F_NINF, "min(-inf,1) = -inf");
assert_eq(ganita_f32_max(F_NINF, F_1), F_1, "max(-inf,1) = 1");
assert_eq(ganita_f32_min(F_INF, F_1), F_1, "min(+inf,1) = 1");
assert_eq(ganita_f32_max(F_INF, F_1), F_INF, "max(+inf,1) = +inf");

test_group("f32: clamp");
assert_eq(ganita_f32_clamp(t_f32(0 - 5), F_M1, F_1), F_M1, "clamp below range -> lo");
assert_eq(ganita_f32_clamp(F_5, F_M1, F_1), F_1, "clamp above range -> hi");
assert_eq(ganita_f32_clamp(F_HALF, F_M1, F_1), F_HALF, "clamp inside range -> unchanged");
assert_eq(ganita_f32_clamp(F_M2, F_M3, F_M1), F_M2, "clamp inside an all-negative range");
assert_eq(ganita_f32_clamp(F_0, F_M3, F_M1), F_M1, "clamp 0 into an all-negative range -> hi");

test_group("f32: abs / neg / sign (pure bit ops, no widening)");
assert_eq(ganita_f32_abs(F_M2H), F_2H, "abs(-2.5) = 2.5");
assert_eq(ganita_f32_abs(F_2H), F_2H, "abs(2.5) = 2.5 (idempotent)");
assert_eq(ganita_f32_abs(F_NZ), F_0, "abs(-0) = +0");
assert_eq(ganita_f32_abs(F_NINF), F_INF, "abs(-inf) = +inf");
assert_eq(ganita_f32_neg(F_2H), F_M2H, "neg(2.5) = -2.5");
assert_eq(ganita_f32_neg(F_M2H), F_2H, "neg(-2.5) = 2.5 (involution)");
assert_eq(ganita_f32_neg(F_0), F_NZ, "neg(+0) = -0");
assert_eq(ganita_f32_neg(F_NZ), F_0, "neg(-0) = +0");
assert_eq(ganita_f32_neg(F_INF), F_NINF, "neg(+inf) = -inf");
assert_eq(ganita_f32_sign(F_M3), F_M1, "sign(-3) = -1.0f");
assert_eq(ganita_f32_sign(F_2), F_1, "sign(2) = 1.0f");
assert_eq(ganita_f32_sign(F_0), F_0, "sign(+0) = +0");
assert_eq(ganita_f32_sign(F_NZ), F_0, "sign(-0) = +0 (both zeros, per the API contract)");
assert_eq(ganita_f32_sign(F_NINF), F_M1, "sign(-inf) = -1.0f");
assert_eq(ganita_f32_sign(F_INF), F_1, "sign(+inf) = 1.0f");

test_group("f32: results stay clean 32-bit patterns");
# An f32 lives in the LOW 32 bits with the high half clear. Callers may hand in
# a value whose high half is dirty (a masked-off lane, a packed pair); every
# entry point masks, so nothing may leak upward into the result.
var F_DIRTY = 0x7FFFFFFF00000000 | F_M2;    # -2.0f with garbage above bit 31
assert_eq(ganita_f32_abs(F_DIRTY), F_2, "abs ignores a dirty high half");
assert_eq(ganita_f32_neg(F_DIRTY), F_2, "neg ignores a dirty high half");
assert_eq(ganita_f32_min(F_DIRTY, F_M1), F_M2, "min ignores a dirty high half");
assert_eq(ganita_f32_max(F_DIRTY, F_M1), F_M1, "max ignores a dirty high half");
assert_eq(ganita_f32_abs(F_DIRTY) >> 32, 0, "abs result has a clear high half");
assert_eq(ganita_f32_neg(F_DIRTY) >> 32, 0, "neg result has a clear high half");
assert_eq(ganita_f32_min(F_DIRTY, F_M1) >> 32, 0, "min result has a clear high half");
assert_eq(ganita_f32_sign(F_DIRTY), F_M1, "sign ignores a dirty high half");

test_group("f32: floor / ceil / trunc (exact widening)");
assert_eq(ganita_f32_floor(F_2H), F_2, "floor(2.5) = 2");
assert_eq(ganita_f32_floor(F_M2H), F_M3, "floor(-2.5) = -3 (toward -inf)");
assert_eq(ganita_f32_ceil(F_2H), F_3, "ceil(2.5) = 3");
assert_eq(ganita_f32_ceil(F_M2H), F_M2, "ceil(-2.5) = -2 (toward +inf)");
assert_eq(ganita_f32_trunc(F_2H), F_2, "trunc(2.5) = 2");
assert_eq(ganita_f32_trunc(F_M2H), F_M2, "trunc(-2.5) = -2 (toward zero, NOT floor)");
assert_eq(ganita_f32_trunc(t_f32div(0 - 1, 2)), F_NZ, "trunc(-0.5) = -0 (sign preserved)");
assert_eq(ganita_f32_floor(t_f32div(0 - 1, 2)), F_M1, "floor(-0.5) = -1 (differs from trunc)");
assert_eq(ganita_f32_floor(F_2), F_2, "floor of an integer is unchanged");
assert_eq(ganita_f32_ceil(F_M2), F_M2, "ceil of a negative integer is unchanged");
assert_eq(ganita_f32_trunc(F_M2), F_M2, "trunc of a negative integer is unchanged");

test_group("f32: lerp");
assert_eq(ganita_f32_lerp(F_0, t_f32(10), F_HALF), F_5, "lerp(0,10,0.5) = 5");
assert_eq(ganita_f32_lerp(F_M1, F_1, F_HALF), F_0, "lerp(-1,1,0.5) = 0 (spans the sign change)");
assert_eq(ganita_f32_lerp(F_2, F_8, F_0), F_2, "lerp(a,b,0) = a");
assert_eq(ganita_f32_lerp(F_2, F_8, F_1), F_8, "lerp(a,b,1) = b");
# 1.2.0: lerp is native f32 now, so it agrees with the same expression built from
# the arithmetic tier. Under the 1.1.x widened form the whole expression was one
# f64 computation rounded once, and this identity was not guaranteed.
var L_A = t_f32div(1, 3);
var L_B = t_f32div(7, 9);
var L_T = t_f32div(1, 7);
assert_eq(ganita_f32_lerp(L_A, L_B, L_T),
  ganita_f32_add(L_A, ganita_f32_mul(ganita_f32_sub(L_B, L_A), L_T)),
  "lerp(a,b,t) == a + (b-a)*t, rounding for rounding");

test_group("f32: sqrt is correctly rounded, not approximated");
assert_eq(ganita_f32_sqrt(F_4), F_2, "sqrt(4) = 2");
assert_eq(ganita_f32_sqrt(F_0), F_0, "sqrt(0) = 0");
assert_eq(ganita_f32_sqrt(t_f32(9)), F_3, "sqrt(9) = 3");
# f64 carries 53 mantissa bits vs f32's 24 (> 2*24+2), so computing in double
# and rounding once to single yields exactly the single-precision result —
# double-rounding cannot bite. 0x3FB504F3 is sqrtf(2).
assert_eq(ganita_f32_sqrt(F_2), 0x3FB504F3, "sqrt(2) = 0x3FB504F3, the correctly-rounded single");
assert_eq(t_is_nan(ganita_f32_sqrt(F_M1)), 1, "sqrt(-1) is NaN");

test_group("f32: transcendentals — exact identities");
assert_eq(ganita_f32_exp(F_0), F_1, "exp(0) = 1");
assert_eq(ganita_f32_ln(F_1), F_0, "ln(1) = 0");
assert_eq(ganita_f32_log2(F_8), F_3, "log2(8) = 3");
assert_eq(ganita_f32_exp2(F_3), F_8, "exp2(3) = 8");
assert_eq(ganita_f32_sin(F_0), F_0, "sin(0) = 0");
assert_eq(ganita_f32_cos(F_0), F_1, "cos(0) = 1");
assert_eq(ganita_f32_atan(F_0), F_0, "atan(0) = 0");
assert_eq(ganita_f32_pow(F_2, t_f32(10)), t_f32(1024), "pow(2,10) = 1024");
assert_eq(ganita_f32_pow(F_2, F_0), F_1, "pow(x,0) = 1");
assert_eq(ganita_f32_pow(t_f32(9), F_HALF), F_3, "pow(9,0.5) = 3");
assert_eq(ganita_f32_hypot(F_3, F_4), F_5, "hypot(3,4) = 5");
assert_eq(ganita_f32_hypot(F_0, F_0), F_0, "hypot(0,0) = 0");
assert_eq(ganita_f32_atan2(F_0, F_1), F_0, "atan2(0,1) = 0");
assert_eq(ganita_f32_atan2(F_1, F_0), 0x3FC90FDB, "atan2(1,0) = pi/2 (0x3FC90FDB)");
assert_eq(t_is_nan(ganita_f32_ln(F_M1)), 1, "ln(-1) is NaN");
assert_eq(ganita_f32_ln(F_0), F_NINF, "ln(0) = -inf");

test_group("f32: round is half-to-EVEN, not half-away-from-zero");
# Worth pinning explicitly: C's roundf(2.5) is 3.0. This lowers to the f64
# rounding intrinsic, which is round-half-to-even, so 2.5 -> 2 and 3.5 -> 4.
# A consumer porting from C will otherwise be quietly off by one on ties.
assert_eq(ganita_f32_round(F_2H), F_2, "round(2.5) = 2 (half-to-even; C roundf gives 3)");
assert_eq(ganita_f32_round(t_f32div(7, 2)), F_4, "round(3.5) = 4 (half-to-even)");
assert_eq(ganita_f32_round(F_M2H), F_M2, "round(-2.5) = -2 (half-to-even)");
assert_eq(ganita_f32_round(t_f32div(12, 5)), F_2, "round(2.4) = 2");
assert_eq(ganita_f32_round(t_f32div(13, 5)), F_3, "round(2.6) = 3");

test_group("f32: cbrt keeps the sign split (1.1.2 zero fix)");
# The sign split is required, not decorative: cbrt goes through pow, pow is
# exp(y*ln x), and ln of a negative is NaN — so a bare pow returns garbage for
# every negative input while looking perfect on the positives a naive test uses.
assert_eq(ganita_f32_cbrt(F_8), F_2, "cbrt(8) = 2");
assert_eq(ganita_f32_cbrt(t_f32(0 - 8)), F_M2, "cbrt(-8) = -2 (bare pow would give NaN)");
assert_eq(ganita_f32_cbrt(t_f32(27)), F_3, "cbrt(27) = 3");
assert_eq(ganita_f32_cbrt(t_f32(0 - 27)), F_M3, "cbrt(-27) = -3");
assert_eq(ganita_f32_cbrt(F_1), F_1, "cbrt(1) = 1");
# 1.1.2: zero used to reach pow, and ln(0) = -inf made cbrt(0) NaN.
assert_eq(ganita_f32_cbrt(F_0), F_0, "cbrt(0) = 0 (was NaN before 1.1.2)");
assert_eq(ganita_f32_cbrt(F_NZ), F_NZ, "cbrt(-0) = -0, sign of zero preserved");

test_group("f32: pow domain (gap closed in 1.1.4)");
# These two were a SELF-EXPIRING pair asserting the old NaN behaviour, so that
# the gap stayed measured rather than merely known. 1.1.4 fixed
# ganita_f64_pow's domain, they failed as designed, and they are now the real
# answers. f32 rounding absorbs the exp/ln core's ~2e-15 error, so these are
# exact bit comparisons.
assert_eq(ganita_f32_pow(F_0, F_2), F_0, "pow(0,2) = 0 (was NaN before 1.1.4)");
assert_eq(ganita_f32_pow(F_M2, F_2), t_f32(4), "pow(-2,2) = 4 (was NaN before 1.1.4)");
assert_eq(ganita_f32_pow(F_M2, F_3), t_f32(0 - 8), "pow(-2,3) = -8, sign from exponent parity");
assert_eq(t_is_nan(ganita_f32_pow(F_M2, F_HALF)), 1,
  "pow(-2,0.5) is still NaN — undefined in the reals, correctly left alone");

# ========================================================================
# linalg — decompositions and solvers (tests added 1.1.3)
# ========================================================================
# Reference matrices, each with a hand-computable answer.
#   A2 = [[4,3],[6,3]]         det = 4*3 - 3*6 = -6
#   SING = [[1,2],[2,4]]       row 2 = 2*row 1, so singular
#   SPD = [[4,2],[2,3]]        symmetric positive-definite
#   M3 = [[6,1,1],[4,-2,5],[2,8,7]]   det = -306 (cofactor expansion)
var A2   = t_m2(t_d(4), t_d(3), t_d(6), t_d(3));
var SING = t_m2(t_d(1), t_d(2), t_d(2), t_d(4));
var SPD  = t_m2(t_d(4), t_d(2), t_d(2), t_d(3));
var M3   = t_m3(t_d(6), t_d(1), t_d(1),
  t_d(4), t_d(0 - 2), t_d(5),
  t_d(2), t_d(8), t_d(7));
var I2 = ganita_mat_identity(2);
var I3 = ganita_mat_identity(3);

test_group("linalg: eq / is_symmetric / trace / norms");
# mat_eq is the comparison tool for everything below, so pin both polarities
# first — an eq that always returned 1 would make the whole suite vacuous.
assert_eq(ganita_mat_eq(A2, ganita_mat_copy(A2), t_tol()), 1, "eq: a matrix equals its copy");
assert_eq(ganita_mat_eq(A2, SPD, t_tol()), 0, "eq: different matrices are not equal");
assert_eq(ganita_mat_eq(I2, I3, t_tol()), 0, "eq: different shapes are not equal");
assert_eq(ganita_mat_is_symmetric(SPD, t_tol()), 1, "is_symmetric: [[4,2],[2,3]] is symmetric");
assert_eq(ganita_mat_is_symmetric(A2, t_tol()), 0, "is_symmetric: [[4,3],[6,3]] is not");
assert_eq(ganita_mat_is_symmetric(ganita_mat_new(2, 3), t_tol()), 0, "is_symmetric: non-square is never symmetric");
assert_eq(t_dclose(ganita_mat_trace(t_m2(t_d(1), t_d(2), t_d(3), t_d(4))), t_d(5)), 1, "trace[[1,2],[3,4]] = 5");
assert_eq(t_dclose(ganita_mat_trace(I3), t_d(3)), 1, "trace(I3) = 3");
# Frobenius = sqrt(sum of squares); 3-4-5 makes it exact.
assert_eq(t_dclose(ganita_mat_frobenius(t_m2(t_d(3), t_d(0), t_d(0), t_d(4))), t_d(5)), 1,
  "frobenius[[3,0],[0,4]] = 5");
# Infinity norm = max absolute ROW sum: rows are |1|+|-2|=3 and |3|+|4|=7.
assert_eq(t_dclose(ganita_mat_max_norm(t_m2(t_d(1), t_d(0 - 2), t_d(3), t_d(4))), t_d(7)), 1,
  "max_norm[[1,-2],[3,4]] = 7 (max row sum, not max element)");

test_group("linalg: copy / neg / row / col / set_row / set_col / submatrix");
# copy must be deep — mutating the original may not touch the copy.
var CP = ganita_mat_copy(A2);
ganita_mat_set(A2, 0, 0, t_d(99));
assert_eq(t_dclose(ganita_mat_get(CP, 0, 0), t_d(4)), 1, "copy is deep, not aliased");
ganita_mat_set(A2, 0, 0, t_d(4));
assert_eq(ganita_mat_eq(ganita_mat_neg(ganita_mat_neg(A2)), A2, t_tol()), 1, "neg is an involution");
assert_eq(t_dclose(ganita_mat_get(ganita_mat_neg(A2), 0, 0), t_d(0 - 4)), 1, "neg negates elements");
var ROW = ganita_mat_row(M3, 1);
assert_eq(t_dclose(load64(ROW), t_d(4)), 1, "mat_row: row 1 element 0");
assert_eq(t_dclose(load64(ROW + 8), t_d(0 - 2)), 1, "mat_row: row 1 element 1");
var COL = ganita_mat_col(M3, 2);
assert_eq(t_dclose(load64(COL), t_d(1)), 1, "mat_col: col 2 element 0");
assert_eq(t_dclose(load64(COL + 16), t_d(7)), 1, "mat_col: col 2 element 2");
var SR = ganita_mat_copy(A2);
ganita_mat_set_row(SR, 0, t_arr2(t_d(7), t_d(8)));
assert_eq(t_dclose(ganita_mat_get(SR, 0, 1), t_d(8)), 1, "set_row writes the row");
assert_eq(t_dclose(ganita_mat_get(SR, 1, 0), t_d(6)), 1, "set_row leaves other rows alone");
var SC = ganita_mat_copy(A2);
ganita_mat_set_col(SC, 1, t_arr2(t_d(7), t_d(8)));
assert_eq(t_dclose(ganita_mat_get(SC, 1, 1), t_d(8)), 1, "set_col writes the column");
assert_eq(t_dclose(ganita_mat_get(SC, 0, 0), t_d(4)), 1, "set_col leaves other columns alone");
# submatrix bounds are [r0..r1) x [c0..c1) — half-open.
var SUB = ganita_mat_submatrix(M3, 0, 0, 2, 2);
assert_eq(ganita_mat_rows(SUB), 2, "submatrix rows");
assert_eq(ganita_mat_cols(SUB), 2, "submatrix cols");
assert_eq(t_dclose(ganita_mat_get(SUB, 1, 1), t_d(0 - 2)), 1, "submatrix copies the right elements");

test_group("linalg: LU decomposition + determinant");
var LU = ganita_mat_new(2, 2);
var PIV = alloc(16);
var SGN = ganita_mat_lu(A2, LU, PIV);
# Partial pivoting swaps row 0 and 1 here (|6| > |4|), so the sign flips once.
assert_eq(SGN, 0 - 1, "lu returns the pivot sign (-1 after one row swap)");
# L is unit lower triangular, U upper — packed together in one matrix.
# Reconstructing L*U and undoing the pivot must give back A.
assert_eq(t_dclose(ganita_mat_get(LU, 0, 0), t_d(6)), 1, "lu: U[0][0] is the pivot, 6");
assert_eq(t_dclose(ganita_mat_det(A2), t_d(0 - 6)), 1, "det[[4,3],[6,3]] = -6");
assert_eq(t_dclose(ganita_mat_det(M3), t_d(0 - 306)), 1, "det of the 3x3 = -306");
assert_eq(t_dclose(ganita_mat_det(I3), t_d(1)), 1, "det(I3) = 1");
# Singular: no pivot survives, so lu reports 0 and det is exactly 0.
assert_eq(ganita_mat_lu(SING, ganita_mat_new(2, 2), alloc(16)), 0, "lu of a singular matrix returns 0");
assert_eq(t_dclose(ganita_mat_det(SING), t_d(0)), 1, "det of a singular matrix = 0");
# det(A) = det(A^T) — a property the pivoting must not break.
assert_eq(t_dclose(ganita_mat_det(ganita_mat_transpose(M3)), ganita_mat_det(M3)), 1,
  "det(A^T) = det(A)");

test_group("linalg: lu_solve");
# [[4,3],[6,3]] x = [10,12]  ->  x = [1,2]
var LU2 = ganita_mat_new(2, 2);
var PIV2 = alloc(16);
ganita_mat_lu(A2, LU2, PIV2);
var X2 = alloc(16);
assert_eq(ganita_mat_lu_solve(LU2, PIV2, t_arr2(t_d(10), t_d(12)), X2), 0, "lu_solve returns 0");
assert_eq(t_dclose(load64(X2), t_d(1)), 1, "lu_solve x0 = 1");
assert_eq(t_dclose(load64(X2 + 8), t_d(2)), 1, "lu_solve x1 = 2");
# 3x3 round trip: solve M3 x = M3 * [1,2,3], recover [1,2,3].
var LU3 = ganita_mat_new(3, 3);
var PIV3 = alloc(24);
ganita_mat_lu(M3, LU3, PIV3);
var B3 = t_arr3(t_d(6 + 2 + 3), t_d(4 - 4 + 15), t_d(2 + 16 + 21));
var X3 = alloc(24);
ganita_mat_lu_solve(LU3, PIV3, B3, X3);
assert_eq(t_dclose(load64(X3), t_d(1)), 1, "lu_solve 3x3 x0 = 1");
assert_eq(t_dclose(load64(X3 + 8), t_d(2)), 1, "lu_solve 3x3 x1 = 2");
assert_eq(t_dclose(load64(X3 + 16), t_d(3)), 1, "lu_solve 3x3 x2 = 3");

test_group("linalg: inverse");
# The defining property, checked both ways round.
assert_eq(ganita_mat_eq(ganita_mat_mul(A2, ganita_mat_inv(A2)), I2, t_tol()), 1, "A * inv(A) = I");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_inv(A2), A2), I2, t_tol()), 1, "inv(A) * A = I");
assert_eq(ganita_mat_eq(ganita_mat_mul(M3, ganita_mat_inv(M3)), I3, t_tol()), 1, "3x3: A * inv(A) = I");
assert_eq(ganita_mat_eq(ganita_mat_inv(I3), I3, t_tol()), 1, "inv(I) = I");
assert_eq(ganita_mat_eq(ganita_mat_inv(ganita_mat_inv(A2)), A2, t_tol()), 1, "inv is an involution");
# Singular input returns the null pointer rather than a garbage matrix.
assert_eq(ganita_mat_inv(SING), 0, "inv of a singular matrix returns 0, not garbage");

test_group("linalg: Cholesky (symmetric positive-definite only)");
var L = ganita_mat_new(2, 2);
assert_eq(ganita_mat_cholesky(SPD, L), 1, "cholesky succeeds on an SPD matrix");
# A = L*L^T is the whole contract.
assert_eq(ganita_mat_eq(ganita_mat_mul(L, ganita_mat_transpose(L)), SPD, t_tol()), 1,
  "cholesky: L * L^T = A");
assert_eq(t_dclose(ganita_mat_get(L, 0, 1), t_d(0)), 1, "cholesky: L is lower triangular");
assert_eq(t_dclose(ganita_mat_get(L, 0, 0), t_d(2)), 1, "cholesky: L[0][0] = sqrt(4) = 2");
# Symmetric but NOT positive-definite: [[1,2],[2,1]] has eigenvalues 3 and -1.
assert_eq(ganita_mat_cholesky(t_m2(t_d(1), t_d(2), t_d(2), t_d(1)), ganita_mat_new(2, 2)), 0,
  "cholesky rejects a symmetric non-positive-definite matrix");
# Solve [[4,2],[2,3]] x = [10,11] -> x = [1,3].
var CX = alloc(16);
assert_eq(ganita_mat_cholesky_solve(L, t_arr2(t_d(10), t_d(11)), CX), 0, "cholesky_solve returns 0");
assert_eq(t_dclose(load64(CX), t_d(1)), 1, "cholesky_solve x0 = 1");
assert_eq(t_dclose(load64(CX + 8), t_d(3)), 1, "cholesky_solve x1 = 3");

test_group("linalg: QR (Householder)");
var Q = ganita_mat_new(2, 2);
var R = ganita_mat_new(2, 2);
assert_eq(ganita_mat_qr(A2, Q, R), 0, "qr returns 0");
assert_eq(ganita_mat_eq(ganita_mat_mul(Q, R), A2, t_tol()), 1, "qr: Q * R = A");
# Orthogonality is the property that makes QR worth having.
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_transpose(Q), Q), I2, t_tol()), 1,
  "qr: Q^T * Q = I (Q is orthogonal)");
assert_eq(t_dclose(ganita_mat_get(R, 1, 0), t_d(0)), 1, "qr: R is upper triangular");
# Non-square input: 3x2 gives a 3x3 Q and a 3x2 R.
var A32 = ganita_mat_new(3, 2);
ganita_mat_set(A32, 0, 0, t_d(1)); ganita_mat_set(A32, 0, 1, t_d(0));
ganita_mat_set(A32, 1, 0, t_d(0)); ganita_mat_set(A32, 1, 1, t_d(1));
ganita_mat_set(A32, 2, 0, t_d(1)); ganita_mat_set(A32, 2, 1, t_d(1));
var Q3 = ganita_mat_new(3, 3);
var R32 = ganita_mat_new(3, 2);
ganita_mat_qr(A32, Q3, R32);
assert_eq(ganita_mat_eq(ganita_mat_mul(Q3, R32), A32, t_tol()), 1, "qr: Q * R = A for a 3x2");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_transpose(Q3), Q3), I3, t_tol()), 1,
  "qr: Q^T * Q = I for a 3x2");

test_group("linalg: Gaussian elimination (augmented, in place)");
# [[4,3|10],[6,3|12]] -> solution [1,2] written back into the last column.
var AUG = ganita_mat_new(2, 3);
ganita_mat_set(AUG, 0, 0, t_d(4)); ganita_mat_set(AUG, 0, 1, t_d(3)); ganita_mat_set(AUG, 0, 2, t_d(10));
ganita_mat_set(AUG, 1, 0, t_d(6)); ganita_mat_set(AUG, 1, 1, t_d(3)); ganita_mat_set(AUG, 1, 2, t_d(12));
assert_eq(ganita_mat_gaussian_elim(AUG), 1, "gaussian_elim returns 1 on success");
assert_eq(t_dclose(ganita_mat_get(AUG, 0, 2), t_d(1)), 1, "gaussian_elim x0 = 1 (in the last column)");
assert_eq(t_dclose(ganita_mat_get(AUG, 1, 2), t_d(2)), 1, "gaussian_elim x1 = 2");
# Same solution as lu_solve on the same system — two independent paths agreeing.
assert_eq(t_dclose(ganita_mat_get(AUG, 0, 2), load64(X2)), 1, "gaussian_elim agrees with lu_solve");
var AUGS = ganita_mat_new(2, 3);
ganita_mat_set(AUGS, 0, 0, t_d(1)); ganita_mat_set(AUGS, 0, 1, t_d(2)); ganita_mat_set(AUGS, 0, 2, t_d(3));
ganita_mat_set(AUGS, 1, 0, t_d(2)); ganita_mat_set(AUGS, 1, 1, t_d(4)); ganita_mat_set(AUGS, 1, 2, t_d(6));
assert_eq(ganita_mat_gaussian_elim(AUGS), 0, "gaussian_elim returns 0 on a singular system");

test_group("linalg: least squares (via QR)");
# Overdetermined but CONSISTENT: x=1, y=2 satisfies all three rows exactly,
# so the least-squares solution is the exact one and can be asserted tightly.
var LSA = ganita_mat_new(3, 2);
ganita_mat_set(LSA, 0, 0, t_d(1)); ganita_mat_set(LSA, 0, 1, t_d(0));
ganita_mat_set(LSA, 1, 0, t_d(0)); ganita_mat_set(LSA, 1, 1, t_d(1));
ganita_mat_set(LSA, 2, 0, t_d(1)); ganita_mat_set(LSA, 2, 1, t_d(1));
var LSX = alloc(16);
assert_eq(ganita_mat_least_squares(LSA, t_arr3(t_d(1), t_d(2), t_d(3)), LSX), 0, "least_squares returns 0");
assert_eq(t_dclose(load64(LSX), t_d(1)), 1, "least_squares x0 = 1");
assert_eq(t_dclose(load64(LSX + 8), t_d(2)), 1, "least_squares x1 = 2");
# ⭐ THE 5793 REGRESSION (filed by naad, 2026-08-23; fixed 1.2.2). Through 1.2.1
# least_squares went through ganita_mat_qr, whose contract is an explicit m x m
# Q — so this 5793 x 3 design (17,379 elements, 0.05% of the cap) made it ask
# for a 5793^2 = 33,558,849-element Q, just OVER the cap. mat_new returned 0,
# nothing checked it, and qr stored through the null: SIGSEGV on in-contract
# arguments. m is now bounded only by memory, so the assertion that discriminates
# is simply that a design past the old m ≈ 5792 ceiling SOLVES, and solves right.
var BIGB = alloc(5793 * 8);
var BIGA = t_quad_design(5793, BIGB);
assert_eq(BIGA != 0, 1, "least_squares: a 5793x3 design allocates (0.05% of the cap)");
var BIGX = alloc(24);
assert_eq(ganita_mat_least_squares(BIGA, BIGB, BIGX), 0,
  "least_squares at m=5793 returns 0 (was SIGSEGV — the m x m Q is gone)");
assert_eq(t_dclose(load64(BIGX), t_d(2)), 1, "least_squares m=5793: c0 = 2");
assert_eq(t_dclose(load64(BIGX + 8), t_d(3)), 1, "least_squares m=5793: c1 = 3");
assert_eq(t_dclose(load64(BIGX + 16), t_d(0 - 4)), 1, "least_squares m=5793: c2 = -4");
# The small consistent system above and the large one agree on the same shape of
# answer, which is what pins the reflector-on-b path as equivalent to forming Q.

test_group("linalg: allocation failure is reported, never written through (1.2.2)");
# 1.2.2 checked every internal allocation. 1.2.3 then added the shape and range
# PRECONDITIONS, and those fire first — which makes most of the cap-driven
# allocation failures structurally unreachable, because the only inputs that
# produced them are exactly the inputs now rejected. That is the better outcome,
# and it is what these assertions record. The allocation checks all remain, and
# still guard genuine out-of-memory; there is simply no longer a legal argument
# that reaches them through the element cap.
# mat_mul is the one that is still reachable: both operands legal, the PRODUCT
# past the cap (8000x1 * 1x8000 = 64M elements).
var MMA = ganita_mat_new(8000, 1);
var MMB = ganita_mat_new(1, 8000);
assert_eq(MMA != 0, 1, "mat_mul guard: the 8000x1 operand is itself legal");
assert_eq(MMB != 0, 1, "mat_mul guard: the 1x8000 operand is itself legal");
assert_eq(ganita_mat_mul(MMA, MMB), 0, "mat_mul -> null when the product exceeds the cap");

test_group("hardening: shape and range preconditions (1.2.3)");
# ⭐ Every assertion here covers a path that, before 1.2.3, READ OR WROTE OUT OF
# BOUNDS and then reported success. Each was reproduced by the P(-1) sweep with a
# program that either printed a neighbouring allocation's contents as data or
# died with SIGSEGV. The inputs are all matrices ganita_mat_new accepted.
var H23 = ganita_mat_new(2, 3);
var H32 = ganita_mat_new(3, 2);
var H22 = ganita_mat_new(2, 2);
assert_eq(H23 != 0 && H32 != 0 && H22 != 0, 1, "hardening: the fixtures are themselves legal matrices");

# mat_add / mat_sub took their shape from A alone and read B for rows(a)*cols(a)
# words whatever B's real size was.
assert_eq(ganita_mat_add(H23, H22), 0, "mat_add -> null on a shape mismatch (was an OOB read of B)");
assert_eq(ganita_mat_sub(H23, H22), 0, "mat_sub -> null on a shape mismatch (was an OOB read of B)");
assert_eq(ganita_mat_add(H23, H23) != 0, 1, "mat_add still builds when the shapes agree");
# mat_mul derived its inner dimension from cols(A) and never read rows(B).
assert_eq(ganita_mat_mul(H23, H23), 0, "mat_mul -> null when rows(B) != cols(A) (was an OOB read of B)");
assert_eq(ganita_mat_mul(H23, H32) != 0, 1, "mat_mul still builds when the inner dimensions agree");
# Null operands used to be dereferenced immediately.
assert_eq(ganita_mat_add(0, H22), 0, "mat_add -> null for a null operand");
assert_eq(ganita_mat_mul(H22, 0), 0, "mat_mul -> null for a null operand");
assert_eq(ganita_mat_transpose(0), 0, "mat_transpose -> null for a null operand");
assert_eq(ganita_mat_copy(0), 0, "mat_copy -> null for a null operand");

# set_row / set_col WRITE, so an out-of-range index was an OOB write: index ==
# rows landed on the next allocation's {rows, cols} header, and a negative index
# walked back into the target's own header.
assert_eq(ganita_mat_set_row(H23, 2, t_arr3(t_d(1), t_d(2), t_d(3))), 0 - 2,
  "set_row -> -2 for r == rows (was a write onto the NEXT matrix's header)");
assert_eq(ganita_mat_set_row(H23, 0 - 1, t_arr3(t_d(1), t_d(2), t_d(3))), 0 - 2,
  "set_row -> -2 for a negative index (was a write into its OWN header)");
assert_eq(ganita_mat_set_col(H23, 3, t_arr2(t_d(1), t_d(2))), 0 - 2, "set_col -> -2 for c == cols");
assert_eq(ganita_mat_set_row(H23, 1, t_arr3(t_d(1), t_d(2), t_d(3))), 0, "set_row still works in range");
assert_eq(t_dclose(ganita_mat_get(H23, 1, 2), t_d(3)), 1, "set_row wrote the right element");
# row / col read, and were unchecked in the same way.
assert_eq(ganita_mat_row(H23, 2), 0, "mat_row -> null for r == rows");
assert_eq(ganita_mat_col(H23, 0 - 1), 0, "mat_col -> null for a negative index");
assert_eq(ganita_mat_row(H23, 1) != 0, 1, "mat_row still works in range");

# submatrix validated only the SIGN of the extent, never the window against the
# source, so a window past the end copied a neighbouring allocation.
assert_eq(ganita_mat_submatrix(H23, 0, 0, 3, 3), 0, "submatrix -> null for a window past the source");
assert_eq(ganita_mat_submatrix(H23, 0 - 1, 0, 2, 2), 0, "submatrix -> null for a negative origin");
assert_eq(ganita_mat_submatrix(H23, 0, 0, 0, 0), 0, "submatrix -> null for an empty range");
assert_eq(ganita_mat_submatrix(H23, 0, 0, 2, 2) != 0, 1, "submatrix still works for a window inside the source");

# trace / lu / det / inv / cholesky took n from the ROW count and read n*n
# elements out of a store holding only rows*cols.
assert_eq(t_f64_is_nan(ganita_mat_trace(H32)), 1, "trace -> NaN for a non-square (was an OOB diagonal walk)");
assert_eq(t_dclose(ganita_mat_trace(ganita_mat_identity(3)), t_d(3)), 1, "trace still works on a square matrix");
assert_eq(ganita_mat_lu(H32, ganita_mat_new(3, 3), alloc(24)), 0, "mat_lu -> 0 for a non-square input");
assert_eq(t_f64_is_nan(ganita_mat_det(H32)), 1, "det -> NaN for a non-square input");
assert_eq(ganita_mat_inv(H32), 0, "inv -> null for a non-square input");
assert_eq(ganita_mat_cholesky(H32, ganita_mat_new(3, 3)), 0, "cholesky -> 0 for a non-square input");

# gaussian_elim indexes column n on an n-row matrix; an n x n argument wrote one
# element past the store on every row and still returned 1.
assert_eq(ganita_mat_gaussian_elim(H22), 0, "gaussian_elim -> 0 for an n x n argument (was an OOB write)");

# least_squares back-substitutes from row cols-1, so a wide design read past qtb
# and R and returned 0 with out_x full of NaN.
assert_eq(ganita_mat_least_squares(H23, t_arr2(t_d(1), t_d(2)), alloc(24)), 0 - 2,
  "least_squares -> -2 for an under-determined system (was OOB, then success with NaN)");

# The SVD family documents m >= n and never enforced it; pseudo_inv returned
# something that was not the Moore-Penrose pseudoinverse at all for a wide input.
assert_eq(ganita_mat_svd(H23, ganita_mat_new(2, 3), alloc(24), ganita_mat_new(3, 3)), 0 - 2,
  "svd -> -2 for a wide matrix");
assert_eq(ganita_mat_rank(H23, t_tol()), 0 - 2, "rank -> -2 for a wide matrix");
assert_eq(t_f64_is_nan(ganita_mat_condition(H23)), 1, "condition -> NaN for a wide matrix");
assert_eq(ganita_mat_pseudo_inv(H23), 0, "pseudo_inv -> null for a wide matrix");
assert_eq(ganita_mat_rank(H32, f64_neg(t_tol())), 0 - 2, "rank -> -2 for a negative tolerance");
# eigen_sym requires a square input and an n x n out_vecs.
assert_eq(ganita_mat_eigen_sym(H23, alloc(24), ganita_mat_new(3, 3)), 0 - 2,
  "eigen_sym -> -2 for a non-square input (was a write past its working copy)");
assert_eq(ganita_mat_eigen_sym(H22, alloc(16), ganita_mat_new(3, 3)), 0 - 2,
  "eigen_sym -> -2 when out_vecs is not n x n");

test_group("hardening: NaN fails CLOSED, and semi-definite is not definite (1.2.3)");
# ⭐ mat_eq is the comparison tool this suite uses to check the decompositions.
# Every f64 comparison is false against a NaN, so `if (diff > tol) return 0;`
# never fired and the loop fell through to `return 1`: an all-NaN matrix
# compared EQUAL to the identity, and a solver that returned NaN would have been
# certified correct by its own suite. That is why this one is starred.
var NANM = ganita_mat_new(2, 2);
var NANV = f64_div(t_d(0), t_d(0));
ganita_mat_set(NANM, 0, 0, NANV); ganita_mat_set(NANM, 0, 1, NANV);
ganita_mat_set(NANM, 1, 0, NANV); ganita_mat_set(NANM, 1, 1, NANV);
assert_eq(t_f64_is_nan(ganita_mat_get(NANM, 0, 0)), 1, "the NaN fixture really holds NaN");
assert_eq(ganita_mat_eq(NANM, I2, t_tol()), 0, "mat_eq: an all-NaN matrix is NOT equal to the identity");
assert_eq(ganita_mat_eq(NANM, NANM, t_tol()), 0, "mat_eq: NaN is not even equal to itself");
assert_eq(ganita_mat_is_symmetric(NANM, t_tol()), 0, "is_symmetric: an all-NaN matrix is NOT symmetric");
assert_eq(ganita_mat_eq(I2, I2, t_tol()), 1, "mat_eq still reports genuinely equal matrices as equal");
assert_eq(ganita_mat_eq(0, I2, t_tol()), 0, "mat_eq -> 0 for a null operand");

# Cholesky's pivot guard was `diag < 0`, strictly less than, so a pivot of
# exactly zero passed: [1 2; 2 4] is symmetric with det 0 and eigenvalues 0 and
# 5 — positive SEMI-definite, which is not positive-definite — and it returned 1
# with a zero on L's diagonal, after which cholesky_solve divided by that zero
# and returned success having written NaN.
var SEMI = t_m2(t_d(1), t_d(2), t_d(2), t_d(4));
var SEMIL = ganita_mat_new(2, 2);
assert_eq(ganita_mat_cholesky(SEMI, SEMIL), 0,
  "cholesky -> 0 for a positive-SEMI-definite matrix (semi-definite is not definite)");
var ZEROM = ganita_mat_new(2, 2);
assert_eq(ganita_mat_cholesky(ZEROM, ganita_mat_new(2, 2)), 0, "cholesky -> 0 for the zero matrix");
assert_eq(ganita_mat_cholesky(NANM, ganita_mat_new(2, 2)), 0, "cholesky -> 0 for a NaN diagonal");
# The genuinely definite case is untouched, and so is the strictly-indefinite one.
var PD = t_m2(t_d(4), t_d(1), t_d(1), t_d(3));
var PDL = ganita_mat_new(2, 2);
assert_eq(ganita_mat_cholesky(PD, PDL), 1, "cholesky still succeeds on a positive-definite matrix");
assert_eq(ganita_mat_eq(ganita_mat_mul(PDL, ganita_mat_transpose(PDL)), PD, t_tol()), 1,
  "cholesky: L * L^T = A for the definite case");
assert_eq(ganita_mat_cholesky(t_m2(t_d(1), t_d(3), t_d(3), t_d(1)), ganita_mat_new(2, 2)), 0,
  "cholesky -> 0 for a strictly indefinite matrix (the pre-1.2.3 guard caught this one)");

test_group("linalg: symmetric eigendecomposition (Jacobi)");
# [[2,1],[1,2]] has eigenvalues 3 and 1, eigenvectors (1,1)/sqrt2 and (1,-1)/sqrt2.
var EM = t_m2(t_d(2), t_d(1), t_d(1), t_d(2));
var EVAL = alloc(16);
var EVEC = ganita_mat_new(2, 2);
assert_eq(ganita_mat_eigen_sym(EM, EVAL, EVEC) >= 0, 1, "eigen_sym converges (non-negative iterations)");
assert_eq(t_dclose(load64(EVAL), t_d(3)), 1, "eigen_sym lambda0 = 3");
assert_eq(t_dclose(load64(EVAL + 8), t_d(1)), 1, "eigen_sym lambda1 = 1");
# Two invariants that hold regardless of eigenvalue ordering.
assert_eq(t_dclose(f64_add(load64(EVAL), load64(EVAL + 8)), ganita_mat_trace(EM)), 1,
  "eigen_sym: sum of eigenvalues = trace");
assert_eq(t_dclose(f64_mul(load64(EVAL), load64(EVAL + 8)), ganita_mat_det(EM)), 1,
  "eigen_sym: product of eigenvalues = determinant");
# A*v = lambda*v for the first eigenvector (columns of out_vecs).
var V0 = ganita_mat_col(EVEC, 0);
var AV0 = f64_add(f64_mul(ganita_mat_get(EM, 0, 0), load64(V0)),
  f64_mul(ganita_mat_get(EM, 0, 1), load64(V0 + 8)));
assert_eq(t_dclose(AV0, f64_mul(load64(EVAL), load64(V0))), 1,
  "eigen_sym: A*v = lambda*v for eigenvector 0");
# Eigenvectors are orthonormal for a symmetric matrix.
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_transpose(EVEC), EVEC), I2, t_tol()), 1,
  "eigen_sym: eigenvectors are orthonormal");
# Already-diagonal input must be left alone.
var DIAG = t_m2(t_d(5), t_d(0), t_d(0), t_d(7));
var DVAL = alloc(16);
ganita_mat_eigen_sym(DIAG, DVAL, ganita_mat_new(2, 2));
assert_eq(t_dclose(f64_add(load64(DVAL), load64(DVAL + 8)), t_d(12)), 1,
  "eigen_sym on a diagonal matrix returns its diagonal");

test_group("linalg: SVD");
var SM = t_m2(t_d(3), t_d(0), t_d(0), t_d(2));
var SU = ganita_mat_new(2, 2);
var SIG = alloc(16);
var SVT = ganita_mat_new(2, 2);
assert_eq(ganita_mat_svd(SM, SU, SIG, SVT), 0, "svd returns 0");
assert_eq(t_dclose(load64(SIG), t_d(3)), 1, "svd sigma0 = 3 (largest first)");
assert_eq(t_dclose(load64(SIG + 8), t_d(2)), 1, "svd sigma1 = 2");
assert_eq(f64_ge(load64(SIG), load64(SIG + 8)), 1, "svd singular values are sorted descending");
# U * diag(sigma) * V^T must reconstruct A.
assert_eq(ganita_mat_eq(
    ganita_mat_mul(ganita_mat_mul(SU, t_m2(load64(SIG), t_d(0), t_d(0), load64(SIG + 8))), SVT),
    SM, t_tol()), 1, "svd: U * Sigma * V^T = A");
# Singular values of a non-diagonal matrix still reconstruct it.
var SU2 = ganita_mat_new(2, 2);
var SIG2 = alloc(16);
var SVT2 = ganita_mat_new(2, 2);
ganita_mat_svd(A2, SU2, SIG2, SVT2);
assert_eq(ganita_mat_eq(
    ganita_mat_mul(ganita_mat_mul(SU2, t_m2(load64(SIG2), t_d(0), t_d(0), load64(SIG2 + 8))), SVT2),
    A2, t_tol()), 1, "svd: reconstruction holds for a non-diagonal matrix");
# Product of singular values = |det| for a square matrix.
assert_eq(t_dclose(f64_mul(load64(SIG2), load64(SIG2 + 8)), f64_abs(ganita_mat_det(A2))), 1,
  "svd: product of singular values = |det|");

test_group("linalg: pseudo-inverse / rank / condition");
# For an invertible matrix the pseudo-inverse IS the inverse.
assert_eq(ganita_mat_eq(ganita_mat_pseudo_inv(A2), ganita_mat_inv(A2), t_tol()), 1,
  "pseudo_inv = inv for an invertible matrix");
# Moore-Penrose property 1, which also holds for the singular case.
assert_eq(ganita_mat_eq(
    ganita_mat_mul(ganita_mat_mul(A2, ganita_mat_pseudo_inv(A2)), A2), A2, t_tol()), 1,
  "pseudo_inv: A * A+ * A = A");
var RTOL = f64_div(t_d(1), t_d(1000000));
assert_eq(ganita_mat_rank(I2, RTOL), 2, "rank(I2) = 2");
assert_eq(ganita_mat_rank(I3, RTOL), 3, "rank(I3) = 3");
assert_eq(ganita_mat_rank(SING, RTOL), 1, "rank of a rank-deficient matrix = 1");
assert_eq(ganita_mat_rank(A2, RTOL), 2, "rank of a full-rank 2x2 = 2");
assert_eq(t_dclose(ganita_mat_condition(I2), t_d(1)), 1, "condition(I) = 1 (perfectly conditioned)");
# Documented sentinel: -1.0 for a singular matrix, not +inf and not a crash.
assert_eq(t_dclose(ganita_mat_condition(SING), t_d(0 - 1)), 1,
  "condition of a singular matrix = -1 (documented sentinel)");
# cond = sigma_max / sigma_min, and it is >= 1 for anything well-formed.
assert_eq(f64_ge(ganita_mat_condition(A2), t_d(1)), 1, "condition >= 1 for a non-singular matrix");

test_group("hardening: tolerances are RELATIVE, so verdicts are scale-invariant (1.2.4)");
# ⭐ LINALG_EPS was compared DIRECTLY against pivots, norms and singular values,
# so "is this matrix singular?" depended on the caller's units. The identity
# scaled by 1e-20 is still perfectly conditioned — cond = 1 — but through 1.2.3
# `det` called it singular, `inv` returned null and `condition` returned -1.0,
# while `rank` said full rank. The library contradicted ITSELF about one matrix.
#
# These assertions pin BOTH directions: a well-conditioned matrix must not be
# called singular at any scale, and a singular one must stay singular at any
# scale. A one-directional test would pass on a tolerance of zero.
fn t_scaled_ident(n, s): i64 {
    var m = ganita_mat_new(n, n);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < n) { ganita_mat_set(m, i, i, s); i = i + 1; }
    return m;
}
# 1e-20 and 1e10, the two ends that used to break in opposite ways.
var TINY_S = f64_div(t_d(1), f64_mul(t_d(10000000000), t_d(10000000000)));
var HUGE_S = f64_from(10000000000);
var ID_TINY = t_scaled_ident(2, TINY_S);
var ID_HUGE = t_scaled_ident(2, HUGE_S);
assert_eq(ganita_mat_det(ID_TINY) & 0x7FFFFFFFFFFFFFFF == 0, 0,
  "det(I * 1e-20) is NOT zero — cond is 1, the matrix is not singular");
assert_eq(ganita_mat_inv(ID_TINY) != 0, 1, "inv(I * 1e-20) succeeds (was null)");
assert_eq(t_dclose(ganita_mat_condition(ID_TINY), t_d(1)), 1,
  "condition(I * 1e-20) = 1 (was -1.0, i.e. 'singular')");
assert_eq(ganita_mat_rank(ID_TINY, f64_mul(LINALG_EPS, TINY_S)), 2, "rank(I * 1e-20) = 2");
assert_eq(ganita_mat_inv(ID_HUGE) != 0, 1, "inv(I * 1e10) succeeds");
assert_eq(t_dclose(ganita_mat_condition(ID_HUGE), t_d(1)), 1, "condition(I * 1e10) = 1");
# The other direction: [1 2; 2 4] is singular at every scale.
var SG_1 = t_m2(t_d(1), t_d(2), t_d(2), t_d(4));
var SG_BIG = t_m2(t_d(1000000000), t_d(2000000000), t_d(2000000000), t_d(4000000000));
assert_eq(ganita_mat_det(SG_1) & 0x7FFFFFFFFFFFFFFF == 0, 1, "det[1 2; 2 4] = 0 (singular)");
assert_eq(ganita_mat_inv(SG_1), 0, "inv[1 2; 2 4] -> null");
assert_eq(ganita_mat_det(SG_BIG) & 0x7FFFFFFFFFFFFFFF == 0, 1,
  "det of the SAME matrix scaled by 1e9 is still 0 — scaling up must not hide singularity");
assert_eq(ganita_mat_inv(SG_BIG), 0, "inv of the scaled singular matrix is still null");
assert_eq(t_dclose(ganita_mat_condition(SG_BIG), f64_neg(t_d(1))), 1,
  "condition of the scaled singular matrix is still -1.0");
# LINALG_EPS is EAGER now: it reads its value with no decomposition having run.
assert_eq(LINALG_EPS != 0, 1, "LINALG_EPS is initialised eagerly, not on first decomposition");
assert_eq(t_dclose(LINALG_EPS, f64_div(t_d(1), t_d(1000000000000))), 1, "LINALG_EPS = 1e-12");

# The scaled two-norm: qr and least_squares used a raw sum of squares, which
# overflowed to NaN for large-magnitude matrices while still returning success.
var LSQ_BIG = ganita_mat_new(3, 2);
var BIGV = f64_mul(f64_mul(t_d(1000000000), t_d(1000000000)), f64_mul(t_d(1000000000), t_d(1000000000)));
var bi2 = 0;
while (bi2 < 3) {
    ganita_mat_set(LSQ_BIG, bi2, 0, BIGV);
    ganita_mat_set(LSQ_BIG, bi2, 1, f64_mul(BIGV, t_d(bi2 + 1)));
    bi2 = bi2 + 1;
}
var BIGQ = ganita_mat_new(3, 3);
var BIGR = ganita_mat_new(3, 2);
assert_eq(ganita_mat_qr(LSQ_BIG, BIGQ, BIGR), 0, "qr accepts a matrix of ~1e36 entries");
assert_eq(t_f64_is_nan(ganita_mat_get(BIGR, 0, 0)), 0,
  "qr's R is not NaN at 1e36 (the unscaled two-norm used to overflow)");

test_group("hardening: math domains and overflow (1.2.3)");
# ⭐ asinh was only correct for x >= 0. It is an ODD function, so |asinh(-x)|
# must equal asinh(x) — but ln(x + sqrt(x*x+1)) at a negative x subtracts two
# nearly equal quantities and the significant digits cancel. Below about -2^26
# the sum rounded to 0 and the answer was -inf; below -1.34e154 the x*x
# overflowed first and the answer came back +inf, wrong in SIGN as well.
# Oddness is the assertion that discriminates, and it is checked bit-for-bit
# across all four regimes of the implementation (x = 1 is the 1.2.11 log1p one).
assert_eq(ganita_f64_asinh(f64_neg(t_d(1))), f64_neg(ganita_f64_asinh(t_d(1))),
  "asinh is odd at x = 1 (bit-exact)");
assert_eq(ganita_f64_asinh(f64_neg(t_d(10))), f64_neg(ganita_f64_asinh(t_d(10))),
  "asinh is odd at x = 10 (the cancellation regime)");
var ABIG = f64_mul(t_d(1000000000), t_d(1000000000));
assert_eq(ganita_f64_asinh(f64_neg(ABIG)), f64_neg(ganita_f64_asinh(ABIG)),
  "asinh is odd at x = 1e18 (was +inf, wrong in sign)");
var ATINY = f64_div(t_d(1), t_d(1000000000000000000));
assert_eq(ganita_f64_asinh(f64_neg(ATINY)), f64_neg(ganita_f64_asinh(ATINY)),
  "asinh is odd at x = 1e-18 (the underflow regime)");
# Values, not just symmetry: asinh(1) = ln(1 + sqrt 2), asinh(1e18) ~ 42.1396788545.
assert_eq(t_dclose(ganita_f64_asinh(t_d(1)), f64_ln(f64_add(t_d(1), f64_sqrt(t_d(2))))), 1,
  "asinh(1) = ln(1 + sqrt 2)");
assert_eq(t_dclose(ganita_f64_asinh(ABIG), f64_add(f64_ln(ABIG), f64_ln(t_d(2)))), 1,
  "asinh(1e18) = ln(x) + ln 2 and is FINITE (was +inf)");
# asinh(tiny) = tiny. The general form computes ln(1 + tiny) as ln(1.0) = 0
# exactly, so everything below ~1e-17 came back as a hard zero.
assert_eq(ganita_f64_asinh(ATINY), ATINY, "asinh(1e-18) = 1e-18, not 0.0");
assert_eq(ganita_f64_asinh(t_d(0)), t_d(0), "asinh(0) = 0");

# ⭐ binomial's own comment claimed it used "symmetry + iterative multiply to
# avoid overflow". Symmetry halves the multiplies; it does nothing about the
# size of the answer. `result * (n - i)` wrapped i64 silently from n = 62 up and
# returned plausible-looking wrong counts, sometimes negative.
assert_eq(ganita_binomial(52, 5), 2598960, "binomial(52,5) = 2598960 (a poker hand)");
assert_eq(ganita_binomial(61, 30), 232714176627630544,
  "binomial(61,30) is EXACT (every product on the way fits: the multiply-first path throughout)");
assert_eq(ganita_binomial(62, 30), 450883717216034179,
  "binomial(62,30) is EXACT: the value fits, so neither a wrap (<= 1.2.2) nor a refusal (1.2.3-1.2.10)");
assert_eq(ganita_binomial(5, 2), 10, "binomial(5,2) = 10 unchanged");
assert_eq(ganita_binomial(2, 5), 0, "binomial(k > n) = 0 unchanged");
# The overflow test also bounds the loop: binomial(2^62, 2^61) used to run
# min(k, n-k) = 2.3e18 times, about 560 years (CWE-834). It now returns at once.
assert_eq(ganita_binomial(4611686018427387904, 2305843009213693952), 0 - 1,
  "binomial(2^62, 2^61) -> -1 immediately (was an unbounded loop)");
# Negative arguments used to skip the loop body and return 1.
assert_eq(ganita_binomial(0 - 3, 2), 0 - 1, "binomial with a negative n -> -1 (was 1)");
assert_eq(ganita_binomial(3, 0 - 2), 0 - 1, "binomial with a negative k -> -1 (was 1)");
assert_eq(ganita_fibonacci(0 - 5), 0 - 1, "fibonacci(-5) -> -1 (was 1)");
assert_eq(ganita_fibonacci(10), 55, "fibonacci(10) = 55 unchanged");

# ⭐ f32 sine and cosine past 2^63. Through 1.1.x they returned their ARGUMENT
# there (the old f64 routine reduced only within the i64 range); 1.2.x guarded
# that with NaN. Since cyrius 6.6.9 f64_sin/f64_cos reduce every finite argument
# within 1 ulp, so 1.2.9 dropped the guard and these are the correctly rounded
# f32 values (reference: libm sin/cos of the exact f32 input, rounded to f32).
# Inputs as f32 bit literals: 2^70 = 0x62800000, 2^63 = 0x5F000000, FLT_MAX = 0x7F7FFFFF.
assert_eq(ganita_f32_sin(0x62800000), 0xBF7F88AF, "f32_sin(2^70) = -0.99817944 (was NaN in 1.2.x)");
assert_eq(ganita_f32_cos(0x62800000), 0x3D770CB4, "f32_cos(2^70) = 0.06031485 (was NaN in 1.2.x)");
assert_eq(ganita_f32_sin(0xE2800000), 0x3F7F88AF, "f32_sin(-2^70) = -f32_sin(2^70)");
# At the old guard boundary and at the top of the f32 range, the result is in
# [-1, 1] and matches the reference bits.
assert_eq(ganita_f32_sin(0x5F000000), 0x3F7FFB70, "f32_sin(2^63) = 0.99993038 (the old guard's boundary)");
assert_eq(ganita_f32_cos(0x5F000000), 0x3C41551C, "f32_cos(2^63) = 0.01180008");
assert_eq(ganita_f32_sin(0x7F7FFFFF), 0xBF0599B3, "f32_sin(FLT_MAX) = -0.52155596");
assert_eq(ganita_f32_cos(0x7F7FFFFF), 0x3F5A5F96, "f32_cos(FLT_MAX) = 0.85301548");
assert_eq(f64_le(f64_abs(f32_to(ganita_f32_cos(0x7F7FFFFF))), t_d(1)), 1,
  "f32_cos(FLT_MAX) is in [-1, 1], as every result must be");
# The ordinary range is untouched.
assert_eq(t_dclose(f32_to(ganita_f32_sin(t_f32(0))), t_d(0)), 1, "f32_sin(0) = 0 unchanged");
assert_eq(f64_lt(f64_abs(f32_to(ganita_f32_sin(t_f32(1)))), t_d(1)) , 1,
  "f32_sin(1) is in range, as every in-range result must be");
# NaN and infinity still give NaN: there is no sine of infinity.
assert_eq(t_is_nan(ganita_f32_sin(0x7F800000)), 1, "f32_sin(+inf) -> NaN");
assert_eq(t_is_nan(ganita_f32_cos(0xFF800000)), 1, "f32_cos(-inf) -> NaN");

test_group("binomial: exact whenever C(n, k) fits in i64 (1.2.11)");
# ⭐ Filed as docs/development/issues/archived/2026-09-30-binomial-refuses-representable-values.md
# (found by abaco 2.4.8, whose evaluator began reporting the -1 as a math error).
# 1.2.3 to 1.2.10 refused whenever C(n, i)·(n - i) did not fit, and that product is
# (i + 1)·C(n, i + 1): every C(n, k) above i64_MAX / min(k, n - k) came back -1
# although it fits — 113 of the 2500 values with n <= 70 that fit. 1.2.11 divides
# through gcd(C(n, i), i + 1) first when the product would wrap, so the only
# product it forms is the next coefficient. Expected values are exact integers from
# Python's math.comb; -1 marks a true value above i64_MAX.
var BN_MAX = 0x7FFFFFFFFFFFFFFF;

# The filing's table: every value fits, and 1.2.10 returned -1 for each. Rows 6-8
# are also the LAST n whose C(n, k) fits, for k = 2, 3, 4.
assert_eq(ganita_binomial(62, 28), 349615716557887465,
  "C(62,28) exact: 1.2.10's first refusal in (n, k) order, the smallest with n <= 70");
assert_eq(ganita_binomial(62, 31), 465428353255261088,
  "C(62,31) exact: binomial's own comment named it as a value which fits");
assert_eq(ganita_binomial(66, 33), 7219428434016265740, "C(66,33) exact: the largest central coefficient in i64");
assert_eq(ganita_binomial(67, 29), 7886597962249166160, "C(67,29) exact: the largest 1.2.10 refused with n <= 70");
assert_eq(ganita_binomial(3037000501, 2), 4611686020018625250,
  "C(3037000501,2) exact: 1.2.10's first refusal at k = 2");
assert_eq(ganita_binomial(4294967296, 2), 9223372034707292160,
  "C(2^32,2) = 2^63 - 2^31 exact: the last n that fits at k = 2");
assert_eq(ganita_binomial(3810779, 3), 9223371416043870029, "C(3810779,3) exact: the last n that fits at k = 3");
assert_eq(ganita_binomial(121977, 4), 9223148185681446450, "C(121977,4) exact: the last n that fits at k = 4");

# Controls, right on 1.2.10 as well: the refusal stays exactly where the value
# leaves i64, and values that never needed the gcd step are unchanged.
assert_eq(ganita_binomial(67, 33), 0 - 1, "C(67,33) = 14226520737620288370 > i64_MAX -> -1");
assert_eq(ganita_binomial(4294967297, 2), 0 - 1, "C(2^32+1,2) > i64_MAX -> -1: the first n that overflows at k = 2");
assert_eq(ganita_binomial(3810780, 3), 0 - 1, "C(3810780,3) > i64_MAX -> -1: the first n that overflows at k = 3");
assert_eq(ganita_binomial(BN_MAX, 2), 0 - 1, "C(i64_MAX,2) > i64_MAX -> -1");
assert_eq(ganita_binomial(BN_MAX, 1), BN_MAX, "C(i64_MAX,1) = i64_MAX exact");
assert_eq(ganita_binomial(3037000500, 2), 4611686016981624750, "C(3037000500,2) exact: 1.2.10's last answer at k = 2");

# The k = 2/3/4 boundaries. With rows 6-8 above (last n that fits) and the two
# controls before, this completes last-fits / first-overflows for each k.
assert_eq(ganita_binomial(121978, 4), 0 - 1, "C(121978,4) > i64_MAX -> -1: the first n that overflows at k = 4");
# Where 1.2.10's refusal band began: the last n answered by multiplying first all
# the way, then the first n whose final step needs the gcd division.
assert_eq(ganita_binomial(2642246, 3), 3074454030718368980, "C(2642246,3) exact (multiply-first throughout)");
assert_eq(ganita_binomial(2642247, 3), 3074457521449010115, "C(2642247,3) exact (gcd step; 1.2.10 refused)");
assert_eq(ganita_binomial(86251, 4), 2305765318049421250, "C(86251,4) exact (multiply-first throughout)");
assert_eq(ganita_binomial(86252, 4), 2305872254572844375, "C(86252,4) exact (gcd step; 1.2.10 refused)");

# Mirrors: C(n, n - k) folds to C(n, k), so each side gives the same answer.
assert_eq(ganita_binomial(4294967296, 4294967294), 9223372034707292160, "C(2^32,2^32-2) = C(2^32,2) exact");
assert_eq(ganita_binomial(4294967297, 4294967295), 0 - 1, "C(2^32+1,2^32-1) = C(2^32+1,2) -> -1");
assert_eq(ganita_binomial(67, 38), 7886597962249166160, "C(67,38) = C(67,29) exact");
assert_eq(ganita_binomial(3810779, 3810776), 9223371416043870029, "C(3810779,3810776) = C(3810779,3) exact");
assert_eq(ganita_binomial(121978, 121974), 0 - 1, "C(121978,121974) = C(121978,4) -> -1");
assert_eq(ganita_binomial(BN_MAX, BN_MAX - 1), BN_MAX, "C(i64_MAX,i64_MAX-1) = i64_MAX exact");
assert_eq(ganita_binomial(BN_MAX, BN_MAX), 1, "C(i64_MAX,i64_MAX) = 1");
assert_eq(ganita_binomial(BN_MAX, 0), 1, "C(i64_MAX,0) = 1");
# CWE-834: a huge min(k, n - k) still refuses within a few iterations, never 2^62.
assert_eq(ganita_binomial(BN_MAX, 4611686018427387904), 0 - 1, "C(i64_MAX,2^62) -> -1 at once");

# The private Euclid helper, directly (the binomial rows reach it only inside the loop).
assert_eq(_gn_gcd(12, 18), 6, "_gn_gcd(12,18) = 6");
assert_eq(_gn_gcd(18, 12), 6, "_gn_gcd(18,12) = 6 (argument order does not matter)");
assert_eq(_gn_gcd(4611686018427387904, 3298534883328), 1099511627776, "_gn_gcd(2^62, 3*2^40) = 2^40");
# F(92) and F(91), the largest consecutive Fibonacci pair in i64: Euclid's worst case (Lamé).
assert_eq(_gn_gcd(7540113804746346429, 4660046610375530309), 1, "_gn_gcd(F92, F91) = 1");
assert_eq(_gn_gcd(BN_MAX, BN_MAX), BN_MAX, "_gn_gcd(i64_MAX, i64_MAX) = i64_MAX");
assert_eq(_gn_gcd(1, BN_MAX), 1, "_gn_gcd(1, i64_MAX) = 1");

# Every C(n, k), 0 <= k <= n <= 70, against Pascal's rule built by addition alone,
# with -1 marking a cell above i64_MAX (two non-negative terms either fit or fail
# a > MAX - b): an oracle independent of the function under test. Stores the cell
# count, the oracle's -1 count and the cells binomial gets wrong at out, out + 8,
# out + 16; returns the wrong count.
fn t_bn_pascal(out): i64 {
    var prev = alloc(72 * 8);
    var cur = alloc(72 * 8);
    var cells = 0;
    var over = 0;
    var wrong = 0;
    var n = 0;
    while (n <= 70) {
        var k = 0;
        while (k <= n) {
            var c = 1;
            if (k > 0 && k < n) {
                var a = load64(prev + (k - 1) * 8);
                var b = load64(prev + k * 8);
                if (a < 0 || b < 0) { c = 0 - 1; }
                else { if (a > BN_MAX - b) { c = 0 - 1; } else { c = a + b; } }
            }
            store64(cur + k * 8, c);
            if (c < 0) { over = over + 1; }
            if (ganita_binomial(n, k) != c) { wrong = wrong + 1; }
            cells = cells + 1;
            k = k + 1;
        }
        var t = prev;
        prev = cur;
        cur = t;
        n = n + 1;
    }
    store64(out, cells);
    store64(out + 8, over);
    store64(out + 16, wrong);
    return wrong;
}
var BN_SW = alloc(24);
t_bn_pascal(BN_SW);
assert_eq(load64(BN_SW), 2556, "the sweep visits all 2556 cells with 0 <= k <= n <= 70");
assert_eq(load64(BN_SW + 8), 56, "Pascal's rule puts 56 of them above i64_MAX, as math.comb does");
assert_eq(load64(BN_SW + 16), 0, "every C(n,k) with n <= 70 matches Pascal's triangle (1.2.10: 113 refused)");

test_group("linalg/math: f64 pow domain (1.1.4)");
# pow is exp(y * ln base); ln is undefined at and below zero, so every base <= 0
# returned NaN before 1.1.4. pow(0,y) and integral pow(negative,y) are ordinary
# defined operations and are now handled ahead of the exp/ln path.
assert_eq(t_dclose(ganita_f64_pow(t_d(0), t_d(2)), t_d(0)), 1, "pow(0,2) = 0 (was NaN)");
assert_eq(t_dclose(ganita_f64_pow(t_d(0), t_d(3)), t_d(0)), 1, "pow(0,3) = 0");
assert_eq(t_dclose(ganita_f64_pow(t_d(0), f64_div(t_d(1), t_d(2))), t_d(0)), 1,
  "pow(0,0.5) = 0 (a non-integral exponent on zero is still zero)");
assert_eq(t_f64_is_pos_inf(ganita_f64_pow(t_d(0), t_d(0 - 2))), 1, "pow(0,-2) = +inf");
assert_eq(t_dclose(ganita_f64_pow(t_d(0 - 2), t_d(2)), t_d(4)), 1, "pow(-2,2) = 4 (was NaN)");
assert_eq(t_dclose(ganita_f64_pow(t_d(0 - 2), t_d(3)), t_d(0 - 8)), 1,
  "pow(-2,3) = -8 (odd exponent keeps the sign)");
assert_eq(t_dclose(ganita_f64_pow(t_d(0 - 2), t_d(10)), t_d(1024)), 1, "pow(-2,10) = 1024 (even exponent)");
# The negative path is exactly -(positive path) — it adds no error of its own.
assert_eq(ganita_f64_pow(t_d(0 - 2), t_d(3)), f64_neg(ganita_f64_pow(t_d(2), t_d(3))),
  "pow(-x,odd) is bit-identical to -pow(x,odd)");
# x^0 = 1 for every x, checked ahead of the zero and negative branches.
assert_eq(t_dclose(ganita_f64_pow(t_d(0), t_d(0)), t_d(1)), 1, "pow(0,0) = 1");
assert_eq(t_dclose(ganita_f64_pow(t_d(0 - 2), t_d(0)), t_d(1)), 1, "pow(-2,0) = 1");
# A non-integral exponent on a negative base has no real result. NaN is correct
# and must NOT be papered over.
assert_eq(t_f64_is_nan(ganita_f64_pow(t_d(0 - 3), f64_div(t_d(1), t_d(2)))), 1,
  "pow(-3,0.5) is NaN — no real square root of a negative");
assert_eq(t_f64_is_nan(ganita_f64_pow(t_d(0 - 8), f64_div(t_d(1), t_d(3)))), 1,
  "pow(-8,1/3) is NaN — which is why ganita_f32_cbrt keeps its sign split");
# Regressions: the positive path is untouched.
assert_eq(t_dclose(ganita_f64_pow(t_d(2), t_d(10)), t_d(1024)), 1, "pow(2,10) = 1024 unchanged");
assert_eq(t_dclose(ganita_f64_pow(t_d(9), f64_div(t_d(1), t_d(2))), t_d(3)), 1, "pow(9,0.5) = 3 unchanged");
assert_eq(t_dclose(ganita_f64_pow(t_d(2), t_d(0 - 2)), f64_div(t_d(1), t_d(4))), 1, "pow(2,-2) = 0.25 unchanged");

test_group("hardening: SVD no longer forms A^T A (1.2.4)");
# ⭐ Forming A^T A SQUARES the condition number, so half the available precision
# was spent before the eigensolver started. The discriminating input is one whose
# ENTRIES are all O(1) but whose singular values are not — a diagonal matrix does
# not discriminate, because A^T A is then exact.
#
# A = [[1, 1], [1, 1+e]] has det = e, so sigma1 ~ 2 and sigma2 ~ e/2. The
# invariant sigma1 * sigma2 = |det A| holds for every SVD, so it is the test.
# Through 1.2.3 sigma2 came back EXACTLY ZERO at e = 1e-9 — for a matrix that
# ganita_mat_det and ganita_mat_inv both handle correctly — which made rank
# report 1 and condition report "singular" for an invertible matrix.
fn t_near_singular(e): i64 {
    var a = ganita_mat_new(2, 2);
    if (a == 0) { return 0; }
    ganita_mat_set(a, 0, 0, t_d(1)); ganita_mat_set(a, 0, 1, t_d(1));
    ganita_mat_set(a, 1, 0, t_d(1)); ganita_mat_set(a, 1, 1, f64_add(t_d(1), e));
    return a;
}
# Ratio sigma1*sigma2 / |det| must be 1. Checked at 1e-6 and 1e-9, both of which
# the A^T A path got wrong (4.5e-5 out, then a hard zero).
var SVE9 = f64_div(t_d(1), t_d(1000000000));
var SVA9 = t_near_singular(SVE9);
var SVU = ganita_mat_new(2, 2);
var SVS = alloc(16);
var SVVT = ganita_mat_new(2, 2);
assert_eq(ganita_mat_svd(SVA9, SVU, SVS, SVVT), 0, "svd converges on a near-singular matrix");
assert_eq(load64(SVS + 8) & 0x7FFFFFFFFFFFFFFF == 0, 0,
  "sigma2 is NOT zero at e=1e-9 (the A^T A path collapsed it to exactly 0)");
# The bound is RELATIVE and deliberately loose: cond(A) is about 4/e = 4e9 here,
# so roughly 9 of f64's ~16 digits are genuinely unavailable and the measured
# error is 5.3e-8. 1e-6 sits comfortably above that and enormously below the
# 1.0 the A^T A path produced by returning sigma2 = 0. A tight absolute bound
# would be asserting precision the problem does not contain.
assert_eq(f64_lt(f64_abs(f64_sub(f64_div(f64_mul(load64(SVS), load64(SVS + 8)), SVE9), t_d(1))),
    f64_div(t_d(1), t_d(1000000))), 1,
  "sigma1 * sigma2 = |det A| to 1e-6 relative at e=1e-9 (the old path was 100% out)");
# At e=1e-6 the conditioning is mild enough to demand much more.
var SVE6 = f64_div(t_d(1), t_d(1000000));
var SVA6 = t_near_singular(SVE6);
var SVS6 = alloc(16);
assert_eq(ganita_mat_svd(SVA6, ganita_mat_new(2, 2), SVS6, ganita_mat_new(2, 2)), 0, "svd at e=1e-6");
assert_eq(f64_lt(f64_abs(f64_sub(f64_div(f64_mul(load64(SVS6), load64(SVS6 + 8)), SVE6), t_d(1))),
    f64_div(t_d(1), t_d(1000000000))), 1,
  "sigma1 * sigma2 = |det A| to 1e-9 relative at e=1e-6 (the old path was 4.5e-5 out)");
assert_eq(ganita_mat_rank(SVA9, f64_div(t_d(1), t_d(1000000000000))), 2,
  "rank = 2 at e=1e-9 — the matrix IS invertible, and det/inv always agreed");
assert_eq(t_dclose(ganita_mat_det(SVA9), SVE9), 1, "det agrees: it is e, not 0");
assert_eq(ganita_mat_inv(SVA9) != 0, 1, "inv succeeds, as it always did — now rank agrees with it");

# The reconstruction properties every SVD must satisfy, on a tall matrix.
var SVB = ganita_mat_new(3, 2);
ganita_mat_set(SVB, 0, 0, t_d(1)); ganita_mat_set(SVB, 0, 1, t_d(2));
ganita_mat_set(SVB, 1, 0, t_d(3)); ganita_mat_set(SVB, 1, 1, t_d(4));
ganita_mat_set(SVB, 2, 0, t_d(5)); ganita_mat_set(SVB, 2, 1, t_d(6));
var SVU2 = ganita_mat_new(3, 2);
var SVS2 = alloc(16);
var SVV2 = ganita_mat_new(2, 2);
assert_eq(ganita_mat_svd(SVB, SVU2, SVS2, SVV2), 0, "svd of a 3x2 succeeds");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_transpose(SVU2), SVU2), I2, t_tol()), 1,
  "U^T U = I — U's columns are orthonormal");
assert_eq(ganita_mat_eq(ganita_mat_mul(SVV2, ganita_mat_transpose(SVV2)), I2, t_tol()), 1,
  "V^T V = I — V is orthogonal");
var SVSM = ganita_mat_new(2, 2);
ganita_mat_set(SVSM, 0, 0, load64(SVS2)); ganita_mat_set(SVSM, 1, 1, load64(SVS2 + 8));
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_mul(SVU2, SVSM), SVV2), SVB, t_tol()), 1,
  "U * diag(sigma) * V^T = A — the factorisation reconstructs");
assert_eq(f64_ge(load64(SVS2), load64(SVS2 + 8)) , 1, "singular values come back descending");
# Moore-Penrose, through the rebuilt SVD.
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_mul(SVB, ganita_mat_pseudo_inv(SVB)), SVB), SVB, t_tol()), 1,
  "A A+ A = A");
# The zero matrix has a defined SVD and used to divide by its own zero scale.
var SVZ = ganita_mat_new(2, 2);
var SVZU = ganita_mat_new(2, 2);
var SVZS = alloc(16);
var SVZV = ganita_mat_new(2, 2);
assert_eq(ganita_mat_svd(SVZ, SVZU, SVZS, SVZV), 0, "svd of the zero matrix succeeds");
assert_eq(load64(SVZS) & 0x7FFFFFFFFFFFFFFF == 0, 1, "zero matrix: every singular value is 0");
assert_eq(ganita_mat_eq(SVZV, I2, t_tol()), 1, "zero matrix: V is the identity");

test_group("hardening: f32 NaN/inf semantics and the new comparators (1.2.4)");
# The f32 NaN pattern, and a couple of finite fixtures.
var FNAN = f32_from(f64_div(t_d(0), t_d(0)));
var FNEGNAN = FNAN | 0x80000000;
var FINF = 0x7F800000;
var FNEGINF = 0xFF800000;
assert_eq(t_is_nan(FNAN), 1, "the NaN fixture really is an f32 NaN");
assert_eq(t_is_nan(FNEGNAN), 1, "the negative-NaN fixture is a NaN too");

# ⭐ min/max were a TOTAL ORDER over the raw key, so a NaN won or lost purely by
# its SIGN BIT: a negative NaN beat every finite value, a positive one lost to
# every finite value. Arbitrary, and not what fminf or Rust's f32::min do.
# IEEE-754 minNum/maxNum ignore a NaN operand and return NaN only if both are.
assert_eq(ganita_f32_min(FNAN, t_f32(3)), t_f32(3), "min(NaN, 3) = 3 — the NaN is ignored");
assert_eq(ganita_f32_min(FNEGNAN, t_f32(3)), t_f32(3),
  "min(-NaN, 3) = 3 — a NEGATIVE NaN used to win, purely by its sign bit");
assert_eq(ganita_f32_min(t_f32(3), FNAN), t_f32(3), "min(3, NaN) = 3 — order does not matter");
assert_eq(ganita_f32_max(FNAN, t_f32(3)), t_f32(3), "max(NaN, 3) = 3");
assert_eq(ganita_f32_max(FNEGNAN, t_f32(3)), t_f32(3), "max(-NaN, 3) = 3");
assert_eq(t_is_nan(ganita_f32_min(FNAN, FNAN)), 1, "min(NaN, NaN) is NaN — only when BOTH are");
assert_eq(t_is_nan(ganita_f32_max(FNAN, FNEGNAN)), 1, "max(NaN, -NaN) is NaN");
# The sign-magnitude ordering the tier exists for is untouched.
assert_eq(ganita_f32_min(t_f32(0 - 1), t_f32(0 - 2)), t_f32(0 - 2), "min(-1, -2) = -2 unchanged");
assert_eq(ganita_f32_max(t_f32(0 - 1), t_f32(2)), t_f32(2), "max(-1, 2) = 2 unchanged");
# clamp PROPAGATES a NaN x instead of ignoring it: it transforms one value
# rather than choosing between two, and composing min/max returned `hi`.
assert_eq(t_is_nan(ganita_f32_clamp(FNAN, t_f32(0), t_f32(1))), 1, "clamp(NaN, 0, 1) is NaN, not hi");
assert_eq(ganita_f32_clamp(t_f32(5), t_f32(0), t_f32(1)), t_f32(1), "clamp(5, 0, 1) = 1 unchanged");

# ⭐ THE COMPARATORS THE TIER NEVER SHIPPED. `_f32_key` was private, so a
# consumer needing to compare f32 patterns fell back to the raw integer compare
# this module's own header calls a trap. All four are false on a NaN operand.
assert_eq(ganita_f32_lt(t_f32(0 - 2), t_f32(0 - 1)), 1, "lt(-2, -1) — negatives order correctly");
assert_eq(ganita_f32_lt(t_f32(0 - 1), t_f32(0 - 2)), 0, "lt(-1, -2) = 0");
assert_eq(t_f32(0 - 2) > t_f32(0 - 1), 1,
  "...whereas the RAW compare says -2 > -1, which is the trap the tier exists for");
assert_eq(ganita_f32_lt(t_f32(0 - 1), t_f32(1)), 1, "lt(-1, 1) — a negative must not compare high");
assert_eq(ganita_f32_gt(t_f32(1), t_f32(0 - 1)), 1, "gt(1, -1)");
assert_eq(ganita_f32_le(t_f32(3), t_f32(3)), 1, "le(3, 3)");
assert_eq(ganita_f32_ge(t_f32(3), t_f32(3)), 1, "ge(3, 3)");
assert_eq(ganita_f32_lt(t_f32(3), t_f32(3)), 0, "lt(3, 3) = 0");
# -0.0 and +0.0 compare equal, as IEEE requires.
assert_eq(ganita_f32_le(t_f32(0) | 0x80000000, t_f32(0)), 1, "le(-0.0, +0.0) — the zeros are equal");
assert_eq(ganita_f32_ge(t_f32(0) | 0x80000000, t_f32(0)), 1, "ge(-0.0, +0.0)");
# Every comparator is false on a NaN, including against itself.
assert_eq(ganita_f32_lt(FNAN, t_f32(1)), 0, "lt(NaN, 1) = 0");
assert_eq(ganita_f32_gt(FNAN, t_f32(1)), 0, "gt(NaN, 1) = 0");
assert_eq(ganita_f32_le(FNAN, FNAN), 0, "le(NaN, NaN) = 0 — NaN is not even <= itself");
assert_eq(ganita_f32_ge(t_f32(1), FNAN), 0, "ge(1, NaN) = 0");

# ⭐ sign(NaN) returned ±1.0f, turning a NaN into a FINITE value and ending the
# propagation that makes a NaN useful as a signal.
assert_eq(t_is_nan(ganita_f32_sign(FNAN)), 1, "sign(NaN) is NaN (was +/-1.0f)");
assert_eq(ganita_f32_sign(t_f32(0 - 5)), 0xBF800000, "sign(-5) = -1.0f unchanged");
assert_eq(ganita_f32_sign(t_f32(0)), 0, "sign(0) = +0.0f unchanged");

# ⭐ cbrt(+-inf) fell into the pow path and returned a negative quiet NaN.
assert_eq(ganita_f32_cbrt(FINF), FINF, "cbrt(+inf) = +inf (was NaN)");
assert_eq(ganita_f32_cbrt(FNEGINF), FNEGINF, "cbrt(-inf) = -inf (was NaN)");
assert_eq(t_is_nan(ganita_f32_cbrt(FNAN)), 1, "cbrt(NaN) is NaN");
assert_eq(ganita_f32_cbrt(t_f32(0)), t_f32(0), "cbrt(0) = 0 unchanged (the 1.1.2 fix)");
assert_eq(t_dclose(f32_to(ganita_f32_cbrt(t_f32(8))), t_d(2)), 1, "cbrt(8) = 2 unchanged");

# ⭐ exp/exp2 forwarded to f64_exp, which returns NaN for an infinite argument.
assert_eq(ganita_f32_exp(FINF), FINF, "exp(+inf) = +inf (was NaN)");
assert_eq(ganita_f32_exp(FNEGINF), 0, "exp(-inf) = 0 (was NaN)");
assert_eq(ganita_f32_exp2(FINF), FINF, "exp2(+inf) = +inf (was NaN)");
assert_eq(ganita_f32_exp2(FNEGINF), 0, "exp2(-inf) = 0 (was NaN)");
assert_eq(t_is_nan(ganita_f32_exp(FNAN)), 1, "exp(NaN) is NaN");
assert_eq(t_dclose(f32_to(ganita_f32_exp(t_f32(0))), t_d(1)), 1, "exp(0) = 1 unchanged");
assert_eq(t_dclose(f32_to(ganita_f32_exp2(t_f32(3))), t_d(8)), 1, "exp2(3) = 8 unchanged");

test_group("hardening: f64 transcendental accuracy (1.2.4)");
# ⭐ CANCELLATION. sinh/tanh/atanh/asinh all evaluated a form that subtracts two
# nearly equal quantities near zero, so everything below ~1e-17 came back as a
# hard 0.0 and 1e-16 was 44% wrong. Each is x + O(x^3), and at 1e-18 the cubic
# term is far under half a ulp — so `== x` EXACTLY is the assertion, not
# "close to x". That discriminates: the old code returned 0.0, which is close to
# 1e-18 in absolute terms and infinitely wrong in relative ones.
var T18 = f64_div(t_d(1), f64_mul(t_d(1000000000), t_d(1000000000)));
assert_eq(ganita_f64_sinh(T18), T18, "sinh(1e-18) == 1e-18 exactly (was 0.0)");
assert_eq(ganita_f64_tanh(T18), T18, "tanh(1e-18) == 1e-18 exactly (was 0.0)");
assert_eq(ganita_f64_atanh(T18), T18, "atanh(1e-18) == 1e-18 exactly (was 0.0)");
assert_eq(ganita_f64_asinh(T18), T18, "asinh(1e-18) == 1e-18 exactly");
# The ordinary range was untouched by 1.2.4. (1.2.11 reroutes it through expm1;
# these still hold to 1e-9.)
assert_eq(t_dclose(ganita_f64_sinh(t_d(1)), f64_div(f64_sub(F64_E, f64_div(t_d(1), F64_E)), t_d(2))), 1,
  "sinh(1) = (e - 1/e)/2 unchanged");
assert_eq(t_dclose(ganita_f64_tanh(t_d(1)), f64_div(ganita_f64_sinh(t_d(1)), ganita_f64_cosh(t_d(1)))), 1,
  "tanh(1) = sinh(1)/cosh(1) unchanged");

# ⭐ OVERFLOW. hypot exists precisely so that a caller does not have to worry
# about x*x overflowing — and it squared first, so it returned +inf above
# ~1.3e154 and 0 below ~1.5e-162 for hypotenuses that are representable.
var E116 = t_d(1);
var ek = 0;
while (ek < 116) { E116 = f64_mul(E116, t_d(10)); ek = ek + 1; }
var E116N = f64_div(t_d(1), E116);
assert_eq(ganita_f64_hypot(f64_mul(t_d(3), E116), f64_mul(t_d(4), E116)), f64_mul(t_d(5), E116),
  "hypot(3e116, 4e116) = 5e116 exactly (was +inf)");
assert_eq(ganita_f64_hypot(f64_mul(t_d(3), E116N), f64_mul(t_d(4), E116N)), f64_mul(t_d(5), E116N),
  "hypot(3e-116, 4e-116) = 5e-116 exactly (was 0)");
assert_eq(ganita_f64_hypot(t_d(3), t_d(4)), t_d(5), "hypot(3,4) = 5 unchanged");
assert_eq(ganita_f64_hypot(t_d(0), t_d(0)), t_d(0), "hypot(0,0) = 0");
# hypot(inf, NaN) is +inf: the magnitude is infinite whatever the other leg is,
# so infinity OUTRANKS NaN propagation here. Ordering-sensitive, hence pinned.
var F64_INF = f64_div(t_d(1), t_d(0));
assert_eq(ganita_f64_hypot(F64_INF, f64_div(t_d(0), t_d(0))), F64_INF, "hypot(inf, NaN) = +inf");

# ⭐ INFINITY. stdlib's f64_exp returns NaN for an infinite argument, so every
# function reaching for it returned NaN where the true value is a defined
# infinity. Guarded in ganita; the fix belongs upstream.
assert_eq(ganita_f64_sinh(F64_INF), F64_INF, "sinh(+inf) = +inf (was NaN)");
assert_eq(ganita_f64_sinh(f64_neg(F64_INF)), f64_neg(F64_INF), "sinh(-inf) = -inf (was NaN)");
assert_eq(ganita_f64_cosh(F64_INF), F64_INF, "cosh(+inf) = +inf (was NaN)");
assert_eq(ganita_f64_cosh(f64_neg(F64_INF)), F64_INF, "cosh(-inf) = +inf (cosh is even)");

# ⭐ pow on an INTEGRAL exponent is now binary exponentiation, not exp(y ln x).
# The old path was up to 47 ulps out, so pow(7,2) floored to 48 — a caller
# indexing an array with it was off by one for no visible reason.
assert_eq(ganita_f64_pow(t_d(7), t_d(2)), t_d(49), "pow(7,2) == 49 EXACTLY (was 48.999...)");
assert_eq(ganita_f64_pow(t_d(10), t_d(15)), t_d(1000000000000000),
  "pow(10,15) == 1e15 exactly (was 1000000000000005.875)");
assert_eq(ganita_f64_pow(t_d(2), t_d(53)), f64_mul(t_d(4503599627370496), t_d(2)), "pow(2,53) is exact");
assert_eq(ganita_f64_pow(t_d(0 - 2), t_d(3)), t_d(0 - 8), "pow(-2,3) = -8 (no logarithm taken)");
assert_eq(ganita_f64_pow(t_d(2), t_d(0 - 2)), f64_div(t_d(1), t_d(4)), "pow(2,-2) = 0.25 exactly");
assert_eq(t_dclose(ganita_f64_pow(t_d(9), f64_div(t_d(1), t_d(2))), t_d(3)), 1,
  "pow(9,0.5) = 3 — the non-integral path still works");
# An infinite base now goes through the integral fast path, which takes no
# logarithm and therefore gets the IEEE answers for free. _f64_is_int used to
# call inf an integer too, which routed the NEGATIVE-base branch into computing
# a parity for an infinity; it now reports non-finite values as non-integers.
assert_eq(ganita_f64_pow(F64_INF, t_d(2)), F64_INF, "pow(inf, 2) = +inf");
assert_eq(ganita_f64_pow(f64_neg(F64_INF), t_d(3)), f64_neg(F64_INF), "pow(-inf, 3) = -inf (odd power keeps the sign)");
assert_eq(ganita_f64_pow(f64_neg(F64_INF), t_d(2)), F64_INF, "pow(-inf, 2) = +inf (even power)");
assert_eq(ganita_f64_pow(F64_INF, t_d(0 - 1)), t_d(0), "pow(inf, -1) = 0");
# A NON-integral exponent on an infinite base is answered by the Annex F table
# (1.2.7), not by exp(y * ln inf). It returned NaN from a guard before 1.2.7.
assert_eq(ganita_f64_pow(F64_INF, f64_div(t_d(1), t_d(2))), F64_INF, "pow(inf, 0.5) = +inf (was NaN)");

test_group("math: f64 pow — C99 Annex F special values (1.2.7)");
# Before 1.2.7 every one of these that missed the integral fast path returned
# NaN, and pow(1, y) lost to the NaN check. Bit-exact: a zero's sign is part of
# the answer.
var PA_NINF = 0xFFF0000000000000;
var PA_NZ = 0x8000000000000000;
var PA_NAN = f64_div(t_d(0), t_d(0));
var PA_HALF = f64_div(t_d(1), t_d(2));
assert_eq(ganita_f64_pow(F64_ONE, PA_NAN), F64_ONE, "pow(1, NaN) = 1 (was NaN)");
assert_eq(ganita_f64_pow(F64_ONE, F64_INF), F64_ONE, "pow(1, +inf) = 1 (was NaN)");
assert_eq(ganita_f64_pow(F64_ONE, PA_NINF), F64_ONE, "pow(1, -inf) = 1");
assert_eq(ganita_f64_pow(t_d(0 - 1), F64_INF), F64_ONE, "pow(-1, +inf) = 1 (was NaN)");
assert_eq(ganita_f64_pow(t_d(0 - 1), PA_NINF), F64_ONE, "pow(-1, -inf) = 1");
assert_eq(ganita_f64_pow(PA_NAN, t_d(0)), F64_ONE, "pow(NaN, 0) = 1");
assert_eq(t_f64_is_nan(ganita_f64_pow(PA_NAN, t_d(2))), 1, "pow(NaN, 2) = NaN");
assert_eq(t_f64_is_nan(ganita_f64_pow(t_d(2), PA_NAN)), 1, "pow(2, NaN) = NaN");
assert_eq(ganita_f64_pow(t_d(2), F64_INF), F64_INF, "pow(2, +inf) = +inf (was NaN)");
assert_eq(ganita_f64_pow(PA_HALF, F64_INF), 0, "pow(0.5, +inf) = +0 (was NaN)");
assert_eq(ganita_f64_pow(t_d(2), PA_NINF), 0, "pow(2, -inf) = +0 (was NaN)");
assert_eq(ganita_f64_pow(PA_HALF, PA_NINF), F64_INF, "pow(0.5, -inf) = +inf");
assert_eq(ganita_f64_pow(t_d(0 - 2), F64_INF), F64_INF, "pow(-2, +inf) = +inf");
assert_eq(ganita_f64_pow(f64_sub(t_d(0), PA_HALF), F64_INF), 0, "pow(-0.5, +inf) = +0");
assert_eq(ganita_f64_pow(F64_INF, f64_sub(t_d(0), PA_HALF)), 0, "pow(+inf, -0.5) = +0 (was NaN)");
assert_eq(ganita_f64_pow(PA_NINF, PA_HALF), F64_INF, "pow(-inf, 0.5) = +inf (was NaN)");
assert_eq(ganita_f64_pow(PA_NINF, t_d(3)), PA_NINF, "pow(-inf, 3) = -inf");
assert_eq(ganita_f64_pow(PA_NINF, t_d(0 - 3)), PA_NZ, "pow(-inf, -3) = -0");
assert_eq(ganita_f64_pow(PA_NINF, t_d(0 - 2)), 0, "pow(-inf, -2) = +0");
assert_eq(ganita_f64_pow(PA_NINF, f64_sub(t_d(0), PA_HALF)), 0, "pow(-inf, -0.5) = +0");
assert_eq(ganita_f64_pow(PA_NZ, t_d(3)), PA_NZ, "pow(-0, 3) = -0 (the zero's sign survives an odd power)");
assert_eq(ganita_f64_pow(PA_NZ, t_d(2)), 0, "pow(-0, 2) = +0");
assert_eq(ganita_f64_pow(PA_NZ, t_d(0 - 3)), PA_NINF, "pow(-0, -3) = -inf");
assert_eq(ganita_f64_pow(PA_NZ, t_d(0 - 2)), F64_INF, "pow(-0, -2) = +inf");
assert_eq(ganita_f64_pow(PA_NZ, PA_HALF), 0, "pow(-0, 0.5) = +0");
assert_eq(ganita_f64_pow(t_d(0), t_d(3)), 0, "pow(+0, 3) = +0");
assert_eq(ganita_f64_pow(t_d(0), f64_sub(t_d(0), PA_HALF)), F64_INF, "pow(+0, -0.5) = +inf");
# Past the integral path's 1024 bound the general path runs: exp must overflow to
# +inf and underflow to +0 there, never wrap (cyrius 6.6.7's aarch64 exp gave
# pow(2, 1100) = -1.5e-285; the cyrius-side crossos test pins that target).
assert_eq(ganita_f64_pow(t_d(2), t_d(1100)), F64_INF, "pow(2, 1100) = +inf");
assert_eq(ganita_f64_pow(t_d(2), t_d(0 - 1100)), 0, "pow(2, -1100) = +0");
assert_eq(ganita_f64_pow(t_d(0 - 2), t_d(1025)), PA_NINF, "pow(-2, 1025) = -inf (odd, past the fast path)");

# ⭐ DOMAIN. acos/acosh/atanh now reject their out-of-domain arguments instead of
# returning whatever the formula produced.
assert_eq(t_f64_is_nan(ganita_f64_acos(t_d(2))), 1, "acos(2) is NaN — outside [-1,1]");
assert_eq(t_f64_is_nan(ganita_f64_acosh(f64_div(t_d(1), t_d(2)))), 1, "acosh(0.5) is NaN — below 1");
assert_eq(t_f64_is_nan(ganita_f64_atanh(t_d(2))), 1, "atanh(2) is NaN — outside (-1,1)");
assert_eq(ganita_f64_acosh(t_d(1)), t_d(0), "acosh(1) = 0");
# acosh squared its argument, so it hit +inf above ~1.34e154 where the answer is
# about 355 and finite.
var E192 = t_d(1);
var e2k = 0;
while (e2k < 192) { E192 = f64_mul(E192, t_d(10)); e2k = e2k + 1; }
assert_eq(t_f64_is_pos_inf(ganita_f64_acosh(E192)), 0, "acosh(1e192) is FINITE (was +inf)");
assert_eq(t_dclose(ganita_f64_acosh(E192), f64_add(f64_ln(E192), f64_ln(t_d(2)))), 1,
  "acosh(1e192) = ln(x) + ln 2");

# ⭐ acos is no longer pi/2 - asin(x). The old form differenced two quantities
# near pi/2 to produce an answer near 0, so it lost ~6 digits exactly where
# acos(dot) for near-parallel unit vectors lands. The half-angle form's error
# SHRINKS toward the ends where the old one's grew.
assert_eq(ganita_f64_acos(t_d(1)), t_d(0), "acos(1) = 0 exactly");
assert_eq(ganita_f64_acos(t_d(0 - 1)), F64_PI, "acos(-1) = pi exactly");
assert_eq(ganita_f64_acos(t_d(0)), F64_PI_2, "acos(0) = pi/2 exactly");
# 1 - 2^-50 is exactly representable, so this measures the implementation and
# not the construction of the argument. True value = sqrt(2 * 2^-50).
var D50 = t_d(1);
var dk = 0;
while (dk < 50) { D50 = f64_div(D50, t_d(2)); dk = dk + 1; }
var ACWANT = f64_sqrt(f64_mul(t_d(2), D50));
assert_eq(f64_lt(f64_div(f64_abs(f64_sub(ganita_f64_acos(f64_sub(t_d(1), D50)), ACWANT)), ACWANT),
    f64_div(t_d(1), t_d(1000000000000))) , 1,
  "acos(1 - 2^-50) is within 1e-12 relative (the old form was 1.3e-9 out)");
assert_eq(t_dclose(ganita_f64_acos(f64_div(t_d(1), t_d(2))), f64_div(F64_PI, t_d(3))), 1,
  "acos(0.5) = pi/3 unchanged");

test_group("f64 atan2: the whole C99 F.10.1.4 table — signed zeros, infinities, NaN (1.2.11)");
# ⭐ Two filings, one function. docs/development/issues/archived/2026-09-30-f64-atan2-signed-zero-and-nan.md
# (hisab): the zero rows were decided with f64_eq, which cannot see the sign of a zero,
# so atan2(-0, -1) came back +pi where carg(conj z) = -carg(z) needs -pi, and a NaN y at
# x = ±0 fell through to -pi/2. docs/development/issues/archived/2026-09-30-f64-atan2-infinite-arguments.md
# (abaco): with both arguments infinite, y/x is inf/inf = NaN, and NaN came back where
# C99 gives ±pi/4 and ±3pi/4. All 12 rows of the first filing's repro and all 20 of the
# second's are here, with the table's remaining sign combinations added beside them.
# Bit-exact, because the sign of a zero is the answer on the zero rows. Every expected
# value is the double (or float) nearest the exact multiple of pi, checked with mpmath
# at 400 bits: fl(pi), fl(pi/2) and fl(pi/4) are 0.276 ulp below, fl(3pi/4) 0.207 ulp.
var AT2_NZ = 0x8000000000000000;
var AT2_ONE = 0x3FF0000000000000;
var AT2_NONE = 0xBFF0000000000000;
var AT2_PINF = 0x7FF0000000000000;
var AT2_NINF = 0xFFF0000000000000;
var AT2_PI = 0x400921FB54442D18;
var AT2_NPI = 0xC00921FB54442D18;
var AT2_HPI = 0x3FF921FB54442D18;
var AT2_NHPI = 0xBFF921FB54442D18;
var AT2_QPI = 0x3FE921FB54442D18;
var AT2_NQPI = 0xBFE921FB54442D18;
var AT2_TQPI = 0x4002D97C7F3321D2;
var AT2_NTQPI = 0xC002D97C7F3321D2;
var AT2_NAN = 0x7FF8000000000000;
# Signed zeros (the hisab filing's 10 bit-pattern rows; its 2 NaN rows are below).
assert_eq(ganita_f64_atan2(0, 0), 0, "atan2(+0, +0) = +0");
assert_eq(ganita_f64_atan2(AT2_NZ, 0), AT2_NZ, "atan2(-0, +0) = -0 (was +0)");
assert_eq(ganita_f64_atan2(0, AT2_NZ), AT2_PI, "atan2(+0, -0) = +pi (was +0)");
assert_eq(ganita_f64_atan2(AT2_NZ, AT2_NZ), AT2_NPI, "atan2(-0, -0) = -pi (was +0)");
assert_eq(ganita_f64_atan2(0, AT2_NONE), AT2_PI, "atan2(+0, -1) = +pi");
assert_eq(ganita_f64_atan2(AT2_NZ, AT2_NONE), AT2_NPI, "atan2(-0, -1) = -pi (was +pi: the branch cut)");
assert_eq(ganita_f64_atan2(0, AT2_ONE), 0, "atan2(+0, +1) = +0");
assert_eq(ganita_f64_atan2(AT2_NZ, AT2_ONE), AT2_NZ, "atan2(-0, +1) = -0");
assert_eq(ganita_f64_atan2(AT2_ONE, AT2_NZ), AT2_HPI, "atan2(+1, -0) = +pi/2");
assert_eq(ganita_f64_atan2(AT2_NONE, 0), AT2_NHPI, "atan2(-1, +0) = -pi/2");
assert_eq(ganita_f64_atan2(AT2_ONE, 0), AT2_HPI, "atan2(+1, +0) = +pi/2");
assert_eq(ganita_f64_atan2(AT2_NONE, AT2_NZ), AT2_NHPI, "atan2(-1, -0) = -pi/2");
# Both infinite (the abaco filing's 4 failing rows).
assert_eq(ganita_f64_atan2(AT2_PINF, AT2_PINF), AT2_QPI, "atan2(+inf, +inf) = +pi/4 (was NaN)");
assert_eq(ganita_f64_atan2(AT2_NINF, AT2_PINF), AT2_NQPI, "atan2(-inf, +inf) = -pi/4 (was NaN)");
assert_eq(ganita_f64_atan2(AT2_PINF, AT2_NINF), AT2_TQPI, "atan2(+inf, -inf) = +3pi/4 (was NaN)");
assert_eq(ganita_f64_atan2(AT2_NINF, AT2_NINF), AT2_NTQPI, "atan2(-inf, -inf) = -3pi/4 (was NaN)");
# y infinite, x finite: ±pi/2 whatever x is, its zeros included.
assert_eq(ganita_f64_atan2(AT2_PINF, AT2_ONE), AT2_HPI, "atan2(+inf, +1) = +pi/2");
assert_eq(ganita_f64_atan2(AT2_NINF, AT2_ONE), AT2_NHPI, "atan2(-inf, +1) = -pi/2");
assert_eq(ganita_f64_atan2(AT2_PINF, AT2_NONE), AT2_HPI, "atan2(+inf, -1) = +pi/2");
assert_eq(ganita_f64_atan2(AT2_NINF, AT2_NONE), AT2_NHPI, "atan2(-inf, -1) = -pi/2");
assert_eq(ganita_f64_atan2(AT2_PINF, AT2_NZ), AT2_HPI, "atan2(+inf, -0) = +pi/2");
assert_eq(ganita_f64_atan2(AT2_NINF, 0), AT2_NHPI, "atan2(-inf, +0) = -pi/2");
# y finite, x infinite: ±0 toward +inf, ±pi toward -inf, signed as y — the zeros too.
assert_eq(ganita_f64_atan2(AT2_ONE, AT2_PINF), 0, "atan2(+1, +inf) = +0");
assert_eq(ganita_f64_atan2(AT2_NONE, AT2_PINF), AT2_NZ, "atan2(-1, +inf) = -0");
assert_eq(ganita_f64_atan2(AT2_ONE, AT2_NINF), AT2_PI, "atan2(+1, -inf) = +pi");
assert_eq(ganita_f64_atan2(AT2_NONE, AT2_NINF), AT2_NPI, "atan2(-1, -inf) = -pi");
assert_eq(ganita_f64_atan2(0x7FEFFFFFFFFFFFFF, AT2_NINF), AT2_PI, "atan2(DBL_MAX, -inf) = +pi");
assert_eq(ganita_f64_atan2(0x8000000000000001, AT2_PINF), AT2_NZ, "atan2(-4.9e-324, +inf) = -0");
assert_eq(ganita_f64_atan2(0, AT2_PINF), 0, "atan2(+0, +inf) = +0");
assert_eq(ganita_f64_atan2(AT2_NZ, AT2_PINF), AT2_NZ, "atan2(-0, +inf) = -0");
assert_eq(ganita_f64_atan2(0, AT2_NINF), AT2_PI, "atan2(+0, -inf) = +pi");
assert_eq(ganita_f64_atan2(AT2_NZ, AT2_NINF), AT2_NPI, "atan2(-0, -inf) = -pi (was +pi)");
# Finite controls in the four quadrants the both-infinite rows answer for.
assert_eq(ganita_f64_atan2(AT2_ONE, AT2_ONE), AT2_QPI, "atan2(+1, +1) = +pi/4");
assert_eq(ganita_f64_atan2(AT2_NONE, AT2_ONE), AT2_NQPI, "atan2(-1, +1) = -pi/4");
assert_eq(ganita_f64_atan2(AT2_ONE, AT2_NONE), AT2_TQPI, "atan2(+1, -1) = +3pi/4");
assert_eq(ganita_f64_atan2(AT2_NONE, AT2_NONE), AT2_NTQPI, "atan2(-1, -1) = -3pi/4");
# NaN in either place is NaN out, so the NaN test has to run before the zero rows:
# atan2(NaN, ±0) was -pi/2, and a NaN x beside a zero y would otherwise get the zero
# row's ±0 or ±pi.
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_NAN, 0)), 1, "atan2(NaN, +0) = NaN (was -pi/2)");
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_NAN, AT2_NZ)), 1, "atan2(NaN, -0) = NaN (was -pi/2)");
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_ONE, AT2_NAN)), 1, "atan2(+1, NaN) = NaN");
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_NAN, AT2_ONE)), 1, "atan2(NaN, +1) = NaN");
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_NAN, AT2_NAN)), 1, "atan2(NaN, NaN) = NaN");
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_NZ, AT2_NAN)), 1, "atan2(-0, NaN) = NaN, not the zero row");
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_PINF, AT2_NAN)), 1, "atan2(+inf, NaN) = NaN");
assert_eq(t_f64_is_nan(ganita_f64_atan2(AT2_NAN, AT2_NINF)), 1, "atan2(NaN, -inf) = NaN");
# Which NaN: the operand itself, payload and sign bit kept, and y's when both are
# NaN. Quiet NaNs with distinct payloads, so the rows tell y from x and still hold if
# a later body quiets its NaN operand.
var AT2_NANP = 0x7FF8000000000123;
var AT2_NNANP = 0xFFF8000000000456;
assert_eq(ganita_f64_atan2(AT2_NANP, 0), AT2_NANP, "atan2(NaN, +0) is y itself, payload kept");
assert_eq(ganita_f64_atan2(AT2_NNANP, AT2_NZ), AT2_NNANP, "atan2(-NaN, -0) is y itself, sign kept");
assert_eq(ganita_f64_atan2(AT2_ONE, AT2_NNANP), AT2_NNANP, "atan2(+1, -NaN) is x itself");
assert_eq(ganita_f64_atan2(0, AT2_NANP), AT2_NANP, "atan2(+0, NaN) is x itself, not the zero row");
assert_eq(ganita_f64_atan2(AT2_NANP, AT2_NNANP), AT2_NANP, "atan2(NaN, -NaN) is y: y first");
assert_eq(ganita_f64_atan2(AT2_NNANP, AT2_NANP), AT2_NNANP, "atan2(-NaN, NaN) is y: y first");
# ganita_f32_atan2 widens onto ganita_f64_atan2, so it inherits every row. Expected
# values are the floats nearest ±pi/4, ±3pi/4, ±pi and ±pi/2.
assert_eq(ganita_f32_atan2(F_INF, F_INF), 0x3F490FDB, "f32 atan2(+inf, +inf) = +pi/4 (was NaN)");
assert_eq(ganita_f32_atan2(F_NINF, F_INF), 0xBF490FDB, "f32 atan2(-inf, +inf) = -pi/4 (was NaN)");
assert_eq(ganita_f32_atan2(F_INF, F_NINF), 0x4016CBE4, "f32 atan2(+inf, -inf) = +3pi/4 (was NaN)");
assert_eq(ganita_f32_atan2(F_NINF, F_NINF), 0xC016CBE4, "f32 atan2(-inf, -inf) = -3pi/4 (was NaN)");
assert_eq(ganita_f32_atan2(F_0, F_0), F_0, "f32 atan2(+0, +0) = +0");
assert_eq(ganita_f32_atan2(F_NZ, F_0), F_NZ, "f32 atan2(-0, +0) = -0 (was +0)");
assert_eq(ganita_f32_atan2(F_0, F_NZ), 0x40490FDB, "f32 atan2(+0, -0) = +pi (was +0)");
assert_eq(ganita_f32_atan2(F_NZ, F_NZ), 0xC0490FDB, "f32 atan2(-0, -0) = -pi (was +0)");
assert_eq(ganita_f32_atan2(F_0, F_M1), 0x40490FDB, "f32 atan2(+0, -1) = +pi");
assert_eq(ganita_f32_atan2(F_NZ, F_M1), 0xC0490FDB, "f32 atan2(-0, -1) = -pi (was +pi)");
assert_eq(ganita_f32_atan2(F_NZ, F_1), F_NZ, "f32 atan2(-0, +1) = -0");
assert_eq(ganita_f32_atan2(F_M1, F_0), 0xBFC90FDB, "f32 atan2(-1, +0) = -pi/2");
assert_eq(ganita_f32_atan2(F_1, F_NZ), 0x3FC90FDB, "f32 atan2(+1, -0) = +pi/2");
assert_eq(t_is_nan(ganita_f32_atan2(FNAN, F_0)), 1, "f32 atan2(NaN, +0) = NaN (was -pi/2)");
assert_eq(t_is_nan(ganita_f32_atan2(F_1, FNAN)), 1, "f32 atan2(+1, NaN) = NaN");

test_group("f64 pow: within 1 ulp of the correctly rounded value, everywhere (1.2.8)");
# ⭐ pow was hundreds of ulp out on both of its old paths. `exp(y*ln x)` turns the
# rounding of y*ln x into a relative error of about |y*ln x| ulp (909 ulp at
# |y ln x| = 667), and the 1.2.4 binary-exponentiation path for integral |y| <= 1024
# doubled its error at every squaring (772 ulp for pow(1.0000144, -916)). 1.2.8 runs
# every finite case through a port of fdlibm's e_pow core. The 108 rows below are
# correctly rounded references (glibc pow, each one re-checked against an 80-digit
# decimal power): 56 across the whole exponent range, 12 with x within 1e-7 of 1 and
# |y| up to 3e9, 10 subnormal bases, 10 subnormal results, and the 20 worst inputs
# of the two old paths. 1.2.7 fails 94 of them.
var PW_BAD = 0;
var PW_MAX = 0;
# One pow reference row: tallies the bit-pattern distance into PW_MAX and PW_BAD.
fn t_pw1(x, y, want): i64 {
    var got = ganita_f64_pow(x, y);
    var d = got - want;
    if (d < 0) { d = 0 - d; }
    if (d > PW_MAX) { PW_MAX = d; }
    if (d > 1) { PW_BAD = PW_BAD + 1; }
    return 0;
}
t_pw1(0x66B54FB7BF3FEEC6, 0xBFF13A5F7F61A0EE, 0x162F518997FB9241);
t_pw1(0x7542101E357F86DF, 0x3FC9EF53B600EC30, 0x4ABD2ED36DA724A3);
