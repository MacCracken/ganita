assert_eq(PW_BAD, 0, "108 pow rows are within 1 ulp of the correctly rounded value");
assert(PW_MAX <= 1, "the largest pow error over the 108 rows is at most 1 ulp");
# An integer power that is representable comes back EXACTLY (the property the 1.2.4
# squaring path existed for), including deep in the subnormals.
assert_eq(ganita_f64_pow(t_d(3), t_d(33)), t_d(5559060566555523), "pow(3, 33) is exact (3^33 < 2^53)");
assert_eq(ganita_f64_pow(t_d(10), t_d(22)), 0x4480F0CF064DD592, "pow(10, 22) == 1e22 exactly");
assert_eq(ganita_f64_pow(t_d(2), t_d(0 - 1074)), 1, "pow(2, -1074) is the smallest subnormal");
assert_eq(ganita_f64_pow(PA_HALF, t_d(1074)), 1, "pow(0.5, 1074) is the smallest subnormal");
assert_eq(ganita_f64_pow(PA_HALF, t_d(1075)), 0, "pow(0.5, 1075) underflows to +0");
assert_eq(ganita_f64_pow(t_d(2), t_d(1023)), 0x7FE0000000000000, "pow(2, 1023) is exact");
assert_eq(ganita_f64_pow(t_d(2), t_d(1024)), 0x7FF0000000000000, "pow(2, 1024) overflows to +inf");
assert_eq(ganita_f64_pow(t_d(0 - 3), t_d(33)), t_d(0 - 5559060566555523), "pow(-3, 33) = -(3^33) exactly");

test_group("f64 sinh/tanh/atanh/asinh/acosh/asin: no cancellation band above the cutoff (1.2.11)");
# ⭐ CANCELLATION above the cutoff. Below 2^-26 (1e-8 for asinh) these return x, but
# just above it the direct forms differenced two numbers near 1 and lost about eps/|x|
# relative: 4e7 ulp for sinh at 2e-8, 1.3e8 for asinh, 2.5e7 for acosh at 1 + 2^-52,
# and asin lost 1,024 ulp near +-1 to the rounding of x·x. 1.2.11 routes the band
# through ports of fdlibm's expm1 and log1p, which never form the 1 + small. Wanted
# bits are correctly rounded (mpmath, 300 bits, rounded once). The first 16 rows and
# the first 11 kernel rows are the filing's; 1.2.10 fails all 16 band rows. Filed as
# docs/development/issues/archived/2026-09-30-f64-hyperbolic-and-asin-cancellation-band.md.
var HB_BAD = 0;
var HB_MAX = 0;
# Scores one row: counts it in HB_BAD when the result is NaN, has the wrong sign or is
# more than 2 ulp (bit-pattern distance) from `want`, and keeps the largest distance in
# HB_MAX. fid: 1 sinh, 2 tanh, 3 atanh, 4 asinh, 5 acosh, 6 asin, 7 _gn_expm1,
# 8 _gn_log1p, 9 cosh.
fn t_hb1(fid, x, want): i64 {
    var got = 0;
    if (fid == 1) { got = ganita_f64_sinh(x); }
    if (fid == 2) { got = ganita_f64_tanh(x); }
    if (fid == 3) { got = ganita_f64_atanh(x); }
    if (fid == 4) { got = ganita_f64_asinh(x); }
    if (fid == 5) { got = ganita_f64_acosh(x); }
    if (fid == 6) { got = ganita_f64_asin(x); }
    if (fid == 7) { got = _gn_expm1(x); }
    if (fid == 8) { got = _gn_log1p(x); }
    if (fid == 9) { got = ganita_f64_cosh(x); }
    var d = 0x0010000000000000;
    if (t_f64_is_nan(got) == 0 && (got >> 63) == (want >> 63)) {
        d = (got & 0x7FFFFFFFFFFFFFFF) - (want & 0x7FFFFFFFFFFFFFFF);
        if (d < 0) { d = 0 - d; }
    }
    if (d > HB_MAX) { HB_MAX = d; }
    if (d > 2) { HB_BAD = HB_BAD + 1; }
    return 0;
}
t_hb1(1, 0x3E5528F5C28F5993, 0x3E5528F5C28F5993);   # sinh(1.9706785678861335e-8): 1.2.10 4.1e7 ulp off
t_hb1(1, 0x3EB0C6F7A0B5ED8D, 0x3EB0C6F7A0B5F0A0);   # sinh(1e-6): 1.2.10 returned less than x
t_hb1(1, 0xBF847AE147AE147B, 0xBF847AF7A654E9EF);   # sinh(-0.01)
t_hb1(2, 0x3E5528F5C28F5993, 0x3E5528F5C28F5992);   # tanh(1.9706785678861335e-8)
t_hb1(2, 0x3E7AD7F29ABCAF48, 0x3E7AD7F29ABCAF2F);   # tanh(1e-7)
t_hb1(2, 0xBF30000000000000, 0xBF2FFFFFF555555A);   # tanh(-2^-12)
t_hb1(3, 0x3E591EB851EB8368, 0x3E591EB851EB8369);   # atanh(2.339482307433937e-8)
t_hb1(3, 0xBEB0000000000000, 0xBEB0000000000555);   # atanh(-2^-20)
t_hb1(3, 0x3F50624DD2F1A9FC, 0x3F50624E2E91ED17);   # atanh(0.001)
t_hb1(4, 0x3E4FBF258BF2565D, 0x3E4FBF258BF2565D);   # asinh(1.4783193667728686e-8): 1.2.10 1.3e8 ulp off
t_hb1(4, 0x3E7AD7F29ABCAF48, 0x3E7AD7F29ABCAF3B);   # asinh(1e-7)
t_hb1(4, 0xBFA999999999999A, 0xBFA996DF55A826BB);   # asinh(-0.05)
t_hb1(5, 0x3FF0000000000001, 0x3E56A09E667F3BCC);   # acosh(1 + 2^-52): 1.2.10 2.5e7 ulp off
t_hb1(5, 0x3FF0000000001000, 0x3EB6A09E667F39EA);   # acosh(1 + 2^-40)
t_hb1(6, 0x3FEFFFFFFC000000, 0x3FF9217B54442BC3);   # asin(1 - 2^-27): 1.2.10 1,024 ulp off
t_hb1(6, 0xBFEFFFFFFC000000, 0xBFF9217B54442BC3);   # asin(-(1 - 2^-27))
# More rows per function, on each branch 1.2.11 gave it.
t_hb1(1, 0xBFD999999999999A, 0xBFDA49C41F850ED2);   # sinh(-0.4)
t_hb1(1, 0x3FE8000000000000, 0x3FEA506B2DD3C690);   # sinh(0.75): expm1's k = 1
t_hb1(1, 0x4014000000000000, 0x40528D0166F07374);   # sinh(5): the E + E/(E+1) form
t_hb1(1, 0xC03E000000000000, 0xC29370470AEC28ED);   # sinh(-30): e^|x|/2
t_hb1(2, 0x3FD3333333333333, 0x3FD2A4DDA7D914FA);   # tanh(0.3)
t_hb1(2, 0x3FE3333333333333, 0x3FE12F8292D2CCFC);   # tanh(0.6): expm1(-1.2), k = -2
t_hb1(2, 0xC008000000000000, 0xBFEFD77D111A0B00);   # tanh(-3): the 1 - 2/(E+2) form
t_hb1(3, 0xBFD3333333333333, 0xBFD3CF2B50617C95);   # atanh(-0.3)
t_hb1(3, 0x3FE8000000000000, 0x3FEF2272AE325A57);   # atanh(0.75): the 2|x|/(1-|x|) form
t_hb1(4, 0xBFD3333333333333, 0xBFD2EC4EA565FCC1);   # asinh(-0.3)
t_hb1(4, 0x3FF8000000000000, 0x3FF31DC0090B63D8);   # asinh(1.5)
t_hb1(4, 0x3FE0000000000031, 0x3FDECC2CAEC51661);   # asinh(1/2 + 49·2^-53): the direct form is 3 ulp off
t_hb1(5, 0x3FF004189374BC6A, 0x3FA6E53ACBCDEBA3);   # acosh(1.001): 1.2.10 133 ulp off
t_hb1(5, 0x3FF8000000000000, 0x3FEECC2CAEC5160A);   # acosh(1.5)
t_hb1(6, 0x3FE8000000000000, 0x3FEB235315C680DC);   # asin(0.75)
t_hb1(6, 0xBFEFFFFFFAA19C47, 0xBFF9216709C28B31);   # asin(-0.99999999): 1.2.10 175 ulp off
# The two fdlibm kernels the fix rests on: every reduction branch of each.
t_hb1(7, 0x3E10000000000000, 0x3E10000000200000);   # expm1(2^-30)
t_hb1(7, 0x3EE4F8B588E368F1, 0x3EE4F8BC681CDFB6);   # expm1(1e-5)
t_hb1(7, 0xBFE0000000000000, 0xBFD92E9A0720D3EC);   # expm1(-0.5): k = -1
t_hb1(7, 0x3FF0000000000000, 0x3FFB7E151628AED3);   # expm1(1): k = 1
t_hb1(7, 0x403E000000000000, 0x42A370470AEC26ED);   # expm1(30): 20 <= k <= 56
t_hb1(7, 0xC044000000000000, 0xBFF0000000000000);   # expm1(-40): below -56 ln2, -1
t_hb1(7, 0x3FC999999999999A, 0x3FCC56ECF2C56468);   # expm1(0.2): k = 0
t_hb1(7, 0x3FD999999999999A, 0x3FDF7A0E4BEEFF80);   # expm1(0.4): k = 1 with r < -1/4
t_hb1(7, 0xBFF0000000000000, 0xBFE43A54E4E98864);   # expm1(-1): k = -1
t_hb1(7, 0xC014000000000000, 0xBFEFC8CD803FE559);   # expm1(-5): k <= -2
t_hb1(7, 0x4014000000000000, 0x40626D389970338F);   # expm1(5): 2 <= k < 20
t_hb1(7, 0x402A000000000000, 0x411B00B1916AC955);   # expm1(13): k = 19
t_hb1(7, 0x402E000000000000, 0x4148F0CC2FAD2A87);   # expm1(15): k = 22
t_hb1(7, 0x4043C00000000000, 0x437FB37161577EDD);   # expm1(39.5): k = 57
t_hb1(7, 0x4049000000000000, 0x44719103E4080B45);   # expm1(50): k > 56
t_hb1(7, 0x40862D999999999A, 0x7FED75AE7A50EE14);   # expm1(709.7): k = 1024
t_hb1(8, 0x3E10000000000000, 0x3E0FFFFFFFC00000);   # log1p(2^-30)
t_hb1(8, 0x3EE4F8B588E368F1, 0x3EE4F8AEA9AE7317);   # log1p(1e-5)
t_hb1(8, 0xBFE0000000000000, 0xBFE62E42FEFA39EF);   # log1p(-0.5) = -ln 2
t_hb1(8, 0x3FF0000000000000, 0x3FE62E42FEFA39EF);   # log1p(1) = ln 2
t_hb1(8, 0x4202A05F20000000, 0x4037069E2AA3184E);   # log1p(1e10)
t_hb1(8, 0x3D70000000000000, 0x3D6FFFFFFFFFF000);   # log1p(2^-40): x - x²/2
t_hb1(8, 0xBFD0000000000000, 0xBFD269621134DB92);   # log1p(-0.25): k = 0, f = x
t_hb1(8, 0x3FE0000000000000, 0x3FD9F323ECBF984C);   # log1p(0.5): u/2 normalised
t_hb1(8, 0x3FF0000004000000, 0x3FE62E4302FA39EF);   # log1p(1 + 2^-26): |f| < 2^-20
t_hb1(8, 0x4007FFFFFFFFFFFF, 0x3FF62E42FEFA39EF);   # log1p(3 - 2^-51): f just below 0
t_hb1(8, 0xBFE3333333333333, 0xBFED5240F0E0E077);   # log1p(-0.6): k = -1
t_hb1(8, 0x43B0000000000000, 0x4044CB5ECF0A9650);   # log1p(2^60): 1 + x is x
t_hb1(8, 0x3FDAE147AE147AE1, 0x3FD6712984EC8F15);   # log1p(0.42): just past sqrt(2) - 1
# Past log1p's k = 0 cut at sqrt(2) - 1, 1 + x is renormalised to f near -1/4. Taking
# f = x up to 1/2 instead leaves these 9 and 38 ulp off.
t_hb1(8, 0x3FDE68CB648F13AE, 0x3FD8E165543789D9);   # log1p(0.4751461488743257)
t_hb1(5, 0x3FF154EA93DD5681, 0x3FD9EF22BE758EAF);   # acosh(1.0832315231286034): log1p of 0.4996
# 1 + x rounds here, and without the correction term c the result is 2 ulp off.
t_hb1(8, 0xBFD30011C5F923FB, 0xBFD68AE185B41854);   # log1p(-0.29687923749275996)
# expm1's correction term c, likewise: without it this tanh row is 2 ulp off.
t_hb1(2, 0x3FCB5E62C497F5A0, 0x3FCAF587AF9B39DA);   # tanh(0.21381792640015096): expm1(-0.4276)
# log1p's c / u where 1 + x rounds with u far above 1 (k > 0). Without the division
# by u the atanh row is 32 ulp off and the log1p row about 2^44 ulp off.
t_hb1(3, 0x3FEFC0639D5D3B1F, 0x40063085F0F8752C);   # atanh(0.9922349999922949)
t_hb1(8, 0x430FFFFFFFFFFFF9, 0x4041542457337D43);   # log1p(1125899906842623.1): u ~ 2^50
assert_eq(HB_BAD, 0, "67 band, branch and kernel rows are within 2 ulp of the correctly rounded value");
assert(HB_MAX <= 1, "the largest error over the 67 rows is at most 1 ulp");
var HB_SIGN = 0x8000000000000000;
var HB_NAN = f64_div(t_d(0), t_d(0));
assert_eq(_gn_expm1(0xFFF0000000000000), 0xBFF0000000000000, "expm1(-inf) = -1");
assert_eq(_gn_expm1(0x7FF0000000000000), 0x7FF0000000000000, "expm1(+inf) = +inf");
assert_eq(_gn_expm1(HB_SIGN), HB_SIGN, "expm1(-0) = -0");
assert_eq(_gn_expm1(0x3C80000000000000), 0x3C80000000000000, "expm1(2^-55) = 2^-55 (below 2^-54, x itself)");
assert_eq(_gn_expm1(0x4086300000000000), 0x7FF0000000000000, "expm1(710) = +inf (past o_threshold)");
# From about 710.13 (k = 1025) 2^k no longer fits the exponent field, so only the
# o_threshold guard keeps expm1 from answering -1 there.
assert_eq(_gn_expm1(t_d(720)), 0x7FF0000000000000, "expm1(720) = +inf (the o_threshold guard)");
assert_eq(t_f64_is_nan(_gn_expm1(HB_NAN)), 1, "expm1(NaN) is NaN");
assert_eq(_gn_log1p(0xBFF0000000000000), 0xFFF0000000000000, "log1p(-1) = -inf");
assert_eq(t_f64_is_nan(_gn_log1p(0xC000000000000000)), 1, "log1p(-2) is NaN");
assert_eq(t_f64_is_nan(_gn_log1p(0xFFF0000000000000)), 1, "log1p(-inf) is NaN");
assert_eq(_gn_log1p(HB_SIGN), HB_SIGN, "log1p(-0) = -0");
assert_eq(_gn_log1p(0x7FF0000000000000), 0x7FF0000000000000, "log1p(+inf) = +inf");
assert_eq(t_f64_is_nan(_gn_log1p(HB_NAN)), 1, "log1p(NaN) is NaN");
assert_eq(ganita_f64_atanh(t_d(1)), 0x7FF0000000000000, "atanh(1) = +inf, as before");
assert_eq(ganita_f64_atanh(t_d(0 - 1)), 0xFFF0000000000000, "atanh(-1) = -inf, as before");
assert_eq(t_f64_is_nan(ganita_f64_atanh(0x3FF0000000000001)), 1, "atanh(1 + 2^-52) is NaN");
assert_eq(ganita_f64_asin(t_d(1)), F64_PI_2, "asin(1) = pi/2, correctly rounded");
assert_eq(ganita_f64_asin(t_d(0 - 1)), F64_PI_2 | HB_SIGN, "asin(-1) = -pi/2");
assert_eq(t_f64_is_nan(ganita_f64_asin(0x3FF0000000000001)), 1, "asin(1 + 2^-52) is NaN");
assert_eq(t_f64_is_nan(ganita_f64_asin(t_d(0 - 2))), 1, "asin(-2) is NaN");
assert_eq(ganita_f64_acosh(t_d(1)), 0, "acosh(1) = +0 through the log1p form");
assert_eq(t_f64_is_nan(ganita_f64_acosh(0x3FEFFFFFFFFFFFFF)), 1, "acosh(1 - 2^-53) is NaN");
assert_eq(ganita_f64_sinh(HB_SIGN), HB_SIGN, "sinh(-0) = -0");
assert_eq(ganita_f64_tanh(HB_SIGN), HB_SIGN, "tanh(-0) = -0");
assert_eq(ganita_f64_atanh(HB_SIGN), HB_SIGN, "atanh(-0) = -0");
assert_eq(ganita_f64_asinh(HB_SIGN), HB_SIGN, "asinh(-0) = -0");
assert_eq(ganita_f64_asin(HB_SIGN), HB_SIGN, "asin(-0) = -0");
assert_eq(ganita_f64_tanh(0xFFF0000000000000), t_d(0 - 1), "tanh(-inf) = -1");
assert_eq(ganita_f64_asinh(0xFFF0000000000000), 0xFFF0000000000000, "asinh(-inf) = -inf");
# Odd, bit for bit: f(-x) is f(x) with the sign bit set. 1.2.10's sinh was not on
# 2^-26 <= |x| < 500, where its negative side formed e^|x| as 1/exp(x), and neither was
# atanh, which divided (1 + x)/(1 - x) on x itself; each of these now computes on |x|
# and re-signs. 600 patterns over [2^-26, 64); NaNs (atanh and asin
# past 1) are skipped, since a NaN's sign is the target's, not the function's.
var hb_odd_bad = 0;
var hb_i = 0;
while (hb_i < 600) {
    var hbx = 0x3E50000000000000 + hb_i * 0xDA740DA740DA;
    var hbf = 1;
    while (hbf <= 6) {
        if (hbf != 5) {
            var hbp = 0;
            var hbn = 0;
            if (hbf == 1) { hbp = ganita_f64_sinh(hbx); hbn = ganita_f64_sinh(hbx | HB_SIGN); }
            if (hbf == 2) { hbp = ganita_f64_tanh(hbx); hbn = ganita_f64_tanh(hbx | HB_SIGN); }
            if (hbf == 3) { hbp = ganita_f64_atanh(hbx); hbn = ganita_f64_atanh(hbx | HB_SIGN); }
            if (hbf == 4) { hbp = ganita_f64_asinh(hbx); hbn = ganita_f64_asinh(hbx | HB_SIGN); }
            if (hbf == 6) { hbp = ganita_f64_asin(hbx); hbn = ganita_f64_asin(hbx | HB_SIGN); }
            if (t_f64_is_nan(hbp) == 0 && hbn != (hbp | HB_SIGN)) { hb_odd_bad = hb_odd_bad + 1; }
        }
        hbf = hbf + 1;
    }
    hb_i = hb_i + 1;
}
assert_eq(hb_odd_bad, 0, "sinh/tanh/atanh/asinh/asin are odd bit for bit over 600 patterns in [2^-26, 64)");
# Where each reroute switches form. Every row is correctly rounded (mpmath, 400 bits),
# the same bits on x86_64 and aarch64, and sits where moving that cut (sinh's and
# tanh's 1, atanh's 1/2, asinh's and acosh's 2, asin's 1/2) changes the answer. They
# come from a 180-mutant campaign on the merged 1.2.11 tree: every one of them failed
# no row before these were added.
assert_eq(ganita_f64_sinh(0x3FE6365179CD66EA), 0x3FE80A12DC5CB255, "sinh(0.6941306475593738) is correctly rounded");
assert_eq(ganita_f64_sinh(0x3FF0A2B2C10F4B6E), 0x3FF3CC8B683CE511, "sinh(1.0397212544819143) is correctly rounded");
assert_eq(ganita_f64_tanh(0x3FE00C1A910F3E29), 0x3FDDA65A3BCE1AC1, "tanh(0.501477511710566) is correctly rounded");
assert_eq(ganita_f64_tanh(0x3FF0DF137FFE5D0F), 0x3FE912B80E0EC424, "tanh(1.0544619560003559) is correctly rounded");
assert_eq(ganita_f64_atanh(0x3FD208AE5531AD2B), 0x3FD2890ABBF48D2C, "atanh(0.28177984542590434) is correctly rounded");
assert_eq(ganita_f64_atanh(0x3FE01591F61DB760), 0x3FE1B0BA125DE75E, "atanh(0.5026330763773608) is correctly rounded");
assert_eq(ganita_f64_asinh(0x3FF8ADD6C4A6ADEA), 0x3FF37D3E6529B7E0, "asinh(1.5424411470111132) is correctly rounded");
assert_eq(ganita_f64_asinh(0x3FFFFFFFFFFFFFFF), 0x3FF719218313D087, "asinh(2 - 2^-52), the last log1p argument");
assert_eq(ganita_f64_asinh(0x400064ED23FAF841), 0x3FF77285C6A7DB79, "asinh(2.0492804347004783) is correctly rounded");
assert_eq(ganita_f64_acosh(0x3FF974B11964D897), 0x3FF0A2B15B693C1E, "acosh(1.5909892074537646) is correctly rounded");
assert_eq(ganita_f64_acosh(0x40036C50663BB379), 0x3FF88E6DD7D16991, "acosh(2.4278877245873756) is correctly rounded");
assert_eq(ganita_f64_asin(0x3FD04ECB2C790A9A), 0x3FD07D57F70A5CCE, "asin(0.254809182577597) is correctly rounded");
assert_eq(ganita_f64_asin(0x3FE0566BEE8924C3), 0x3FE12577D9666F0B, "asin(0.5105495127583243) is correctly rounded");
# sinh's 22 between the expm1 form and e^|x|/2: below 22 e^-|x| still counts. With the
# cut moved down to 5, sinh(5.5) came back 1.4e11 ulp off and no row noticed.
assert_eq(ganita_f64_sinh(0x403053279ABBCE37), 0x415774232D8539F1, "sinh(16.324823065615615) is correctly rounded");
assert_eq(ganita_f64_sinh(0x4037EC489A17BD04), 0x4206D75B186D487F, "sinh(23.92298281745481) is correctly rounded");
# How the kernels choose a branch, not only that each branch runs: expm1's k = +-1 and
# ln2/2 cuts, its k > 56 cut; log1p's k = 0 bands (both signs), its sqrt(2) cut on
# the normalised mantissa, its 2^53 cut and the |f| < 2^-20 branch.
assert_eq(ganita_f64_sinh(0x3FD62E4270BFDEBD), 0x3FD6A09DCFA43841, "sinh(0.3465734578198683), just below ln2/2");
assert_eq(ganita_f64_sinh(0x3FD62E430E8EB2EF), 0x3FD6A09E7705A5CF, "sinh(0.34657360478995164), just above ln2/2");
assert_eq(_gn_expm1(0x40433D6094280429), 0x4366D9E8416515CF, "expm1(38.47950984910887) is correctly rounded");
assert_eq(_gn_expm1(0x404399BFADC1F812), 0x4377830EF81E06D9, "expm1(39.20116207095283), k = 57");
assert_eq(ganita_f64_atanh(0x3FC5F619318AD05C), 0x3FC62E42955CDF5B, "atanh(0.17157282752089287) is correctly rounded");
assert_eq(ganita_f64_atanh(0x3FC5F61A859495FF), 0x3FC62E43F3B6DF61, "atanh(0.17157298586350575) is correctly rounded");
assert_eq(_gn_log1p(0xBE428E768BD21E29), 0xBE428E768D2A761D, "log1p(-8.641041988077045e-09): x - x²/2");
assert_eq(_gn_log1p(0xBFD2BEC406D8410C), 0xBFD62E442A900EFB, "log1p(-0.29289341610366715): k = 0, f = x");
assert_eq(_gn_log1p(0xBFD2BEC51E174B9A), 0xBFD62E45B57A0C6F, "log1p(-0.2928936761720081): past the k = 0 band");
assert_eq(_gn_log1p(0x4333FFFFA806E5A2), 0x4042222664BFE299, "log1p(5629498058270114.0): below 2^53, c kept");
assert_eq(_gn_log1p(0x3FF00001F9B1673A), 0x3FE62E44F8AB918E, "log1p(1.0000018838531575): |f| < 2^-20");

test_group("f64 sinh/cosh: the overflow band within 1 bit pattern of correctly rounded (1.2.11)");
# ⭐ OVERFLOW band. Between ~709.78, where f64_exp overflows, and ~710.4759, where
# sinh/cosh do, both returned exp(|x| - ln 2) from 709 up: rounding |x| - ln 2 near 709
# costs up to half an ulp of 709, and exp turns that into up to ~500 ulp (496 at
# 710.4755). 1.2.11 keeps 0.5·exp(|x|) up to exp's own overflow and above it forms
# exp(|x| - c)·2^2042, c the double nearest 2043·ln 2, with |x| - c exact. Wanted bits
# are correctly rounded (mpmath, 400 bits); the |x| = 708 rows sit below the branch
# and were right before. 1.2.10 fails all 8 band rows. Filed as
# docs/development/issues/archived/2026-09-30-f64-sinh-cosh-overflow-band.md.
HB_BAD = 0;
HB_MAX = 0;
t_hb1(1, 0x40862C0000000000, 0x7FD81E9B4B52D0C9);   # sinh(709.5): 1.2.10 373 ulp off
t_hb1(1, 0x4086300000000000, 0x7FE3E21A464507F9);   # sinh(710)
t_hb1(1, 0x408633CDDA05A699, 0x7FEFFD294EF597D8);   # sinh(710.4755135003535): 1.2.10 496 ulp off
t_hb1(1, 0xC08633CDDA05A699, 0xFFEFFD294EF597D8);   # sinh(-710.4755135003535)
t_hb1(9, 0x40862C0000000000, 0x7FD81E9B4B52D0C9);   # cosh(709.5)
t_hb1(9, 0x4086300000000000, 0x7FE3E21A464507F9);   # cosh(710): 1.2.10 308 ulp off
t_hb1(9, 0x408633CDDA05A699, 0x7FEFFD294EF597D8);   # cosh(710.4755135003535)
t_hb1(9, 0xC08633CDDA05A699, 0x7FEFFD294EF597D8);   # cosh(-710.4755135003535)
t_hb1(1, 0x4086200000000000, 0x7FB586F6BF260CF1);   # sinh(708): control
t_hb1(9, 0x4086200000000000, 0x7FB586F6BF260CF1);   # cosh(708): control
# 710.4758600739439 is the largest double whose sinh/cosh is finite.
t_hb1(1, 0x408633CE8FB9F87D, 0x7FEFFFFFFFFFFD3B);   # sinh at the threshold
t_hb1(9, 0x408633CE8FB9F87D, 0x7FEFFFFFFFFFFD3B);   # cosh at the threshold
# Either side of exp's overflow threshold, 709.782712893384: 0.5·exp, then 2^2042.
t_hb1(1, 0x40862E42FEFA39EF, 0x7FDFFFFFFFFFFF2A);   # sinh(709.78271289338397)
t_hb1(9, 0x40862E42FEFA39F0, 0x7FE0000000000195);   # cosh(709.78271289338409)
# (w/2)·w with w = exp(|x|/2), which doubles exp's error, is 3 bit patterns off at the
# first three arguments on aarch64 and 2 off at the last two on both targets.
t_hb1(1, 0x408628A6E9D4C625, 0x7FCFBE326E9EBAF2);   # sinh(709.0815006850213)
t_hb1(9, 0x408628A6E9D4C625, 0x7FCFBE326E9EBAF2);   # cosh(709.0815006850213)
t_hb1(1, 0x408628B5C7560156, 0x7FCFF9651CB153EC);   # sinh(709.08875910941674)
t_hb1(9, 0x408628B5C7560156, 0x7FCFF9651CB153EC);   # cosh(709.08875910941674)
t_hb1(1, 0x408633CCDD1C42CD, 0x7FEFF9364192F8C4);   # sinh(710.47503110960827)
t_hb1(9, 0x408633CCDD1C42CD, 0x7FEFF9364192F8C4);   # cosh(710.47503110960827)
t_hb1(9, 0x408628ACA1E31A37, 0x7FCFD4EBBBDDF36A);   # cosh(709.08429315017463)
t_hb1(1, 0x408633C6F3BB4D3F, 0x7FEFE19E7A7C1DB6);   # sinh(710.4721445687245)
assert_eq(HB_BAD, 0, "the 22 overflow-band rows are within 2 bit patterns of correctly rounded (1.2.10: 8 were not)");
assert(HB_MAX <= 1, "every one of the 22 overflow-band rows is at most 1 bit pattern from correctly rounded");
assert_eq(ganita_f64_sinh(0x408633CE8FB9F87E), 0x7FF0000000000000, "sinh(710.475860073944) = +inf: one ulp past it");
assert_eq(ganita_f64_sinh(0xC08633CE8FB9F87E), 0xFFF0000000000000, "sinh(-710.475860073944) = -inf");
assert_eq(ganita_f64_cosh(0x408633CE8FB9F87E), 0x7FF0000000000000, "cosh(710.475860073944) = +inf");
assert_eq(ganita_f64_cosh(0xC08633CE8FB9F87E), 0x7FF0000000000000, "cosh(-710.475860073944) = +inf");
assert_eq(ganita_f64_sinh(t_d(1500)), 0x7FF0000000000000, "sinh(1500) = +inf: the 2^2042 scaling overflows, no NaN");
assert_eq(ganita_f64_cosh(t_d(0 - 1500)), 0x7FF0000000000000, "cosh(-1500) = +inf");
assert_eq(_gn_exp_half(0x7FF0000000000000), 0x7FF0000000000000, "_gn_exp_half(+inf) = +inf: inf times 2^2042, no NaN");
# sinh odd and cosh even, bit for bit, across the band: 200 patterns over (709, 710.4759].
var hb_sym_bad = 0;
hb_i = 0;
while (hb_i < 200) {
    var hbo = 0x4086280000000001 + hb_i * 0xF1CE0EE0A;
    if (ganita_f64_sinh(hbo | HB_SIGN) != (ganita_f64_sinh(hbo) | HB_SIGN)) { hb_sym_bad = hb_sym_bad + 1; }
    if (ganita_f64_cosh(hbo | HB_SIGN) != ganita_f64_cosh(hbo)) { hb_sym_bad = hb_sym_bad + 1; }
    hb_i = hb_i + 1;
}
assert_eq(hb_sym_bad, 0, "sinh is odd and cosh even, bit for bit, over 200 patterns in (709, 710.4759]");
# cosh's cuts. Its two-exponential form gives way to e^|x|/2 at 709, but from about
# 18.7 up 1/e^|x| is under half an ulp of e^|x| and the two agree bit for bit, so that
# cut matters only if it moves below 18.7: the first row fails then (e^|x|/2 is 2 ulp
# off there). _gn_exp_half switches from 0.5·exp to the 2^2042 form at exp's own
# overflow; the second row fails if that cut moves.
assert_eq(ganita_f64_cosh(0xC031E147AE147AD0), 0x417BC4C9040453AA, "cosh(-17.87999999999994) is correctly rounded");
assert_eq(ganita_f64_cosh(0x4086290C6B4DCF1D), 0x7FD0AD8DA73D10F9, "cosh(709.1310640410262) is correctly rounded");
# cosh even below the band too. Through 1.2.10 a negative x formed e^|x| as the rounded
# 1/exp(x), and about one argument in six came back an ulp from its mirror.
var hb_even_bad = 0;
hb_i = 0;
while (hb_i < 600) {
    var hbe = 0x3E50000000000000 + hb_i * 0xF191111ABCDE;
    if (ganita_f64_cosh(hbe | HB_SIGN) != ganita_f64_cosh(hbe)) { hb_even_bad = hb_even_bad + 1; }
    hb_i = hb_i + 1;
}
assert_eq(hb_even_bad, 0, "cosh is even bit for bit over 600 patterns in [2^-26, 709)");

test_group("f64 cbrt: correctly rounded, odd, exact on every cube (1.2.6)");
# ⭐ Filed by tanmatra ahead of its Rust -> Cyrius port, which asserts golden values
# generated from Rust's libm::cbrt. ganita had no f64 cube root, and the pow(x, 1/3)
# stand-in a consumer had to write was wrong in the last bits for structural
# reasons: 1/3 rounds DOWN, so every perfect cube came back low, and exp(y·ln x)
# grows its error with |ln x| — 137 ulps at 1e-300. Groups A-C are the filing's
# own, moved in from docs/development/issues/repros/2026-09-16-f64-cbrt-missing.cyr.
var CB_SIGN = 0x8000000000000000;
var CB_INF = 0x7FF0000000000000;

# Group A — IEEE special values, sign of zero and of infinity preserved.
assert_eq(ganita_f64_cbrt(0), 0, "cbrt(+0) = +0");
assert_eq(ganita_f64_cbrt(CB_SIGN), CB_SIGN, "cbrt(-0) = -0 — the sign of zero survives (bare pow gave +0)");
assert_eq(ganita_f64_cbrt(CB_INF), CB_INF, "cbrt(+inf) = +inf (bare pow gave NaN)");
assert_eq(ganita_f64_cbrt(CB_INF | CB_SIGN), CB_INF | CB_SIGN, "cbrt(-inf) = -inf (bare pow gave NaN)");
assert_eq(t_f64_is_nan(ganita_f64_cbrt(f64_div(t_d(0), t_d(0)))), 1, "cbrt(NaN) is NaN");

# Group B — cbrt(±k³) = ±k EXACTLY. Every k³ below is under 2^53, so input and
# answer are both exact doubles and exactly one bit pattern is right.
var cb_bad = 0;
var cbk = 1;
while (cbk <= 1000) {
    var cube = t_d(cbk * cbk * cbk);
    if (ganita_f64_cbrt(cube) != t_d(cbk)) { cb_bad = cb_bad + 1; }
    if (ganita_f64_cbrt(cube | CB_SIGN) != (t_d(cbk) | CB_SIGN)) { cb_bad = cb_bad + 1; }
    cbk = cbk + 1;
}
assert_eq(cb_bad, 0, "cbrt(±k^3) == ±k exactly for every k = 1..1000 (the guarded pow form missed 1752 of 2000)");
assert_eq(ganita_f64_cbrt(t_d(8)), t_d(2), "cbrt(8) == 2 exactly (pow: 1.9999999999999998, -1 ulp)");
assert_eq(ganita_f64_cbrt(t_d(64)), t_d(4), "cbrt(64) == 4 exactly (pow: -2 ulp)");
assert_eq(ganita_f64_cbrt(t_d(1728)), t_d(12), "cbrt(1728) == 12 exactly (pow: 11.999999999999995, -3 ulp)");
assert_eq(ganita_f64_cbrt(t_d(0 - 27)), t_d(0 - 3), "cbrt(-27) == -3 exactly");
# 208063 is the largest k with k^3 < 2^53, so this is the last exact cube.
assert_eq(ganita_f64_cbrt(t_d(9007091372906047)), t_d(208063),
  "cbrt(208063^3) == 208063 exactly — the largest cube whose input is exact");

# Group C — correctly rounded results. Each expected pattern is the round-to-nearest
# double of the exact cube root of the exact binary input, computed at 120
# significant digits for the filing and re-derived with exact integer arithmetic.
assert_eq(ganita_f64_cbrt(0x4000000000000000), 0x3FF428A2F98D728B, "cbrt(2) is correctly rounded");
assert_eq(ganita_f64_cbrt(0x4008000000000000), 0x3FF7137449123EF6, "cbrt(3) is correctly rounded");
assert_eq(ganita_f64_cbrt(0x4024000000000000), 0x40013C484138704F, "cbrt(10) is correctly rounded");
assert_eq(ganita_f64_cbrt(0x404C000000000000), 0x400E9B5DBA58189E, "cbrt(56) is correctly rounded (tanmatra: Fe-56)");
assert_eq(ganita_f64_cbrt(0x406A000000000000), 0x4017B3312382B4B5, "cbrt(208) is correctly rounded (tanmatra: Pb-208)");
assert_eq(ganita_f64_cbrt(0x406DC00000000000), 0x4018C9E2DA25E5E4, "cbrt(238) is correctly rounded (tanmatra: U-238)");
assert_eq(ganita_f64_cbrt(0x4071E00000000000), 0x401A5AA8345EF361,
  "cbrt(286) is correctly rounded (pow's worst over n = 1..300: -2 ulp)");
assert_eq(ganita_f64_cbrt(0x3FE0000000000000), 0x3FE965FEA53D6E3D, "cbrt(0.5) is correctly rounded");
assert_eq(ganita_f64_cbrt(0x7E37E43C8800759C), 0x54B249AD2594C37D,
  "cbrt(1e300) is correctly rounded (pow: -89 ulp; a naive Newton step's y^3 overflows here)");
assert_eq(ganita_f64_cbrt(0x01A56E1FC2F8F359), 0x2B2BFF2EE48E0530, "cbrt(1e-300) is correctly rounded (pow: +137 ulp)");
assert_eq(ganita_f64_cbrt(0x0010000000000000), 0x2AA428A2F98D728B,
  "cbrt(DBL_MIN = 2^-1022) is correctly rounded (pow: +106 ulp)");
assert_eq(ganita_f64_cbrt(0x0000000000000001), 0x2990000000000000,
  "cbrt(2^-1074, the min subnormal) == 2^-358 exactly (pow: +66 ulp)");

# The ends of the range, where an unsplit exponent overflows or underflows.
assert_eq(ganita_f64_cbrt(0x7FEFFFFFFFFFFFFF), 0x554428A2F98D728B, "cbrt(DBL_MAX) is correctly rounded and finite");
assert_eq(ganita_f64_cbrt(0x7FE0000000000000), 0x5540000000000000, "cbrt(2^1023) == 2^341 exactly");
assert_eq(ganita_f64_cbrt(0x000FFFFFFFFFFFFF), 0x2AA428A2F98D728A, "cbrt(the largest subnormal) is correctly rounded");
assert_eq(ganita_f64_cbrt(0x0000000000000003), 0x2997137449123EF6, "cbrt(3 * 2^-1074) is correctly rounded");
# A root that rounds UP to the next power of two needs the next exponent — the one
# significand, 2^53, that the final bit assembly handles separately.
assert_eq(ganita_f64_cbrt(0x401FFFFFFFFFFFFF), 0x4000000000000000,
  "cbrt(8 - 1 ulp) rounds up to exactly 2.0 (the carry into the exponent)");
assert_eq(ganita_f64_cbrt(0x3FEFFFFFFFFFFFFF), 0x3FF0000000000000,
  "cbrt(1 - 1 ulp) rounds up to exactly 1.0 — the same carry from the scaled branch");

# Odd, bit for bit, across every exponent class: cbrt(-x) must be cbrt(x) with the
# sign bit set. Checked over 4096 patterns from a fixed generator.
# splitmix64's output function: a well-mixed 64-bit pattern from a counter.
fn t_cb_mix(s): i64 {
    var z = s * 0x9E3779B97F4A7C15;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    return z ^ (z >> 31);
}
var cb_odd_bad = 0;
var cbs = 1;
while (cbs <= 4096) {
    var cbx = t_cb_mix(cbs) & 0x7FFFFFFFFFFFFFFF;
    if (ganita_f64_cbrt(cbx | CB_SIGN) != (ganita_f64_cbrt(cbx) | CB_SIGN)) {
        if (t_f64_is_nan(cbx) == 0) { cb_odd_bad = cb_odd_bad + 1; }
    }
    cbs = cbs + 1;
}
assert_eq(cb_odd_bad, 0, "cbrt(-x) == cbrt(x) with the sign bit set, over 4096 patterns in every exponent class");

# The rounding step is exact integer arithmetic. _f64_cbrt_cmp compares h^3 with
# mant * 2^sh; these pin both signs, the equality case, and carries that cross
# every limb boundary (2^35 +- 1 cubed spans limbs 0 through 4).
assert_eq(_f64_cbrt_cmp(34359738368, 1, 105), 0, "_f64_cbrt_cmp: (2^35)^3 == 2^105 exactly");
assert_eq(_f64_cbrt_cmp(34359738369, 1, 105), 1, "_f64_cbrt_cmp: (2^35 + 1)^3 > 2^105");
assert_eq(_f64_cbrt_cmp(34359738367, 1, 105), 0 - 1, "_f64_cbrt_cmp: (2^35 - 1)^3 < 2^105");
assert_eq(_f64_cbrt_cmp(18014398509481985, 9007199254740991, 109), 1,
  "_f64_cbrt_cmp at the top of its contract: (2^54 + 1)^3 > (2^53 - 1) * 2^109");
# The bisection fallback is unreachable through ganita_f64_cbrt by its bound, so it
# is exercised directly: from the full significand range it must land on the same
# significand the approximate-then-walk path returned.
var cb_bis_bad = 0;
cbs = 1;
while (cbs <= 64) {
    # bx is in [1, 2), so r = 0 and k = 0: its root's significand is the answer's.
    var bx = (t_cb_mix(cbs + 5000) & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var bmant = (bx & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    var got_sig = (ganita_f64_cbrt(bx) & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    if (_f64_cbrt_bisect(bmant, 107) != got_sig) { cb_bis_bad = cb_bis_bad + 1; }
    cbs = cbs + 1;
}
assert_eq(cb_bis_bad, 0, "_f64_cbrt_bisect agrees with the walk on 64 inputs in [1, 2)");

test_group("f32 cbrt: correctly rounded by construction (1.2.6)");
# ganita_f32_cbrt now widens onto ganita_f64_cbrt. Every f32 perfect cube, both signs.
var cb32_bad = 0;
cbk = 1;
while (cbk <= 255) {
    var c32 = t_f32(cbk * cbk * cbk);
    if (ganita_f32_cbrt(c32) != t_f32(cbk)) { cb32_bad = cb32_bad + 1; }
    if (ganita_f32_cbrt(c32 | 0x80000000) != (t_f32(cbk) | 0x80000000)) { cb32_bad = cb32_bad + 1; }
    cbk = cbk + 1;
}
assert_eq(cb32_bad, 0, "f32 cbrt(±k^3) == ±k exactly for every f32 cube, k = 1..255");
# The tier is the narrowed f64 root, so the two must agree wherever the input is an f32.
var cb32_path = 0;
cbs = 1;
while (cbs <= 1024) {
    var fx = t_cb_mix(cbs + 9000) & 0x7F7FFFFF;
    if (ganita_f32_cbrt(fx) != f32_from(ganita_f64_cbrt(f32_to(fx)))) { cb32_path = cb32_path + 1; }
    cbs = cbs + 1;
}
assert_eq(cb32_path, 0, "ganita_f32_cbrt == narrow(ganita_f64_cbrt(widen x)) over 1024 finite patterns");
# The pow form survived narrowing almost everywhere: an exhaustive sweep of all
# 2,139,095,039 positive finite f32 inputs found it one ulp out on exactly 13 of
# them, from the small and large ends where pow's error grows with |ln x|. These
# four are from that list; the pow form fails every one.
assert_eq(ganita_f32_cbrt(0x02A1B8E7), 0x2B2E5805, "f32 cbrt(2.37629526e-37) is correctly rounded (pow form: +1 ulp)");
assert_eq(ganita_f32_cbrt(0x088353B5), 0x2D22A7BC, "f32 cbrt(7.90395514e-34) is correctly rounded (pow form: -1 ulp)");
assert_eq(ganita_f32_cbrt(0x640353B5), 0x4BA2A7BC, "f32 cbrt(9.6902208e21) is correctly rounded (pow form: -1 ulp)");
assert_eq(ganita_f32_cbrt(0xFDD26132), 0xD43E51F0,
  "f32 cbrt(-3.49553183e37) is correctly rounded and negative (pow form: 1 ulp out)");

test_group("performance backlog closed: inv / qr / pseudo_inv allocate what they keep (1.2.6)");
# ⭐ The three items the 1.2.4 backlog left open. Each is pinned two ways: the
# RESULT is unchanged (bit for bit, where the old arithmetic can be rebuilt here),
# and the MEMORY a call takes from the bump allocator — which never frees — is what
# the function actually keeps, not scratch it discarded.
# The 3x3 permutation whose rows are I3's rotated, so LU must pivot on every column.
fn t_perm3(): i64 {
    return t_m3(t_d(0), t_d(1), t_d(0), t_d(0), t_d(0), t_d(1), t_d(1), t_d(0), t_d(0));
}
# A permutation's inverse is its transpose, exactly — and it drives the new
# forward substitution through a different starting row for every column.
assert_eq(ganita_mat_eq(ganita_mat_inv(t_perm3()), ganita_mat_transpose(t_perm3()), 0), 1,
  "inv(P) == P^T bit for bit for a pivoting permutation (tolerance 0)");
assert_eq(ganita_mat_eq(ganita_mat_mul(M3, ganita_mat_inv(M3)), I3, t_tol()), 1,
  "3x3: A * inv(A) = I through the single-scratch solve");
# mat_inv: two n x n matrices (the LU factor and the result) and three n-vectors
# (pivots, the scratch column, the pivot inverse). Through 1.2.5 it also took an
# n-vector per column inside lu_solve, plus two more — 8n^2 bytes it never kept.
var INV_N = 32;
var INV_A = ganita_mat_add(ganita_mat_identity(INV_N), ganita_mat_identity(INV_N));
ganita_mat_set(INV_A, 0, INV_N - 1, t_d(1));
var inv_u0 = alloc_used();
var INV_R = ganita_mat_inv(INV_A);
var inv_bytes = alloc_used() - inv_u0;
assert_eq(INV_R != 0, 1, "inv of a 32x32 succeeds");
assert_eq(inv_bytes <= 2 * (16 + 8 * INV_N * INV_N) + 3 * 8 * INV_N, 1,
  "inv(32x32) allocates two matrices and three vectors — the per-column scratch is gone");
assert_eq(ganita_mat_eq(ganita_mat_mul(INV_A, INV_R), ganita_mat_identity(INV_N), t_tol()), 1,
  "32x32: A * inv(A) = I");

# qr: the Q transpose is in place. The only allocation left is the reflector.
var QRN = 12;
var QRA = ganita_mat_new(QRN, QRN);
var qri = 0;
while (qri < QRN * QRN) {
    store64(QRA + 16 + qri * 8, f64_div(t_d((t_cb_mix(qri + 777) >> 40) % 2001 - 1000), t_d(97)));
    qri = qri + 1;
}
var QRQ = ganita_mat_new(QRN, QRN);
var QRR = ganita_mat_new(QRN, QRN);
var qr_u0 = alloc_used();
assert_eq(ganita_mat_qr(QRA, QRQ, QRR), 0, "qr of a 12x12 returns 0");
assert_eq(alloc_used() - qr_u0 <= 8 * QRN, 1,
  "qr allocates only its reflector — no m x m transposed copy of Q");
assert_eq(ganita_mat_eq(ganita_mat_mul(QRQ, QRR), QRA, t_tol()), 1, "12x12: Q * R = A with Q transposed in place");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_transpose(QRQ), QRQ), ganita_mat_identity(QRN), t_tol()), 1,
  "12x12: Q^T * Q = I with Q transposed in place");

# pseudo_inv: rebuild the 1.2.5 arithmetic from the same SVD — transpose V^T, scale
# V's columns, transpose U, multiply — and require the new result to match it BIT
# FOR BIT. A tall, rank-deficient input (its last column is zero) so the
# negligible-singular-value branch is taken as well.
var PINV_A = ganita_mat_new(5, 3);
var pir = 0;
while (pir < 5) {
    ganita_mat_set(PINV_A, pir, 0, t_d(pir + 1));
    ganita_mat_set(PINV_A, pir, 1, t_d((pir * pir) % 7 - 3));
    pir = pir + 1;
}
var PINV_U = ganita_mat_new(5, 3);
var PINV_S = alloc(24);
var PINV_VT = ganita_mat_new(3, 3);
assert_eq(ganita_mat_svd(PINV_A, PINV_U, PINV_S, PINV_VT), 0, "svd of the rank-2 5x3 succeeds");
var PINV_V = ganita_mat_transpose(PINV_VT);
var pic = 0;
while (pic < 3) {
    var pif = t_d(0);
    if (f64_gt(load64(PINV_S + pic * 8), f64_mul(LINALG_EPS, load64(PINV_S))) == 1) {
        pif = f64_div(t_d(1), load64(PINV_S + pic * 8));
    }
    pir = 0;
    while (pir < 3) {
        ganita_mat_set(PINV_V, pir, pic, f64_mul(ganita_mat_get(PINV_V, pir, pic), pif));
        pir = pir + 1;
    }
    pic = pic + 1;
}
var PINV_OLD = ganita_mat_mul(PINV_V, ganita_mat_transpose(PINV_U));
var PINV_NEW = ganita_mat_pseudo_inv(PINV_A);
assert_eq(ganita_mat_rows(PINV_NEW) == 3 && ganita_mat_cols(PINV_NEW) == 5, 1, "pseudo_inv of a 5x3 is 3x5");
assert_eq(ganita_mat_eq(PINV_NEW, PINV_OLD, 0), 1,
  "pseudo_inv is BIT-IDENTICAL to V * Sigma+ * U^T built with the transposes it no longer forms");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_mul(PINV_A, PINV_NEW), PINV_A), PINV_A, t_tol()), 1,
  "pseudo_inv: A A+ A = A for the rank-deficient 5x3");
# The shared multiply kernel's transposed mode, directly: (A B)^T without forming A B.
var KA = ganita_mat_new(3, 4);
var KB = ganita_mat_new(4, 2);
var kki = 0;
while (kki < 12) { store64(KA + 16 + kki * 8, t_d(kki - 5)); kki = kki + 1; }
kki = 0;
while (kki < 8) { store64(KB + 16 + kki * 8, f64_div(t_d(kki + 1), t_d(3))); kki = kki + 1; }
var KT = ganita_mat_new(2, 3);
_ganita_mat_mul_into(KA, KB, KT, 1);
assert_eq(ganita_mat_eq(KT, ganita_mat_transpose(ganita_mat_mul(KA, KB)), 0), 1,
  "_ganita_mat_mul_into(transposed) == transpose(A * B), bit for bit, for a 3x4 * 4x2");

test_group("f64/f32 tan: fdlibm k_tan on the stdlib reducer (1.2.11)");
# ⭐ Filed by abaco (docs/development/issues/archived/2026-09-30-f64-tan-missing.md): there was
# no tangent at all, and the f64_sin(x) / f64_cos(x) a consumer had to write is two
# results within 1 ulp each and then a rounded division — up to 2 ulp. Every expected
# f64 pattern below is the correctly rounded tan of the exact binary input (mpmath at
# 320+ bits, rounded once); every f32 one likewise in single precision. The first
# eight rows are the filing's repro, the last two of them its controls: sin/cos misses
# the first six by 2 ulp each.
var TN_SIGN = 0x8000000000000000;
var TN_INF = 0x7FF0000000000000;
var TN_NAN = f64_div(t_d(0), t_d(0));
assert_eq(ganita_f64_tan(0x3FE8ABFD0623CAB4), 0x3FEF1759205E500C, "tan(0.770994674674816) is correctly rounded");
assert_eq(ganita_f64_tan(0xBFE5FA427B8CEBDD), 0xBFEA3D30361F2EFF, "tan(-0.6867992795081325) is correctly rounded");
assert_eq(ganita_f64_tan(0x3FF0280821E3AFE2), 0x3FF9766548EDEC10, "tan(1.0097733806423936) is correctly rounded");
assert_eq(ganita_f64_tan(0xC0440926381A5059), 0x3FEEFB395BD7179D, "tan(-40.07147885594231) is correctly rounded");
assert_eq(ganita_f64_tan(0xC04D0D3B48837D32), 0xC04F115FAB4615F4, "tan(-58.10337168140758) is correctly rounded");
assert_eq(ganita_f64_tan(0x404661D6B1124C50), 0x3FEFC99B5776134D, "tan(44.764364370283715) is correctly rounded");
assert_eq(ganita_f64_tan(0x3FE0000000000000), 0x3FE17B4F5BF3474A, "tan(0.5) is correctly rounded (control)");
assert_eq(ganita_f64_tan(0x4008000000000000), 0xBFC23EF71254B86F, "tan(3.0) is correctly rounded (control)");

# IEEE special values. The sign of zero is part of the answer.
assert_eq(ganita_f64_tan(0), 0, "tan(+0) = +0");
assert_eq(ganita_f64_tan(TN_SIGN), TN_SIGN, "tan(-0) = -0 (the kernel alone would give +0)");
assert_eq(t_f64_is_nan(ganita_f64_tan(TN_INF)), 1, "tan(+inf) is NaN");
assert_eq(t_f64_is_nan(ganita_f64_tan(TN_INF | TN_SIGN)), 1, "tan(-inf) is NaN");
assert_eq(t_f64_is_nan(ganita_f64_tan(TN_NAN)), 1, "tan(NaN) is NaN");
# Below 2^-27, tan(x) = x is the correctly rounded answer, subnormals included; 2^-27
# itself is the first argument the kernel sees.
assert_eq(ganita_f64_tan(0x3E45798EE2308C3A), 0x3E45798EE2308C3A, "tan(1e-8) = 1e-8");
assert_eq(ganita_f64_tan(0x3E3FFFFFFFFFFFFF), 0x3E3FFFFFFFFFFFFF, "tan(2^-27 - 1 ulp) = itself");
assert_eq(ganita_f64_tan(0x3E40000000000000), 0x3E40000000000000, "tan(2^-27) = 2^-27, through the kernel");
assert_eq(ganita_f64_tan(1), 1, "tan(2^-1074) = 2^-1074 (the min subnormal survives)");
assert_eq(ganita_f64_tan(1 | TN_SIGN), 1 | TN_SIGN, "tan(-2^-1074) = -2^-1074");
# Just above 2^-27 returning x is no longer right: from about 1.82 * 2^-27, x³/3 is
# over half a ulp and the correctly rounded tan is x + 1 ulp. These rows fail if the
# guard moves up, to 2^-26 say (the bound f64_sin and this module's _F64_TINY use).
assert_eq(ganita_f64_tan(0x3E4D800000000000), 0x3E4D800000000001,
  "tan(1.84375 * 2^-27) is x + 1 ulp: the 2^-27 guard must not move up at all");
assert_eq(ganita_f64_tan(0x3E4F000000000000), 0x3E4F000000000001, "tan(1.9375 * 2^-27) is x + 1 ulp");
assert_eq(ganita_f64_tan(0x3E4FFFFFFFFFFFFF), 0x3E50000000000000,
  "tan(2^-26 - 1 ulp) is x + 1 ulp: the 2^-27 guard must not move up");

# |x| >= 0.6744 (high word 0x3FE59428 up) folds onto pi/4 - |x|; one ulp below the
# boundary is the polynomial alone. Both sides of it, and the double nearest pi/4.
assert_eq(ganita_f64_tan(0x3FE59427FFFFFFFF), 0x3FE99427887A14D4,
  "tan just below the 0.6744 fold (polynomial alone) is correctly rounded");
assert_eq(ganita_f64_tan(0x3FE5942800000000), 0x3FE99427887A14D6,
  "tan at the 0.6744 fold (high word 0x3FE59428) is correctly rounded");
assert_eq(ganita_f64_tan(0x3FE6666666666666), 0x3FEAF406C2FC78AE, "tan(0.7), folded, is correctly rounded");
assert_eq(ganita_f64_tan(0xBFE6666666666666), 0xBFEAF406C2FC78AE, "tan(-0.7): the fold puts the sign back");
assert_eq(ganita_f64_tan(0x3FE921FB54442D18), 0x3FEFFFFFFFFFFFFF, "tan(double nearest pi/4) = 1 - 2^-53");
# The top of the unreduced range is the last double with high word 0x3FE921FB; the
# next one is the first the reducer sees (n = 1, so -1/tan of y = x - pi/2).
assert_eq(ganita_f64_tan(0x3FE921FBFFFFFFFF), 0x3FF00000ABBBD680,
  "tan(0x3FE921FBFFFFFFFF), the last unreduced argument, is correctly rounded");
assert_eq(ganita_f64_tan(0x3FE921FC00000000), 0x3FF00000ABBBD681,
  "tan(0x3FE921FC00000000), the first reduced argument, is correctly rounded");
# 24 ulp above the fold, the polynomial alone would round the other way: this row
# fails if the fold's threshold moves up even one step in the high word.
assert_eq(ganita_f64_tan(0x3FE5942800000018), 0x3FE99427887A14FD,
  "tan(0x3FE5942800000018), just past the fold, is correctly rounded");
# 37 ulp below the fold, the folded form would round the other way: this row fails if
# the threshold moves down even one step in the high word.
assert_eq(ganita_f64_tan(0x3FE59427FFFFFFDB), 0x3FE99427887A1499,
  "tan(0x3FE59427FFFFFFDB), 37 ulp below the fold (polynomial alone), is correctly rounded");
# T5 one unit up in its last place moves this one.
assert_eq(ganita_f64_tan(0x3FE59427D82C1B48), 0x3FE994274733A829, "tan(0.6743354055514397) is correctly rounded");
# Rows that pin the coefficients: each is correctly rounded here and comes back an ulp
# off if T1, T2, T3 or T4 is raised by one unit in its last place, or T5 by 128
# (found by mutating each one; a decrease is not caught by these rows).
assert_eq(ganita_f64_tan(0x3FE0DDFBD7C146EC), 0x3FE29FF29CE703A0, "tan(0.5270976270641916) is correctly rounded");
assert_eq(ganita_f64_tan(0x3FE57FB8C9F5E0DC), 0x3FE972BAF39C7FF5, "tan(0.6718410439052849) is correctly rounded");
assert_eq(ganita_f64_tan(0xBFE2FB51C907B6C8), 0xBFE592CB23355F4C, "tan(-0.5931786466951161) is correctly rounded");
assert_eq(ganita_f64_tan(0x3FED850AB2CAEB30), 0x3FF51F036B8516EC, "tan(0.9224904529613465) is correctly rounded");
assert_eq(ganita_f64_tan(0x3FEE382900668714), 0x3FF61BFAAB40F3BB, "tan(0.9443554885694732) is correctly rounded");

# An odd quadrant (n odd after reduction) returns -1/tan(y): through the fold when
# |y| >= 0.6744 (0.8, 2.3), through the compensated division when it is not.
assert_eq(ganita_f64_tan(0x3FE999999999999A), 0x3FF079664793B60B, "tan(0.8): n = 1, folded -1/tan");
assert_eq(ganita_f64_tan(0x4002666666666666), 0xBFF1E84C9047C337, "tan(2.3): n = 1, folded -1/tan");
assert_eq(ganita_f64_tan(0x3FF0000000000000), 0x3FF8EB245CBEE3A6, "tan(1.0): n = 1, compensated -1/tan");
assert_eq(ganita_f64_tan(0x3FF8000000000000), 0x402C33ED50B88777, "tan(1.5): n = 1, compensated -1/tan");
assert_eq(ganita_f64_tan(0x4000000000000000), 0xC0017AF62E0950F8, "tan(2.0): n = 1, compensated -1/tan");
assert_eq(ganita_f64_tan(0xC000000000000000), 0x40017AF62E0950F8, "tan(-2.0) = -tan(2.0)");
# The doubles nearest two poles, where the answer is -1/y for a reduced y of about
# -6.1e-17 and -1.8e-16, and nearest the zero at pi.
assert_eq(ganita_f64_tan(0x3FF921FB54442D18), 0x434D02967C31CDB5,
  "tan(double nearest pi/2) = 1.633123935319537e16, correctly rounded");
assert_eq(ganita_f64_tan(0x4012D97C7F3321D2), 0x4333570EFD768923,
  "tan(double nearest 3pi/2) = 5443746451065123, correctly rounded");
assert_eq(ganita_f64_tan(0x400921FB54442D18), 0xBCA1A62633145C07, "tan(double nearest pi) = -1.2246467991473532e-16");

# Large arguments go through the stdlib's exact reduction, as f64_sin's do.
assert_eq(ganita_f64_tan(0x4059000000000000), 0xBFE2CA74D62B5D38, "tan(100) is correctly rounded");
assert_eq(ganita_f64_tan(0x412E848000000000), 0xBFD7E9768AB734C0, "tan(1e6) is correctly rounded");
assert_eq(ganita_f64_tan(0x4480F0CF064DD592), 0xBFFA0F79C1B6B258,
  "tan(1e22) is 1 ulp off the correctly rounded ...B257 (0.544 ulp from the exact), the same bits on every target");
# Where the error peaks (see ganita_f64_tan): a reduced argument just below the 0.6744
# fold, with a tail. Both rows are 1 ulp off, as fdlibm's kernel itself is. The second
# is the worst error found at 1.2.11, in a sweep of every f32 value as an argument.
assert_eq(ganita_f64_tan(0xC275D8CBF99ED8A3), 0xBFE96DE59812187E,
  "tan(-1501304953325.5398) is 1 ulp off the correctly rounded ...187D (0.886 ulp from the exact)");
assert_eq(ganita_f64_tan(0x4725D8E500000000), 0xBFE99390066D26E8,
  "tan(5.67186889e34) is 1 ulp off the correctly rounded ...26E9 (0.940 ulp from the exact)");
assert_eq(ganita_f64_tan(0x7E70000000000000), 0xBFC4A41D560C08CC, "tan(2^1000) is correctly rounded");
assert_eq(ganita_f64_tan(0x7FEFFFFFFFFFFFFF), 0xBF74530CFE729484, "tan(DBL_MAX) is correctly rounded");

# Odd, bit for bit: tan(-x) must be tan(x) with the sign bit flipped. 512 random bit
# patterns from the cbrt group's generator; NaN results are skipped.
var tn_odd_bad = 0;
var tns = 1;
while (tns <= 512) {
    var tnx = t_cb_mix(tns + 20000) & 0x7FFFFFFFFFFFFFFF;
    if (t_f64_is_nan(tnx) == 0) {
        var tnp = ganita_f64_tan(tnx);
        if (t_f64_is_nan(tnp) == 0) {
            if (ganita_f64_tan(tnx | TN_SIGN) != (tnp ^ TN_SIGN)) { tn_odd_bad = tn_odd_bad + 1; }
        }
    }
    tns = tns + 1;
}
assert_eq(tn_odd_bad, 0, "tan(-x) == tan(x) with the sign bit flipped, over 512 random bit patterns");

# The kernel directly: iy = 1 is tan(x + y), iy = -1 is -1/tan(x + y).
assert_eq(_gn_k_tan(0x3FE0000000000000, 0, 1), 0x3FE17B4F5BF3474A, "_gn_k_tan(0.5, 0, 1) = tan(0.5)");
assert_eq(_gn_k_tan(0x3FE0000000000000, 0, 0 - 1), 0xBFFD49AD7E47C0A3,
  "_gn_k_tan(0.5, 0, -1) = -1/tan(0.5), correctly rounded");
assert_eq(_gn_k_tan(0x3FE70A3D70A3D70A, 0, 0 - 1), 0xBFF23E1B1E365198,
  "_gn_k_tan(0.72, 0, -1) = -1/tan(0.72) through the fold, correctly rounded");

# f32: widened onto ganita_f64_tan and narrowed once.
assert_eq(ganita_f32_tan(0), 0, "f32 tan(+0) = +0");
assert_eq(ganita_f32_tan(0x80000000), 0x80000000, "f32 tan(-0) = -0");
assert_eq(t_is_nan(ganita_f32_tan(0x7F800000)), 1, "f32 tan(+inf) is NaN");
assert_eq(t_is_nan(ganita_f32_tan(0xFF800000)), 1, "f32 tan(-inf) is NaN");
assert_eq(t_is_nan(ganita_f32_tan(f32_from(TN_NAN))), 1, "f32 tan(NaN) is NaN");
assert_eq(ganita_f32_tan(1), 1, "f32 tan(min subnormal) = itself");
assert_eq(ganita_f32_tan(0x3F800000), 0x3FC75923, "f32 tan(1) is correctly rounded");
assert_eq(ganita_f32_tan(0x3F000000), 0x3F0BDA7B, "f32 tan(0.5) is correctly rounded");
assert_eq(ganita_f32_tan(0x3F333333), 0x3F57A036, "f32 tan(0.7) is correctly rounded");
assert_eq(ganita_f32_tan(0x3FC00000), 0x41619F6B, "f32 tan(1.5) is correctly rounded");
assert_eq(ganita_f32_tan(0xC0000000), 0x400BD7B1, "f32 tan(-2) is correctly rounded");
assert_eq(ganita_f32_tan(0x3FC90FDB), 0xCBAE8A4A, "f32 tan(float nearest pi/2) = -22877332, correctly rounded");
assert_eq(ganita_f32_tan(0x60AD78EC), 0x3F5ED890, "f32 tan(1e20) is correctly rounded");
assert_eq(ganita_f32_tan(0x7F7FFFFF), 0xBF1C9ECA, "f32 tan(FLT_MAX) is correctly rounded");
assert_eq(ganita_f32_tan(0xFF7FFFFF), 0x3F1C9ECA, "f32 tan(-FLT_MAX) is correctly rounded");
# An exhaustive sweep of every non-negative finite f32 found 7 inputs whose double tan
# lies within 2 ulp of a single-precision midpoint, the only places narrowing could
# misround; none does. Two of them: the double for 3.64902137e19 lies EXACTLY on one.
assert_eq(ganita_f32_tan(0x5FFD33A4), 0x3FD06C8C,
  "f32 tan(3.64902137e19) is correctly rounded (its double tan sits exactly on an f32 midpoint)");
assert_eq(ganita_f32_tan(0x408174DD), 0x3FA29B31,
  "f32 tan(4.04551554) is correctly rounded (its double tan is 2 ulp below an f32 midpoint)");

test_group("SVD family: a NaN or infinite entry is refused, not decomposed (1.2.12)");
# hisab 3.3.3 found that ganita_mat_svd had no finite check. An all-NaN 2x2 came back
# as status 0 with sigma (0, 0), and [[NaN, 0], [0, 2]] as status 0 with the FINITE
# sigma (2, 0): the scale and the column norm are ordered maxima that a NaN never
# wins, and a NaN gamma fails the orthogonality test, so the pair counted as
# converged. rank, condition and pseudo_inv inherited it (rank 0 or 1, condition
# -1.0 "singular", a pseudo-inverse of zeros). Each must now refuse in its own shape.
fn t_nf_poison(p, n): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, 0x7FF4000000000BAD); i = i + 1; }
    return 0;
}
# 1 when every one of the n words at p still holds t_nf_poison's pattern.
fn t_nf_untouched(p, n): i64 {
    var i = 0;
    while (i < n) {
        if (load64(p + i * 8) != 0x7FF4000000000BAD) { return 0; }
        i = i + 1;
    }
    return 1;
}
# How many of the four SVD-family functions refuse `a` in their own shape: svd -2
# with sigma, U and V^T left untouched; rank -2; condition NaN; pseudo_inv null.
fn t_nf_refusals(a): i64 {
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    var u = ganita_mat_new(rows, cols);
    var vt = ganita_mat_new(cols, cols);
    var s = alloc(cols * 8);
    t_nf_poison(s, cols);
    t_nf_poison(u + 16, rows * cols);
    t_nf_poison(vt + 16, cols * cols);
    var n = 0;
    if (ganita_mat_svd(a, u, s, vt) == 0 - 2) {
        n = n + (t_nf_untouched(s, cols) & t_nf_untouched(u + 16, rows * cols) & t_nf_untouched(vt + 16, cols * cols));
    }
    if (ganita_mat_rank(a, t_tol()) == 0 - 2) { n = n + 1; }
    if (t_f64_is_nan(ganita_mat_condition(a)) == 1) { n = n + 1; }
    if (ganita_mat_pseudo_inv(a) == 0) { n = n + 1; }
    return n;
}
var NF_PINF = 0x7FF0000000000000;
var NF_NINF = 0xFFF0000000000000;
# The all-NaN fixture from the 1.2.3 group, function by function.
var NF_S = alloc(16);
assert_eq(ganita_mat_svd(NANM, ganita_mat_new(2, 2), NF_S, ganita_mat_new(2, 2)), 0 - 2,
  "svd -> -2 for an all-NaN 2x2 (was 0 with sigma (0, 0))");
assert_eq(ganita_mat_rank(NANM, t_tol()), 0 - 2, "rank -> -2 for an all-NaN 2x2 (was 0)");
assert_eq(t_f64_is_nan(ganita_mat_condition(NANM)), 1, "condition -> NaN for an all-NaN 2x2 (was -1.0)");
assert_eq(ganita_mat_pseudo_inv(NANM), 0, "pseudo_inv -> null for an all-NaN 2x2 (was a matrix of zeros)");
assert_eq(t_nf_refusals(t_m2(NANV, t_d(0), t_d(0), t_d(2))), 4,
  "[[NaN, 0], [0, 2]]: all four refuse (svd was 0 with the finite sigma (2, 0))");
assert_eq(t_nf_refusals(t_m2(NF_PINF, t_d(0), t_d(0), t_d(2))), 4, "[[+inf, 0], [0, 2]]: all four refuse");
assert_eq(t_nf_refusals(t_m2(NF_NINF, t_d(0), t_d(0), t_d(2))), 4, "[[-inf, 0], [0, 2]]: all four refuse");
assert_eq(t_nf_refusals(t_m2(t_d(3), NANV, t_d(0), t_d(2))), 4, "[[3, NaN], [0, 2]]: all four refuse");
assert_eq(t_nf_refusals(t_m2(t_d(1), t_d(2), t_d(3), NF_PINF)), 4, "[[1, 2], [3, +inf]]: all four refuse");
# The LAST entry, which a scan of rows, cols or rows * cols - 1 entries misses.
assert_eq(t_nf_refusals(t_m2(t_d(3), t_d(0), t_d(0), NANV)), 4,
  "[[3, 0], [0, NaN]]: all four refuse (was sigma (3, 0), rank 1, pseudo_inv [0][0] = 1/3)");
var NF32 = ganita_mat_new(3, 2);
ganita_mat_set(NF32, 0, 0, t_d(1)); ganita_mat_set(NF32, 0, 1, t_d(2));
ganita_mat_set(NF32, 1, 0, t_d(3)); ganita_mat_set(NF32, 1, 1, t_d(4));
ganita_mat_set(NF32, 2, 0, t_d(5)); ganita_mat_set(NF32, 2, 1, NF_NINF);
assert_eq(t_nf_refusals(NF32), 4, "a tall 3x2 with -inf in its last entry: all four refuse");
# Every NaN, not just the default one: a negative quiet NaN and a signalling payload.
assert_eq(t_nf_refusals(t_m2(t_d(1), 0xFFF8000000000000, t_d(0), t_d(1))), 4, "a negative NaN is refused");
assert_eq(t_nf_refusals(t_m2(t_d(1), t_d(0), 0x7FF0000000000001, t_d(1))), 4, "a signalling NaN is refused");
# The scan is on the exponent, so the extremes of the FINITE range still decompose.
var NF_BIG = t_m2(0x7FEFFFFFFFFFFFFF, t_d(0), t_d(0), t_d(1));
var NF_BS = alloc(16);
assert_eq(ganita_mat_svd(NF_BIG, ganita_mat_new(2, 2), NF_BS, ganita_mat_new(2, 2)), 0,
  "svd still decomposes [[DBL_MAX, 0], [0, 1]]");
assert_eq(load64(NF_BS), 0x7FEFFFFFFFFFFFFF, "  ... and sigma0 is DBL_MAX exactly");
assert_eq(t_dclose(load64(NF_BS + 8), t_d(1)), 1, "  ... and sigma1 is 1");
var NF_TINY = t_m2(0x0000000000000001, t_d(0), t_d(0), 0x0000000000000001);
var NF_TS = alloc(16);
assert_eq(ganita_mat_svd(NF_TINY, ganita_mat_new(2, 2), NF_TS, ganita_mat_new(2, 2)), 0,
  "svd still decomposes 2^-1074 * I");
assert_eq(load64(NF_TS) == 1 && load64(NF_TS + 8) == 1, 1, "  ... and both sigma are 2^-1074 exactly");
assert_eq(ganita_mat_rank(t_m2(t_d(3), t_d(0), t_d(0), t_d(2)), t_tol()), 2,
  "the finite control diag(3, 2) has rank 2");

test_group("linalg: every function that judges a matrix refuses a NaN or infinity (1.2.12)");
# The audit that followed the SVD fix found the rest of linalg had no finite check.
# Two mechanisms turned bad input into success: an infinity became the matrix scale,
# so every relative threshold was +inf and every "anything left to do?" test failed
# at once; and an ordered comparison dropped a NaN. Each row below was a status of
# success with every output finite, or a finite f64, through 1.2.11
# (docs/development/issues/2026-10-03-linalg-non-finite-input.md). Out-params are
# poisoned first, so "nothing written" is checked too.
var LNF_NAN = 0x7FF8000000000000;
var LNF_PINF = 0x7FF0000000000000;
var LNF_NINF = 0xFFF0000000000000;
var LNF_POISON = 0x7FF4000000000BAD;
# Fill n words at p with LNF_POISON.
fn t_lnf_poison(p, n): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, LNF_POISON); i = i + 1; }
    return 0;
}
# 1 when the n words at p all still hold LNF_POISON.
fn t_lnf_untouched(p, n): i64 {
    var i = 0;
    while (i < n) {
        if (load64(p + i * 8) != LNF_POISON) { return 0; }
        i = i + 1;
    }
    return 1;
}
# Build a 3x2 matrix from its six entries, row-major.
fn t_lnf_m32(a, b, c, d, e, f): i64 {
    var m = ganita_mat_new(3, 2);
    ganita_mat_set(m, 0, 0, a); ganita_mat_set(m, 0, 1, b);
    ganita_mat_set(m, 1, 0, c); ganita_mat_set(m, 1, 1, d);
    ganita_mat_set(m, 2, 0, e); ganita_mat_set(m, 2, 1, f);
    return m;
}
# eigen_sym on an n x n input: 1 when it returns -2 and writes neither out-param.
fn t_lnf_eig_refuses(a): i64 {
    var n = ganita_mat_rows(a);
    var vals = alloc(n * 8);
    var vecs = ganita_mat_new(n, n);
    t_lnf_poison(vals, n);
    t_lnf_poison(vecs + 16, n * n);
    if (ganita_mat_eigen_sym(a, vals, vecs) != 0 - 2) { return 0; }
    return t_lnf_untouched(vals, n) & t_lnf_untouched(vecs + 16, n * n);
}
# qr: 1 when it returns -2 and writes neither Q nor R.
fn t_lnf_qr_refuses(a): i64 {
    var r = ganita_mat_rows(a);
    var c = ganita_mat_cols(a);
    var q = ganita_mat_new(r, r);
    var rr = ganita_mat_new(r, c);
    t_lnf_poison(q + 16, r * r);
    t_lnf_poison(rr + 16, r * c);
    if (ganita_mat_qr(a, q, rr) != 0 - 2) { return 0; }
    return t_lnf_untouched(q + 16, r * r) & t_lnf_untouched(rr + 16, r * c);
}
# least_squares: 1 when it returns -2 and leaves x unwritten.
fn t_lnf_ls_refuses(a, b): i64 {
    var c = ganita_mat_cols(a);
    var x = alloc(c * 8);
    t_lnf_poison(x, c);
    if (ganita_mat_least_squares(a, b, x) != 0 - 2) { return 0; }
    return t_lnf_untouched(x, c);
}

# eigen_sym. The infinite off-diagonal made eig_tol +inf: 0 rotations, the raw diagonal.
assert_eq(t_lnf_eig_refuses(t_m2(t_d(2), LNF_PINF, LNF_PINF, t_d(3))), 1,
  "eigen_sym -> -2 for [[2, +inf], [+inf, 3]] (was 0 with the raw diagonal (2, 3))");
# A NaN at (0, 1) became row 0's recorded max and hid the finite 5 at (0, 2).
assert_eq(t_lnf_eig_refuses(t_m3(t_d(1), LNF_NAN, t_d(5), LNF_NAN, t_d(2), t_d(0), t_d(5), t_d(0), t_d(3))), 1,
  "eigen_sym -> -2 for [[1, NaN, 5], [NaN, 2, 0], [5, 0, 3]] (was 0 with (1, 2, 3))");
assert_eq(t_lnf_eig_refuses(t_m2(t_d(2), LNF_NAN, LNF_NAN, t_d(3))), 1, "eigen_sym -> -2 for a NaN pair");
assert_eq(t_lnf_eig_refuses(t_m3(t_d(4), t_d(1), t_d(0), t_d(1), t_d(3), t_d(0), t_d(0), t_d(0), LNF_NINF)), 1,
  "eigen_sym -> -2 for -inf in the LAST entry");
# A lower-triangle-only NaN: the rotations read both triangles, so the scan must too.
assert_eq(t_lnf_eig_refuses(t_m3(t_d(4), t_d(1), t_d(1), t_d(1), t_d(3), t_d(1), LNF_NAN, t_d(1), t_d(2))), 1,
  "eigen_sym -> -2 for a NaN in the lower triangle only");
var LNF_EV = alloc(16);
assert_eq(ganita_mat_eigen_sym(t_m2(t_d(2), t_d(1), t_d(1), t_d(3)), LNF_EV, ganita_mat_new(2, 2)) >= 0, 1,
  "eigen_sym still decomposes the finite [[2, 1], [1, 3]]");

# qr. Inf made qr_tol +inf: no reflector passed, Q = I and R = A, not triangular.
assert_eq(t_lnf_qr_refuses(t_lnf_m32(t_d(1), t_d(2), t_d(3), t_d(4), t_d(5), LNF_PINF)), 1,
  "qr -> -2 for +inf in the LAST entry of a 3x2 (was 0 with Q = I, R = A)");
assert_eq(t_lnf_qr_refuses(t_lnf_m32(t_d(1), t_d(2), t_d(3), t_d(4), LNF_NAN, t_d(6))), 1,
  "qr -> -2 for a NaN below the diagonal (its reflector was skipped)");
assert_eq(t_lnf_qr_refuses(t_m2(LNF_NAN, t_d(2), t_d(3), t_d(4))), 1, "qr -> -2 for a NaN in the first entry");

# least_squares. Inf solved the unreduced top triangle against b[0..n-1].
var LNF_B = t_arr3(t_d(1), t_d(2), t_d(2));
assert_eq(t_lnf_ls_refuses(t_lnf_m32(t_d(1), t_d(1), t_d(1), t_d(2), t_d(1), LNF_PINF), LNF_B), 1,
  "least_squares -> -2 for +inf in A's last entry (was 0 with x = (0, 1))");
assert_eq(t_lnf_ls_refuses(t_lnf_m32(t_d(1), t_d(1), LNF_NAN, t_d(2), t_d(1), t_d(3)), LNF_B), 1,
  "least_squares -> -2 for a NaN below A's diagonal");
var LNF_A31 = ganita_mat_new(3, 1);
ganita_mat_set(LNF_A31, 0, 0, t_d(2)); ganita_mat_set(LNF_A31, 1, 0, LNF_NAN); ganita_mat_set(LNF_A31, 2, 0, t_d(1));
assert_eq(t_lnf_ls_refuses(LNF_A31, t_arr3(t_d(4), t_d(1), t_d(1))), 1,
  "least_squares -> -2 for a one-column A holding a NaN (was x = b0 / a00 = 2)");
var LNF_A32 = t_lnf_m32(t_d(1), t_d(1), t_d(1), t_d(2), t_d(1), t_d(3));
assert_eq(t_lnf_ls_refuses(LNF_A32, t_arr3(t_d(1), t_d(2), LNF_NAN)), 1,
  "least_squares -> -2 for a NaN in b's last entry");
assert_eq(t_lnf_ls_refuses(LNF_A32, t_arr3(LNF_NINF, t_d(2), t_d(2))), 1, "least_squares -> -2 for -inf in b");
var LNF_X = alloc(16);
assert_eq(ganita_mat_least_squares(LNF_A32, LNF_B, LNF_X), 0, "least_squares still fits the finite 3x2");

# det: 0.0 is "singular", so a non-finite matrix must not get it.
assert_eq(t_f64_is_nan(ganita_mat_det(t_m2(LNF_NAN, t_d(0), t_d(0), t_d(2)))), 1,
  "det([[NaN, 0], [0, 2]]) is NaN (was 0.0, 'singular')");
assert_eq(t_f64_is_nan(ganita_mat_det(t_m2(t_d(1), t_d(1), t_d(1), LNF_PINF))), 1,
  "det is NaN for +inf in the last entry");
assert_eq(ganita_mat_det(t_m2(t_d(1), t_d(2), t_d(2), t_d(4))), t_d(0),
  "det of the finite singular [[1, 2], [2, 4]] is still 0.0");

# lu / inv refused an infinity only while LINALG_EPS > 0; the scan makes it explicit.
var LNF_LU = ganita_mat_new(2, 2);
var LNF_PIV = alloc(16);
t_lnf_poison(LNF_LU + 16, 4);
t_lnf_poison(LNF_PIV, 2);
assert_eq(ganita_mat_lu(t_m2(t_d(4), t_d(3), t_d(6), LNF_NAN), LNF_LU, LNF_PIV), 0,
  "lu -> 0 for a NaN in the last entry");
assert_eq(t_lnf_untouched(LNF_LU + 16, 4) & t_lnf_untouched(LNF_PIV, 2), 1,
  "  ... and writes neither out_lu nor out_piv");
var LNF_EPS_SAVED = LINALG_EPS;
LINALG_EPS = 0;
var LNF_LU0 = ganita_mat_lu(t_m2(LNF_PINF, t_d(1), t_d(1), t_d(1)), ganita_mat_new(2, 2), alloc(16));
var LNF_INV0 = ganita_mat_inv(t_m2(LNF_PINF, t_d(1), t_d(1), t_d(1)));
LINALG_EPS = LNF_EPS_SAVED;
assert_eq(LNF_LU0, 0, "lu -> 0 for +inf even with LINALG_EPS = 0 (was 1)");
assert_eq(LNF_INV0, 0, "inv -> null for +inf even with LINALG_EPS = 0 (was the finite [[0, -0], [0, 1]])");

# lu_solve checks the factors it is handed.
var LNF_A2 = t_m2(t_d(4), t_d(3), t_d(6), t_d(3));
var LNF_F = ganita_mat_new(2, 2);
var LNF_FP = alloc(16);
ganita_mat_lu(LNF_A2, LNF_F, LNF_FP);
var LNF_B2 = t_arr2(t_d(1), t_d(2));
var LNF_X2 = alloc(16);
assert_eq(ganita_mat_lu_solve(LNF_F, LNF_FP, LNF_B2, LNF_X2), 0, "lu_solve still solves from real factors");
var LNF_FI = ganita_mat_copy(LNF_F);
ganita_mat_set(LNF_FI, 1, 1, LNF_PINF);
t_lnf_poison(LNF_X2, 2);
assert_eq(ganita_mat_lu_solve(LNF_FI, LNF_FP, LNF_B2, LNF_X2), 0 - 2,
  "lu_solve -> -2 for +inf on U's diagonal (was 0, x finite)");
assert_eq(t_lnf_untouched(LNF_X2, 2), 1, "  ... and leaves x unwritten");
var LNF_FZ = ganita_mat_copy(LNF_F);
ganita_mat_set(LNF_FZ, 1, 1, t_d(0));
assert_eq(ganita_mat_lu_solve(LNF_FZ, LNF_FP, LNF_B2, LNF_X2), 0 - 2,
  "lu_solve -> -2 for a zero on U's diagonal (was a NaN x)");
var LNF_FN = ganita_mat_copy(LNF_F);
ganita_mat_set(LNF_FN, 1, 0, LNF_NAN);
assert_eq(ganita_mat_lu_solve(LNF_FN, LNF_FP, LNF_B2, LNF_X2), 0 - 2, "lu_solve -> -2 for a NaN in L");
assert_eq(ganita_mat_lu_solve(LNF_F, LNF_FP, t_arr2(t_d(1), LNF_NAN), LNF_X2), 0 - 2, "lu_solve -> -2 for a NaN in b");
assert_eq(ganita_mat_lu_solve(LNF_F, t_arr2(0, 2), LNF_B2, LNF_X2), 0 - 2,
  "lu_solve -> -2 for a pivot index outside [0, n) (was an out-of-bounds read of b)");
assert_eq(ganita_mat_lu_solve(LNF_F, t_arr2(0, 0 - 1), LNF_B2, LNF_X2), 0 - 2,
  "lu_solve -> -2 for a negative pivot index");
# Non-square with a non-zero diagonal, so only the shape check can refuse it: n comes
# from the rows, and a 2x3 lu would be indexed with the wrong row stride.
var LNF_W23 = ganita_mat_new(2, 3);
ganita_mat_set(LNF_W23, 0, 0, t_d(1)); ganita_mat_set(LNF_W23, 1, 1, t_d(1));
assert_eq(ganita_mat_lu_solve(LNF_W23, LNF_FP, LNF_B2, LNF_X2), 0 - 2, "lu_solve -> -2 for a non-square lu");

# cholesky: an infinite pivot was "positive" and zeroed its column of L.
assert_eq(ganita_mat_cholesky(t_m2(LNF_PINF, t_d(2), t_d(2), t_d(3)), ganita_mat_new(2, 2)), 0,
  "cholesky -> 0 for [[+inf, 2], [2, 3]] (was 1, 'positive definite')");
assert_eq(ganita_mat_cholesky(t_m2(t_d(4), LNF_NAN, t_d(2), t_d(3)), ganita_mat_new(2, 2)), 0,
  "cholesky -> 0 for a NaN in the never-read upper triangle");
assert_eq(ganita_mat_cholesky(t_m3(t_d(4), t_d(2), t_d(2), t_d(2), t_d(5), t_d(3), t_d(2), t_d(3), LNF_PINF),
    ganita_mat_new(3, 3)), 0, "cholesky -> 0 for +inf in the last entry");
assert_eq(ganita_mat_cholesky(t_m2(t_d(4), t_d(2), t_d(2), t_d(3)), ganita_mat_new(2, 2)), 1,
  "cholesky still factors the finite [[4, 2], [2, 3]]");

# cholesky_solve: an infinite diagonal divided to 0 and decoupled x.
var LNF_L = t_m2(t_d(2), t_d(0), t_d(1), LNF_PINF);
var LNF_X3 = alloc(16);
t_lnf_poison(LNF_X3, 2);
var LNF_U0 = alloc_used();
assert_eq(ganita_mat_cholesky_solve(LNF_L, LNF_B2, LNF_X3), 0 - 2,
  "cholesky_solve -> -2 for +inf on L's diagonal (was 0, x finite)");
assert_eq(t_lnf_untouched(LNF_X3, 2), 1, "  ... and leaves x unwritten");
assert_eq(alloc_used() - LNF_U0, 0, "  ... and takes no scratch (the checks run before the allocation)");
var LNF_LOK = t_m2(t_d(2), t_d(0), t_d(1), t_d(1));
assert_eq(ganita_mat_cholesky_solve(LNF_LOK, t_arr2(t_d(1), LNF_PINF), LNF_X3), 0 - 2,
  "cholesky_solve -> -2 for +inf in b");
assert_eq(ganita_mat_cholesky_solve(t_m2(t_d(2), t_d(0), LNF_NAN, t_d(1)), LNF_B2, LNF_X3), 0 - 2,
  "cholesky_solve -> -2 for a NaN below L's diagonal");
assert_eq(ganita_mat_cholesky_solve(LNF_W23, LNF_B2, LNF_X3), 0 - 2, "cholesky_solve -> -2 for a non-square l");
assert_eq(ganita_mat_cholesky_solve(LNF_LOK, LNF_B2, LNF_X3), 0, "cholesky_solve still solves with a finite L");

# gaussian_elim: a NaN in the right-hand side returned 1; now it refuses like an infinity.
var LNF_AUG = ganita_mat_new(2, 3);
ganita_mat_set(LNF_AUG, 0, 0, t_d(2)); ganita_mat_set(LNF_AUG, 0, 1, t_d(1)); ganita_mat_set(LNF_AUG, 0, 2, LNF_NAN);
ganita_mat_set(LNF_AUG, 1, 0, t_d(1)); ganita_mat_set(LNF_AUG, 1, 1, t_d(3)); ganita_mat_set(LNF_AUG, 1, 2, t_d(4));
var LNF_AUGC = ganita_mat_copy(LNF_AUG);
assert_eq(ganita_mat_gaussian_elim(LNF_AUG), 0, "gaussian_elim -> 0 for a NaN in the right-hand side (was 1)");
assert_eq(load64(LNF_AUG + 16) == load64(LNF_AUGC + 16) && load64(LNF_AUG + 48) == load64(LNF_AUGC + 48), 1,
  "  ... and leaves aug untouched");
var LNF_AUGN = ganita_mat_copy(LNF_AUGC);
ganita_mat_set(LNF_AUGN, 0, 2, t_d(5));
ganita_mat_set(LNF_AUGN, 1, 1, LNF_NAN);
assert_eq(ganita_mat_gaussian_elim(LNF_AUGN), 0, "gaussian_elim -> 0 for a NaN in A");
assert_eq(ganita_mat_get(LNF_AUGN, 1, 2), t_d(4), "  ... without half-eliminating aug first");
ganita_mat_set(LNF_AUGC, 0, 2, t_d(5));
assert_eq(ganita_mat_gaussian_elim(LNF_AUGC), 1, "gaussian_elim still solves the finite system");

# max_norm dropped a NaN row.
assert_eq(t_f64_is_nan(ganita_mat_max_norm(t_m2(LNF_NAN, t_d(1), t_d(2), t_d(3)))), 1,
  "max_norm([[NaN, 1], [2, 3]]) is NaN (was 5)");
var LNF_ONE = ganita_mat_new(1, 1);
ganita_mat_set(LNF_ONE, 0, 0, LNF_NAN);
assert_eq(t_f64_is_nan(ganita_mat_max_norm(LNF_ONE)), 1, "max_norm([[NaN]]) is NaN (was 0.0)");
assert_eq(ganita_mat_max_norm(t_m2(t_d(1), t_d(2), t_d(3), LNF_NINF)), LNF_PINF,
  "max_norm with -inf is +inf, the norm");
assert_eq(ganita_mat_max_norm(t_m2(t_d(1), t_d(0) - t_d(2), t_d(3), t_d(4))), t_d(7),
  "max_norm of a finite 2x2 is unchanged");

# frobenius: finite input that overflowed or underflowed when squared.
assert_eq(ganita_mat_frobenius(t_m2(0x6974E718D7D7625A, 0x6974E718D7D7625A, t_d(0), t_d(0))), 0x697D8F9811335B57,
  "frobenius of [[1e200, 1e200], [0, 0]] is 1e200 * sqrt(2) (was +inf)");
assert_eq(ganita_mat_frobenius(t_m2(0x16687E92154EF7AC, 0x16687E92154EF7AC, t_d(0), t_d(0))), 0x167151F68876F410,
  "frobenius of [[1e-200, 1e-200], [0, 0]] is 1e-200 * sqrt(2) (was 0)");
assert_eq(ganita_mat_frobenius(t_m2(t_d(1), t_d(2), t_d(3), t_d(4))), 0x4015E8ADD236A58F,
  "frobenius of [[1, 2], [3, 4]] is sqrt(30), the same bits as the plain sum");
assert_eq(ganita_mat_frobenius(t_m2(t_d(1), t_d(2), t_d(3), LNF_PINF)), LNF_PINF, "frobenius with an infinity is +inf");
assert_eq(t_f64_is_nan(ganita_mat_frobenius(t_m2(t_d(1), LNF_NAN, t_d(3), t_d(4)))), 1, "frobenius with a NaN is NaN");
assert_eq(ganita_mat_frobenius(ganita_mat_new(2, 2)), t_d(0), "frobenius of the zero matrix is 0");

# eq / is_symmetric: a NaN or +inf tolerance accepted anything.
var LNF_P = t_m2(t_d(1), t_d(2), t_d(3), t_d(4));
var LNF_Q = t_m2(t_d(5), t_d(0), t_d(6), t_d(1));
assert_eq(ganita_mat_eq(LNF_P, LNF_Q, LNF_NAN), 0, "eq -> 0 under a NaN tolerance (was 1 for any two matrices)");
assert_eq(ganita_mat_eq(LNF_P, LNF_Q, LNF_PINF), 0, "eq -> 0 under a +inf tolerance");
assert_eq(ganita_mat_eq(LNF_P, LNF_P, f64_neg(t_d(1))), 0, "eq -> 0 under a negative tolerance");
assert_eq(ganita_mat_eq(LNF_P, LNF_P, 0x8000000000000000), 1, "eq(A, A, -0.0) is 1: -0.0 is a zero tolerance");
var LNF_PI = t_m2(LNF_PINF, t_d(2), t_d(3), t_d(4));
assert_eq(ganita_mat_eq(LNF_PI, LNF_Q, f64_mul(LINALG_EPS, ganita_mat_frobenius(LNF_PI))), 0,
  "eq -> 0 with tol = LINALG_EPS * frobenius of a matrix holding +inf (was 1)");
assert_eq(ganita_mat_eq(LNF_PI, LNF_PI, t_tol()), 0,
  "eq -> 0 for an infinity, even against itself (fails closed like NaN)");
var LNF_BIG = t_m2(0x6974E718D7D7625A, t_d(1), t_d(2), t_d(3));
var LNF_BIGTOL = f64_mul(LINALG_EPS, ganita_mat_frobenius(LNF_BIG));
assert_eq(ganita_mat_eq(LNF_BIG, t_m2(f64_neg(t_d(1)), t_d(1), t_d(2), t_d(3)), LNF_BIGTOL), 0,
  "eq -> 0 for [[1e200, ...]] vs [[-1, ...]] under LINALG_EPS * frobenius (the norm overflowed to +inf)");
assert_eq(ganita_mat_is_symmetric(LNF_P, LNF_NAN), 0, "is_symmetric -> 0 under a NaN tolerance (was 1)");
assert_eq(ganita_mat_is_symmetric(LNF_P, LNF_PINF), 0, "is_symmetric -> 0 under a +inf tolerance");
assert_eq(ganita_mat_is_symmetric(t_m2(LNF_NAN, t_d(1), t_d(1), t_d(2)), t_tol()), 0,
  "is_symmetric -> 0 for a NaN on the diagonal (its doc always said so)");
var LNF_ASYM = t_m2(LNF_NAN, t_d(1), t_d(4), t_d(2));
assert_eq(ganita_mat_is_symmetric(LNF_ASYM, f64_mul(LINALG_EPS, ganita_mat_frobenius(LNF_ASYM))), 0,
  "is_symmetric -> 0 for the ASYMMETRIC [[NaN, 1], [4, 2]] under LINALG_EPS * frobenius (was 1)");
assert_eq(ganita_mat_is_symmetric(t_m2(t_d(1), LNF_PINF, LNF_PINF, t_d(3)), t_tol()), 0,
  "is_symmetric -> 0 for mirrored infinities (they passed only because |inf - inf| is NaN)");
# A 1x1 has no pair to compare, so only the tolerance check can refuse it.
var LNF_11 = ganita_mat_new(1, 1);
ganita_mat_set(LNF_11, 0, 0, t_d(5));
assert_eq(ganita_mat_is_symmetric(LNF_11, f64_neg(t_d(1))), 0, "is_symmetric([[5]], tol = -1) is 0 (was 1)");
assert_eq(ganita_mat_is_symmetric(LNF_11, t_tol()), 1, "is_symmetric([[5]], 1e-9) is 1");
assert_eq(ganita_mat_is_symmetric(t_m2(t_d(1), t_d(2), t_d(2), t_d(1)), 0x8000000000000000), 1,
  "is_symmetric of a symmetric 2x2 at tol -0.0 is 1");
# The two predicates every guard above goes through, called directly. _linalg_all_finite reads the
# exponent bits: a NaN of any sign or kind, or an infinity, among the n words refuses; 0, -0.0, a
# subnormal and +-DBL_MAX are finite, and so are no words at all. _linalg_tol_ok takes a tolerance that
# is finite and not negative, -0.0 included.
var LNF_FW = alloc(48);
store64(LNF_FW, t_d(1));
store64(LNF_FW + 8, 0x8000000000000000);
store64(LNF_FW + 16, 1);
store64(LNF_FW + 24, 0x7FEFFFFFFFFFFFFF);
store64(LNF_FW + 32, 0xFFEFFFFFFFFFFFFF);
store64(LNF_FW + 40, 0);
assert_eq(_linalg_all_finite(LNF_FW, 6), 1, "_linalg_all_finite: 1, -0.0, a subnormal, +-DBL_MAX and 0 are finite");
assert_eq(_linalg_all_finite(LNF_FW, 0), 1, "_linalg_all_finite: no words at all is finite");
store64(LNF_FW + 40, 0x7FF0000000000001);
assert_eq(_linalg_all_finite(LNF_FW, 6), 0, "_linalg_all_finite: a signalling NaN in the last word refuses");
assert_eq(_linalg_all_finite(LNF_FW, 5), 1, "  ... and n stops the scan before it");
store64(LNF_FW + 40, 0xFFF8000000000000);
assert_eq(_linalg_all_finite(LNF_FW, 6), 0, "_linalg_all_finite: a negative NaN refuses");
store64(LNF_FW + 40, LNF_NINF);
assert_eq(_linalg_all_finite(LNF_FW, 6), 0, "_linalg_all_finite: -inf refuses");
store64(LNF_FW, LNF_PINF);
assert_eq(_linalg_all_finite(LNF_FW, 1), 0, "_linalg_all_finite: +inf in the first word refuses");
assert_eq(_linalg_tol_ok(0), 1, "_linalg_tol_ok: 0 is a tolerance");
assert_eq(_linalg_tol_ok(0x8000000000000000), 1, "_linalg_tol_ok: -0.0 is a tolerance (it is 0)");
assert_eq(_linalg_tol_ok(1), 1, "_linalg_tol_ok: the smallest subnormal is a tolerance");
assert_eq(_linalg_tol_ok(0x7FEFFFFFFFFFFFFF), 1, "_linalg_tol_ok: DBL_MAX is a tolerance");
assert_eq(_linalg_tol_ok(0x8000000000000001), 0, "_linalg_tol_ok: the smallest negative is not");
assert_eq(_linalg_tol_ok(LNF_PINF), 0, "_linalg_tol_ok: +inf is not");
assert_eq(_linalg_tol_ok(LNF_NAN), 0, "_linalg_tol_ok: NaN is not");
assert_eq(_linalg_tol_ok(0xFFF8000000000000), 0, "_linalg_tol_ok: -NaN is not");

test_group("SVD: one-sided Jacobi on a pivoted QR — every finite input decomposes (1.2.12)");
# hisab 3.3.3 found ganita_mat_svd returning -1, "did not converge", for finite matrices that have an
# SVD: square matrices with a zero or repeated row, column pairs that needed a very small rotation,
# and a rounding-level two-cycle (docs/development/issues/2026-10-03-mat-svd-no-convergence-on-tiny-
# columns.md). 1.2.12 runs the Jacobi on R^T from a Householder QR with column AND row pivoting (a
# second QR first for n >= 4); see ganita_mat_svd.
#
# Every row runs ganita_mat_svd and the values-only path _linalg_svd_impl(A, 0, s, 0, 0, 0), all
# out-params poisoned first, and checks the result against the EXACT singular values — computed from
# the bits of A with Python Fractions and mpmath, certified, and rounded once (the oracle of
# scripts/svdh) — under the row's bounds, in u = 2^-52:
#   - status 0, and the values-only path gives the same status and the same sigma bits;
#   - sigma descending and never negative, each within the bound of the exact one, in u·sigma_1;
#   - U's columns for a non-zero sigma (a subnormal one's too), and V^T's rows, orthonormal to the
#     bound;
#   - U·diag(sigma)·V^T = A to the bound, in u·sigma_1.
# Graded rows assert RELATIVE accuracy as well, where the pivoting is there to give it. A bound is
# about twice what 1.2.12 measures, rounded up to a power of two and at least 1 u; a failing bound
# prints the measurement as "got" (999999999 for NaN or an infinity). The measures use error-free
# transformations — TwoSum, Dekker's TwoProduct — so they report the SVD's error, not the test's
# own: a plain 512-term dot product can be off by 256 u.
#
# -3 (the sweeps did not converge) is NOT tested: no finite input is known to reach it (see
# ganita_mat_svd for what was measured), and a test that forced it would test the forcing. rank and
# condition pass the SVD's status through; that is pinned below for -2.
var SV12_ST = 0;
var SV12_S = 0;
var SV12_U = 0;
var SV12_VT = 0;
var SV12_VO = 0;
var SV12_DESC = 0;
var SV12_U0 = 0;
var SV12_ES = 0;
var SV12_EU = 0;
var SV12_EV = 0;
var SV12_ER = 0;
var SV12_AS = 0;
var SV12_AC = 0;
var SV12_LCG = 0;
var SV12_NAN = 0x7FF8000000000000;
var SV12_EPS = 0x3CB0000000000000;
# An array of n words, rounded up to whole groups of four so t_sv12_put4 can fill it.
fn t_sv12_arr(n): i64 { return alloc(((n + 3) / 4) * 32); }
# Store the words a, b, c, d at p[k], p[k+1], p[k+2], p[k+3] (a matrix's row-major data is at m + 16).
fn t_sv12_put4(p, k, a, b, c, d): i64 {
    store64(p + k * 8, a);
    store64(p + k * 8 + 8, b);
    store64(p + k * 8 + 16, c);
    store64(p + k * 8 + 24, d);
    return 0;
}
# The double nearest n/d: IEEE division rounds once, as Python's literal 1.3 does.
fn t_sv12_q(n, d): i64 { return f64_div(f64_from(n), f64_from(d)); }
# 2^e as its bit pattern, for -1022 <= e <= 1023.
fn t_sv12_p2(e): i64 { return (e + 1023) << 52; }
# The next entry from the test generator, a 64-bit LCG (Knuth's MMIX constants): k, the 20 bits under
# its top 4, gives k/2^18 - 2, exact and in [-2, 2). The oracle side generates the same entries.
fn t_sv12_next(): i64 {
    SV12_LCG = SV12_LCG * 0x5851F42D4C957F2D + 0x14057B7EF767814F;
    return t_sv12_q(((SV12_LCG >> 40) & 0xFFFFF) - 524288, 262144);
}
# An m×n matrix of t_sv12_next entries from seed s, filled row by row.
fn t_sv12_gen(s, m, n): i64 {
    SV12_LCG = s;
    var a = ganita_mat_new(m, n);
    var i = 0;
    while (i < m * n) {
        store64(a + 16 + i * 8, t_sv12_next());
        i = i + 1;
    }
    return a;
}
# t_sv12_gen(s, m, n) with row i multiplied by 2^-g, g = floor(span·((7·i) mod m) / (m - 1)): the
# rows are graded over `span` binades in a shuffled order (exactly: every entry stays normal).
fn t_sv12_rowgrad(s, m, n, span): i64 {
    var a = t_sv12_gen(s, m, n);
    var i = 0;
    while (i < m) {
        var g = (span * ((7 * i) % m)) / (m - 1);
        var j = 0;
        while (j < n) {
            ganita_mat_set(a, i, j, f64_mul(ganita_mat_get(a, i, j), t_sv12_p2(0 - g)));
            j = j + 1;
        }
        i = i + 1;
    }
    return a;
}
# The filing's family A(t) = [[1, t], [t, t], [t, -t]]; -t flips the sign bit.
fn t_sv12_fam(t): i64 {
    return t_lnf_m32(0x3FF0000000000000, t, t, t, t, t ^ 0x8000000000000000);
}
# Start the compensated sum at x.
fn t_sv12_acc0(x): i64 {
    SV12_AS = x;
    SV12_AC = 0;
    return 0;
}
# Add x to the compensated sum: Knuth's TwoSum puts the addition's exact rounding error in SV12_AC.
fn t_sv12_acc(x): i64 {
    var s = f64_add(SV12_AS, x);
    var bb = f64_sub(s, SV12_AS);
    var e = f64_add(f64_sub(SV12_AS, f64_sub(s, bb)), f64_sub(x, bb));
    SV12_AS = s;
    SV12_AC = f64_add(SV12_AC, e);
    return 0;
}
# The exact rounding error of fl(a·b), by Dekker's TwoProduct on Veltkamp's split at 2^27 + 1; the
# operands here are at most a few units, far from over- and underflow.
fn t_sv12_perr(a, b): i64 {
    var p = f64_mul(a, b);
    var ca = f64_mul(0x41A0000002000000, a);
    var ah = f64_sub(ca, f64_sub(ca, a));
    var al = f64_sub(a, ah);
    var cb = f64_mul(0x41A0000002000000, b);
    var bh = f64_sub(cb, f64_sub(cb, b));
    var bl = f64_sub(b, bh);
    return f64_add(f64_add(f64_add(f64_sub(f64_mul(ah, bh), p), f64_mul(ah, bl)), f64_mul(al, bh)), f64_mul(al, bl));
}
# Add a·b to the compensated sum, the product's rounding error included.
fn t_sv12_accp(a, b): i64 {
    t_sv12_acc(f64_mul(a, b));
    SV12_AC = f64_add(SV12_AC, t_sv12_perr(a, b));
    return 0;
}
# The larger of two measures; a NaN on either side wins, so a NaN result can never pass.
fn t_sv12_max(a, b): i64 {
    if ((t_f64_is_nan(a) == 1) || (t_f64_is_nan(b) == 1)) { return SV12_NAN; }
    if (f64_gt(b, a) == 1) { return b; }
    return a;
}
# Run ganita_mat_svd and the values-only path on a, every out-param poisoned first, and measure the
# result against `want` (the exact sigma, rounded once): fills SV12_*. Everything is first scaled by
# 2^-e, e the exponent of the exact sigma_1 — exact — so the measures stay far from over- and
# underflow whatever A's magnitude.
fn t_sv12_run(a, want): i64 {
    var m = ganita_mat_rows(a);
    var n = ganita_mat_cols(a);
    var u = ganita_mat_new(m, n);
    var vt = ganita_mat_new(n, n);
    var s = alloc(n * 8);
    var s2 = alloc(n * 8);
    t_nf_poison(u + 16, m * n);
    t_nf_poison(vt + 16, n * n);
    t_nf_poison(s, n);
    t_nf_poison(s2, n);
    SV12_ST = ganita_mat_svd(a, u, s, vt);
    SV12_S = s;
    SV12_U = u;
    SV12_VT = vt;
    SV12_VO = 0;
    if (_linalg_svd_impl(a, 0, s2, 0, 0, 0) == SV12_ST) { SV12_VO = memeq(s, s2, n * 8); }
    SV12_ES = SV12_NAN;
    SV12_EU = SV12_NAN;
    SV12_EV = SV12_NAN;
    SV12_ER = SV12_NAN;
    SV12_DESC = 0;
    SV12_U0 = 0;
    if (SV12_ST != 0) { return SV12_ST; }
    var e = ((load64(want) >> 52) & 0x7FF) - 1023;
    if (e > 1022) { e = 1022; }
    var g = t_sv12_p2(0 - e);
    var den = f64_mul(f64_mul(load64(want), g), SV12_EPS);
    var mx = 0;
    var i = 0;
    var j = 0;
    var k = 0;
    SV12_DESC = 1;
    while (i < n) {
        var si = load64(s + i * 8);
        if (f64_ge(si, 0) == 0) { SV12_DESC = 0; }
        if (i > 0) {
            if (f64_ge(load64(s + (i - 1) * 8), si) == 0) { SV12_DESC = 0; }
        }
        mx = t_sv12_max(mx, f64_abs(f64_sub(f64_mul(si, g), f64_mul(load64(want + i * 8), g))));
        i = i + 1;
    }
    SV12_ES = f64_div(mx, den);
    # U: every column whose sigma is not 0, a subnormal sigma's included (1.2.12; see _linalg_svd_reorth).
    mx = 0;
    i = 0;
    while (i < n) {
        j = i;
        while (j < n) {
            if (((load64(s + i * 8) & 0x7FFFFFFFFFFFFFFF) != 0) && ((load64(s + j * 8) & 0x7FFFFFFFFFFFFFFF) != 0)) {
                t_sv12_acc0(0);
                if (i == j) { t_sv12_acc0(0xBFF0000000000000); }
                k = 0;
                while (k < m) {
                    t_sv12_accp(ganita_mat_get(u, k, i), ganita_mat_get(u, k, j));
                    k = k + 1;
                }
                mx = t_sv12_max(mx, f64_abs(f64_add(SV12_AS, SV12_AC)));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    SV12_EU = f64_div(mx, SV12_EPS);
    mx = 0;
    i = 0;
    while (i < n) {
        j = i;
        while (j < n) {
            t_sv12_acc0(0);
            if (i == j) { t_sv12_acc0(0xBFF0000000000000); }
            k = 0;
            while (k < n) {
                t_sv12_accp(ganita_mat_get(vt, i, k), ganita_mat_get(vt, j, k));
                k = k + 1;
            }
            mx = t_sv12_max(mx, f64_abs(f64_add(SV12_AS, SV12_AC)));
            j = j + 1;
        }
        i = i + 1;
    }
    SV12_EV = f64_div(mx, SV12_EPS);
    SV12_U0 = 1;
    j = 0;
    while (j < n) {
        if ((load64(s + j * 8) & 0x7FFFFFFFFFFFFFFF) == 0) {
            k = 0;
            while (k < m) {
                if ((ganita_mat_get(u, k, j) & 0x7FFFFFFFFFFFFFFF) != 0) { SV12_U0 = 0; }
                k = k + 1;
            }
        }
        j = j + 1;
    }
    # A - U·diag(sigma)·V^T, entry by entry: each term U_ik·sigma_k·V^T_kj with both products'
    # rounding errors carried.
    mx = 0;
    i = 0;
    while (i < m) {
        j = 0;
        while (j < n) {
            t_sv12_acc0(f64_neg(f64_mul(ganita_mat_get(a, i, j), g)));
            k = 0;
            while (k < n) {
                var uik = ganita_mat_get(u, i, k);
                var sk = f64_mul(load64(s + k * 8), g);
                var vkj = ganita_mat_get(vt, k, j);
                t_sv12_accp(f64_mul(uik, sk), vkj);
                SV12_AC = f64_add(SV12_AC, f64_mul(t_sv12_perr(uik, sk), vkj));
                k = k + 1;
            }
            mx = t_sv12_max(mx, f64_abs(f64_add(SV12_AS, SV12_AC)));
            j = j + 1;
        }
        i = i + 1;
    }
    SV12_ER = f64_div(mx, den);
    return 0;
}
# The largest relative error |sigma_i - exact_i| / exact_i of the last run over lo <= i < hi, in u;
# an exact_i of 0 asks for sigma_i to be 0 exactly.
fn t_sv12_rel(want, lo, hi): i64 {
    var mx = 0;
    var i = lo;
    while (i < hi) {
        var w = load64(want + i * 8);
        var d = f64_abs(f64_sub(load64(SV12_S + i * 8), w));
        if (w == 0) {
            if ((d & 0x7FFFFFFFFFFFFFFF) != 0) { mx = SV12_NAN; }
        }
        if (w != 0) { mx = t_sv12_max(mx, f64_div(f64_div(d, w), SV12_EPS)); }
        i = i + 1;
    }
    return mx;
}
# How many of the last run's n sigma differ from `want` in any bit.
fn t_sv12_diff(want, n): i64 {
    var c = 0;
    var i = 0;
    while (i < n) {
        if (load64(SV12_S + i * 8) != load64(want + i * 8)) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
# 0 when the measure x (an f64 in u) is within b u; otherwise x rounded up, which assert_eq prints as
# "got", or 999999999 for NaN or an infinity.
fn t_sv12_over(x, b): i64 {
    if (f64_le(x, f64_from(b)) == 1) { return 0; }
    if (f64_lt(x, 0x43E0000000000000) == 1) { return f64_to(x) + 1; }
    return 999999999;
}
# label followed by text, as a new C string.
fn t_sv12_msg(label, text): i64 {
    var a = strlen(label);
    var b = strlen(text);
    var p = alloc(a + b + 1);
    memcpy(p, label, a);
    memcpy(p + a, text, b);
    store8(p + a + b, 0);
    return p;
}
# Run a through t_sv12_run and assert what every row asserts, under the row's bounds in u: bs for
# sigma and br for U·diag(sigma)·V^T, both relative to sigma_1; bu for U, bv for V^T.
fn t_sv12_row(label, a, want, bs, bu, bv, br): i64 {
    t_sv12_run(a, want);
    assert_eq(SV12_ST, 0, t_sv12_msg(label, ": ganita_mat_svd returns 0"));
    assert_eq(SV12_VO, 1, t_sv12_msg(label, ": the values-only path returns the same status and sigma bits"));
    assert_eq(SV12_DESC, 1, t_sv12_msg(label, ": sigma is descending and never negative"));
    assert_eq(t_sv12_over(SV12_ES, bs), 0, t_sv12_msg(label, ": sigma within its bound of exact (got: u*sigma_1)"));
    assert_eq(t_sv12_over(SV12_EU, bu), 0, t_sv12_msg(label, ": U's columns for non-zero sigma orthonormal (got: u)"));
    assert_eq(t_sv12_over(SV12_EV, bv), 0, t_sv12_msg(label, ": V^T orthonormal (got: u)"));
    assert_eq(t_sv12_over(SV12_ER, br), 0, t_sv12_msg(label, ": U * diag(sigma) * V^T = A (got: u*sigma_1)"));
    return 0;
}

# The filing's family A(t) = [[1, t], [t, t], [t, -t]]: zeta^2 overflowed and t became 0 (branch 1).
# sigma_2 is about sqrt(2)·t, so the rows also ask for it relatively: each sigma within 4 u of the
# exact one, which for A5's 2^-1074 means exactly. 1.2.11: -1 for all four.
var SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x3FF0000000000000, 0x1FE6A09E667F3BCD, 0, 0);
t_sv12_row("A1 = A(2^-513)", t_sv12_fam(0x1FE0000000000000), SV12_W, 1, 2, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 2), 4), 0, "A1: both sigma within 4 u of exact, relatively");
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x3FF0000000000000, 0x1E137CC152F76F67, 0, 0);
t_sv12_row("A4 = A(1.72 * 2^-543)", t_sv12_fam(0x1E0B8F2A4C1D3E57), SV12_W, 1, 2, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 2), 4), 0, "A4: both sigma within 4 u of exact, relatively");
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x3FF0000000000000, 0x0000000000000001, 0, 0);
t_sv12_row("A5 = A(2^-1074)", t_sv12_fam(0x0000000000000001), SV12_W, 1, 1, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 2), 4), 0, "A5: both sigma within 4 u of exact, relatively");
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x3FF0000000000000, 0x001058E43F6FA300, 0, 0);
t_sv12_row("A6 = A(1.6e-308)", t_sv12_fam(0x000B8F2A4C1D3E57), SV12_W, 1, 1, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 2), 4), 0, "A6: both sigma within 4 u of exact, relatively");

# B1 and B2, the measured witnesses of branch 2: a column's squared norm underflowed and the
# orthogonality threshold with it. 1.2.11: -1.
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x6FCB799CC80A713E, 0x4B3326815FE2FA41, 0, 0);
t_sv12_row("B1", t_lnf_m32(0xCB3326815FE2FA41, 0x6C7B1009E69DC636, 0, 0x6FCB799CC80A713E, 0xC78D2DAD93DD5D23,
    0x5B82A0E6E26B85A5), SV12_W, 1, 1, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 2), 4), 0, "B1: both sigma within 4 u of exact, relatively");
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x35DAC74898CD0527, 0x0C56594A23EF8276, 0, 0);
t_sv12_row("B2", t_lnf_m32(0x89F0481668FD9259, 0xB5DAC74898CD0527, 0x03B8DFFBAEE26112, 0x29858E6E791CDEE9,
    0x0C56594A23EF8276, 0x1CE65B0EE8C8430C), SV12_W, 1, 1, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 2), 4), 0, "B2: both sigma within 4 u of exact, relatively");

# Branch 3, a null column that the rotations wore down but kept nearly parallel to its partner: the
# filing's zero-row Z and the repeated-row R. sigma_3 is exactly 0, so its U column must be all zero
# (ganita's convention) and V's third column comes from _linalg_svd_complete. 1.2.11: -1, and rank -1,
# condition NaN, pseudo_inv null.
var SV12_Z = t_m3(t_sv12_q(13, 10), t_sv12_q(27, 10), t_sv12_q(4, 10), t_d(0), t_d(0), t_d(0),
  t_sv12_q(9, 10), t_sv12_q(11, 10), t_sv12_q(23, 10));
SV12_W = t_sv12_arr(3);
t_sv12_put4(SV12_W, 0, 0x400D3FB1257408C4, 0x3FFC17E03945F102, 0, 0);
t_sv12_row("Z = [[1.3, 2.7, 0.4], [0, 0, 0], [0.9, 1.1, 2.3]]", SV12_Z, SV12_W, 2, 2, 2, 1);
assert_eq(load64(SV12_S + 16), 0, "Z: sigma_3 is exactly 0");
assert_eq(SV12_U0, 1, "Z: the U column of the zero sigma is all zero");
var SV12_R = t_m3(t_d(1), t_d(2), t_d(3), t_d(1), t_d(2), t_d(3), t_d(4), t_d(5), t_d(6));
SV12_W = t_sv12_arr(3);
t_sv12_put4(SV12_W, 0, 0x4024646BB0023E7B, 0x3FF04ECE4EBDCE2C, 0, 0);
t_sv12_row("R = [[1, 2, 3], [1, 2, 3], [4, 5, 6]]", SV12_R, SV12_W, 2, 1, 4, 1);
assert_eq(load64(SV12_S + 16), 0, "R: sigma_3 is exactly 0");
assert_eq(SV12_U0, 1, "R: the U column of the zero sigma is all zero");

# Branch 4, the full-rank 5×4 whose gamma flipped sign at a fixed magnitude just above the 2^-52
# threshold: a rounding-level two-cycle. Also at 2^-827, where every entry and sigma is the same
# mantissa: a power-of-two scaling must scale sigma exactly. 1.2.11: -1 at both scales.
var SV12_W54 = ganita_mat_new(5, 4);
t_sv12_put4(SV12_W54 + 16, 0, 0xBFC2CACD2BBA2BFC, 0x3FF436F97395FC68, 0xC00807F8A62BF805, 0x3FF337DF0357C8C9);
t_sv12_put4(SV12_W54 + 16, 4, 0x3FEFD315ACC77FE7, 0xBFA1614B40EA6CC2, 0xC0295CEBBFDDBB61, 0xBFC32AF6F3470282);
t_sv12_put4(SV12_W54 + 16, 8, 0xBFD6269DC8658203, 0xC025B46BF0A392B4, 0x3FC03FF652EED9BF, 0);
t_sv12_put4(SV12_W54 + 16, 12, 0x3FDF9160669D391A, 0x3FCC98B730A0D724, 0xBFBC46376FF5E5C4, 0x3FC92A56372A02BB);
t_sv12_put4(SV12_W54 + 16, 16, 0xC02551ACEC11860F, 0x400130C3519E4F30, 0x3FC6D251F22A1E9B, 0x3FE9E1EFC1AEB952);
SV12_W = t_sv12_arr(4);
t_sv12_put4(SV12_W, 0, 0x402A55180C7066EC, 0x402793D5C3F35250, 0x4023BC5D726B72E5, 0x3FF2F035DF06D48A);
t_sv12_row("W54", SV12_W54, SV12_W, 4, 2, 16, 8);
var SV12_S54 = SV12_S;
var SV12_W54S = ganita_mat_new(5, 4);
var sv12i = 0;
while (sv12i < 20) {
    store64(SV12_W54S + 16 + sv12i * 8, f64_mul(load64(SV12_W54 + 16 + sv12i * 8), t_sv12_p2(0 - 827)));
    sv12i = sv12i + 1;
}
SV12_W = t_sv12_arr(4);
t_sv12_put4(SV12_W, 0, 0x0C7A55180C7066EC, 0x0C7793D5C3F35250, 0x0C73BC5D726B72E5, 0x0C42F035DF06D48A);
t_sv12_row("W54 * 2^-827", SV12_W54S, SV12_W, 4, 2, 16, 8);
sv12i = 0;
var sv12same = 0;
while (sv12i < 4) {
    if (load64(SV12_S + sv12i * 8) == f64_mul(load64(SV12_S54 + sv12i * 8), t_sv12_p2(0 - 827))) {
        sv12same = sv12same + 1;
    }
    sv12i = sv12i + 1;
}
assert_eq(sv12same, 4, "W54 * 2^-827: every sigma is W54's times 2^-827, bit for bit");

# Graded 5×4 from the harness corpus (id 18924, rows spread over 593 binades). 1.2.11 returned 0 for
# it with two U columns at cosine 0.99999999 (4.5e15 u from orthogonal) and sigma_4 10^4 times too
# large: the dot products of graded columns underflowed. 1.2.12 gets every sigma to 1 u, relatively.
var SV12_G5 = ganita_mat_new(5, 4);
t_sv12_put4(SV12_G5 + 16, 0, 0xBFB41ACB5FB3A786, 0xBFD519B23B7E72F7, 0x3FCB1CD76D2792D2, 0x3FBDE9A797312740);
t_sv12_put4(SV12_G5 + 16, 4, 0xA372CABCAA7E01C1, 0x2354BCAC8B19D828, 0x2366C9489175EA54, 0xA37580166DA16365);
t_sv12_put4(SV12_G5 + 16, 8, 0x9C46FC5EAECA5240, 0x9C17DBC502F63608, 0x1C109B4AED3CB856, 0x1C309B77A2BDC1AB);
t_sv12_put4(SV12_G5 + 16, 12, 0x1ACAAC057D260C8F, 0x9AE727B76A763AD7, 0x1ABB512EF486433B, 0x1AB258D1EEEC1510);
t_sv12_put4(SV12_G5 + 16, 16, 0x1AB5224165320F7C, 0x9AB4ADF6A1DFA2A0, 0x1AD51956AB0F6953, 0x9AA01444269B84BE);
SV12_W = t_sv12_arr(4);
t_sv12_put4(SV12_W, 0, 0x3FDAA638DFB5A258, 0x237F2B0258119399, 0x1C44D51BF78DE570, 0x1AD5659B26AB195C);
t_sv12_row("graded 5x4 (corpus 18924)", SV12_G5, SV12_W, 1, 2, 8, 2);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 4), 2), 0,
  "graded 5x4: every sigma relatively accurate (1.2.11: sigma_4 off by 4e19 ulps)");

# The square zero-row and repeated-row class, random entries in [-2, 2): 1.2.11 failed 500 of 500 at
# 6×6 and 10×10. ZR10's zero sigma is exactly 0 with an all-zero U column; RR6's comes out at rounding
# level, as a backward-stable SVD may return it.
var SV12_ZR = t_sv12_gen(1, 10, 10);
sv12i = 0;
while (sv12i < 10) {
    ganita_mat_set(SV12_ZR, 3, sv12i, 0);
    sv12i = sv12i + 1;
}
SV12_W = t_sv12_arr(10);
t_sv12_put4(SV12_W, 0, 0x4017D56C9ACC6DB4, 0x40124925DF288048, 0x40117D4745DA5E25, 0x401040A7744CE6B8);
t_sv12_put4(SV12_W, 4, 0x400C4D07C32A8BCD, 0x4007BB09635064E6, 0x3FF7875FE66615C0, 0x3FF2C131C565D04F);
t_sv12_put4(SV12_W, 8, 0x3FCA912806B1B509, 0, 0, 0);
t_sv12_row("10x10 with row 3 zero", SV12_ZR, SV12_W, 8, 4, 16, 8);
assert_eq(load64(SV12_S + 72), 0, "10x10 zero row: sigma_10 is exactly 0");
assert_eq(SV12_U0, 1, "10x10 zero row: the U column of the zero sigma is all zero");
var SV12_RR = t_sv12_gen(2, 6, 6);
sv12i = 0;
while (sv12i < 6) {
    ganita_mat_set(SV12_RR, 5, sv12i, ganita_mat_get(SV12_RR, 0, sv12i));
    sv12i = sv12i + 1;
}
SV12_W = t_sv12_arr(6);
t_sv12_put4(SV12_W, 0, 0x4014312DE1CD2B8E, 0x400D4DA91344F1DD, 0x4001DD3BCA6D3E35, 0x3FF9D74EE6179F41);
t_sv12_put4(SV12_W, 4, 0x3FEE8DB4B257BB34, 0, 0, 0);
t_sv12_row("6x6 with row 6 = row 1", SV12_RR, SV12_W, 2, 4, 8, 4);

# The adversarial sets built against the 1.2.12 candidates. adv2 #0, a 3×3 whose first row is 2^1048
# above the other two: candidate B, plain Jacobi with scaled columns, returned -3. sigma_2 and sigma_3
# are 2^-1047 of sigma_1, invisible normwise, so they are asked for relatively (candidate A zeroed
# sigma_3).
SV12_W = t_sv12_arr(3);
t_sv12_put4(SV12_W, 0, 0x5BABEA32092262B6, 0x1A3392EAAD658024, 0x1A21E0C6043F9E7E, 0);
t_sv12_row("adv2 #0 (3x3, rows 2^1048 apart)", t_m3(0xDB940400280C8DDB, 0xDB96C286A0074337, 0x5BA7716E193B4D95,
    0x1A1C558550000000, 0x1A11FFA9B0000000, 0x1A37511650000000, 0x9A150C4570000000, 0x1A1D7A3B90000000,
    0x99D2B47700000000), SV12_W, 2, 2, 2, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 1, 3), 16777216), 0, "adv2 #0: sigma_2 and sigma_3 relatively accurate");
# adv #805: a 2×2 whose second column is 2^-520 times a near-copy of the first. sigma_2 = 1.4e-163 must
# come back, relatively accurate (cond of the column-scaled matrix is 7.4e6): candidate B zeroed it,
# 1.2.11 returned -1.
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x3FFCAAC172F287EC, 0x1E205172838EFD6A, 0, 0);
t_sv12_row("adv #805 (2x2, sigma_2 = 1.4e-163)", t_m2(0xBFFAAD39BBEAD4BA, 0x9F7AAD38DFC655C6, 0xBFE4FDA4F3D090ED,
    0x9F64FDA32E05DA07), SV12_W, 1, 1, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 1, 2), 4194304), 0,
  "adv #805: sigma_2 = 1.4e-163 is not flushed, and is relatively accurate (to 2^-30)");
# adv #3666: a 4×4 built against candidate B, entries from 2^934 down to 2^-977, sigma from 2^934
# to 2^-526. 1.2.11: -1; candidate B: U 6e12 u from orthogonal with sigma_4 = 0. Every sigma is
# asked for relatively, which is what QR's column pivoting gives here.
var SV12_C4 = ganita_mat_new(4, 4);
t_sv12_put4(SV12_C4 + 16, 0, 0x5254A36F5FDF36C7, 0x2E5273CCECDF70AF, 0x7A510A74DBC94CD3, 0xB7201165A2DD5CFA);
t_sv12_put4(SV12_C4 + 16, 4, 0xB772579516D3B4E7, 0x9F162D9CF7E900A2, 0x82E598B29E10907A, 0xB16E342A1C93CC0A);
t_sv12_put4(SV12_C4 + 16, 8, 0x4FC3F310328B6DDD, 0, 0x3D448CD9CF68F28D, 0x65C5C9F99A90F836);
t_sv12_put4(SV12_C4 + 16, 12, 0xB144DC48AEC5DE59, 0x8FDFB42328248804, 0xDF9D1FD23EE94FAC, 0);
SV12_W = t_sv12_arr(4);
t_sv12_put4(SV12_W, 0, 0x7A510A74DBC94CD3, 0x65C5C9F99A90F836, 0x37A1C8EB64AEAEC3, 0x1F15FE3C5F06B548);
t_sv12_row("adv #3666 (4x4)", SV12_C4, SV12_W, 1, 2, 1, 1);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 4), 1), 0, "adv #3666: every sigma relatively accurate");

# Row-graded D·B, 30×30, rows spread over 300 binades. Plain Jacobi needs many sweeps here: candidate A
# took 29, candidate B 76 with two restarts; 1.2.11 returned -1. 1.2.12 takes 2 sweeps. Row-graded input is
# what the row pivoting is for, so sigma is asked for relatively too.
SV12_W = t_sv12_arr(30);
t_sv12_put4(SV12_W, 0, 0x4018180D537C96C2, 0x3F758FFE01E2A8E9, 0x3ED6E4E3387F5235, 0x3E24D99457633DC4);
t_sv12_put4(SV12_W, 4, 0x3D86571F17E8BEEC, 0x3CE862BD021E9357, 0x3C377A36D270CEDC, 0x3B9646D8746B6E28);
t_sv12_put4(SV12_W, 8, 0x3AF87DDC48C9856D, 0x3A47DB283F080E27, 0x39A4DE05D909D367, 0x39035D808CD8B576);
t_sv12_put4(SV12_W, 12, 0x38566D4DF92F7E9F, 0x37B84C76571DA7DD, 0x37125ACA893C5557, 0x365D0A0FFD11CBA0);
t_sv12_put4(SV12_W, 16, 0x35C38A98D1C4FE83, 0x3524417ECC864DC3, 0x346DA23A2C062D81, 0x33CC2F591ABC1EC9);
t_sv12_put4(SV12_W, 20, 0x332A1F0C501BB8C4, 0x32798A49245DE58D, 0x31DCF21170271F87, 0x3137C78B67A9C6DD);
t_sv12_put4(SV12_W, 24, 0x3085783F6BEBFFBD, 0x2FE6DE24AF4B96AC, 0x2F3FF61EF1B3AE49, 0x2E97DAEA7E784B77);
t_sv12_put4(SV12_W, 28, 0x2DE38645E2FE309F, 0x2D141BA0B1A6D6A4, 0, 0);
t_sv12_row("row-graded 30x30 over 300 binades", t_sv12_rowgrad(11, 30, 30, 300), SV12_W, 2, 4, 16, 2);
assert_eq(t_sv12_over(t_sv12_rel(SV12_W, 0, 30), 16), 0, "row-graded 30x30: every sigma relatively accurate");

# 512 equal rows (1, 2): rank 1, sigma = (sqrt(2560), 0). Every sum over the 512 rows is pairwise; a
# plain running sum (the first 1.2.12 draft) gave sigma 11 u·sigma_1 off and U 46 u from orthogonal
# here, and 104 u and 565 u at 4096 rows. 1.2.11 was exact on it.
var SV12_T = ganita_mat_new(512, 2);
sv12i = 0;
while (sv12i < 512) {
    ganita_mat_set(SV12_T, sv12i, 0, t_d(1));
    ganita_mat_set(SV12_T, sv12i, 1, t_d(2));
    sv12i = sv12i + 1;
}
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x40494C583ADA5B53, 0, 0, 0);
t_sv12_row("512x2, every row (1, 2)", SV12_T, SV12_W, 2, 16, 2, 8);

# The special branches end to end, each on an input that needs it.
# Regime B: [[1, 1], [0, 2^-1060]]. Its columns of R^T are 1060 binades apart, past the 500 where
# zeta is not formed, and the small one is projected off the large one. sigma_2 = 2^-1060/sqrt(2)
# rounded, a subnormal; with no regime B it came back 0.
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x3FF6A09E667F3BCD, 0x0000000000002D41, 0, 0);
t_sv12_row("[[1, 1], [0, 2^-1060]]", t_m2(t_d(1), t_d(1), t_d(0), 0x0000000000004000), SV12_W, 1, 1, 2,
  1);
assert_eq(t_sv12_diff(SV12_W, 2), 0, "[[1, 1], [0, 2^-1060]]: both sigma are the exact ones, bit for bit");
assert_eq(((ganita_mat_get(SV12_U, 0, 0) & 0x7FFFFFFFFFFFFFFF) == 0x3FF0000000000000)
  && (ganita_mat_get(SV12_U, 0, 1) == 0) && (ganita_mat_get(SV12_U, 1, 0) == 0)
  && ((ganita_mat_get(SV12_U, 1, 1) & 0x7FFFFFFFFFFFFFFF) == 0x3FF0000000000000), 1,
  "[[1, 1], [0, 2^-1060]]: U is diag(+-1, +-1) exactly");
# The subnormal floor: adv #3634, a 5×4 whose first column is near 2^1000 and the other three between
# 2^-1047 and 2^-1040. Two all-subnormal columns of X cannot be made orthogonal beyond their absolute
# rounding; without the floor this returns -3. With it every sigma is the exact one, and the three
# subnormal sigma's U columns are orthonormal too (_linalg_svd_reorth; 114 u without it).
var SV12_F = ganita_mat_new(5, 4);
t_sv12_put4(SV12_F + 16, 0, 0x7E7C729EFC636324, 0x800000000A060B0A, 0x80000002358ECC8C, 0x80000000176C505A);
t_sv12_put4(SV12_F + 16, 4, 0x7E701367C136C564, 0x000000000CDD0A88, 0x000000022187C376, 0x0000000016EC629C);
t_sv12_put4(SV12_F + 16, 8, 0x7E732AE69CC7EBC0, 0x800000000B3DED7E, 0x00000002DE2D775E, 0x000000001A82A088);
t_sv12_put4(SV12_F + 16, 12, 0x7E7BA16448ECAB1E, 0x80000000088103E0, 0x8000000383077FDE, 0x8000000014A2064C);
t_sv12_put4(SV12_F + 16, 16, 0xFE70A9615D91134E, 0x000000000AA18B22, 0x80000002C7E54FE6, 0x800000001621CE84);
SV12_W = t_sv12_arr(4);
t_sv12_put4(SV12_W, 0, 0x7E88E167011CF90C, 0x000000061FF1DDAC, 0x0000000013FB710E, 0x00000000097CD05A);
t_sv12_row("adv #3634 (5x4, 2^1000 over 2^-1040 and below)", SV12_F, SV12_W, 1, 4, 4, 1);
assert_eq(t_sv12_diff(SV12_W, 4), 0, "adv #3634: all four sigma are the exact ones, bit for bit");
# The t = 1/(2 zeta) branch, past where zeta^2 overflows: adv #582, a 3×3 whose rows each hold three
# nearly equal entries, near 2^-600, 2^-1 and 2^-475. Taking sqrt(1 + zeta^2) there instead
# overflows: status 0 with sigma (3.4e-187, -2.7e-307, -2.7e-307), wrong and negative, and V NaN.
SV12_W = t_sv12_arr(3);
t_sv12_put4(SV12_W, 0, 0x3FF167AC2565E485, 0x2125D13C597599A4, 0x19375BD8A651DFBE, 0);
t_sv12_row("adv #582 (3x3, |zeta| > 2^512)", t_m3(0x9A7AE57DAB386363, 0x9A7AE57F14CDE7FF, 0x9A7AE57CC6CA106A,
    0x3FE418F5FE91F19A, 0x3FE418F94BB24A7C, 0x3FE418F7A6C62845, 0x224A3DA3865F6E13, 0x224A3DA02424CA0A,
    0x224A3DA250F05AC6), SV12_W, 1, 1, 2, 1);
# A column of X whose entries are all subnormal is not a V column for n <= 3 (_linalg_svd_impl): it
# is completed, like a zero one. adv #3452, a 2×2 with rows 2^1000 and 2^-1060: kept, V was 2.7e5 u
# from orthogonal.
SV12_W = t_sv12_arr(2);
t_sv12_put4(SV12_W, 0, 0x7E81078E5878C2AE, 0x0000000000000904, 0, 0);
t_sv12_row("adv #3452 (2x2, rows 2^1000 and 2^-1060)", t_m2(0xFE7BA5392AA533EE, 0xFE73E4B90A333606,
    0x000000000000700E, 0x0000000000005BBE), SV12_W, 2, 1, 4, 1);
# Pairs with 2^-52 < |cos| <= tol are rotated, though they are not progress: adv #724, a row-graded
# 8×6 over 1000 binades whose U comes out orthonormal to 0.001 u. Without those rotations it stops
# with a cosine near tol = sqrt(6)·2^-52 left: U 2.4 u from orthogonal.
var SV12_D8 = ganita_mat_new(8, 6);
t_sv12_put4(SV12_D8 + 16, 0, 0x105E987D6F2CFE65, 0x105E987C9FE20B9A, 0x105E987F59351BA5, 0x105E987CB0FB75BF);
t_sv12_put4(SV12_D8 + 16, 4, 0x105E987E507E47AA, 0x105E987BDF125D7D, 0x0A5E1E3CA8AD4FB8, 0x0A5E1E3DE136578F);
t_sv12_put4(SV12_D8 + 16, 8, 0x0A5E1E3D73266CEA, 0x0A5E1E3D6EA93A08, 0x0A5E1E3C09C0EF96, 0x0A5E1E3AE75F3DE4);
t_sv12_put4(SV12_D8 + 16, 12, 0x23E145FC1579250D, 0x23E145FE20284163, 0x23E145FE0B49571B, 0x23E145FD3064B654);
t_sv12_put4(SV12_D8 + 16, 16, 0x23E145F8D294D3B4, 0x23E145FA4837910F, 0xB1747EB3E5C803FA, 0xB1747EB262AD69F9);
t_sv12_put4(SV12_D8 + 16, 20, 0xB1747EB53D33E6F4, 0xB1747EB2957346FF, 0xB1747EB05C76A360, 0xB1747EB588701AE7);
t_sv12_put4(SV12_D8 + 16, 24, 0x0172828D516D1C1D, 0x0172828B9CB0EFFF, 0x0172828E26B3D43F, 0x0172828B670AAAC5);
t_sv12_put4(SV12_D8 + 16, 28, 0x0172828E41A3ED3C, 0x0172828E3ACA8416, 0x1369A06C97983CEE, 0x1369A06E5EDEE7E4);
t_sv12_put4(SV12_D8 + 16, 32, 0x1369A06E09F82478, 0x1369A06A9085B1AC, 0x1369A06AEFF37A88, 0x1369A06AC22175C5);
t_sv12_put4(SV12_D8 + 16, 36, 0x3FF70F5EFEF3B687, 0x3FF70F5D5BDA5C36, 0x3FF70F5E3892E8B1, 0x3FF70F5E35405D89);
t_sv12_put4(SV12_D8 + 16, 40, 0x3FF70F606947C11D, 0x3FF70F60E47AFA73, 0xBD4944A7ECA3814A, 0xBD4944A8E52FE1EE);
t_sv12_put4(SV12_D8 + 16, 44, 0xBD4944A9566892E5, 0xBD4944A6DCA3C4E9, 0xBD4944A9D7ECE947, 0xBD4944A6D71D81EF);
SV12_W = t_sv12_arr(6);
t_sv12_put4(SV12_W, 0, 0x400C3E1FA05D984F, 0x3C22DDF2AE054F32, 0x3053E0F24F08295F, 0x22B6D4D2D3C34E5E);
t_sv12_put4(SV12_W, 4, 0x1225A12D16B4A584, 0x0F0E18C58A1B0D2E, 0, 0);
t_sv12_row("adv #724 (8x6, rows over 1000 binades)", SV12_D8, SV12_W, 1, 1, 8, 4);
# For n >= 4 a column of X whose entries are all subnormal becomes a U column, made orthonormal to the
# others by _linalg_svd_reorth. Both matrices here have their largest entry near DBL_MAX and three
# sigma just above 2^-1022, so the working copy is scaled DOWN — by 2^6 at 8×4, 2^10 at 4096×4 (rows 4
# on are zero) — and those three columns of X are all subnormal. Without it U came out 261 u and 529 u
# from orthonormal; 1.2.11 returned status 0 with sigma_2..4 = 0 for both.
var SV12_D1 = ganita_mat_new(8, 4);
t_sv12_put4(SV12_D1 + 16, 0, 0x7FECB17FF9C83740, 0, 0, 0);
t_sv12_put4(SV12_D1 + 16, 4, 0, 0x003DA139F0ACD1C2, 0x003D14D4191BC8B6, 0x803B6E96422B7D31);
t_sv12_put4(SV12_D1 + 16, 8, 0, 0x002530A09FC0595A, 0x00355BC260171C96, 0x8024DB7FFEA418CD);
t_sv12_put4(SV12_D1 + 16, 12, 0, 0x002BC15346BFFB10, 0x00218ADB2D4108E4, 0x8038EA5AEB16E869);
SV12_W = t_sv12_arr(4);
t_sv12_put4(SV12_W, 0, 0x7FECB17FF9C83740, 0x004EF2C46F14D752, 0x002B99E648E21F6E, 0x0012C43774E46778);
t_sv12_row("8x4, 2^1023 over three sigma near 2^-1021", SV12_D1, SV12_W, 1, 2, 2, 1);
var SV12_D2 = ganita_mat_new(4096, 4);
t_sv12_put4(SV12_D2 + 16, 0, 0xFFEB48FA5984EEB2, 0, 0, 0);
t_sv12_put4(SV12_D2 + 16, 4, 0, 0x8017789B7DCDD8F5, 0x001FB7D4F0C9FF6F, 0x803EC31BDC5AF0A6);
t_sv12_put4(SV12_D2 + 16, 8, 0, 0x803BD3814D9B3D56, 0x8022117147DD9AB0, 0x801FD295E67AA39B);
t_sv12_put4(SV12_D2 + 16, 12, 0, 0x802022B6686679A3, 0x003951A996F537DB, 0x801AA987CEF51C47);
SV12_W = t_sv12_arr(4);
t_sv12_put4(SV12_W, 0, 0x7FEB48FA5984EEB2, 0x00438AFAF12946ED, 0x003C9EBBAE658F9C, 0x0033257CEB208171);
t_sv12_row("4096x4, -2^1023 over three sigma near 2^-1021", SV12_D2, SV12_W, 1, 2, 16, 1);

# rank, condition and pseudo_inv on the filing's two textbook singular matrices. Through 1.2.11 they
# inherited the SVD's -1: rank -1 ("allocation failed"), condition NaN, pseudo_inv null.
var SV12_RTOL = t_sv12_q(1, 1000000000000);
assert_eq(ganita_mat_rank(SV12_Z, SV12_RTOL), 2, "rank(Z) = 2 at tol 1e-12 (1.2.11: -1)");
assert_eq(ganita_mat_condition(SV12_Z), 0xBFF0000000000000, "condition(Z) = -1.0, singular (1.2.11: NaN)");
var SV12_ZP = ganita_mat_pseudo_inv(SV12_Z);
assert_eq(SV12_ZP != 0, 1, "pseudo_inv(Z) exists (1.2.11: null)");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_mul(SV12_Z, SV12_ZP), SV12_Z), SV12_Z, t_tol()), 1, "Z Z+ Z = Z");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_mul(SV12_ZP, SV12_Z), SV12_ZP), SV12_ZP, t_tol()), 1,
  "Z+ Z Z+ = Z+");
assert_eq(ganita_mat_rank(SV12_R, SV12_RTOL), 2, "rank([[1, 2, 3], [1, 2, 3], [4, 5, 6]]) = 2 (1.2.11: -1)");
assert_eq(ganita_mat_condition(SV12_R), 0xBFF0000000000000, "condition([[1, 2, 3], [1, 2, 3], [4, 5, 6]]) = -1.0");
var SV12_RP = ganita_mat_pseudo_inv(SV12_R);
assert_eq(SV12_RP != 0, 1, "pseudo_inv([[1, 2, 3], [1, 2, 3], [4, 5, 6]]) exists (1.2.11: null)");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_mul(SV12_R, SV12_RP), SV12_R), SV12_R, t_tol()), 1, "R R+ R = R");
assert_eq(ganita_mat_eq(ganita_mat_mul(ganita_mat_mul(SV12_RP, SV12_R), SV12_RP), SV12_RP, t_tol()), 1,
  "R+ R R+ = R+");
# rank passes the SVD's status through rather than reading it as an allocation failure: -2 here (also
# in the non-finite group above). -3 would pass the same way; no finite input reaches it.
assert_eq(ganita_mat_rank(t_m3(t_d(1), t_d(2), t_d(3), t_d(1), t_d(2), t_d(3), t_d(4), t_d(5), LNF_NAN), SV12_RTOL),
  0 - 2, "rank passes the SVD's -2 through for a NaN entry");

# Two guards no input in the corpus or the adversarial sets reaches, tested on the helpers directly.
# "A rotation that changed no bit of X is not progress": columns (2, 2) and (1, -1) with a fake
# gamma' of 2^-80 give a rotation by about 2^-82, which rounds back to the same bits. It must report
# 0 and touch neither Z nor the stopping rule's largest |sin|; counted as progress, the same pair
# would come back every sweep (the filing's branch 1 was that loop).
var SV12_X = alloc(32);
var SV12_ZZ = alloc(32);
var SV12_CE = alloc(16);
var SV12_ST2 = alloc(16);
t_sv12_put4(SV12_X, 0, t_d(2), t_d(2), t_d(1), t_d(0 - 1));
t_sv12_put4(SV12_ZZ, 0, t_d(1), 0, 0, t_d(1));
store64(SV12_CE, _linalg_svd_cf(t_d(2)));
store64(SV12_CE + 8, _linalg_svd_cf(t_d(1)));
store64(SV12_ST2, 0);
store64(SV12_ST2 + 8, 0);
assert_eq(_linalg_svd_rot(SV12_X, 2, SV12_ZZ, SV12_CE, 0, 1, t_d(2), t_d(2), 0x3AF0000000000000, SV12_ST2), 0,
  "_linalg_svd_rot: a rotation that changes no bit of X returns 0 (no progress)");
assert_eq((load64(SV12_X) == t_d(2)) && (load64(SV12_X + 8) == t_d(2)) && (load64(SV12_X + 16) == t_d(1))
  && (load64(SV12_X + 24) == t_d(0 - 1)), 1, "  ... X is unchanged");
assert_eq((load64(SV12_ZZ) == t_d(1)) && (load64(SV12_ZZ + 8) == 0) && (load64(SV12_ZZ + 16) == 0)
  && (load64(SV12_ZZ + 24) == t_d(1)), 1, "  ... and the rotation is not applied to Z");
assert_eq(load64(SV12_ST2 + 8), 0, "  ... and the largest |sin| the stopping rule reads is not raised");
# The same guard in regime B: columns (2^400, 2^400) and (2^-200, 2^-200), 600 binades apart, with a
# fake gamma' so small that the projection rounds away.
t_sv12_put4(SV12_X, 0, t_sv12_p2(400), t_sv12_p2(400), t_sv12_p2(0 - 200), t_sv12_p2(0 - 200));
store64(SV12_CE, _linalg_svd_cf(t_sv12_p2(400)));
store64(SV12_CE + 8, _linalg_svd_cf(t_sv12_p2(0 - 200)));
store64(SV12_ST2 + 8, 0);
assert_eq(_linalg_svd_rot(SV12_X, 2, 0, SV12_CE, 0, 1, t_d(2), t_d(2), 0x3AF0000000000000, SV12_ST2), 0,
  "_linalg_svd_rot: a regime-B projection that changes no bit returns 0");
assert_eq((load64(SV12_X + 16) == t_sv12_p2(0 - 200)) && (load64(SV12_X + 24) == t_sv12_p2(0 - 200)), 1,
  "  ... the small column is unchanged");
assert_eq(load64(SV12_ST2 + 8), 0, "  ... and the largest |sin| is not raised");
# Regime B through a whole sweep: columns (2^400, 2^400) and (2^-200, 0). The small one loses its
# component along the large one, exactly (2^-201, -2^-201); the projection enters the stopping rule as
# |sin| = 2^-1022, as dgsvj0's Gram-Schmidt step does; and the next sweep finds nothing to do.
t_sv12_put4(SV12_X, 0, t_sv12_p2(400), t_sv12_p2(400), t_sv12_p2(0 - 200), 0);
var SV12_TOL2 = f64_mul(f64_sqrt(t_d(2)), SV12_EPS);
assert_eq(_linalg_svd_sweep(SV12_X, 2, 0, SV12_CE, SV12_TOL2, SV12_ST2), 1, "_linalg_svd_sweep: regime B is progress");
assert_eq((load64(SV12_X + 16) == 0x3360000000000000) && (load64(SV12_X + 24) == 0xB360000000000000), 1,
  "  ... the small column becomes (2^-201, -2^-201), exactly");
assert_eq(load64(SV12_ST2 + 8), 0x0010000000000000, "  ... it counts as |sin| = 2^-1022 for the stopping rule");
assert_eq(_linalg_svd_sweep(SV12_X, 2, 0, SV12_CE, SV12_TOL2, SV12_ST2), 0, "  ... and the next sweep has no work");
# The subnormal floor stays FINITE for n >= 5. It is n·2^-1074·(fp·sqrt(beta') + fq·sqrt(alpha')),
# and fp·sqrt(beta') alone overflows when a factor is 2^1022 (an all-subnormal column) and the other
# column's alpha' reaches 16. The first 1.2.12 draft formed it in that order: the floor was +inf and
# the pair counted as orthogonal. Here x_0 = 1.9375·2^-1000·(1, 1, 1, 1, 1), so alpha' = 18.8, and
# x_1 = 2^-1060·(1, 1, 0, 0, 0), all subnormal, at cosine 0.63: the pair must be rotated.
var SV12_X5 = alloc(200);
var SV12_CE5 = alloc(40);
sv12i = 0;
while (sv12i < 25) {
    store64(SV12_X5 + sv12i * 8, 0);
    sv12i = sv12i + 1;
}
sv12i = 0;
while (sv12i < 5) {
    store64(SV12_X5 + sv12i * 8, f64_mul(t_sv12_q(31, 16), t_sv12_p2(0 - 1000)));
    store64(SV12_CE5 + sv12i * 8, 0);
    sv12i = sv12i + 1;
}
store64(SV12_X5 + 40, 0x0000000000004000);
store64(SV12_X5 + 48, 0x0000000000004000);
store64(SV12_CE5, _linalg_svd_cf(load64(SV12_X5)));
store64(SV12_CE5 + 8, _linalg_svd_cf(0x0000000000004000));
assert_eq(_linalg_svd_sweep(SV12_X5, 5, 0, SV12_CE5, f64_mul(f64_sqrt(t_d(5)), SV12_EPS), SV12_ST2), 1,
  "_linalg_svd_sweep, n = 5: a subnormal column at cosine 0.63 to a 2^-1000 one is rotated (finite floor)");
# _linalg_svd_reorth on the column-major 4×3 y = [c0 | c1 | y2], c0 = (0.6, 0.8, 0, 0) and c1 = (-0.8,
# 0.6, 0, 0) final (state 1). y2 = (1, 1, 1, 1)/2 loses its components along both and becomes (0, 0, 1,
# 1)/sqrt(2) to rounding: orthogonal to both and unit, to 1 u.
var SV12_Y = alloc(96);
var SV12_YS = alloc(24);
t_sv12_put4(SV12_Y, 0, 0x3FE3333333333333, 0x3FE999999999999A, 0, 0);
t_sv12_put4(SV12_Y, 4, 0xBFE999999999999A, 0x3FE3333333333333, 0, 0);
t_sv12_put4(SV12_Y, 8, 0x3FE0000000000000, 0x3FE0000000000000, 0x3FE0000000000000, 0x3FE0000000000000);
store64(SV12_YS, 1);
store64(SV12_YS + 8, 1);
store64(SV12_YS + 16, 2);
_linalg_svd_reorth(SV12_Y, 4, 3, 2, SV12_YS);
var sv12d0 = 0;
var sv12d1 = 0;
var sv12nn = f64_neg(t_d(1));
sv12i = 0;
while (sv12i < 4) {
    var sv12y = load64(SV12_Y + 64 + sv12i * 8);
    sv12d0 = f64_add(sv12d0, f64_mul(sv12y, load64(SV12_Y + sv12i * 8)));
    sv12d1 = f64_add(sv12d1, f64_mul(sv12y, load64(SV12_Y + 32 + sv12i * 8)));
    sv12nn = f64_add(sv12nn, f64_mul(sv12y, sv12y));
    sv12i = sv12i + 1;
}
assert_eq(f64_le(f64_abs(sv12d0), SV12_EPS) && f64_le(f64_abs(sv12d1), SV12_EPS), 1,
  "_linalg_svd_reorth: the column is orthogonal to both final columns, to 1 u");
assert_eq(f64_le(f64_abs(sv12nn), SV12_EPS), 1, "  ... and unit, to 1 u");
assert_eq(f64_lt(f64_abs(f64_sub(load64(SV12_Y + 80), 0x3FE6A09E667F3BCD)), 0x3CC0000000000000), 1,
  "  ... it is (0, 0, 1, 1)/sqrt(2): what is left of y2's own direction");
# The restart: a y2 in the span of the final columns (c0 itself) keeps nothing after the two passes, so
# it starts again from the axis they cover least — rows 2 and 3 tie at 0, the first wins — and comes
# back exactly e_2. No input of the corpus, the adversarial sets or the hunts reaches this.
t_sv12_put4(SV12_Y, 8, 0x3FE3333333333333, 0x3FE999999999999A, 0, 0);
_linalg_svd_reorth(SV12_Y, 4, 3, 2, SV12_YS);
assert_eq((load64(SV12_Y + 64) == 0) && (load64(SV12_Y + 72) == 0) && (load64(SV12_Y + 80) == t_d(1))
  && (load64(SV12_Y + 88) == 0), 1, "_linalg_svd_reorth: a column in the span of the others restarts from e_2");
# The restart is decided by length, not by exact cancellation: y2 = c0 + 2^-60·e_3 keeps exactly
# 2^-60·e_3, far below half its length, so it restarts too (normalising that remnant would give e_3).
t_sv12_put4(SV12_Y, 8, 0x3FE3333333333333, 0x3FE999999999999A, 0, 0x3C30000000000000);
_linalg_svd_reorth(SV12_Y, 4, 3, 2, SV12_YS);
assert_eq((load64(SV12_Y + 64) == 0) && (load64(SV12_Y + 72) == 0) && (load64(SV12_Y + 80) == t_d(1))
  && (load64(SV12_Y + 88) == 0), 1, "_linalg_svd_reorth: a column left with under half its length restarts");
# Only state-1 columns are projected out: with c1 marked 2 (pending), y2 = (-0.8, 0.6, 1, 0) keeps its
# component along c1 — it would become e_2 without it — and comes back (-0.8, 0.6, 1, 0)/sqrt(2).
store64(SV12_YS + 8, 2);
t_sv12_put4(SV12_Y, 8, 0xBFE999999999999A, 0x3FE3333333333333, t_d(1), 0);
_linalg_svd_reorth(SV12_Y, 4, 3, 2, SV12_YS);
assert_eq((load64(SV12_Y + 64) == 0xBFE21A1851FF630A) && (load64(SV12_Y + 72) == 0x3FDB27247AFF148E)
  && (load64(SV12_Y + 80) == 0x3FE6A09E667F3BCC) && (load64(SV12_Y + 88) == 0), 1,
  "_linalg_svd_reorth: a pending (state 2) column is not projected out");

test_group("SVD building blocks, called directly (1.2.12)");
# Every private helper of the 1.2.12 SVD on input whose answer is known exactly, so each is pinned on its
# own and not only through whole decompositions. Expected bits come from Python, by the same operations
# where rounding matters (math.ldexp rounds once).
#
# _linalg_svd_pow2: 2^j as its bits, subnormal below -1022. _linalg_svd_expo: floor(log2 |x|), the sign
# ignored and held at -1022, so 2^-e is representable.
assert_eq(_linalg_svd_pow2(0), 0x3FF0000000000000, "_linalg_svd_pow2(0) = 1");
assert_eq(_linalg_svd_pow2(1023), 0x7FE0000000000000, "_linalg_svd_pow2(1023)");
assert_eq(_linalg_svd_pow2(0 - 1022), 0x0010000000000000, "_linalg_svd_pow2(-1022) = DBL_MIN");
assert_eq(_linalg_svd_pow2(0 - 1023), 0x0008000000000000, "_linalg_svd_pow2(-1023), a subnormal");
assert_eq(_linalg_svd_pow2(0 - 1074), 1, "_linalg_svd_pow2(-1074), the smallest subnormal");
assert_eq(_linalg_svd_expo(t_d(1)), 0, "_linalg_svd_expo(1) = 0");
assert_eq(_linalg_svd_expo(0xC008000000000000), 1, "_linalg_svd_expo(-3) = 1: the sign is ignored");
assert_eq(_linalg_svd_expo(0x3FEFFFFFFFFFFFFF), 0 - 1, "_linalg_svd_expo(1 - 2^-53) = -1");
assert_eq(_linalg_svd_expo(0x7FEFFFFFFFFFFFFF), 1023, "_linalg_svd_expo(DBL_MAX) = 1023");
assert_eq(_linalg_svd_expo(0x0010000000000000), 0 - 1022, "_linalg_svd_expo(DBL_MIN) = -1022");
assert_eq(_linalg_svd_expo(1), 0 - 1022, "_linalg_svd_expo of a subnormal is held at -1022");

# _linalg_svd_ldexp: x·2^e rounded ONCE, ties to even; a signed infinity past the range and a signed 0
# far below it.
assert_eq(_linalg_svd_ldexp(t_d(1), 3), 0x4020000000000000, "_linalg_svd_ldexp(1, 3) = 8");
assert_eq(_linalg_svd_ldexp(0xBFF8000000000000, 0 - 1), 0xBFE8000000000000, "_linalg_svd_ldexp(-1.5, -1) = -0.75");
assert_eq(_linalg_svd_ldexp(t_d(1), 1024), 0x7FF0000000000000, "_linalg_svd_ldexp(1, 1024) = +inf");
assert_eq(_linalg_svd_ldexp(f64_neg(t_d(1)), 1024), 0xFFF0000000000000, "_linalg_svd_ldexp(-1, 1024) = -inf");
assert_eq(_linalg_svd_ldexp(0x3FFFFFFFFFFFFFFF, 0 - 1022), 0x001FFFFFFFFFFFFF,
  "_linalg_svd_ldexp(2 - 2^-52, -1022): still normal, exact");
assert_eq(_linalg_svd_ldexp(0x3FFFFFFFFFFFFFFF, 0 - 1023), 0x0010000000000000,
  "_linalg_svd_ldexp(2 - 2^-52, -1023): half a step below DBL_MIN, a tie, to even: DBL_MIN");
assert_eq(_linalg_svd_ldexp(t_d(1), 0 - 1074), 1, "_linalg_svd_ldexp(1, -1074) = 2^-1074, exact");
assert_eq(_linalg_svd_ldexp(0x3FF4000000000000, 0 - 1074), 1, "_linalg_svd_ldexp(1.25, -1074) rounds to 1 step");
assert_eq(_linalg_svd_ldexp(0x3FF8000000000000, 0 - 1074), 2, "_linalg_svd_ldexp(1.5, -1074): a tie, to even, 2");
assert_eq(_linalg_svd_ldexp(0x3FFC000000000000, 0 - 1074), 2, "_linalg_svd_ldexp(1.75, -1074) rounds to 2 steps");
assert_eq(_linalg_svd_ldexp(t_d(1), 0 - 1075), 0, "_linalg_svd_ldexp(1, -1075): half a step, a tie, to even, 0");
assert_eq(_linalg_svd_ldexp(0x3FF8000000000000, 0 - 1075), 1, "_linalg_svd_ldexp(1.5, -1075) rounds to 1 step");
assert_eq(_linalg_svd_ldexp(t_d(1), 0 - 1076), 0, "_linalg_svd_ldexp(1, -1076) = 0");
assert_eq(_linalg_svd_ldexp(f64_neg(t_d(1)), 0 - 1080), 0x8000000000000000, "_linalg_svd_ldexp(-1, -1080) = -0.0");
assert_eq(_linalg_svd_ldexp(0x8000000000000000, 5), 0x8000000000000000, "_linalg_svd_ldexp(-0.0, 5) = -0.0");

# _linalg_svd_nrm: |x| with the largest entry's power of two scaled out exactly, so (3, 4)·2^1000 and
# (3, 4)·2^-1074 give 5·2^1000 and 5·2^-1074 exactly, where the plain sum of squares is +inf and 0.
var SVB_V = alloc(16);
store64(SVB_V, t_d(3));
store64(SVB_V + 8, t_d(4));
assert_eq(_linalg_svd_nrm(SVB_V, 2), t_d(5), "_linalg_svd_nrm(3, 4) = 5");
store64(SVB_V, f64_mul(t_d(3), t_sv12_p2(1000)));
store64(SVB_V + 8, f64_mul(t_d(4), t_sv12_p2(1000)));
assert_eq(_linalg_svd_nrm(SVB_V, 2), f64_mul(t_d(5), t_sv12_p2(1000)), "_linalg_svd_nrm((3, 4)*2^1000) = 5*2^1000");
store64(SVB_V, 3);
store64(SVB_V + 8, 4);
assert_eq(_linalg_svd_nrm(SVB_V, 2), 5, "_linalg_svd_nrm((3, 4)*2^-1074) = 5*2^-1074");
store64(SVB_V, 0);
store64(SVB_V + 8, 0x8000000000000000);
assert_eq(_linalg_svd_nrm(SVB_V, 2), 0, "_linalg_svd_nrm(0, -0) = 0");

# _linalg_svd_ssq and _linalg_svd_dot sum PAIRWISE, halving until 16 terms are left. Over 1 followed by
# 32 copies of 2^-27 (squares 2^-54): a running sum rounds each 2^-54 away and gives 1 — as the first 16
# terms do here — while the 17 of the second half are summed among themselves first, giving 1 + 2^-50
# (the exact sum is 1 + 2^-49).
var SVB_W = alloc(264);
store64(SVB_W, t_d(1));
var svbi = 1;
while (svbi < 33) {
    store64(SVB_W + svbi * 8, t_sv12_p2(0 - 27));
    svbi = svbi + 1;
}
assert_eq(_linalg_svd_ssq(SVB_W, 16, t_d(1), 0), t_d(1), "_linalg_svd_ssq: 16 terms are the plain loop, 1");
assert_eq(_linalg_svd_ssq(SVB_W, 33, t_d(1), 0), 0x3FF0000000000004, "_linalg_svd_ssq: 33 terms pairwise, 1 + 2^-50");
assert_eq(_linalg_svd_dot(SVB_W, SVB_W, 33), 0x3FF0000000000004, "_linalg_svd_dot: the same split, the same bits");
assert_eq(_linalg_svd_ssq(SVB_W, 33, t_d(2), 1), 0x4010000000000004, "_linalg_svd_ssq with f = 2: 4·(1 + 2^-50)");
assert_eq((load64(SVB_W) == t_d(2)) && (load64(SVB_W + 256) == t_sv12_p2(0 - 26)), 1,
  "  ... and put = 1 stores each 2·x_i back");

# _linalg_svd_house: (3, 4) becomes the unit v = (2, 1)/sqrt(5) of H = I - 2·v·v^T and returns r = -5,
# opposite in sign to x_0; _linalg_svd_reflect then maps (3, 4) to (-5, 0), here exactly. The same x at
# 2^-1074 gives the same v, so H stays orthogonal at every magnitude, and r = -5·2^-1074 exactly.
store64(SVB_V, t_d(3));
store64(SVB_V + 8, t_d(4));
assert_eq(_linalg_svd_house(SVB_V, 2, t_d(4)), 0xC014000000000000, "_linalg_svd_house(3, 4) returns -5");
assert_eq((load64(SVB_V) == 0x3FEC9F25C5BFEDD9) && (load64(SVB_V + 8) == 0x3FDC9F25C5BFEDD9), 1,
  "  ... and leaves v = (2, 1)/sqrt(5)");
var SVB_Y = alloc(16);
store64(SVB_Y, t_d(3));
store64(SVB_Y + 8, t_d(4));
_linalg_svd_reflect(SVB_V, SVB_Y, 2);
assert_eq((load64(SVB_Y) == 0xC014000000000000) && (load64(SVB_Y + 8) == 0), 1,
  "_linalg_svd_reflect: H (3, 4) = (-5, 0)");
store64(SVB_V, 3);
store64(SVB_V + 8, 4);
assert_eq(_linalg_svd_house(SVB_V, 2, 4), 0x8000000000000005, "_linalg_svd_house((3, 4)*2^-1074) returns -5*2^-1074");
assert_eq((load64(SVB_V) == 0x3FEC9F25C5BFEDD9) && (load64(SVB_V + 8) == 0x3FDC9F25C5BFEDD9), 1,
  "  ... and the same v");
store64(SVB_V, t_d(7));
assert_eq(_linalg_svd_house(SVB_V, 1, t_d(7)), t_d(7), "_linalg_svd_house of one entry: r = x_0 and H = I ...");
assert_eq(load64(SVB_V), 0, "  ... v = 0");
store64(SVB_V, 0);
store64(SVB_V + 8, 0);
assert_eq(_linalg_svd_house(SVB_V, 2, 0), 0, "_linalg_svd_house of a zero x: r = 0, v stays 0");
store64(SVB_Y, t_d(3));
store64(SVB_Y + 8, t_d(4));
_linalg_svd_reflect(SVB_V, SVB_Y, 2);
assert_eq((load64(SVB_Y) == t_d(3)) && (load64(SVB_Y + 8) == t_d(4)), 1,
  "_linalg_svd_reflect: a zero v is the identity, skipped");

# _linalg_svd_qrcp, _linalg_svd_apply_q and _linalg_svd_rt on a 3×2 whose factorisation is exact: A =
# [[1, 0], [0, 2], [0, 0]], column-major. Column pivoting takes the larger column first, row pivoting
# swaps rows 0 and 1 to bring its 2 to the diagonal, and both reflectors are sign flips: R = [[-2, 0], [0,
# -1]], piv = (1, 0), rp = (1, 1). Q·[R; 0] is then A·P bit for bit, and R^T's column scalings are 2^-1
# and 1 (_linalg_svd_cf).
var SVB_QA = alloc(48);
t_sv12_put4(SVB_QA, 0, t_d(1), 0, 0, 0);
store64(SVB_QA + 32, t_d(2));
store64(SVB_QA + 40, 0);
var SVB_RD = alloc(16);
var SVB_PV = alloc(16);
var SVB_RP = alloc(16);
var SVB_N1 = alloc(16);
var SVB_N2 = alloc(16);
_linalg_svd_qrcp(SVB_QA, 3, 2, SVB_RD, SVB_PV, SVB_RP, SVB_N1, SVB_N2);
assert_eq((load64(SVB_PV) == 1) && (load64(SVB_PV + 8) == 0), 1, "_linalg_svd_qrcp: the larger column goes first");
assert_eq((load64(SVB_RP) == 1) && (load64(SVB_RP + 8) == 1), 1, "  ... its largest entry is swapped to the diagonal");
assert_eq((load64(SVB_RD) == 0xC000000000000000) && (load64(SVB_RD + 8) == 0xBFF0000000000000)
  && (load64(SVB_QA + 24) == 0), 1, "  ... and R = [[-2, 0], [0, -1]]");
var SVB_QY = alloc(48);
t_sv12_put4(SVB_QY, 0, 0xC000000000000000, 0, 0, load64(SVB_QA + 24));
store64(SVB_QY + 32, 0xBFF0000000000000);
store64(SVB_QY + 40, 0);
_linalg_svd_apply_q(SVB_QA, 3, 2, SVB_RP, SVB_QY, 2);
assert_eq((load64(SVB_QY) == 0) && (load64(SVB_QY + 8) == t_d(2)) && (load64(SVB_QY + 16) == 0)
  && (load64(SVB_QY + 24) == t_d(1)) && (load64(SVB_QY + 32) == 0) && (load64(SVB_QY + 40) == 0), 1,
  "_linalg_svd_apply_q: Q [R; 0] = A P, bit for bit");
var SVB_RT = alloc(32);
var SVB_CF = alloc(16);
_linalg_svd_rt(SVB_QA, 3, SVB_RD, 2, SVB_RT, SVB_CF);
assert_eq((load64(SVB_RT) == 0xC000000000000000) && (load64(SVB_RT + 8) == 0) && (load64(SVB_RT + 16) == 0)
  && (load64(SVB_RT + 24) == 0xBFF0000000000000), 1, "_linalg_svd_rt: R^T, column j = row j of R");
assert_eq((load64(SVB_CF) == 0x3FE0000000000000) && (load64(SVB_CF + 8) == 0x3FF0000000000000), 1,
  "  ... with each column's scaling, 2^-e for its largest entry");
# The same three on a generic 5×3 (the test generator's entries, in [-2, 2)): piv is a permutation, the
# pivoting keeps |R_kk| >= |R_kj| for j > k, and A·P = Q·[R; 0] to 8 u.
var SVB_G = t_sv12_gen(7, 5, 3);
var SVB_GA = alloc(120);
var SVB_GY = alloc(120);
var svbj = 0;
svbi = 0;
while (svbi < 15) {
    store64(SVB_GA + ((svbi % 3) * 5 + svbi / 3) * 8, load64(SVB_G + 16 + svbi * 8));
    store64(SVB_GY + svbi * 8, 0);
    svbi = svbi + 1;
}
var SVB_GRD = alloc(24);
var SVB_GPV = alloc(24);
var SVB_GRP = alloc(24);
_linalg_svd_qrcp(SVB_GA, 5, 3, SVB_GRD, SVB_GPV, SVB_GRP, alloc(24), alloc(24));
var svbp0 = load64(SVB_GPV);
var svbp1 = load64(SVB_GPV + 8);
var svbp2 = load64(SVB_GPV + 16);
assert_eq(((svbp0 + svbp1 + svbp2) == 3) && (svbp0 != svbp1) && (svbp0 != svbp2) && (svbp1 != svbp2), 1,
  "_linalg_svd_qrcp on a 5x3: piv is a permutation of (0, 1, 2)");
var svbok = 1;
svbi = 0;
while (svbi < 3) {
    store64(SVB_GY + (svbi * 5 + svbi) * 8, load64(SVB_GRD + svbi * 8));
    svbj = svbi + 1;
    while (svbj < 3) {
        var svbr = load64(SVB_GA + (svbj * 5 + svbi) * 8);
        store64(SVB_GY + (svbj * 5 + svbi) * 8, svbr);
        if (f64_lt(f64_abs(load64(SVB_GRD + svbi * 8)), f64_abs(svbr)) == 1) { svbok = 0; }
        svbj = svbj + 1;
    }
    svbi = svbi + 1;
}
assert_eq(svbok, 1, "  ... and |R_kk| >= |R_kj| for every j > k");
_linalg_svd_apply_q(SVB_GA, 5, 3, SVB_GRP, SVB_GY, 3);
var svbmx = 0;
svbi = 0;
while (svbi < 5) {
    svbj = 0;
    while (svbj < 3) {
        var svbpj = load64(SVB_GPV + svbj * 8);
        var svbd = f64_sub(load64(SVB_GY + (svbj * 5 + svbi) * 8), ganita_mat_get(SVB_G, svbi, svbpj));
        svbmx = t_sv12_max(svbmx, f64_abs(svbd));
        svbj = svbj + 1;
    }
    svbi = svbi + 1;
}
assert_eq(f64_le(svbmx, f64_mul(t_d(16), SV12_EPS)), 1, "  ... and Q [R; 0] = A P to 8 u of A's largest entry (2)");

# _linalg_svd_unit: (3, 4) -> (0.6, 0.8), the doubles nearest. _linalg_svd_cross: e_0 × e_1 = e_2, and
# (0.6, 0.8, 0) × e_2 = (0.8, -0.6, 0), normalised.
store64(SVB_V, t_d(3));
store64(SVB_V + 8, t_d(4));
_linalg_svd_unit(SVB_V, 2);
assert_eq((load64(SVB_V) == 0x3FE3333333333333) && (load64(SVB_V + 8) == 0x3FE999999999999A), 1,
  "_linalg_svd_unit(3, 4) = (0.6, 0.8)");
var SVB_X = t_sv12_arr(9);
t_sv12_put4(SVB_X, 0, t_d(1), 0, 0, 0);
t_sv12_put4(SVB_X, 4, t_d(1), 0, 0, 0);
_linalg_svd_cross(SVB_X, SVB_X + 24, SVB_X + 48);
assert_eq((load64(SVB_X + 48) == 0) && (load64(SVB_X + 56) == 0) && (load64(SVB_X + 64) == t_d(1)), 1,
  "_linalg_svd_cross: e_0 x e_1 = e_2");
t_sv12_put4(SVB_X, 0, 0x3FE3333333333333, 0x3FE999999999999A, 0, 0);
store64(SVB_X + 32, 0);
store64(SVB_X + 40, t_d(1));
_linalg_svd_cross(SVB_X, SVB_X + 24, SVB_X + 48);
assert_eq((load64(SVB_X + 48) == 0x3FE999999999999A) && (load64(SVB_X + 56) == 0xBFE3333333333333)
  && (load64(SVB_X + 64) == 0), 1, "_linalg_svd_cross: (0.6, 0.8, 0) x e_2 = (0.8, -0.6, 0)");

# _linalg_svd_complete fills each zero column (ce = 0) of the n×n x into an orthonormal basis: for n = 2
# the other column turned by 90 degrees; for n = 3 the cross product of the other two; with two zero
# columns the axis the remaining one is least aligned with, made orthogonal to it, then the cross product.
var SVB_CE = alloc(24);
t_sv12_put4(SVB_X, 0, 0x3FE3333333333333, 0x3FE999999999999A, 0, 0);
store64(SVB_CE, t_d(1));
store64(SVB_CE + 8, 0);
_linalg_svd_complete(SVB_X, 2, SVB_CE);
assert_eq((load64(SVB_X + 16) == 0xBFE999999999999A) && (load64(SVB_X + 24) == 0x3FE3333333333333), 1,
  "_linalg_svd_complete, n = 2: the zero column becomes (-0.8, 0.6)");
t_sv12_put4(SVB_X, 0, t_d(1), 0, 0, 0);
t_sv12_put4(SVB_X, 4, t_d(1), 0, 0, 0);
t_sv12_put4(SVB_X, 8, 0x7FF4000000000BAD, 0, 0, 0);
store64(SVB_CE + 8, t_d(1));
store64(SVB_CE + 16, 0);
_linalg_svd_complete(SVB_X, 3, SVB_CE);
assert_eq((load64(SVB_X + 48) == 0) && (load64(SVB_X + 56) == 0) && (load64(SVB_X + 64) == t_d(1)), 1,
  "_linalg_svd_complete, n = 3, one zero column: e_0 x e_1 = e_2");
t_sv12_put4(SVB_X, 0, 0x3FE3333333333333, 0x3FE999999999999A, 0, 0);
store64(SVB_CE + 8, 0);
_linalg_svd_complete(SVB_X, 3, SVB_CE);
assert_eq(((load64(SVB_X + 24) & 0x7FFFFFFFFFFFFFFF) == 0) && ((load64(SVB_X + 32) & 0x7FFFFFFFFFFFFFFF) == 0)
  && (load64(SVB_X + 40) == t_d(1)), 1, "_linalg_svd_complete, two zero columns: the first becomes e_2 ...");
assert_eq((load64(SVB_X + 48) == 0x3FE999999999999A) && (load64(SVB_X + 56) == 0xBFE3333333333333)
  && (load64(SVB_X + 64) == 0), 1, "  ... and the second (0.6, 0.8, 0) x e_2 = (0.8, -0.6, 0)");

test_group("back-compat aliases");
var a2 = mat_new(4, 5);
assert_eq(mat_rows(a2), 4, "alias mat_rows");
assert_eq(mat_cols(a2), 5, "alias mat_cols");
assert_eq(binomial(5, 2), 10, "alias binomial == canonical");
assert_eq(f64_cbrt(t_d(27)), ganita_f64_cbrt(t_d(27)), "alias f64_cbrt == canonical (1.2.6)");

# 1.2.8: EVERY alias is exercised, each against its ganita_* twin on the same inputs. cyrius 6.6.8's
# `cyrius coverage` counts a reference, not a substring — and every alias name is a substring of
# the canonical it forwards to, so the old counter credited all 54 without one call (this file
# called five). Measured under the 6.6.9 toolchain: 60% real, against a 94% floor. The floor stays;
# these rows make it true, and they also pin that each alias forwards to the right function.
test_group("back-compat aliases: every alias forwards to its ganita_* twin (1.2.8)");
var CA = t_m2(t_d(4), t_d(3), t_d(6), t_d(3));
var CS = t_m2(t_d(4), t_d(2), t_d(2), t_d(3));
var CB = t_m2(t_d(1), t_d(2), t_d(3), t_d(4));
var C3 = t_m3(t_d(2), t_d(1), t_d(1), t_d(1), t_d(3), t_d(2), t_d(1), t_d(0), t_d(0));
var CTOL = t_tol();
var CHALF = f64_div(t_d(1), t_d(2));
assert_eq(ganita_mat_eq(mat_new(3, 2), ganita_mat_new(3, 2), 0), 1, "alias mat_new");
assert_eq(mat_get(CA, 1, 0), ganita_mat_get(CA, 1, 0), "alias mat_get");
var CS1 = ganita_mat_copy(CA);
var CS2 = ganita_mat_copy(CA);
mat_set(CS1, 0, 1, t_d(9));
ganita_mat_set(CS2, 0, 1, t_d(9));
assert_eq(ganita_mat_eq(CS1, CS2, 0), 1, "alias mat_set");
assert_eq(ganita_mat_eq(mat_identity(3), ganita_mat_identity(3), 0), 1, "alias mat_identity");
var CD4 = alloc(32);
store64(CD4, t_d(1)); store64(CD4 + 8, t_d(2)); store64(CD4 + 16, t_d(3)); store64(CD4 + 24, t_d(4));
assert_eq(ganita_mat_eq(mat_from(2, 2, CD4), ganita_mat_from(2, 2, CD4), 0), 1, "alias mat_from");
assert_eq(ganita_mat_eq(mat_add(CA, CB), ganita_mat_add(CA, CB), 0), 1, "alias mat_add");
assert_eq(ganita_mat_eq(mat_sub(CA, CB), ganita_mat_sub(CA, CB), 0), 1, "alias mat_sub");
assert_eq(ganita_mat_eq(mat_scale(CA, t_d(3)), ganita_mat_scale(CA, t_d(3)), 0), 1, "alias mat_scale");
assert_eq(ganita_mat_eq(mat_mul(CA, CB), ganita_mat_mul(CA, CB), 0), 1, "alias mat_mul");
assert_eq(ganita_mat_eq(mat_transpose(CA), ganita_mat_transpose(CA), 0), 1, "alias mat_transpose");
var CV1 = t_arr3(t_d(1), t_d(2), t_d(3));
var CV2 = t_arr3(t_d(4), t_d(5), t_d(6));
assert_eq(mat_dot(CV1, CV2, 3), ganita_mat_dot(CV1, CV2, 3), "alias mat_dot");
assert_eq(mat_print(CB), ganita_mat_print(CB), "alias mat_print");
assert_eq(ganita_mat_eq(mat_copy(CA), CA, 0), 1, "alias mat_copy");
assert_eq(ganita_mat_eq(mat_neg(CA), ganita_mat_neg(CA), 0), 1, "alias mat_neg");
var CR1 = mat_row(C3, 1);
var CR2 = ganita_mat_row(C3, 1);
assert_eq(load64(CR1 + 16), load64(CR2 + 16), "alias mat_row");
var CC1 = mat_col(C3, 1);
var CC2 = ganita_mat_col(C3, 1);
assert_eq(load64(CC1 + 8), load64(CC2 + 8), "alias mat_col");
var CW1 = ganita_mat_copy(CA);
var CW2 = ganita_mat_copy(CA);
mat_set_row(CW1, 1, t_arr2(t_d(7), t_d(8)));
ganita_mat_set_row(CW2, 1, t_arr2(t_d(7), t_d(8)));
assert_eq(ganita_mat_eq(CW1, CW2, 0), 1, "alias mat_set_row");
mat_set_col(CW1, 0, t_arr2(t_d(5), t_d(6)));
ganita_mat_set_col(CW2, 0, t_arr2(t_d(5), t_d(6)));
assert_eq(ganita_mat_eq(CW1, CW2, 0), 1, "alias mat_set_col");
assert_eq(ganita_mat_eq(mat_submatrix(C3, 0, 0, 2, 2), ganita_mat_submatrix(C3, 0, 0, 2, 2), 0), 1,
  "alias mat_submatrix");
assert_eq(mat_frobenius(CA), ganita_mat_frobenius(CA), "alias mat_frobenius");
assert_eq(mat_max_norm(CA), ganita_mat_max_norm(CA), "alias mat_max_norm");
assert_eq(mat_is_symmetric(CS, CTOL), ganita_mat_is_symmetric(CS, CTOL), "alias mat_is_symmetric");
assert_eq(mat_eq(CA, CA, 0), 1, "alias mat_eq");
assert_eq(mat_trace(CA), ganita_mat_trace(CA), "alias mat_trace");
var CLU1 = ganita_mat_new(2, 2);
var CPV1 = alloc(16);
var CLU2 = ganita_mat_new(2, 2);
var CPV2 = alloc(16);
assert_eq(mat_lu(CA, CLU1, CPV1), ganita_mat_lu(CA, CLU2, CPV2), "alias mat_lu (return)");
assert_eq(ganita_mat_eq(CLU1, CLU2, 0), 1, "alias mat_lu (factors)");
var CX1 = alloc(16);
var CX2 = alloc(16);
mat_lu_solve(CLU1, CPV1, t_arr2(t_d(10), t_d(12)), CX1);
ganita_mat_lu_solve(CLU2, CPV2, t_arr2(t_d(10), t_d(12)), CX2);
assert_eq(load64(CX1 + 8), load64(CX2 + 8), "alias mat_lu_solve");
assert_eq(mat_det(CA), ganita_mat_det(CA), "alias mat_det");
assert_eq(ganita_mat_eq(mat_inv(CA), ganita_mat_inv(CA), 0), 1, "alias mat_inv");
var CL1 = ganita_mat_new(2, 2);
var CL2 = ganita_mat_new(2, 2);
assert_eq(mat_cholesky(CS, CL1), ganita_mat_cholesky(CS, CL2), "alias mat_cholesky (return)");
assert_eq(ganita_mat_eq(CL1, CL2, 0), 1, "alias mat_cholesky (factor)");
var CY1 = alloc(16);
var CY2 = alloc(16);
mat_cholesky_solve(CL1, t_arr2(t_d(10), t_d(11)), CY1);
ganita_mat_cholesky_solve(CL2, t_arr2(t_d(10), t_d(11)), CY2);
assert_eq(load64(CY1), load64(CY2), "alias mat_cholesky_solve");
var CQ1 = ganita_mat_new(2, 2);
var CRR1 = ganita_mat_new(2, 2);
var CQ2 = ganita_mat_new(2, 2);
var CRR2 = ganita_mat_new(2, 2);
mat_qr(CA, CQ1, CRR1);
ganita_mat_qr(CA, CQ2, CRR2);
assert_eq(ganita_mat_eq(CRR1, CRR2, 0), 1, "alias mat_qr");
var CG1 = ganita_mat_new(2, 3);
var CG2 = ganita_mat_new(2, 3);
ganita_mat_set(CG1, 0, 0, t_d(2)); ganita_mat_set(CG1, 0, 1, t_d(1)); ganita_mat_set(CG1, 0, 2, t_d(5));
ganita_mat_set(CG1, 1, 0, t_d(1)); ganita_mat_set(CG1, 1, 1, t_d(3)); ganita_mat_set(CG1, 1, 2, t_d(10));
ganita_mat_set(CG2, 0, 0, t_d(2)); ganita_mat_set(CG2, 0, 1, t_d(1)); ganita_mat_set(CG2, 0, 2, t_d(5));
ganita_mat_set(CG2, 1, 0, t_d(1)); ganita_mat_set(CG2, 1, 1, t_d(3)); ganita_mat_set(CG2, 1, 2, t_d(10));
assert_eq(mat_gaussian_elim(CG1), ganita_mat_gaussian_elim(CG2), "alias mat_gaussian_elim (return)");
assert_eq(ganita_mat_eq(CG1, CG2, 0), 1, "alias mat_gaussian_elim (result)");
var CLA = ganita_mat_new(3, 2);
ganita_mat_set(CLA, 0, 0, t_d(1)); ganita_mat_set(CLA, 0, 1, t_d(0));
ganita_mat_set(CLA, 1, 0, t_d(0)); ganita_mat_set(CLA, 1, 1, t_d(1));
ganita_mat_set(CLA, 2, 0, t_d(1)); ganita_mat_set(CLA, 2, 1, t_d(1));
var CZ1 = alloc(16);
var CZ2 = alloc(16);
mat_least_squares(CLA, t_arr3(t_d(1), t_d(2), t_d(3)), CZ1);
ganita_mat_least_squares(CLA, t_arr3(t_d(1), t_d(2), t_d(3)), CZ2);
assert_eq(load64(CZ1 + 8), load64(CZ2 + 8), "alias mat_least_squares");
var CE1 = alloc(16);
var CE2 = alloc(16);
mat_eigen_sym(CS, CE1, ganita_mat_new(2, 2));
ganita_mat_eigen_sym(CS, CE2, ganita_mat_new(2, 2));
assert_eq(load64(CE1), load64(CE2), "alias mat_eigen_sym");
var CSG1 = alloc(16);
var CSG2 = alloc(16);
mat_svd(CA, ganita_mat_new(2, 2), CSG1, ganita_mat_new(2, 2));
ganita_mat_svd(CA, ganita_mat_new(2, 2), CSG2, ganita_mat_new(2, 2));
assert_eq(load64(CSG1), load64(CSG2), "alias mat_svd");
assert_eq(ganita_mat_eq(mat_pseudo_inv(CA), ganita_mat_pseudo_inv(CA), 0), 1, "alias mat_pseudo_inv");
assert_eq(mat_rank(CA, CTOL), ganita_mat_rank(CA, CTOL), "alias mat_rank");
assert_eq(mat_condition(CA), ganita_mat_condition(CA), "alias mat_condition");
assert_eq(f64_sinh(t_d(1)), ganita_f64_sinh(t_d(1)), "alias f64_sinh");
assert_eq(f64_cosh(t_d(1)), ganita_f64_cosh(t_d(1)), "alias f64_cosh");
assert_eq(f64_tanh(t_d(1)), ganita_f64_tanh(t_d(1)), "alias f64_tanh");
assert_eq(f64_pow(t_d(2), t_d(10)), ganita_f64_pow(t_d(2), t_d(10)), "alias f64_pow");
assert_eq(f64_tan(t_d(1)), ganita_f64_tan(t_d(1)), "alias f64_tan (1.2.11)");
assert_eq(f64_asin(CHALF), ganita_f64_asin(CHALF), "alias f64_asin");
assert_eq(f64_acos(CHALF), ganita_f64_acos(CHALF), "alias f64_acos");
assert_eq(f64_atan2(t_d(1), t_d(2)), ganita_f64_atan2(t_d(1), t_d(2)), "alias f64_atan2");
assert_eq(f64_asinh(t_d(1)), ganita_f64_asinh(t_d(1)), "alias f64_asinh");
assert_eq(f64_acosh(t_d(2)), ganita_f64_acosh(t_d(2)), "alias f64_acosh");
assert_eq(f64_atanh(CHALF), ganita_f64_atanh(CHALF), "alias f64_atanh");
assert_eq(f64_hypot(t_d(3), t_d(4)), ganita_f64_hypot(t_d(3), t_d(4)), "alias f64_hypot");
assert_eq(fibonacci(10), ganita_fibonacci(10), "alias fibonacci");

test_group("canonicals no other row called (1.2.8)");
assert_eq(ganita_mat_eq(ganita_mat_scale(CB, t_d(2)), t_m2(t_d(2), t_d(4), t_d(6), t_d(8)), 0), 1,
  "ganita_mat_scale doubles every entry");
assert_eq(t_dclose(ganita_mat_dot(CV1, CV2, 3), t_d(32)), 1, "ganita_mat_dot: (1,2,3) . (4,5,6) = 32");
assert_eq(t_dclose(f64_sin(ganita_f64_asin(CHALF)), CHALF), 1, "sin(ganita_f64_asin(0.5)) = 0.5");
assert_eq(t_dclose(ganita_f64_atan2(t_d(1), t_d(1)), f64_atan(t_d(1))), 1,
  "ganita_f64_atan2(1, 1) = atan(1) = pi/4");
assert_eq(t_dclose(ganita_f64_atan2(t_d(0) - t_d(0), t_d(1)), t_d(0)), 1, "ganita_f64_atan2(0, 1) = 0");

test_group("pseudo_inv and condition at the ends of the double range (1.2.13)");
# docs/development/issues/archived/2026-10-04-svd-derived-functions-at-the-range-ends.md. Both took
# sigma unscaled to A's magnitude: a kept sigma below 2^-1024 had a reciprocal of +inf that met V^T's
# zeros as NaN, and a sigma_1 above DBL_MAX made 1e-12·sigma_1 +inf, so every sigma was "negligible".
# Both now work in the SVD's working scale; an entry of the exact pseudo-inverse above DBL_MAX is +inf.
var PE_DM = 0x7FEFFFFFFFFFFFFF;
var PE_P1 = ganita_mat_pseudo_inv(t_m2(0x0000000000004000, 0, 0, 0x0000000000004000));
assert_eq(ganita_mat_get(PE_P1, 0, 0), 0x7FF0000000000000, "pseudo_inv(diag(2^-1060, 2^-1060))[0][0] = +inf (was NaN)");
assert_eq(ganita_mat_get(PE_P1, 0, 1), 0, "pseudo_inv(diag(2^-1060, 2^-1060))[0][1] = 0 (was NaN)");
assert_eq(ganita_mat_get(PE_P1, 1, 1), 0x7FF0000000000000, "pseudo_inv(diag(2^-1060, 2^-1060))[1][1] = +inf");
var PE_P2 = ganita_mat_pseudo_inv(t_m2(0x0170000000000000, 0, 0, 0x0000400000000000));
assert_eq(ganita_mat_get(PE_P2, 0, 0), 0x7E70000000000000, "pseudo_inv(diag(2^-1000, 2^-1030))[0][0] = 2^1000 (was NaN)");
assert_eq(ganita_mat_get(PE_P2, 1, 0), 0, "pseudo_inv(diag(2^-1000, 2^-1030))[1][0] = 0 (was NaN)");
assert_eq(ganita_mat_get(PE_P2, 1, 1), 0x7FF0000000000000, "pseudo_inv(diag(2^-1000, 2^-1030))[1][1] = +inf, 2^1030 overflows");
var PE_H = t_m2(PE_DM, PE_DM, PE_DM, PE_DM ^ 0x8000000000000000);
var PE_P3 = ganita_mat_pseudo_inv(PE_H);
assert_eq(ganita_mat_get(PE_P3, 0, 0), 0x0002000000000000, "pseudo_inv(DBL_MAX·[[1, 1], [1, -1]])[0][0] = 1/(2·DBL_MAX) (was 0)");
assert_eq(ganita_mat_get(PE_P3, 0, 1), 0x0002000000000000, "pseudo_inv(DBL_MAX·[[1, 1], [1, -1]])[0][1] = 1/(2·DBL_MAX)");
assert_eq(ganita_mat_get(PE_P3, 1, 0), 0x0002000000000000, "pseudo_inv(DBL_MAX·[[1, 1], [1, -1]])[1][0] = 1/(2·DBL_MAX)");
assert_eq(ganita_mat_get(PE_P3, 1, 1), 0x8002000000000000, "pseudo_inv(DBL_MAX·[[1, 1], [1, -1]])[1][1] = -1/(2·DBL_MAX)");
assert_eq(ganita_mat_condition(PE_H), 0x3FF0000000000000, "condition(DBL_MAX·[[1, 1], [1, -1]]) = 1 (was -1.0)");
# Exact 6.3423292192132454 (0x40195E8B8D03F1C5); within 4 ulps.
var PE_C = ganita_mat_condition(t_m2(PE_DM, PE_DM, PE_DM, 0x7FDFFFFFFFFFFFFF));
assert_eq(PE_C >= 0x40195E8B8D03F1C1 && PE_C <= 0x40195E8B8D03F1C9, 1,
  "condition(DBL_MAX·[[1, 1], [1, 1/2]]) = 6.3423292192132454 to 4 ulps (was -1.0)");
assert_eq(ganita_mat_rank(t_m2(0x0000000000004000, 0, 0, 0x0000000000004000), 0), 2,
  "rank(diag(2^-1060, 2^-1060), 0) = 2: the values-only SVD path is unchanged");

var r = assert_summary();
