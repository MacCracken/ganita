# --- matrix.cyr ---

# matrix.cyr — dense matrix operations for f64 values
# Usage: include "lib/matrix.cyr"
# Requires: alloc.cyr, fmt.cyr, string.cyr
#
# Row-major dense matrix backed by a single heap allocation.
# All values are f64 bit patterns stored as i64.
# Layout: { rows: i64, cols: i64, data: f64[rows*cols] }
# Total: 16 + rows * cols * 8 bytes

# Maximum element count (rows*cols) for a dense matrix. The backing store is
# `16 + rows*cols*8` bytes, and stdlib `alloc` rejects any single request over
# ALLOC_MAX, so the largest allocatable matrix holds (ALLOC_MAX - 16) / 8
# elements. Capping rows*cols at this value (checked via a division that can't
# itself overflow) guarantees the size expression never wraps i64 — the CWE-190
# that a wrapped, undersized `alloc` followed by a full-length `rows*cols`
# zero-fill would turn into a heap overflow.
#
# ⚠ THIS IS NO LONGER (ALLOC_MAX - 16) / 8, AND THAT IS DELIBERATE AS OF 1.2.3.
# The value 33,554,430 was derived from ALLOC_MAX = 0x10000000 (256 MiB). cyrius
# v6.4.51 raised ALLOC_MAX to 0x80000000 (2 GiB); this constant did not follow,
# and until 1.2.3 the comment here still claimed it was "kept in step", which was
# simply false. The drift had a consequence: it is why ganita_mat_least_squares'
# internal m x m Q hit the cap at m = 5793 rather than m = 16383 — the SIGSEGV
# 1.2.2 fixed.
#
# The cap was NOT raised to the re-derived 268,435,454, because that is a
# capability change wearing a hardening change's clothes:
#   - one such matrix is 2 GiB, i.e. the ENTIRE ALLOC_MAX, so allocating it
#     succeeds only by leaving nothing for the working factors every
#     decomposition here needs;
#   - ganita_mat_eigen_sym is O(n^4) per sweep, so matrices within an order of
#     magnitude of the cap are already computationally out of reach;
#   - and it silently multiplies by 8 the memory a single call can demand of
#     every existing consumer.
# The number below is a deliberate policy limit, not a derivation. Raising it is
# tracked separately — see docs/audit/2026-09-07-v1.2.3-audit.md.
var GANITA_MAT_MAX_ELEMS = 33554430;

# Create a zero-filled rows x cols matrix. Returns 0 (null) for non-positive
# dimensions, for an element count too large to allocate (overflow-safe), or on
# allocation failure — a caller sizing a matrix from untrusted input MUST check
# the result for null before use.
fn ganita_mat_new(rows, cols): i64 {
    if (rows <= 0 || cols <= 0) { return 0; }
    if (rows > GANITA_MAT_MAX_ELEMS / cols) { return 0; }
    var sz = 16 + rows * cols * 8;
    var m = alloc(sz);
    if (m == 0) { return 0; }
    store64(m, rows);
    store64(m + 8, cols);
    var i = 0;
    while (i < rows * cols) {
        store64(m + 16 + i * 8, 0);
        i = i + 1;
    }
    return m;
}

# Get number of rows
fn ganita_mat_rows(m): i64 { return load64(m); }
# Get number of columns
fn ganita_mat_cols(m): i64 { return load64(m + 8); }

# Get element at (row, col) — returns f64 bit pattern.
#
# ⚠ UNCHECKED BY DESIGN, and the only function pair here that is. This computes
# `m + 16 + (r*cols + c)*8` and dereferences it with no bounds test, because it
# sits inside every inner loop in linalg.cyr and a per-element branch there is
# measurable where a per-call one is not. Two consequences a caller owns:
# an out-of-range (r, c) is an out-of-bounds read (CWE-125), and for very large
# r the product `r * cols + c` can itself wrap i64 (CWE-190) and land anywhere.
# Validate `0 <= r < rows` and `0 <= c < cols` yourself before indexing from
# untrusted input. See SECURITY.md.
fn ganita_mat_get(m, r, c): i64 {
    var cols = load64(m + 8);
    return load64(m + 16 + (r * cols + c) * 8);
}

# Set element at (row, col) — value is f64 bit pattern.
# ⚠ UNCHECKED BY DESIGN — see ganita_mat_get above. Out of range is an
# out-of-bounds WRITE (CWE-787), which is strictly worse than the read.
fn ganita_mat_set(m, r, c, val): i64 {
    var cols = load64(m + 8);
    store64(m + 16 + (r * cols + c) * 8, val);
    return 0;
}

# Create an identity matrix (N x N). Propagates null from ganita_mat_new for
# non-positive / overflow-prone n (CWE-190 guard).
fn ganita_mat_identity(n): i64 {
    var m = ganita_mat_new(n, n);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < n) {
        ganita_mat_set(m, i, i, f64_from(1));
        i = i + 1;
    }
    return m;
}

# Create a matrix from a flat array of f64 values. Propagates null from
# ganita_mat_new for non-positive / overflow-prone dims (CWE-190 guard).
fn ganita_mat_from(rows, cols, data): i64 {
    var m = ganita_mat_new(rows, cols);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < rows * cols) {
        store64(m + 16 + i * 8, load64(data + i * 8));
        i = i + 1;
    }
    return m;
}

# Matrix addition: C = A + B (returns new matrix).
# Returns 0 for a null operand, for a SHAPE MISMATCH, or if the result cannot be
# allocated. Through 1.2.2 the shape came from A alone and B was never inspected,
# so a mismatched B was read for rows(a)*cols(a) words regardless of its real
# size — a well-formed, correctly-shaped result full of a neighbouring object's
# bytes reinterpreted as f64, or a SIGSEGV at scale.
fn ganita_mat_add(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    if ((ganita_mat_rows(b) != rows) || (ganita_mat_cols(b) != cols)) { return 0; }
    var c = ganita_mat_new(rows, cols);
    if (c == 0) { return 0; }
    var i = 0;
    while (i < rows * cols) {
        var va = load64(a + 16 + i * 8);
        var vb = load64(b + 16 + i * 8);
        store64(c + 16 + i * 8, f64_add(va, vb));
        i = i + 1;
    }
    return c;
}

# Matrix subtraction: C = A - B (returns new matrix).
# Returns 0 for a null operand, for a shape mismatch, or on allocation failure.
# Same out-of-bounds read as ganita_mat_add through 1.2.2.
fn ganita_mat_sub(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    if ((ganita_mat_rows(b) != rows) || (ganita_mat_cols(b) != cols)) { return 0; }
    var c = ganita_mat_new(rows, cols);
    if (c == 0) { return 0; }
    var i = 0;
    while (i < rows * cols) {
        var va = load64(a + 16 + i * 8);
        var vb = load64(b + 16 + i * 8);
        store64(c + 16 + i * 8, f64_sub(va, vb));
        i = i + 1;
    }
    return c;
}

# Scalar multiply: C = A * scalar (returns new matrix, or 0 if the result cannot
# be allocated — propagates ganita_mat_new's null).
fn ganita_mat_scale(a, scalar): i64 {
    if (a == 0) { return 0; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    var c = ganita_mat_new(rows, cols);
    if (c == 0) { return 0; }
    var i = 0;
    while (i < rows * cols) {
        store64(c + 16 + i * 8, f64_mul(load64(a + 16 + i * 8), scalar));
        i = i + 1;
    }
    return c;
}

# Matrix multiply: C = A * B (returns new matrix, A is m×k, B is k×n → C is m×n).
#
# Returns 0 for a null operand, when rows(B) != cols(A), or when C cannot be
# allocated — note m×n can exceed the cap even when both operands are well
# inside it: an N×1 times a 1×N is 2N elements of input for an N² result.
#
# The inner-dimension gate is new at 1.2.3. Through 1.2.2 the inner dimension k
# came from cols(A) alone and rows(B) was never read, so the accumulation loop
# walked B for k steps whatever B's real height was: silently folding a
# neighbouring allocation into every element at small sizes, and SIGSEGV at
# large ones. The check is one load and one compare per CALL, outside the
# O(m*n*k) triple loop — it does not belong inside ganita_mat_get, which this
# loop invokes twice per multiply-accumulate.
fn ganita_mat_mul(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var m = ganita_mat_rows(a);
    var k = ganita_mat_cols(a);
    if (ganita_mat_rows(b) != k) { return 0; }
    var n = ganita_mat_cols(b);
    var c = ganita_mat_new(m, n);
    if (c == 0) { return 0; }
    var i = 0;
    while (i < m) {
        var j = 0;
        while (j < n) {
            var sum = f64_from(0);
            var p = 0;
            while (p < k) {
                sum = f64_add(sum, f64_mul(ganita_mat_get(a, i, p), ganita_mat_get(b, p, j)));
                p = p + 1;
            }
            ganita_mat_set(c, i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }
    return c;
}

# Transpose: returns new matrix, or 0 if it cannot be allocated (propagates
# ganita_mat_new's null).
fn ganita_mat_transpose(a): i64 {
    if (a == 0) { return 0; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    var t = ganita_mat_new(cols, rows);
    if (t == 0) { return 0; }
    var i = 0;
    while (i < rows) {
        var j = 0;
        while (j < cols) {
            ganita_mat_set(t, j, i, ganita_mat_get(a, i, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return t;
}

# Dot product of two FLAT f64 arrays of length n — the form ganita_mat_row and
# ganita_mat_col return.
#
# ⚠ NOT for matrices. Through 1.2.2 this doc said "Nx1 matrices or flat arrays",
# but the body reads `load64(a + i*8)` from the pointer directly: handed an Nx1
# matrix it reads the 16-byte {rows, cols} header as the first two elements and
# every value shifted by two slots, returning a plausible wrong answer with no
# diagnostic. Pass `m + 16` if you have a matrix, or use ganita_mat_col.
fn ganita_mat_dot(a, b, n): i64 {
    var sum = f64_from(0);
    var i = 0;
    while (i < n) {
        sum = f64_add(sum, f64_mul(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return sum;
}

# Print matrix to stdout
fn ganita_mat_print(m): i64 {
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    var i = 0;
    while (i < rows) {
        syscall(1, 1, "[ ", 2);
        var j = 0;
        while (j < cols) {
            var v = ganita_mat_get(m, i, j);
            fmt_int(f64_to(f64_mul(v, f64_from(100))));
            syscall(1, 1, "/100 ", 5);
            j = j + 1;
        }
        syscall(1, 1, "]\n", 2);
        i = i + 1;
    }
    return 0;
}

# --- linalg.cyr ---

# linalg.cyr — dense linear algebra on f64 matrices
# Usage: include "lib/linalg.cyr"
# Requires: alloc.cyr, math.cyr, matrix.cyr
#
# Builds on matrix.cyr's storage layer (row-major, f64 as i64 bit patterns).
# All decompositions use out-params (Cyrius has no tuples):
#   ganita_mat_lu(m, out_lu, out_piv)  not  (lu, piv) = ganita_mat_lu(m)
#
# Pivoting: partial pivoting only. Complete pivoting is deliberately excluded
# (O(n^3) column search per step, no benefit for hisab's use cases).
#
# ganita_mat_det and ganita_mat_inv are convenience wrappers around ganita_mat_lu — they are
# not independent implementations.

# FAILURE VOCABULARY (settled at 1.2.3 — see docs/adr/0001-failure-vocabulary.md).
# Every function reports failure in the shape of its own return value:
#
#   returns a matrix or array  ->  0 (null)
#   returns a status           ->  NEGATIVE, and never a positive code:
#                                    -1  allocation failure
#                                    -2  contract violation (shape, dimension,
#                                        index, or a documented precondition)
#                                    -3  algorithmic non-convergence
#
# ONE EXCEPTION: ganita_mat_lu's successful returns are the permutation sign
# +1 and -1, so it cannot spend a negative on an error. It folds a contract
# violation into its existing 0 ("cannot decompose"), which is what a caller
# already tests for.
#   returns an f64             ->  NaN, because 0.0 and -1.0 are real answers
#                                  about the matrix in det and condition
#
# A caller that only wants "did it work" can test `< 0` on every status fn.

# Default tolerance for floating-point comparisons
var LINALG_EPS = 0;

# True when an f64 bit pattern is a NaN — max exponent, non-zero mantissa.
# Needed because every f64 comparison is FALSE against a NaN, so a loop shaped
# `if (bad) return 0;` falls through and reports success. That is not a
# hypothetical: it is exactly how ganita_mat_eq reported an all-NaN matrix as
# equal to the identity through 1.2.2.
fn _linalg_is_nan(b): i64 {
    if (((b >> 52) & 0x7FF) != 0x7FF) { return 0; }
    if ((b & 0x000FFFFFFFFFFFFF) == 0) { return 0; }
    return 1;
}

fn _linalg_init_eps(): i64 {
    if (LINALG_EPS == 0) {
        # 1e-12 as f64 bit pattern
        LINALG_EPS = f64_div(f64_from(1), f64_from(1000000000000));
    }
    return 0;
}

# ================================================================
# Tier 3 — Matrix utilities (additions to matrix.cyr's feature set)
# ================================================================

# Deep copy of a matrix. Returns 0 if the copy cannot be allocated (propagates
# ganita_mat_new's null).
fn ganita_mat_copy(m): i64 {
    if (m == 0) { return 0; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    var c = ganita_mat_new(rows, cols);
    if (c == 0) { return 0; }
    var i = 0;
    var n = rows * cols;
    while (i < n) {
        store64(c + 16 + i * 8, load64(m + 16 + i * 8));
        i = i + 1;
    }
    return c;
}

# Negate all elements. Returns 0 if the result cannot be allocated (propagates
# ganita_mat_new's null).
fn ganita_mat_neg(m): i64 {
    if (m == 0) { return 0; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    var c = ganita_mat_new(rows, cols);
    if (c == 0) { return 0; }
    var i = 0;
    var n = rows * cols;
    while (i < n) {
        store64(c + 16 + i * 8, f64_neg(load64(m + 16 + i * 8)));
        i = i + 1;
    }
    return c;
}

# Extract row r as a flat f64 array (heap-allocated, cols entries).
# Returns 0 for a null matrix, for r outside [0, rows), or on allocation failure.
fn ganita_mat_row(m, r): i64 {
    if (m == 0) { return 0; }
    if (r < 0 || r >= ganita_mat_rows(m)) { return 0; }
    var cols = ganita_mat_cols(m);
    var out = alloc(cols * 8);
    if (out == 0) { return 0; }
    var j = 0;
    while (j < cols) {
        store64(out + j * 8, ganita_mat_get(m, r, j));
        j = j + 1;
    }
    return out;
}

# Extract column c as a flat f64 array (heap-allocated, rows entries).
# Returns 0 for a null matrix, for c outside [0, cols), or on allocation failure.
fn ganita_mat_col(m, c): i64 {
    if (m == 0) { return 0; }
    if (c < 0 || c >= ganita_mat_cols(m)) { return 0; }
    var rows = ganita_mat_rows(m);
    var out = alloc(rows * 8);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < rows) {
        store64(out + i * 8, ganita_mat_get(m, i, c));
        i = i + 1;
    }
    return out;
}

# Overwrite row r from a flat f64 array of `cols` entries.
# Returns 0 on success, -2 for a null matrix or r outside [0, rows).
#
# The index gate is new at 1.2.3. This function WRITES, so an out-of-range r was
# an out-of-bounds write (CWE-787), not merely a read: r == rows lands on
# whatever the bump allocator handed out next — typically the {rows, cols}
# header of the next matrix, which then reports fabricated dimensions — and a
# negative r walks backwards into the target matrix's own header.
fn ganita_mat_set_row(m, r, data): i64 {
    if (m == 0) { return 0 - 2; }
    if (r < 0 || r >= ganita_mat_rows(m)) { return 0 - 2; }
    var cols = ganita_mat_cols(m);
    var j = 0;
    while (j < cols) {
        ganita_mat_set(m, r, j, load64(data + j * 8));
        j = j + 1;
    }
    return 0;
}

# Overwrite column c from a flat f64 array of `rows` entries.
# Returns 0 on success, -2 for a null matrix or c outside [0, cols).
# Same out-of-bounds write as ganita_mat_set_row through 1.2.2.
fn ganita_mat_set_col(m, c, data): i64 {
    if (m == 0) { return 0 - 2; }
    if (c < 0 || c >= ganita_mat_cols(m)) { return 0 - 2; }
    var rows = ganita_mat_rows(m);
    var i = 0;
    while (i < rows) {
        ganita_mat_set(m, i, c, load64(data + i * 8));
        i = i + 1;
    }
    return 0;
}

# Extract submatrix [r0..r1, c0..c1) as a new matrix — half-open on both axes.
# Returns 0 for a null matrix, for an empty or inverted range, for a window that
# is not wholly inside the source, or on allocation failure.
#
# The window gate is new at 1.2.3. Through 1.2.2 only the SIGN of the extent was
# checked — implicitly, by ganita_mat_new rejecting a non-positive dimension —
# and never the range against the source. A window past the end copied whatever
# the allocator had placed after the matrix into a perfectly well-formed result;
# a negative origin read backwards and faulted at scale.
fn ganita_mat_submatrix(m, r0, c0, r1, c1): i64 {
    if (m == 0) { return 0; }
    if (r0 < 0 || c0 < 0) { return 0; }
    if (r1 > ganita_mat_rows(m) || c1 > ganita_mat_cols(m)) { return 0; }
    var nr = r1 - r0;
    var nc = c1 - c0;
    var s = ganita_mat_new(nr, nc);
    if (s == 0) { return 0; }
    var i = 0;
    while (i < nr) {
        var j = 0;
        while (j < nc) {
            ganita_mat_set(s, i, j, ganita_mat_get(m, r0 + i, c0 + j));
            j = j + 1;
        }
        i = i + 1;
    }
    return s;
}

# Frobenius norm: sqrt(sum of squares of all elements)
fn ganita_mat_frobenius(m): i64 {
    var n = ganita_mat_rows(m) * ganita_mat_cols(m);
    var sum = f64_from(0);
    var i = 0;
    while (i < n) {
        var v = load64(m + 16 + i * 8);
        sum = f64_add(sum, f64_mul(v, v));
        i = i + 1;
    }
    return f64_sqrt(sum);
}

# Infinity norm: max absolute row sum
fn ganita_mat_max_norm(m): i64 {
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    var mx = f64_from(0);
    var i = 0;
    while (i < rows) {
        var rsum = f64_from(0);
        var j = 0;
        while (j < cols) {
            rsum = f64_add(rsum, f64_abs(ganita_mat_get(m, i, j)));
            j = j + 1;
        }
        if (f64_gt(rsum, mx) == 1) { mx = rsum; }
        i = i + 1;
    }
    return mx;
}

# Check symmetry within tolerance. Returns 1 if symmetric, 0 otherwise —
# including for a null or non-square matrix, and for one containing ANY NaN.
# See ganita_mat_eq below for why the NaN case needs saying.
fn ganita_mat_is_symmetric(m, tol): i64 {
    if (m == 0) { return 0; }
    var n = ganita_mat_rows(m);
    if (n != ganita_mat_cols(m)) { return 0; }
    var i = 0;
    while (i < n) {
        var j = i + 1;
        while (j < n) {
            var above = ganita_mat_get(m, i, j);
            var below = ganita_mat_get(m, j, i);
            if (_linalg_is_nan(above) == 1 || _linalg_is_nan(below) == 1) { return 0; }
            var diff = f64_abs(f64_sub(above, below));
            if (f64_gt(diff, tol) == 1) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Element-wise equality within tolerance. Returns 1 if equal, 0 otherwise —
# including for a null operand, a shape mismatch, or ANY NaN on either side.
#
# ⚠ PASS AN EXPLICIT TOLERANCE. The old doc said "use LINALG_EPS as default",
# but LINALG_EPS is lazily initialised by _linalg_init_eps and reads 0 until
# some decomposition has run, so the identical call answered differently
# depending on what the program did before it. Pass the tolerance you mean.
#
# ⚠ NaN NOW FAILS CLOSED. Every f64 comparison is false against a NaN, so the
# `if (diff > tol) return 0;` shape below simply never fired and the loop fell
# through to `return 1`: through 1.2.2 an all-NaN matrix compared EQUAL to the
# identity. That is worse than an ordinary wrong answer, because this function
# is the comparison tool the test suite uses to check the decompositions — a
# solver that returned NaN would have been certified correct by its own suite.
fn ganita_mat_eq(a, b, tol): i64 {
    if (a == 0 || b == 0) { return 0; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    if (rows != ganita_mat_rows(b)) { return 0; }
    if (cols != ganita_mat_cols(b)) { return 0; }
    var n = rows * cols;
    var i = 0;
    while (i < n) {
        var va = load64(a + 16 + i * 8);
        var vb = load64(b + 16 + i * 8);
        if (_linalg_is_nan(va) == 1 || _linalg_is_nan(vb) == 1) { return 0; }
        var diff = f64_abs(f64_sub(va, vb));
        if (f64_gt(diff, tol) == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Trace: sum of diagonal elements. SQUARE INPUT ONLY — returns NaN otherwise.
#
# The precondition is new at 1.2.3, and it was not academic: n came from the ROW
# count alone, so a tall matrix walked ganita_mat_get(m, i, i) for i up to
# rows-1 while the store only holds rows*cols elements. A 100000x1 read ~800 MB
# past its own allocation.
fn ganita_mat_trace(m): i64 {
    if (m == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var n = ganita_mat_rows(m);
    if (n != ganita_mat_cols(m)) { return f64_div(f64_from(0), f64_from(0)); }
    var sum = f64_from(0);
    var i = 0;
    while (i < n) {
        sum = f64_add(sum, ganita_mat_get(m, i, i));
        i = i + 1;
    }
    return sum;
}

# ================================================================
# Tier 1 — Linear solvers
# ================================================================

# LU decomposition with partial pivoting.
# out_lu: n×n matrix (caller allocates via ganita_mat_new). Receives packed L\U.
# out_piv: flat i64 array of length n (caller allocates via alloc(n*8)).
# Returns pivot sign (+1 or -1) for determinant, or 0 on a singular matrix.
# SQUARE INPUT ONLY — a non-square (or null) input also returns 0, because the
# success values +1/-1 leave no room for a distinct error code and 0 already
# means "cannot decompose".
#
# The square gate is new at 1.2.3. n came from the ROW count alone, so a tall
# input drove an n*n copy loop over a store holding only rows*cols elements —
# an out-of-bounds read of the caller's matrix that then propagated into
# ganita_mat_det and ganita_mat_inv, which are wrappers around this.
#
# L is unit lower triangular (1s on diagonal, stored below diagonal).
# U is upper triangular (stored on and above diagonal).
fn ganita_mat_lu(m, out_lu, out_piv): i64 {
    if (m == 0 || out_lu == 0 || out_piv == 0) { return 0; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0; }
    var n = ganita_mat_rows(m);
    # Copy m into out_lu
    var i = 0;
    var total = n * n;
    while (i < total) {
        store64(out_lu + 16 + i * 8, load64(m + 16 + i * 8));
        i = i + 1;
    }
    # Initialize pivot vector to identity permutation
    i = 0;
    while (i < n) { store64(out_piv + i * 8, i); i = i + 1; }

    var sign = 1;
    var k = 0;
    while (k < n) {
        # Find pivot: row with largest |a[i][k]| for i >= k
        var max_val = f64_from(0);
        var max_row = k;
        i = k;
        while (i < n) {
            var av = f64_abs(ganita_mat_get(out_lu, i, k));
            if (f64_gt(av, max_val) == 1) {
                max_val = av;
                max_row = i;
            }
            i = i + 1;
        }

        _linalg_init_eps();
        if (f64_lt(max_val, LINALG_EPS) == 1) {
            return 0;  # Singular
        }

        # Swap rows k and max_row
        if (max_row != k) {
            var j = 0;
            while (j < n) {
                var tmp = ganita_mat_get(out_lu, k, j);
                ganita_mat_set(out_lu, k, j, ganita_mat_get(out_lu, max_row, j));
                ganita_mat_set(out_lu, max_row, j, tmp);
                j = j + 1;
            }
            var ptmp = load64(out_piv + k * 8);
            store64(out_piv + k * 8, load64(out_piv + max_row * 8));
            store64(out_piv + max_row * 8, ptmp);
            sign = 0 - sign;
        }

        # Eliminate below pivot
        var akk = ganita_mat_get(out_lu, k, k);
        i = k + 1;
        while (i < n) {
            var factor = f64_div(ganita_mat_get(out_lu, i, k), akk);
            ganita_mat_set(out_lu, i, k, factor);  # Store L factor
            var j = k + 1;
            while (j < n) {
                var val = f64_sub(ganita_mat_get(out_lu, i, j),
                  f64_mul(factor, ganita_mat_get(out_lu, k, j)));
                ganita_mat_set(out_lu, i, j, val);
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    return sign;
}

# Solve Ax=b from LU factors (from ganita_mat_lu).
# lu: packed L\U matrix. piv: pivot vector. b: flat f64 array of length n.
# out_x: flat f64 array of length n (caller allocates). Receives solution.
# Returns 0 on success, -1 if the forward-substitution scratch cannot be allocated.
fn ganita_mat_lu_solve(lu, piv, b, out_x): i64 {
    if (lu == 0 || piv == 0 || b == 0 || out_x == 0) { return 0 - 2; }
    var n = ganita_mat_rows(lu);

    # Forward substitution: Ly = Pb
    var y = alloc(n * 8);
    if (y == 0) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        var pi = load64(piv + i * 8);
        var sum = load64(b + pi * 8);
        var j = 0;
        while (j < i) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(lu, i, j), load64(y + j * 8)));
            j = j + 1;
        }
        store64(y + i * 8, sum);
        i = i + 1;
    }

    # Back substitution: Ux = y
    i = n - 1;
    while (i >= 0) {
        var sum = load64(y + i * 8);
        var j = i + 1;
        while (j < n) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(lu, i, j), load64(out_x + j * 8)));
            j = j + 1;
        }
        store64(out_x + i * 8, f64_div(sum, ganita_mat_get(lu, i, i)));
        i = i - 1;
    }
    return 0;
}

# Determinant via LU. Convenience wrapper around ganita_mat_lu.
# SQUARE INPUT ONLY. Returns 0.0 for a singular matrix, and NaN for a null or
# non-square input or if the n×n working factor cannot be allocated — NOT 0.0,
# which would report a perfectly invertible matrix as singular.
fn ganita_mat_det(m): i64 {
    if (m == 0) { return f64_div(f64_from(0), f64_from(0)); }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return f64_div(f64_from(0), f64_from(0)); }
    var n = ganita_mat_rows(m);
    var lu = ganita_mat_new(n, n);
    if (lu == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var piv = alloc(n * 8);
    if (piv == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var sign = ganita_mat_lu(m, lu, piv);
    if (sign == 0) { return f64_from(0); }
    var det = f64_from(sign);
    var i = 0;
    while (i < n) {
        det = f64_mul(det, ganita_mat_get(lu, i, i));
        i = i + 1;
    }
    return det;
}

# Inverse via LU. Convenience wrapper — solves LU against identity columns.
# SQUARE INPUT ONLY. Returns a new n×n matrix, or 0 if the input is null or
# non-square, if it is singular, or if any working allocation fails.
fn ganita_mat_inv(m): i64 {
    if (m == 0) { return 0; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0; }
    var n = ganita_mat_rows(m);
    var lu = ganita_mat_new(n, n);
    if (lu == 0) { return 0; }
    var piv = alloc(n * 8);
    if (piv == 0) { return 0; }
    var sign = ganita_mat_lu(m, lu, piv);
    if (sign == 0) { return 0; }

    var inv = ganita_mat_new(n, n);
    if (inv == 0) { return 0; }
    var col = alloc(n * 8);
    if (col == 0) { return 0; }
    var x = alloc(n * 8);
    if (x == 0) { return 0; }
    var k = 0;
    while (k < n) {
        # Build identity column k
        var i = 0;
        while (i < n) { store64(col + i * 8, f64_from(0)); i = i + 1; }
        store64(col + k * 8, f64_from(1));

        ganita_mat_lu_solve(lu, piv, col, x);

        # Copy solution into column k of inv
        i = 0;
        while (i < n) {
            ganita_mat_set(inv, i, k, load64(x + i * 8));
            i = i + 1;
        }
        k = k + 1;
    }
    return inv;
}

# Cholesky factorization for symmetric positive-definite matrices.
# out_l: n×n matrix (caller allocates). Receives lower triangular L where A = LL^T.
# Returns 1 on success, 0 if the input is null, non-square, or NOT
# POSITIVE-DEFINITE. This return is the cheapest positive-definiteness test in
# the library, so it has to be exact about what "definite" means.
#
# ⚠ SEMI-DEFINITE IS NOT DEFINITE, and through 1.2.2 this said otherwise. The
# pivot guard was `diag < 0`, strictly less than, so a pivot of exactly zero
# passed, f64_sqrt(0) went onto L's diagonal, and every later off-diagonal
# divided by it. [1 2; 2 4] — symmetric, det 0, eigenvalues 0 and 5 — returned
# 1, produced L = [1 0; 2 0], and ganita_mat_cholesky_solve then returned 0
# (success) having written NaN into every slot of the solution. A caller doing
# exactly the documented thing got success, success, NaN.
#
# Only the reads BELOW and ON the diagonal are consulted, so a non-symmetric
# input is accepted and factorised as if it were its own lower triangle mirrored.
# Call ganita_mat_is_symmetric first if the input is not known to be symmetric.
fn ganita_mat_cholesky(m, out_l): i64 {
    if (m == 0 || out_l == 0) { return 0; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0; }
    var n = ganita_mat_rows(m);
    # Zero out_l
    var i = 0;
    var total = n * n;
    while (i < total) { store64(out_l + 16 + i * 8, f64_from(0)); i = i + 1; }

    i = 0;
    while (i < n) {
        var j = 0;
        while (j <= i) {
            var sum = f64_from(0);
            var k = 0;
            while (k < j) {
                sum = f64_add(sum, f64_mul(ganita_mat_get(out_l, i, k), ganita_mat_get(out_l, j, k)));
                k = k + 1;
            }
            if (i == j) {
                var diag = f64_sub(ganita_mat_get(m, i, i), sum);
                # `<= 0`, not `< 0`: a zero pivot means semi-definite, which is
                # not definite, and letting it through puts a 0 on L's diagonal
                # for every later division to produce NaN through. NaN itself
                # fails every comparison, so it is rejected explicitly.
                if (_linalg_is_nan(diag) == 1) { return 0; }
                if (f64_le(diag, f64_from(0)) == 1) { return 0; }
                ganita_mat_set(out_l, i, j, f64_sqrt(diag));
            } else {
                var lij = f64_div(f64_sub(ganita_mat_get(m, i, j), sum), ganita_mat_get(out_l, j, j));
                ganita_mat_set(out_l, i, j, lij);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# Solve Ax=b from Cholesky factor L (where A = LL^T).
# l: lower triangular. b: flat f64 array. out_x: flat f64 array.
# Returns 0 on success, -1 if the forward-substitution scratch cannot be allocated.
fn ganita_mat_cholesky_solve(l, b, out_x): i64 {
    if (l == 0 || b == 0 || out_x == 0) { return 0 - 2; }
    var n = ganita_mat_rows(l);

    # Forward: Ly = b
    var y = alloc(n * 8);
    if (y == 0) { return 0 - 1; }
    # Defence in depth: every step below divides by L[i][i]. A factor that came
    # from a successful ganita_mat_cholesky cannot have a zero there as of 1.2.3,
    # but this function takes L from the CALLER and cannot know where it came
    # from — and a zero would quietly produce a solution of NaN while returning
    # success, which is exactly the failure the cholesky fix closed upstream.
    var d = 0;
    while (d < n) {
        if (ganita_mat_get(l, d, d) & 0x7FFFFFFFFFFFFFFF == 0) { return 0 - 2; }
        d = d + 1;
    }
    var i = 0;
    while (i < n) {
        var sum = load64(b + i * 8);
        var j = 0;
        while (j < i) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(l, i, j), load64(y + j * 8)));
            j = j + 1;
        }
        store64(y + i * 8, f64_div(sum, ganita_mat_get(l, i, i)));
        i = i + 1;
    }

    # Backward: L^T x = y
    i = n - 1;
    while (i >= 0) {
        var sum = load64(y + i * 8);
        var j = i + 1;
        while (j < n) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(l, j, i), load64(out_x + j * 8)));
            j = j + 1;
        }
        store64(out_x + i * 8, f64_div(sum, ganita_mat_get(l, i, i)));
        i = i - 1;
    }
    return 0;
}

# QR decomposition via Householder reflections.
# out_q: m×m matrix (caller allocates). Receives orthogonal Q.
# out_r: m×n matrix (caller allocates). Receives upper triangular R.
# Returns 0 on success, -1 if a working allocation fails, -2 if any argument is
# null or an out-param is not the documented shape.
#
# ⚠ The m×m out_q is this function's CONTRACT, and it bounds m at
# sqrt(GANITA_MAT_MAX_ELEMS) ≈ 5792 for any caller that wants an explicit Q.
# If you only need to SOLVE, ganita_mat_least_squares no longer comes through
# here — it applies the reflectors to b directly and is O(m·n).
fn ganita_mat_qr(m, out_q, out_r): i64 {
    if (m == 0 || out_q == 0 || out_r == 0) { return 0 - 2; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    if (ganita_mat_rows(out_q) != rows || ganita_mat_cols(out_q) != rows) { return 0 - 2; }
    if (ganita_mat_rows(out_r) != rows || ganita_mat_cols(out_r) != cols) { return 0 - 2; }

    # Copy m into R
    var i = 0;
    while (i < rows * cols) {
        store64(out_r + 16 + i * 8, load64(m + 16 + i * 8));
        i = i + 1;
    }

    # Initialize Q to identity
    i = 0;
    var q_total = rows * rows;
    while (i < q_total) { store64(out_q + 16 + i * 8, f64_from(0)); i = i + 1; }
    i = 0;
    while (i < rows) { ganita_mat_set(out_q, i, i, f64_from(1)); i = i + 1; }

    var min = rows;
    if (cols < min) { min = cols; }

    var k = 0;
    while (k < min) {
        # Extract column k below diagonal
        var v = alloc((rows - k) * 8);
        if (v == 0) { return 0 - 1; }
        i = 0;
        while (i < rows - k) {
            store64(v + i * 8, ganita_mat_get(out_r, k + i, k));
            i = i + 1;
        }

        # Compute norm of v
        var norm = f64_from(0);
        i = 0;
        while (i < rows - k) {
            var vi = load64(v + i * 8);
            norm = f64_add(norm, f64_mul(vi, vi));
            i = i + 1;
        }
        norm = f64_sqrt(norm);

        _linalg_init_eps();
        if (f64_gt(norm, LINALG_EPS) == 1) {
            # Choose sign to avoid cancellation
            var v0 = load64(v);
            if (f64_gt(v0, f64_from(0)) == 1) {
                store64(v, f64_add(v0, norm));
            } else {
                store64(v, f64_sub(v0, norm));
            }

            # Normalize v
            var vnorm = f64_from(0);
            i = 0;
            while (i < rows - k) {
                var vi = load64(v + i * 8);
                vnorm = f64_add(vnorm, f64_mul(vi, vi));
                i = i + 1;
            }
            vnorm = f64_sqrt(vnorm);
            if (f64_gt(vnorm, LINALG_EPS) == 1) {
                i = 0;
                while (i < rows - k) {
                    store64(v + i * 8, f64_div(load64(v + i * 8), vnorm));
                    i = i + 1;
                }
            }

            # Apply H = I - 2vv^T to R (columns k..cols)
            var j = k;
            while (j < cols) {
                var dot = f64_from(0);
                i = 0;
                while (i < rows - k) {
                    dot = f64_add(dot, f64_mul(load64(v + i * 8), ganita_mat_get(out_r, k + i, j)));
                    i = i + 1;
                }
                dot = f64_mul(f64_from(2), dot);
                i = 0;
                while (i < rows - k) {
                    var rij = ganita_mat_get(out_r, k + i, j);
                    ganita_mat_set(out_r, k + i, j, f64_sub(rij, f64_mul(dot, load64(v + i * 8))));
                    i = i + 1;
                }
                j = j + 1;
            }

            # Apply H to Q (columns)
            j = 0;
            while (j < rows) {
                var dot = f64_from(0);
                i = 0;
                while (i < rows - k) {
                    dot = f64_add(dot, f64_mul(load64(v + i * 8), ganita_mat_get(out_q, k + i, j)));
                    i = i + 1;
                }
                dot = f64_mul(f64_from(2), dot);
                i = 0;
                while (i < rows - k) {
                    var qij = ganita_mat_get(out_q, k + i, j);
                    ganita_mat_set(out_q, k + i, j, f64_sub(qij, f64_mul(dot, load64(v + i * 8))));
                    i = i + 1;
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }

    # Q accumulated H_k...H_1 — transpose to get Q where A = QR
    var qt = ganita_mat_transpose(out_q);
    if (qt == 0) { return 0 - 1; }
    i = 0;
    while (i < q_total) {
        store64(out_q + 16 + i * 8, load64(qt + 16 + i * 8));
        i = i + 1;
    }
    return 0;
}

# Gaussian elimination on augmented matrix [A|b]. Solves in-place.
# aug: n×(n+1) augmented matrix. Solution written to last column.
# Returns 1 on success, 0 if the input is null, not n×(n+1), or singular.
#
# The shape gate is new at 1.2.3. The routine indexes column n on an n-row
# matrix, so an n×n argument — the shape a caller most plausibly reaches for by
# mistake, since every other solver here takes one — wrote one element PAST the
# backing store on each of n rows and still returned 1.
fn ganita_mat_gaussian_elim(aug): i64 {
    if (aug == 0) { return 0; }
    var n = ganita_mat_rows(aug);
    if (ganita_mat_cols(aug) != n + 1) { return 0; }
    _linalg_init_eps();

    var k = 0;
    while (k < n) {
        # Partial pivot
        var max_val = f64_from(0);
        var max_row = k;
        var i = k;
        while (i < n) {
            var av = f64_abs(ganita_mat_get(aug, i, k));
            if (f64_gt(av, max_val) == 1) {
                max_val = av;
                max_row = i;
            }
            i = i + 1;
        }
        if (f64_lt(max_val, LINALG_EPS) == 1) { return 0; }

        # Swap rows
        if (max_row != k) {
            var j = k;
            while (j <= n) {
                var tmp = ganita_mat_get(aug, k, j);
                ganita_mat_set(aug, k, j, ganita_mat_get(aug, max_row, j));
                ganita_mat_set(aug, max_row, j, tmp);
                j = j + 1;
            }
        }

        # Eliminate
        var akk = ganita_mat_get(aug, k, k);
        i = k + 1;
        while (i < n) {
            var factor = f64_div(ganita_mat_get(aug, i, k), akk);
            var j = k;
            while (j <= n) {
                ganita_mat_set(aug, i, j, f64_sub(ganita_mat_get(aug, i, j),
                    f64_mul(factor, ganita_mat_get(aug, k, j))));
                j = j + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }

    # Back substitution — write solution into last column
    var i = n - 1;
    while (i >= 0) {
        var sum = ganita_mat_get(aug, i, n);
        var j = i + 1;
        while (j < n) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(aug, i, j), ganita_mat_get(aug, j, n)));
            j = j + 1;
        }
        ganita_mat_set(aug, i, n, f64_div(sum, ganita_mat_get(aug, i, i)));
        i = i - 1;
    }
    return 1;
}

# Least-squares solve via Householder QR: minimize ||Ax - b||^2.
# a: m×n matrix (m >= n). b: flat f64 array of length m.
# out_x: flat f64 array of length n (caller allocates).
# Returns 0 on success, -1 if a working allocation fails, -2 if an argument is
# null or the system is UNDER-determined (m < n).
#
# ⚠ m >= n IS CHECKED AS OF 1.2.3. Back-substitution runs from row cols-1, so a
# wide design indexed qtb and R past their ends: the routine read far out of
# bounds and then returned 0 — success — with out_x full of NaN, or faulted
# outright at scale. An under-determined system has no unique least-squares
# solution and needs the minimum-norm one, which is ganita_mat_pseudo_inv.
#
# ⚠ NO Q IS EVER FORMED. Through 1.2.1 this called ganita_mat_qr, whose
# contract is an explicit m×m orthogonal Q — so a caller's perfectly ordinary
# m×n design matrix made this function ask for an m² one. A degree-2 fit over
# 5793 samples is a 5793×3 design (17,379 elements, 0.05% of
# GANITA_MAT_MAX_ELEMS) and ganita_mat_new accepts it without complaint, but the
# internal Q was 5793² = 33,558,849 elements, just over the cap. mat_new
# returned 0, nothing checked it, and ganita_mat_qr's Q-initialisation loop
# stored through the null: SIGSEGV from a public API on in-contract arguments,
# with an undocumented ceiling of m ≈ 5792 that came from a matrix the algorithm
# does not need. Filed by naad 2.1.3; see
# docs/development/issues/archived/2026-08-23-least-squares-unchecked-q-alloc.md.
#
# The reflectors are now applied to `b` in the same sweep that reduces A to R,
# which IS Q^T·b (R = H_{n-1}···H_0·A, so Q^T = H_{n-1}···H_0 and each H is its
# own inverse). Peak memory is O(m·n) instead of O(m²): an m×n working copy plus
# two length-m vectors. The 5793×3 case needs 231 KB where it used to need
# 268 MB, and a degree-2 fit over 100,000 samples — outright impossible before,
# at any cap — costs 4 MB.
#
# The upstream report proposed thin modified Gram-Schmidt (as ported by hisab
# 1.4.0). Householder-applied-to-b reaches the same O(m·n) bound, and is kept
# here instead because it is unconditionally stable where MGS is not, and
# because it is the SAME arithmetic 1.1.4 through 1.2.1 already shipped — only
# the accumulation of Q, and its transpose, are gone. Results are unchanged to
# well inside the suite's 1e-9 tolerance, and are strictly more accurate: the
# reflectors now reach b directly rather than through a materialised Q.
fn ganita_mat_least_squares(a, b, out_x): i64 {
    if (a == 0 || b == 0 || out_x == 0) { return 0 - 2; }
    var rows = ganita_mat_rows(a);
    var cols = ganita_mat_cols(a);
    if (rows < cols) { return 0 - 2; }
    _linalg_init_eps();

    # Working copy of A, reduced to R in place.
    var r = ganita_mat_copy(a);
    if (r == 0) { return 0 - 1; }
    # Q^T·b, accumulated reflector by reflector. Starts as a copy of b.
    var qtb = alloc(rows * 8);
    if (qtb == 0) { return 0 - 1; }
    # Reflector scratch, sized once for the longest column (k = 0).
    var v = alloc(rows * 8);
    if (v == 0) { return 0 - 1; }

    var i = 0;
    while (i < rows) {
        store64(qtb + i * 8, load64(b + i * 8));
        i = i + 1;
    }

    var k = 0;
    while (k < cols) {
        var len = rows - k;

        # Extract column k below the diagonal
        i = 0;
        while (i < len) {
            store64(v + i * 8, ganita_mat_get(r, k + i, k));
            i = i + 1;
        }

        # Compute norm of v
        var norm = f64_from(0);
        i = 0;
        while (i < len) {
            var vi = load64(v + i * 8);
            norm = f64_add(norm, f64_mul(vi, vi));
            i = i + 1;
        }
        norm = f64_sqrt(norm);

        if (f64_gt(norm, LINALG_EPS) == 1) {
            # Choose sign to avoid cancellation
            var v0 = load64(v);
            if (f64_gt(v0, f64_from(0)) == 1) {
                store64(v, f64_add(v0, norm));
            } else {
                store64(v, f64_sub(v0, norm));
            }

            # Normalize v
            var vnorm = f64_from(0);
            i = 0;
            while (i < len) {
                var vi = load64(v + i * 8);
                vnorm = f64_add(vnorm, f64_mul(vi, vi));
                i = i + 1;
            }
            vnorm = f64_sqrt(vnorm);
            if (f64_gt(vnorm, LINALG_EPS) == 1) {
                i = 0;
                while (i < len) {
                    store64(v + i * 8, f64_div(load64(v + i * 8), vnorm));
                    i = i + 1;
                }
            }

            # Apply H = I - 2vv^T to R (columns k..cols)
            var j = k;
            while (j < cols) {
                var dot = f64_from(0);
                i = 0;
                while (i < len) {
                    dot = f64_add(dot, f64_mul(load64(v + i * 8), ganita_mat_get(r, k + i, j)));
                    i = i + 1;
                }
                dot = f64_mul(f64_from(2), dot);
                i = 0;
                while (i < len) {
                    var rij = ganita_mat_get(r, k + i, j);
                    ganita_mat_set(r, k + i, j, f64_sub(rij, f64_mul(dot, load64(v + i * 8))));
                    i = i + 1;
                }
                j = j + 1;
            }

            # Apply the SAME H to b. Sweeping every reflector across b in the
            # order they hit A leaves Q^T·b behind, with no Q in between.
            var dotb = f64_from(0);
            i = 0;
            while (i < len) {
                dotb = f64_add(dotb, f64_mul(load64(v + i * 8), load64(qtb + (k + i) * 8)));
                i = i + 1;
            }
            dotb = f64_mul(f64_from(2), dotb);
            i = 0;
            while (i < len) {
                var bi = load64(qtb + (k + i) * 8);
                store64(qtb + (k + i) * 8, f64_sub(bi, f64_mul(dotb, load64(v + i * 8))));
                i = i + 1;
            }
        }
        k = k + 1;
    }

    # Back-substitution on upper n×n of R
    i = cols - 1;
    while (i >= 0) {
        var sum = load64(qtb + i * 8);
        var j = i + 1;
        while (j < cols) {
            sum = f64_sub(sum, f64_mul(ganita_mat_get(r, i, j), load64(out_x + j * 8)));
            j = j + 1;
        }
        store64(out_x + i * 8, f64_div(sum, ganita_mat_get(r, i, i)));
        i = i - 1;
    }
    return 0;
}

# ================================================================
# Tier 2 — Advanced decomposition
# ================================================================

# Column index of the largest |a[r][j]| over j > r — one row of the strict upper
# triangle. Returns r+1 for the last row, which has no off-diagonal entries and
# which ganita_mat_eigen_sym never reads. Ties go to the lowest j (strict >),
# matching the scan order the exhaustive search used, so the pivot SEQUENCE is
# unchanged and so are the results, bit for bit.
fn _linalg_row_max_col(a, n, r): i64 {
    var best = r + 1;
    if (best >= n) { return best; }
    var bv = f64_abs(ganita_mat_get(a, r, best));
    var j = r + 2;
    while (j < n) {
        var v = f64_abs(ganita_mat_get(a, r, j));
        if (f64_gt(v, bv) == 1) {
            bv = v;
            best = j;
        }
        j = j + 1;
    }
    return best;
}

# Eigendecomposition for real symmetric matrices via Jacobi rotation.
# out_vals: flat f64 array of length n (caller allocates via alloc(n*8)).
# out_vecs: n×n matrix (caller allocates via ganita_mat_new). Columns are eigenvectors.
# SYMMETRIC SQUARE INPUT ONLY. Returns the number of rotations applied, or a
# negative failure code: -1 allocation, -2 contract violation (null argument,
# non-square input, or out_vecs not n×n), -3 max iterations exceeded.
#
# ⚠ THE -1/-3 SPLIT CHANGED AT 1.2.3. Non-convergence used to be -1 and
# allocation failure -2 (added at 1.2.2); they now follow the module-wide
# vocabulary at the top of this file. Any negative is still a failure, which is
# what the existing `>= 0` idiom tests.
#
# Symmetry is NOT checked — only the upper triangle is read, so a non-symmetric
# input silently yields the eigenvalues of its symmetrised self. Call
# ganita_mat_is_symmetric first if the input is not known to be symmetric.
# Max 100*n^2 rotations. Converges when the largest off-diagonal < LINALG_EPS.
fn ganita_mat_eigen_sym(m, out_vals, out_vecs): i64 {
    if (m == 0 || out_vals == 0 || out_vecs == 0) { return 0 - 2; }
    if (ganita_mat_rows(m) != ganita_mat_cols(m)) { return 0 - 2; }
    _linalg_init_eps();
    var n = ganita_mat_rows(m);
    if (ganita_mat_rows(out_vecs) != n || ganita_mat_cols(out_vecs) != n) { return 0 - 2; }

    # Copy m into working matrix A (will be diagonalized in place)
    var a = ganita_mat_copy(m);
    if (a == 0) { return 0 - 2; }

    # Initialize out_vecs to identity (accumulates rotations)
    var i = 0;
    var total = n * n;
    while (i < total) { store64(out_vecs + 16 + i * 8, f64_from(0)); i = i + 1; }
    i = 0;
    while (i < n) { ganita_mat_set(out_vecs, i, i, f64_from(1)); i = i + 1; }

    # ⚡ THE PIVOT SEARCH IS INDEXED, NOT EXHAUSTIVE (1.2.3).
    #
    # Classical Jacobi picks the largest off-diagonal entry each time. Through
    # 1.2.2 that meant rescanning the whole upper triangle — O(n^2) — before
    # EVERY rotation, and convergence takes O(n^2) rotations, so the routine was
    # O(n^4). ganita_mat_condition on a 200x200 took about 13 seconds, and
    # ganita_mat_rank, ganita_mat_condition and ganita_mat_pseudo_inv all route
    # through here, so the cost was not confined to callers who asked for
    # eigenvalues.
    #
    # rmax[i] holds the column of the largest |a[i][j]| over j > i. The global
    # maximum is then one O(n) pass over rmax. A rotation at (p, q) changes only
    # rows p and q and columns p and q, so afterwards rows p and q are recomputed
    # in full and every other row is repaired from its two changed entries —
    # rescanned only when its recorded maximum WAS at column p or q and may
    # therefore have shrunk. That is O(n) per rotation in the common case,
    # O(n^2) in the worst, against O(n^2) unconditionally before.
    #
    # Ties break identically (strict >, lowest index first), so this selects the
    # same pivot at every step as the exhaustive scan did: the eigenvalues are
    # bit-for-bit what 1.2.2 produced, not merely close.
    var rmax = alloc(n * 8);
    if (rmax == 0) { return 0 - 1; }
    i = 0;
    while (i < n - 1) {
        store64(rmax + i * 8, _linalg_row_max_col(a, n, i));
        i = i + 1;
    }

    var max_iter = 100 * n * n;
    var iter = 0;
    while (iter < max_iter) {
        # Largest off-diagonal element, read off the per-row maxima.
        var max_off = f64_from(0);
        var p = 0;
        var q = 1;
        i = 0;
        while (i < n - 1) {
            var rc = load64(rmax + i * 8);
            var rv = f64_abs(ganita_mat_get(a, i, rc));
            if (f64_gt(rv, max_off) == 1) {
                max_off = rv;
                p = i;
                q = rc;
            }
            i = i + 1;
        }

        # Converged?
        if (f64_lt(max_off, LINALG_EPS) == 1) {
            # Extract eigenvalues from diagonal
            i = 0;
            while (i < n) {
                store64(out_vals + i * 8, ganita_mat_get(a, i, i));
                i = i + 1;
            }
            return iter;
        }

        # Compute rotation angle
        var app = ganita_mat_get(a, p, p);
        var aqq = ganita_mat_get(a, q, q);
        var apq = ganita_mat_get(a, p, q);

        var theta = f64_div(f64_sub(aqq, app),
          f64_mul(f64_from(2), apq));
        # t = sign(theta) / (|theta| + sqrt(theta^2 + 1))
        var t = f64_from(0);
        var abs_theta = f64_abs(theta);
        var denom = f64_add(abs_theta,
          f64_sqrt(f64_add(f64_mul(theta, theta), f64_from(1))));
        if (f64_gt(theta, f64_from(0)) == 1) {
            t = f64_div(f64_from(1), denom);
        } else {
            t = f64_neg(f64_div(f64_from(1), denom));
        }

        var c = f64_div(f64_from(1),
          f64_sqrt(f64_add(f64_mul(t, t), f64_from(1))));
        var s = f64_mul(t, c);
        var tau = f64_div(s, f64_add(f64_from(1), c));

        # Apply rotation to A
        # Update rows/cols p and q
        i = 0;
        while (i < n) {
            if (i != p && i != q) {
                var aip = ganita_mat_get(a, i, p);
                var aiq = ganita_mat_get(a, i, q);
                ganita_mat_set(a, i, p, f64_sub(aip, f64_mul(s,
                      f64_add(aiq, f64_mul(tau, aip)))));
                ganita_mat_set(a, i, q, f64_add(aiq, f64_mul(s,
                      f64_sub(aip, f64_mul(tau, aiq)))));
                ganita_mat_set(a, p, i, ganita_mat_get(a, i, p));
                ganita_mat_set(a, q, i, ganita_mat_get(a, i, q));
            }
            i = i + 1;
        }

        # Update diagonal
        ganita_mat_set(a, p, p, f64_sub(app, f64_mul(t, apq)));
        ganita_mat_set(a, q, q, f64_add(aqq, f64_mul(t, apq)));
        ganita_mat_set(a, p, q, f64_from(0));
        ganita_mat_set(a, q, p, f64_from(0));

        # Accumulate rotation into eigenvector matrix
        i = 0;
        while (i < n) {
            var vip = ganita_mat_get(out_vecs, i, p);
            var viq = ganita_mat_get(out_vecs, i, q);
            ganita_mat_set(out_vecs, i, p, f64_sub(vip, f64_mul(s,
                  f64_add(viq, f64_mul(tau, vip)))));
            ganita_mat_set(out_vecs, i, q, f64_add(viq, f64_mul(s,
                  f64_sub(vip, f64_mul(tau, viq)))));
            i = i + 1;
        }

        # Repair the per-row maxima. Rows p and q changed in many positions and
        # are recomputed in full; every other row saw at most its p and q entries
        # change, so it only needs a rescan when its recorded maximum was AT one
        # of those columns and may have shrunk.
        store64(rmax + p * 8, _linalg_row_max_col(a, n, p));
        if (q < n - 1) { store64(rmax + q * 8, _linalg_row_max_col(a, n, q)); }
        i = 0;
        while (i < n - 1) {
            if (i != p && i != q) {
                var rc2 = load64(rmax + i * 8);
                if (rc2 == p || rc2 == q) {
                    store64(rmax + i * 8, _linalg_row_max_col(a, n, i));
                } else {
                    var cv = f64_abs(ganita_mat_get(a, i, rc2));
                    if (p > i) {
                        var vp = f64_abs(ganita_mat_get(a, i, p));
                        if (f64_gt(vp, cv) == 1) {
                            cv = vp;
                            rc2 = p;
                        }
                    }
                    if (q > i) {
                        var vq = f64_abs(ganita_mat_get(a, i, q));
                        if (f64_gt(vq, cv) == 1) {
                            cv = vq;
                            rc2 = q;
                        }
                    }
                    store64(rmax + i * 8, rc2);
                }
            }
            i = i + 1;
        }

        iter = iter + 1;
    }

    # Didn't converge — still extract what we have, but SAY so. -3 per the
    # module vocabulary; this was -1 through 1.2.2.
    i = 0;
    while (i < n) {
        store64(out_vals + i * 8, ganita_mat_get(a, i, i));
        i = i + 1;
    }
    return 0 - 3;
}

# SVD via eigendecomposition of A^T*A.
# For m×n matrix A (m >= n):
#   A = U * diag(sigma) * V^T
# out_u: m×n matrix (caller allocates).
# out_sigma: flat f64 array of length n (singular values).
# out_vt: n×n matrix (caller allocates, V transposed).
# Returns 0 on success, -1 if any working allocation fails or the internal
# eigendecomposition does not converge, -2 for a null argument, for m < n, or
# for an out-param that is not the documented shape.
#
# ⚠ m >= n IS CHECKED AS OF 1.2.3, and the whole SVD family inherits it —
# ganita_mat_rank, ganita_mat_condition and ganita_mat_pseudo_inv all route
# through here. A wide matrix produced answers that were not merely imprecise
# but wrong in kind: pseudo_inv returned something that was not the
# Moore-Penrose pseudoinverse at all. Transpose a wide matrix and transpose the
# result back.
fn ganita_mat_svd(m, out_u, out_sigma, out_vt): i64 {
    if (m == 0 || out_u == 0 || out_sigma == 0 || out_vt == 0) { return 0 - 2; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    if (rows < cols) { return 0 - 2; }
    if (ganita_mat_rows(out_u) != rows || ganita_mat_cols(out_u) != cols) { return 0 - 2; }
    if (ganita_mat_rows(out_vt) != cols || ganita_mat_cols(out_vt) != cols) { return 0 - 2; }
    _linalg_init_eps();

    # Compute A^T * A (n×n symmetric)
    var mt = ganita_mat_transpose(m);
    if (mt == 0) { return 0 - 1; }
    var ata = ganita_mat_mul(mt, m);
    if (ata == 0) { return 0 - 1; }

    # Eigendecompose A^T*A → V, lambda
    var lambda = alloc(cols * 8);
    if (lambda == 0) { return 0 - 1; }
    var v = ganita_mat_new(cols, cols);
    if (v == 0) { return 0 - 1; }
    # ANY negative is a failure. Through 1.2.2 this tested only for -2, so a
    # non-converged eigendecomposition — the -1 of the day — was discarded and
    # svd returned 0 (success) on singular values derived from a matrix that was
    # never diagonalised.
    if (ganita_mat_eigen_sym(ata, lambda, v) < 0) { return 0 - 1; }

    # Singular values = sqrt(eigenvalues), V^T = transpose of eigenvectors
    var i = 0;
    while (i < cols) {
        var ev = load64(lambda + i * 8);
        if (f64_lt(ev, f64_from(0)) == 1) { ev = f64_from(0); }
        store64(out_sigma + i * 8, f64_sqrt(ev));
        i = i + 1;
    }

    # Sort singular values descending (and corresponding V columns)
    i = 0;
    while (i < cols) {
        var max_idx = i;
        var max_sv = load64(out_sigma + i * 8);
        var j = i + 1;
        while (j < cols) {
            if (f64_gt(load64(out_sigma + j * 8), max_sv) == 1) {
                max_sv = load64(out_sigma + j * 8);
                max_idx = j;
            }
            j = j + 1;
        }
        if (max_idx != i) {
            # Swap sigma
            var tmp = load64(out_sigma + i * 8);
            store64(out_sigma + i * 8, load64(out_sigma + max_idx * 8));
            store64(out_sigma + max_idx * 8, tmp);
            # Swap V columns
            var k = 0;
            while (k < cols) {
                var tv = ganita_mat_get(v, k, i);
                ganita_mat_set(v, k, i, ganita_mat_get(v, k, max_idx));
                ganita_mat_set(v, k, max_idx, tv);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    # V^T
    var vt_tmp = ganita_mat_transpose(v);
    if (vt_tmp == 0) { return 0 - 1; }
    i = 0;
    var vt_total = cols * cols;
    while (i < vt_total) {
        store64(out_vt + 16 + i * 8, load64(vt_tmp + 16 + i * 8));
        i = i + 1;
    }

    # U = A * V * Sigma_inv (column by column)
    # For each column j: u_j = (1/sigma_j) * A * v_j
    var j = 0;
    while (j < cols) {
        var sv = load64(out_sigma + j * 8);
        if (f64_gt(sv, LINALG_EPS) == 1) {
            var inv_sv = f64_div(f64_from(1), sv);
            # Compute A * v_j
            i = 0;
            while (i < rows) {
                var sum = f64_from(0);
                var k = 0;
                while (k < cols) {
                    sum = f64_add(sum, f64_mul(ganita_mat_get(m, i, k), ganita_mat_get(v, k, j)));
                    k = k + 1;
                }
                ganita_mat_set(out_u, i, j, f64_mul(sum, inv_sv));
                i = i + 1;
            }
        } else {
            # Zero singular value — zero column in U
            i = 0;
            while (i < rows) {
                ganita_mat_set(out_u, i, j, f64_from(0));
                i = i + 1;
            }
        }
        j = j + 1;
    }
    return 0;
}

# Moore-Penrose pseudoinverse via SVD.
# TALL-OR-SQUARE INPUT ONLY (m >= n) — see ganita_mat_svd. Returns a new n×m
# matrix, or 0 for a null or wide input, or if any working allocation fails. The
# n×n factors mean a wide input can exceed the cap even when the input does not.
fn ganita_mat_pseudo_inv(m): i64 {
    if (m == 0) { return 0; }
    var rows = ganita_mat_rows(m);
    var cols = ganita_mat_cols(m);
    if (rows < cols) { return 0; }
    _linalg_init_eps();

    var u = ganita_mat_new(rows, cols);
    if (u == 0) { return 0; }
    var sigma = alloc(cols * 8);
    if (sigma == 0) { return 0; }
    var vt = ganita_mat_new(cols, cols);
    if (vt == 0) { return 0; }
    if (ganita_mat_svd(m, u, sigma, vt) != 0) { return 0; }

    # Pseudo-inverse = V * Sigma_inv * U^T
    # Build Sigma_inv diagonal matrix
    var sigma_inv = ganita_mat_new(cols, cols);
    if (sigma_inv == 0) { return 0; }
    var i = 0;
    while (i < cols) {
        var sv = load64(sigma + i * 8);
        if (f64_gt(sv, LINALG_EPS) == 1) {
            ganita_mat_set(sigma_inv, i, i, f64_div(f64_from(1), sv));
        }
        i = i + 1;
    }

    # V = transpose of V^T
    var v = ganita_mat_transpose(vt);
    if (v == 0) { return 0; }
    var ut = ganita_mat_transpose(u);
    if (ut == 0) { return 0; }

    # V * Sigma_inv
    var vs = ganita_mat_mul(v, sigma_inv);
    if (vs == 0) { return 0; }
    # (V * Sigma_inv) * U^T
    return ganita_mat_mul(vs, ut);
}

# Numerical rank: count of singular values above tolerance.
# TALL-OR-SQUARE INPUT ONLY (m >= n) — see ganita_mat_svd.
# Returns -1 if any working allocation fails and -2 for a null or wide input, or
# a negative or NaN tolerance. A rank is never negative, so no failure code can
# be mistaken for the rank-0 answer.
fn ganita_mat_rank(m, tol): i64 {
    if (m == 0) { return 0 - 2; }
    if (ganita_mat_rows(m) < ganita_mat_cols(m)) { return 0 - 2; }
    if (_linalg_is_nan(tol) == 1) { return 0 - 2; }
    if (f64_lt(tol, f64_from(0)) == 1) { return 0 - 2; }
    var cols = ganita_mat_cols(m);
    var u = ganita_mat_new(ganita_mat_rows(m), cols);
    if (u == 0) { return 0 - 1; }
    var sigma = alloc(cols * 8);
    if (sigma == 0) { return 0 - 1; }
    var vt = ganita_mat_new(cols, cols);
    if (vt == 0) { return 0 - 1; }
    if (ganita_mat_svd(m, u, sigma, vt) != 0) { return 0 - 1; }

    var rank = 0;
    var i = 0;
    while (i < cols) {
        if (f64_gt(load64(sigma + i * 8), tol) == 1) {
            rank = rank + 1;
        }
        i = i + 1;
    }
    return rank;
}

# Condition number: sigma_max / sigma_min.
# TALL-OR-SQUARE INPUT ONLY (m >= n) — see ganita_mat_svd.
# Returns f64: -1.0 if the matrix is singular (sigma_min ≈ 0), and NaN for a null
# or wide input or if any working allocation fails — distinct from -1.0, which is
# a real answer about the matrix rather than about the run.
fn ganita_mat_condition(m): i64 {
    if (m == 0) { return f64_div(f64_from(0), f64_from(0)); }
    if (ganita_mat_rows(m) < ganita_mat_cols(m)) { return f64_div(f64_from(0), f64_from(0)); }
    var cols = ganita_mat_cols(m);
    _linalg_init_eps();

    var u = ganita_mat_new(ganita_mat_rows(m), cols);
    if (u == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var sigma = alloc(cols * 8);
    if (sigma == 0) { return f64_div(f64_from(0), f64_from(0)); }
    var vt = ganita_mat_new(cols, cols);
    if (vt == 0) { return f64_div(f64_from(0), f64_from(0)); }
    if (ganita_mat_svd(m, u, sigma, vt) != 0) { return f64_div(f64_from(0), f64_from(0)); }

    var smax = load64(sigma);
    var smin = load64(sigma + (cols - 1) * 8);

    if (f64_lt(smin, LINALG_EPS) == 1) { return f64_neg(f64_from(1)); }
    return f64_div(smax, smin);
}

# --- math_advanced.cyr ---

# ganita math_advanced — transcendental + number-theory carved from
# cyrius stdlib lib/math.cyr at v6.1.26. Self-contained (f64 builtins only).

# sinh(x) = (exp(x) - exp(-x)) / 2
fn ganita_f64_sinh(x): i64 {
    var ex = f64_exp(x);
    var enx = f64_exp(f64_neg(x));
    return f64_div(f64_sub(ex, enx), F64_TWO);
}

# cosh(x) = (exp(x) + exp(-x)) / 2
fn ganita_f64_cosh(x): i64 {
    var ex = f64_exp(x);
    var enx = f64_exp(f64_neg(x));
    return f64_div(f64_add(ex, enx), F64_TWO);
}

# tanh(x) = sinh(x) / cosh(x)
# Saturate for large |x| before the exponential overflows. For |x| >= ~19,
# 1 - |tanh(x)| ~ 2·e^(-2|x|) falls below half a ULP of 1.0, so tanh(x) is already
# exactly +/-1.0 in f64 — returning it directly is BIT-EXACT for every finite x.
# Without this, |x| > ~709 makes f64_exp(x) overflow to +inf and the (e^x-e^-x)/
# (e^x+e^-x) form returns inf/inf = NaN (e.g. GELU's tanh(c·(x+a·x³)) on a large
# activation). Threshold 20 sits safely inside the saturated region.
fn ganita_f64_tanh(x): i64 {
    if (f64_gt(x, f64_from(20)) == 1) { return f64_from(1); }
    if (f64_lt(x, f64_from(0 - 20)) == 1) { return f64_from(0 - 1); }
    var ex = f64_exp(x);
    var enx = f64_exp(f64_neg(x));
    var s = f64_sub(ex, enx);
    var c = f64_add(ex, enx);
    return f64_div(s, c);
}

# True when an f64 holds an exact integer value.
fn _f64_is_int(v): i64 {
    if (f64_floor(v) == v) { return 1; }
    return 0;
}

# Parity of an integral f64. Every |v| >= 2^53 is even by construction: at that
# magnitude consecutive f64 values are 2 apart, so no odd integer is
# representable and the f64_to() narrowing below would be meaningless anyway.
fn _f64_int_is_odd(v): i64 {
    var a = f64_abs(v);
    if (f64_ge(a, f64_from(9007199254740992)) == 1) { return 0; }
    if (f64_to(a) & 1 == 1) { return 1; }
    return 0;
}

# pow(base, exp).
#
# The core is exp(exp * ln base), which is valid ONLY for base > 0 — ln(0) is
# -inf and ln of a negative is NaN. Before 1.1.4 there was nothing else, so
# every base <= 0 returned NaN: pow(0,2) and pow(-2,3) are ordinary defined
# operations, and both came back NaN with no diagnostic. The domain is now
# handled explicitly ahead of the exp/ln path, following C's pow:
#
#   pow(x,  0)    = 1       for every x, NaN included
#   pow(0,  y>0)  = 0
#   pow(0,  y<0)  = +inf
#   pow(x<0, y)   = ±|x|^y  when y is an integer; sign from y's parity
#   pow(x<0, y)   = NaN     when y is not an integer — undefined in the reals,
#                           so NaN is the correct answer and is left alone
#
# C distinguishes pow(-0, odd) = -0 from pow(+0, odd) = +0. That distinction is
# deliberately NOT made here: cyrius's `f64_neg(f64_from(0))` yields +0, so a
# negative zero cannot be produced (or asserted against) through the f64 helper
# surface, and a branch for it would be untestable dead code. Zero of either
# sign returns +0.
fn ganita_f64_pow(base, exp): i64 {
    # x^0 = 1 for every x. First, so it wins over the zero and negative cases.
    if (exp & 0x7FFFFFFFFFFFFFFF == 0) { return f64_from(1); }

    # zero base (either sign)
    if (base & 0x7FFFFFFFFFFFFFFF == 0) {
        if (f64_lt(exp, f64_from(0)) == 1) { return f64_div(f64_from(1), f64_from(0)); }
        return f64_from(0);
    }

    # negative base — real only for an integral exponent
    if ((base >> 63) & 1 == 1) {
        if (_f64_is_int(exp) == 0) { return f64_div(f64_from(0), f64_from(0)); }
        var mag = f64_exp(f64_mul(exp, f64_ln(f64_abs(base))));
        if (_f64_int_is_odd(exp) == 1) { return f64_neg(mag); }
        return mag;
    }

    return f64_exp(f64_mul(exp, f64_ln(base)));
}

# ================================================================
# Inverse trigonometry
# ================================================================
#
# Inverse trig family (asin/acos/atan2) — builds on the `f64_atan`
# builtin. PORTABLE across x86 (x87 `fpatan`) AND aarch64: Cyrius
# v6.4.25 added `_f64_atan_polyfill`, so `f64_atan` works on aarch64
# (an aarch64 consumer must `include "lib/math.cyr"` for the polyfill).
# Was `#ifdef CYRIUS_ARCH_X86`-guarded through v1.0.2 (the `_compat.cyr`
# f64_asin/acos/atan2 wrappers sat OUTSIDE the guard → a latent
# undefined-fn on aarch64); un-guarded at v1.0.3 (v6.4.25 unblock).
# x87 `fpatan` (exposed by Cyrius as the `f64_atan` builtin) is a
# single-argument arctangent returning a value in [-π/2, π/2]. The
# helpers below build the rest of the inverse-trig family on top of
# it via standard identities:
#
#   asin(x) = atan(x / √(1 − x²))
#   acos(x) = π/2 − asin(x)
#   atan2(y, x) = atan(y / x) corrected per quadrant
#
# abaco 1.1.0's ntheory port was carrying the same identities
# inline but with a broken atan2 (no quadrant fix → wrong in Q2/Q3).
# This hardens that fix and makes it available to every consumer.
#
# Domain notes:
#   asin / acos: |x| ≤ 1. Outside the domain sqrt yields NaN and
#     the atan chain propagates it — consistent with C's libm.
#   atan:  any finite x. Returns value in (-π/2, π/2).
#   atan2: defined for (y, x) ≠ (0, 0). The (0, 0) case returns 0
#     by convention (matches C libm).

# asin(x) = atan(x / √(1 − x²))
fn ganita_f64_asin(x): i64 {
    var one_minus_xx = f64_sub(F64_ONE, f64_mul(x, x));
    var denom = f64_sqrt(one_minus_xx);
    return f64_atan(f64_div(x, denom));
}

# acos(x) = π/2 − asin(x)
fn ganita_f64_acos(x): i64 {
    return f64_sub(F64_PI_2, ganita_f64_asin(x));
}

# Two-argument arctangent with full-plane quadrant handling. Result
# is in (-π, π]. Quadrant map:
#   x > 0            : atan(y/x)                   (Q1 / Q4)
#   x < 0, y ≥ 0     : atan(y/x) + π               (Q2)
#   x < 0, y < 0     : atan(y/x) − π               (Q3)
#   x == 0, y > 0    : +π/2
#   x == 0, y < 0    : −π/2
#   x == 0, y == 0   : 0  (convention — C libm matches)
# Zero comparisons use bit equality against the f64 representation
# of 0.0 (IEEE 754: both +0 and −0 compare equal via f64_eq).
fn ganita_f64_atan2(y, x): i64 {
    if (f64_eq(x, _F64_ZERO) == 1) {
        if (f64_eq(y, _F64_ZERO) == 1) { return _F64_ZERO; }
        if (f64_gt(y, _F64_ZERO) == 1) { return F64_PI_2; }
        return f64_neg(F64_PI_2);
    }
    var q = f64_atan(f64_div(y, x));
    if (f64_gt(x, _F64_ZERO) == 1) { return q; }
    # x < 0.
    if (f64_lt(y, _F64_ZERO) == 1) { return f64_sub(q, F64_PI); }
    return f64_add(q, F64_PI);
}

# ================================================================
# Inverse hyperbolic
# ================================================================
# Closes the symmetry with `ganita_f64_sinh` / `cosh` / `tanh` that's been
# in this file since day one. Identity-based implementations —
# accurate enough for most consumers, loses ~1-2 ulp at small |x|
# for asinh and near ±1 for atanh (classic catastrophic
# cancellation from `1 − x²` and `ln(1 + small)`). Downstream
# crates that need sub-ulp accuracy should roll their own
# range-reduced series; most consumers (abaco, dhvani) don't.
#
# Domains:
#   asinh: all real x.
#   acosh: x ≥ 1.       Below domain, sqrt(x²−1) propagates NaN.
#   atanh: |x| < 1.     At ±1 the ln diverges; outside domain it
#                       propagates NaN via ln of a negative.

# asinh(x) = ln(x + √(x² + 1)), computed on |x| and re-signed.
#
# ⚠ THE NAIVE FORM IS ONLY CORRECT FOR x >= 0, and through 1.2.2 that is what
# shipped. asinh is odd, so |asinh(-x)| must equal asinh(x) — but evaluating
# `ln(x + sqrt(x*x + 1))` directly at a negative x subtracts two nearly equal
# quantities (for x = -10 the sum is 0.0499, from operands near 10), so the
# significant digits cancel and what is left is rounding noise. Below about
# -2^26 the sum rounds to exactly 0 and the result is -inf; below -1.34e154 the
# x*x overflows to +inf first and the answer comes back +inf, wrong in sign as
# well as magnitude. Computing on |x| and negating avoids every cancellation.
#
# Three regimes, and the outer two exist because the middle one breaks:
#   |x| < 1e-8      -> x. The series is x - x^3/6 + ..., and x^3/6 is below half
#                      a ulp of x there, so x IS the correctly-rounded answer.
#                      The general form computes ln(1 + tiny) as ln(1.0) = 0
#                      EXACTLY, so it returned 0.0 for every |x| <= 1e-17.
#   |x| > 2^26      -> ln(|x|) + ln 2, since sqrt(x^2+1) -> |x| to well within
#                      an ulp there and x*x would otherwise overflow.
#   otherwise       -> the direct form, which is accurate on the positive side.
fn ganita_f64_asinh(x): i64 {
    var a = f64_abs(x);
    var r = f64_from(0);
    if (f64_lt(a, f64_div(f64_from(1), f64_from(100000000))) == 1) {
        r = a;
    } else {
        if (f64_gt(a, f64_from(67108864)) == 1) {
            r = f64_add(f64_ln(a), f64_ln(f64_from(2)));
        } else {
            r = f64_ln(f64_add(a, f64_sqrt(f64_add(f64_mul(a, a), F64_ONE))));
        }
    }
    if ((x >> 63) & 1 == 1) { return f64_neg(r); }
    return r;
}

# acosh(x) = ln(x + √(x² − 1)), x ≥ 1
fn ganita_f64_acosh(x): i64 {
    var x2_minus_1 = f64_sub(f64_mul(x, x), F64_ONE);
    return f64_ln(f64_add(x, f64_sqrt(x2_minus_1)));
}

# atanh(x) = ½ · ln((1 + x) / (1 − x)), |x| < 1
fn ganita_f64_atanh(x): i64 {
    var num = f64_add(F64_ONE, x);
    var den = f64_sub(F64_ONE, x);
    return f64_mul(F64_HALF, f64_ln(f64_div(num, den)));
}

# Hypotenuse: sqrt(x^2 + y^2). No overflow protection (use for normal ranges).
fn ganita_f64_hypot(x, y): i64 {
    return f64_sqrt(f64_add(f64_mul(x, x), f64_mul(y, y)));
}

# Fibonacci number (iterative). Returns -1 if n > 92 (overflow).
fn ganita_fibonacci(n): i64 {
    # A negative index has no value here; through 1.2.2 it fell past the n == 0
    # test, skipped the `while (i <= n)` body entirely, and returned b = 1 —
    # fibonacci(-5) = 1, with no diagnostic.
    if (n < 0) { return 0 - 1; }
    if (n == 0) { return 0; }
    if (n > 92) { return 0 - 1; }
    var a = 0;
    var b = 1;
    var i = 2;
    while (i <= n) {
        var next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return b;
}

# Binomial coefficient C(n, k), exact in i64. Returns 0 when k > n, and -1 for a
# negative argument or when the true value does not fit in i64.
#
# ⚠ "Uses symmetry + iterative multiply to avoid overflow" — what the comment
# said through 1.2.2 — was FALSE, and it is the kind of false that a caller acts
# on. The symmetry step halves the number of multiplies; it does nothing about
# the size of the answer. C(62,31) is 465,428,353,255,261,088, which fits, but
# `result * (n - i)` on the way there does not: the product wrapped i64 silently
# and the function returned a plausible-looking wrong count, sometimes negative.
# From n = 62 upward the results were unreliable with no signal of any kind.
#
# The pre-multiply overflow test also bounds the loop. CWE-834 (uncontrolled
# iteration) was reachable before: binomial(2^62, 2^61) has min(k, n-k) = 2^61,
# so the loop ran 2.3 quintillion times — roughly 560 years — with nothing to
# stop it. Now `result` exceeds the limit within the first few iterations and it
# returns -1 immediately.
fn ganita_binomial(n, k): i64 {
    if (n < 0 || k < 0) { return 0 - 1; }
    if (k > n) { return 0; }
    if (k > n - k) { k = n - k; }
    var result = 1;
    var i = 0;
    while (i < k) {
        var factor = n - i;
        # result * factor would wrap. Tested by division, which cannot itself
        # overflow; factor is >= 1 here because i < k <= n - k <= n.
        if (result > 0x7FFFFFFFFFFFFFFF / factor) { return 0 - 1; }
        # Exact at every step: the running product of j consecutive integers is
        # always divisible by j!, so this division has no remainder.
        result = result * factor / (i + 1);
        i = i + 1;
    }
    return result;
}

# --- math_f32.cyr ---

# ganita math_f32 — single-precision scalar tier (1.1.0).
#
# WHY THIS EXISTS. cyrius gives you `f32_from` / `f32_to` and f32 arithmetic, but every
# shape-level helper was f64-only, so a consumer doing f32 work paid a widen-op-narrow
# round trip for things that are one integer instruction: `f32_abs` was
# `f32_from(f64_abs(f32_to(x)))` — three ops per lane for a bit-clear. Filed from the
# ranga (image processing) Rust->Cyrius port, whose pixel loops are f32 throughout.
#
# REPRESENTATION. An f32 is its IEEE-754 **single** bit pattern in the LOW 32 bits of an
# i64, high 32 clear — the same convention `f32_from` / `f32_to` use. Every fn here takes
# and returns that form. The arithmetic tier declares its PARAMS `f32` so the value lands
# in an xmm register as a single; callers still pass and receive the same bit patterns.
#
# ⚠ WHY min/max/clamp ARE NOT A BARE UNSIGNED COMPARE. IEEE-754 is SIGN-MAGNITUDE, not
# two's complement. Raw patterns order correctly only among NON-NEGATIVE values; for two
# negatives the order REVERSES (-2.0 has a larger magnitude field than -1.0), and a
# negative always has bit 31 set so it compares HIGH against every positive. The issue
# that requested this tier says "for non-negative finite f32 the raw pattern orders
# identically to an unsigned integer" — true, and precisely the trap: pixel data is
# non-negative, so a naive implementation passes every plausible test and is wrong the
# first time a consumer subtracts. `_f32_key` applies the standard monotone transform
# (flip all bits when negative, else set the sign bit) so ONE signed compare is correct
# across the whole range, negatives and zero included.

# ================================================================
# TIER 0 — arithmetic, in NATIVE single precision
# ================================================================
# These are real `addss` / `subss` / `mulss` / `divss`: one rounding, in f32, per
# operation. They are NOT widen-compute-narrow.
#
# The 1.1.0 header (and the filing that requested this tier) recorded that no f32
# arithmetic tier could be written, because `f32_add(...)` is not a builtin and cyrius
# reaches f32 arithmetic only through the OPERATORS on an `F32_TYID`-typed value, "and
# these params arrive as untyped i64 bit patterns". That last clause is the part that was
# wrong: a param can simply BE typed. `fn f(a: f32, b: f32)` puts the incoming pattern in
# an xmm lane as a single, `var s: f32 = a + b` emits the single-precision op, and
# returning `s` as `i64` hands the pattern back. Only the RETURN type is still barred
# (`fn f(): f32` -> "fn return type must be struct or i8/i16/i32/i64/.../f64"), and that
# does not matter here because the bit pattern is the interchange form anyway.
#
# WHY IT HAD TO BE NATIVE. For a SINGLE +, -, * or /, widen-compute-narrow is correctly
# rounded — f64's 53 bits exceed 2*24+2, so double rounding cannot bite. So a one-op
# helper would have been indistinguishable. It stops being true the moment a consumer
# CHAINS operations: an f64 accumulator keeps precision f32 does not have, and the answers
# diverge. `ganita_f32_add(2^24, 1.0)` is 2^24 in single precision (ties-to-even) and
# 2^24+1 in double — that is the test that pins these as native rather than widened.
fn ganita_f32_add(a: f32, b: f32): i64 {
    var s: f32 = a + b;
    return s;
}

# a - b, one f32 rounding.
fn ganita_f32_sub(a: f32, b: f32): i64 {
    var s: f32 = a - b;
    return s;
}

# a * b, one f32 rounding.
fn ganita_f32_mul(a: f32, b: f32): i64 {
    var s: f32 = a * b;
    return s;
}

# a / b, one f32 rounding. Finite/0 is a signed infinity; 0/0 is NaN.
fn ganita_f32_div(a: f32, b: f32): i64 {
    var s: f32 = a / b;
    return s;
}

# Monotone sort key: maps an f32 bit pattern to an i64 that orders like the float.
fn _f32_key(b): i64 {
    var lo = b & 0xFFFFFFFF;
    if (lo & 0x80000000 != 0) { return (~lo) & 0xFFFFFFFF; }
    return lo | 0x80000000;
}

# |x| — clear the sign bit. Exact, no rounding, no widening.
fn ganita_f32_abs(x): i64 { return x & 0x7FFFFFFF; }

# -x — flip the sign bit. Exact for zeros and infinities too.
fn ganita_f32_neg(x): i64 { return (x & 0xFFFFFFFF) ^ 0x80000000; }

# min / max — one signed compare on the monotone key.
fn ganita_f32_min(a, b): i64 {
    if (_f32_key(a) <= _f32_key(b)) { return a & 0xFFFFFFFF; }
    return b & 0xFFFFFFFF;
}
# max(a, b) — one signed compare on the monotone key.
fn ganita_f32_max(a, b): i64 {
    if (_f32_key(a) >= _f32_key(b)) { return a & 0xFFFFFFFF; }
    return b & 0xFFFFFFFF;
}

# clamp(x, lo, hi) — the loop body ranga runs per pixel.
fn ganita_f32_clamp(x, lo, hi): i64 {
    return ganita_f32_min(ganita_f32_max(x, lo), hi);
}

# sign(x) -> -1.0f / 0.0f / +1.0f. Zero (either signed zero) returns +0.0f.
# 0x3F800000 = 1.0f, 0xBF800000 = -1.0f.
fn ganita_f32_sign(x): i64 {
    if (x & 0x7FFFFFFF == 0) { return 0; }
    if (x & 0x80000000 != 0) { return 0xBF800000; }
    return 0x3F800000;
}

# lerp(a, b, t) = a + (b - a) * t.
# ⭐ NO LONGER WIDENS (1.2.0). It used to compute the whole expression in f64 and round
# once at the end, because the tier believed f32 arithmetic was unreachable from a library
# fn — see TIER 0 for why that was wrong. It now rounds three times, in single, exactly as
# the same expression does in Rust or C. Results can differ from 1.1.x by 1 ULP; the new
# ones are the single-precision answers.
fn ganita_f32_lerp(a: f32, b: f32, t: f32): i64 {
    var r: f32 = a + (b - a) * t;
    return r;
}

# floor / ceil / trunc.
# ⭐ These DO widen, and that is correct rather than lazy: f32 -> f64 is EXACT (every
# f32 is representable in f64), the f64 rounding intrinsic is exact on it, and the
# integer-valued result narrows back exactly because it is within f32 range whenever the
# input was. So the round trip introduces no error at all. A bit-twiddled version would
# have to special-case the exponent range, NaN and infinity by hand for no accuracy gain
# — the win this tier is about is min/max/clamp/abs/neg, which are now branch-and-mask.
fn ganita_f32_floor(x): i64 { return f32_from(f64_floor(f32_to(x))); }
# ceil(x) — smallest integral value >= x.
fn ganita_f32_ceil(x): i64 { return f32_from(f64_ceil(f32_to(x))); }
# trunc(x) — toward zero, so it differs from floor for negatives.
fn ganita_f32_trunc(x): i64 {
    if (x & 0x80000000 != 0) { return ganita_f32_neg(ganita_f32_floor(ganita_f32_abs(x))); }
    return ganita_f32_floor(x);
}

# ================================================================
# TIER 2 — sqrt
# ================================================================
# The filing asks for `sqrtss` (a direct single-precision encoding, no widening). That
# would need a NEW cyrius intrinsic; it does not exist yet, and adding one is a compiler
# change, not a library one. Widening is used instead and it is **correctly rounded, not
# an approximation**: f64 carries 53 mantissa bits against f32's 24, which is more than
# 2*24 + 2, so computing sqrt in double and rounding once to single yields exactly the
# single-precision result. Double-rounding cannot bite here.
# ⚠ Do NOT "optimise" this into a bare f32 bit trick without the intrinsic — the accuracy
# is the point, and `sqrtss` is a cyrius-side follow-up, recorded in the issue.
fn ganita_f32_sqrt(x): i64 { return f32_from(f64_sqrt(f32_to(x))); }

# ================================================================
# TIER 3 — transcendentals
# ================================================================
# Widen-compute-narrow, which the filing explicitly blesses for this tier: "completely
# acceptable here; the win is that the conversions stop being the consumer's problem and
# the naming stays symmetric with the f64 tier." Each of these is the f32-facing name for
# an f64 routine that already exists and is already tested — the value delivered is the
# symmetry and the removal of per-call-site `f32_from(f64_x(f32_to(v)))` boilerplate from
# every consumer, not new numerics.
fn ganita_f32_exp(x): i64 { return f32_from(f64_exp(f32_to(x))); }
# Natural logarithm.
fn ganita_f32_ln(x): i64 { return f32_from(f64_ln(f32_to(x))); }
# Base-2 logarithm.
fn ganita_f32_log2(x): i64 { return f32_from(f64_log2(f32_to(x))); }
# 2 raised to x.
fn ganita_f32_exp2(x): i64 { return f32_from(f64_exp2(f32_to(x))); }
# Largest |x| for which the underlying f64 sin/cos perform argument reduction.
# Above 2^63 they return the argument unchanged, which for a bounded function is
# not an approximation but a category error.
var _F32_TRIG_LIMIT = 0;

# Lazily build 2^63 as an f64. A literal that large does not survive an i64 parse.
fn _f32_trig_limit(): i64 {
    if (_F32_TRIG_LIMIT == 0) {
        var v = f64_from(1);
        var k = 0;
        while (k < 63) {
            v = f64_mul(v, f64_from(2));
            k = k + 1;
        }
        _F32_TRIG_LIMIT = v;
    }
    return _F32_TRIG_LIMIT;
}

# Sine, x in radians. Returns NaN for |x| >= 2^63.
#
# ⚠ THE GUARD IS THE POINT. stdlib's f64_sin reduces its argument only within the
# i64 range; past 2^63 it returns the argument UNCHANGED. Forwarded through
# f32_from that meant ganita_f32_sin(2^70) = 2^70 — a value a caller is entitled
# to assume lies in [-1, 1], because that is what sine means. Roughly a quarter
# of the finite f32 exponent range is above 2^63, so this was not an edge case
# reachable only by contrivance. NaN is the honest answer: the reduction cannot
# be performed, and NaN propagates loudly where 2^70 propagates silently.
fn ganita_f32_sin(x): i64 {
    var xf = f32_to(x);
    if (f64_ge(f64_abs(xf), _f32_trig_limit()) == 1) {
        return f32_from(f64_div(f64_from(0), f64_from(0)));
    }
    return f32_from(f64_sin(xf));
}
# Cosine, x in radians. Returns NaN for |x| >= 2^63 — see ganita_f32_sin.
fn ganita_f32_cos(x): i64 {
    var xf = f32_to(x);
    if (f64_ge(f64_abs(xf), _f32_trig_limit()) == 1) {
        return f32_from(f64_div(f64_from(0), f64_from(0)));
    }
    return f32_from(f64_cos(xf));
}
# Arctangent, result in radians.
fn ganita_f32_atan(x): i64 { return f32_from(f64_atan(f32_to(x))); }
# Round to nearest, ties to even.
fn ganita_f32_round(x): i64 { return f32_from(f64_round(f32_to(x))); }

# Two-argument forms — both operands widen before the f64 routine runs.
fn ganita_f32_pow(base, exp): i64 {
    return f32_from(ganita_f64_pow(f32_to(base), f32_to(exp)));
}
# Two-argument arctangent of y/x, quadrant-correct.
fn ganita_f32_atan2(y, x): i64 {
    return f32_from(ganita_f64_atan2(f32_to(y), f32_to(x)));
}
# sqrt(x*x + y*y) without intermediate overflow.
fn ganita_f32_hypot(x, y): i64 {
    return f32_from(ganita_f64_hypot(f32_to(x), f32_to(y)));
}

# cbrt(x) = sign(x) * |x|^(1/3). There is no f64 cbrt in ganita or the stdlib, so it is
# built from pow — and the sign split is REQUIRED, not decorative: `pow` goes through
# exp(y*ln x) and ln of a negative is undefined, so a bare pow returns garbage for every
# negative input while looking fine for the positives a naive test would use.
fn ganita_f32_cbrt(x): i64 {
    # cbrt(±0) = ±0. Without this the zero falls into pow -> exp(third * ln 0),
    # and ln(0) = -inf makes that NaN — so cbrt(0) returned NaN, which no caller
    # expects and which a positives-only test never sees. Sign of zero preserved.
    if (x & 0x7FFFFFFF == 0) { return x & 0xFFFFFFFF; }
    var xf = f32_to(x);
    var third = f64_div(f64_from(1), f64_from(3));
    if (x & 0x80000000 != 0) {
        return f32_from(f64_neg(ganita_f64_pow(f64_abs(xf), third)));
    }
    return f32_from(ganita_f64_pow(xf, third));
}

